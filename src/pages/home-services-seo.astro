---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/home-services-seo/',
  title: 'Home Services SEO for Trades and Contractors | Bright Forge',
  description: 'SEO for plumbers, pest controllers, roofers and other trades: service pages, real coverage areas, Google Business Profile and call tracking that works.',
  h1: 'Home Services SEO for Trades',
  crumb: 'Home services SEO',
  parents: [{ name: 'Industries', url: '/industries/' }],
  lead: [
    'A customer with a leak or a wasp nest searches, looks at a few listings and rings one. We work on being among them and on what the customer sees when they look: the right services, the right area, reviews and a phone number that connects.',
  ],
  sections: [
    {
      h2: 'Published results',
      html: `<ul class="bf-results">
<li><span class="bf-num">10,300 to 23,500</span><span class="bf-what"><strong>ThermoPest</strong> (pest.co.uk, pest control): organic clicks over six months, compared with the previous six, with more impressions (rounded)</span><a class="bf-src" href="/case-studies/pest-control-core-update-seo/">Case study</a></li>
<li><span class="bf-num">168 to 302</span><span class="bf-what"><strong>A pool-control systems business</strong> (not named): clicks up 80% as impressions more than doubled, from a small base</span><a class="bf-src" href="/case-studies/pool-control-systems-search-growth/">Case study</a></li>
</ul>
<p>These are search clicks. They do not measure calls or booked jobs.</p>`,
    },
    {
      h2: 'What we work on',
      html: `<dl class="bf-deliverables">
<dt>A page for each service</dt><dd>Saying what is included and what it usually costs or how it is quoted.</dd>
<dt>Coverage areas</dt><dd>Stated honestly: the towns you reach, not every town in the region.</dd>
<dt>Google Business Profile</dt><dd>Set up as a service-area business where you have no shopfront. See <a href="/local-seo-for-google-maps-and-gbp/">local SEO</a>.</dd>
<dt>Reviews</dt><dd>A routine for asking after each job.</dd>
<dt>Emergency and out-of-hours information</dt><dd>If you offer it.</dd>
<dt>Call and form tracking</dt><dd>So you can tell a connected call from a tap.</dd>
</dl>`,
    },
    {
      h2: 'How we do it',
      html: `<ol class="bf-steps">
<li>List the jobs you want more of and the areas you cover.</li>
<li>Fix the Business Profile and directory listings.</li>
<li>Rebuild the service pages.</li>
<li>Set up tracking.</li>
<li>Report monthly on calls and enquiries.</li>
</ol>
<p>For builders, contractors and suppliers, see <a href="/construction-seo-services/">construction SEO</a>.</p>`,
    },
  ],
  faqs: [
    { question: 'Should every suburb have a page?', answer: 'No. We first check whether the business serves the area and whether a separate page would answer a distinct need. Repeating the same text with a different suburb name is not a reason to create another URL.' },
    { question: 'Can we advertise emergency or same-day service?', answer: 'Only when the business can support that claim. Confirm staffed hours, dispatch coverage and any restrictions before the page says so.' },
  ],
};
---
<EditorialPage page={page} />
