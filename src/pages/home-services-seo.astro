---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";
const canonical = "https://brightforge.com.ph/home-services-seo/";
const proof = [
  {
    "title": "Jobs you want to take",
    "text": "Emergency repairs, planned installations and recurring maintenance are separate searches. We split them before choosing target pages."
  },
  {
    "title": "Coverage customers can check",
    "text": "Areas served, hours and the contact route, stated plainly enough for a visitor to decide whether to call."
  },
  {
    "title": "Inquiries your team can assess",
    "text": "We compare search activity with the job types and locations your office actually receives."
  }
];
const inclusions = [
  "A page for each service you want to book, and the areas each one covers",
  "Google Business Profile and local visibility signals",
  "Gaps in reviews, proof and trust beside the service",
  "Technical health, speed and mobile usability",
  "Tracking for calls, forms and quote requests"
];
const fit = [
  {
    "title": "Repair or replacement?",
    "text": "A leaking pipe and a bathroom installation are different purchases made in different moods. We map urgent service searches separately from planned work, then review the symptoms, scope, exclusions and next step on each page, including how the job is quoted."
  },
  {
    "title": "Area and availability",
    "text": "We check coverage against the area you actually dispatch to. A radius invented for SEO only brings calls you have to turn away. The site and the profile should agree on hours, and emergency or same-day wording needs confirmation from the team answering the phone."
  },
  {
    "title": "Proof beside the service",
    "text": "Approved job photos, current qualifications and relevant customer feedback belong where the buyer is making the choice. A roofing page should explain the work shown in its photos. An unrelated testimonial does not do that job."
  }
];
const process = [
  {
    "title": "Define the work",
    "text": "We start with your priority job types, areas, opening hours and capacity. We also confirm the services the team does not offer, so no page attracts inquiries you cannot take."
  },
  {
    "title": "Review existing pages",
    "text": "We compare service and area pages with Search Console queries, and decide which page already answers each search before proposing another town or service URL."
  },
  {
    "title": "Check profile and website",
    "text": "We compare Google Business Profile coverage, phone number and hours with the website, and flag eligibility or ownership issues before any business detail is changed."
  },
  {
    "title": "Brief the page changes",
    "text": "The brief specifies the missing service details, approved proof, internal links and contact instructions. Your operations contact checks availability and claims before release."
  },
  {
    "title": "Test the inquiry route",
    "text": "We check the call link on a phone and the agreed form fields, confirmation and recipient with the site owner. A click event alone does not show whether the call connected."
  },
  {
    "title": "Review job fit",
    "text": "We ask the office to distinguish missed calls, out-of-area requests, unsuitable jobs and booked work in its records, then use that feedback to adjust pages and priorities."
  }
];
const qa = [
  {
    "title": "Can we take this job?",
    "text": "Service pages should name the work accepted and any important exclusions. For example, a domestic electrician should not imply industrial coverage unless that is genuinely offered."
  },
  {
    "title": "Can we reach this customer?",
    "text": "The page lists the areas you actually reach and explains any booking restrictions. If the form asks for a postcode or suburb, we confirm who checks it and how the customer hears back."
  },
  {
    "title": "Did the inquiry become work?",
    "text": "Your office owns qualification and follow-up. We can compare the outcome records you supply with the available website data. Call handling and dispatch stay with your team and sit outside the SEO scope."
  }
];
const faqs = [
  {
    "question": "What is home services SEO?",
    "answer": "It helps customers find and assess a trade business for a specific job in a real service area. A customer with a leak or a wasp nest searches, looks at a short list of businesses and rings one, so the work covers service pages, local profile information, approved proof, mobile contact paths and measurement. A repair call and a planned installation may need different pages and inquiry routes."
  },
  {
    "question": "Should every suburb have a page?",
    "answer": "No. We first check whether the business serves the area and whether a separate page would answer a distinct need. A useful area page explains coverage, services and relevant local work. The same text with a different suburb name is not a reason to create another URL, and our published pest-control case makes the same point: publish the locations actually served, not interchangeable town pages."
  },
  {
    "question": "Can we advertise emergency or same-day service?",
    "answer": "Only when the business can support the claim. Confirm staffed hours, dispatch coverage and any restrictions first. If the website takes requests after hours but nobody answers until morning, say so. Presenting that form as emergency assistance costs you the customer and the review."
  },
  {
    "question": "How do you measure inquiry quality?",
    "answer": "Phone-button clicks and form submissions show activity, but a tap is not a connected call. Your office records whether requests were genuine, within the service area, suitable and booked. We agree which records can be shared and used before reporting qualified inquiries. Call recording or a new CRM integration needs separate scoping and privacy review."
  },
  {
    "question": "Can you work with our existing developer?",
    "answer": "Yes. We supply page briefs, technical recommendations and QA while your developer implements the changes. We agree in advance who updates hours and coverage, who tests the form recipient and who maintains tracking after release."
  },
  {
    "question": "When should we expect results?",
    "answer": "The starting pages, local competition, profile eligibility and the pace of approved changes all affect the plan. We distinguish completed fixes from later search movement and from booked work, so you can see progress at each stage. Rankings and call volumes are not guaranteed."
  }
];
---
<MainLayout title="Home Services SEO Philippines | Bright Forge" description="SEO for plumbing, HVAC, roofing, pest control and other trades: service pages, real coverage areas, Google Business Profile and tested inquiry routes." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Home Services SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Home Services <span>SEO</span>" breadcrumbCurrent="Home Services SEO">
    <Fragment slot="story"><p class="hero-subtitle">SEO for plumbers, HVAC teams, roofers and other trades that need customers to find the right service and contact the right team.</p><p>A customer with a leak searches, compares a few listings and rings one. We work on being among those listings and on what the customer sees when they look: the job you do, the area you cover and a phone number that connects. We start from the work you want to book and where you can send a team, and that sets the priorities for service pages, Google Business Profile and the inquiry route.</p><div class="hero-proof">{proof.map((item) => (<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
    <Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="#included" text="See What We Check" /></Fragment>
  </Hero>
  <main class="service-page">
    <section><div class="page-container intro-grid"><div><p class="eyebrow">SEO focus</p><h2><span>Home services SEO</span> should help urgent buyers choose the right provider</h2><p>A homeowner needs three things from your page before they call: that you handle their job, that you serve their address and that you answer at the time they need help. We review those details alongside <a href="/local-seo-for-google-maps-and-gbp/">local SEO and Google Business Profile</a>, then set out the page and contact-path changes.</p><p>Our published trade work is with ThermoPest (pest.co.uk), a pest-control business that specializes in bed bug heat treatment. Organic clicks rose from 10.3k to 23.5k across two six-month windows, with impressions up from 1.26M to 3.12M. The <a href="/case-studies/pest-control-core-update-seo/">case study</a> explains the evidence and its limits. We have also published an anonymized <a href="/case-studies/pool-control-systems-search-growth/">pool-control systems case</a>, where clicks rose from 168 to 302 across two 90-day periods. Both report organic search clicks, not plumbing or HVAC bookings, and neither is a forecast for another trade.</p></div><aside class="panel"><h3>What we check first</h3><ul>{inclusions.map((item) => <li>{item}</li>)}</ul></aside></div></section>
    <section id="included"><div class="page-container"><p class="eyebrow">What we focus on</p><h2>What <span>home services SEO</span> should cover</h2><div class="fit-grid">{fit.map((item) => (<article class="fit-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>Match <span>local demand</span> to the jobs your team can take</h2><p>This suits trades with defined services and someone responsible for incoming work. Philippine coverage might be described by city or barangay; Australian and UK teams may use suburb or postcode, while US teams may use city and ZIP code. We use the boundaries the business actually dispatches to. A translated list of place names helps nobody.</p></div><div class="panel"><h3>Not the right fit when</h3><p>the team cannot confirm service coverage, approve availability claims or respond to new requests. Those operational questions need answers before we expand the pages that attract calls.</p></div></div></section>
    <section><div class="page-container"><p class="eyebrow">Process</p><h2>From service coverage to a <span>tested inquiry route</span></h2><div class="process-grid">{process.map((item, index) => (<article class="process-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Quality control</p><h2>The questions that define a <span>suitable inquiry</span></h2><div class="qa-grid">{qa.map((item) => (<article class="qa-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Related work</p><h2><span>Useful next steps</span> from here</h2><div class="link-grid"><a href="/seo-services-philippines/"><span>SEO services</span>Plan service and area pages within the wider search campaign.</a><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Check speed, mobile usability and crawl access on service and area pages.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Brief service pages with the scope, exclusions and approved proof.</a></div></div></section>
    <section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>Home services SEO</span> questions worth answering</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section><div class="page-container"><div class="cta-card"><h2>Want more useful <span>local inquiries</span>, not just more traffic?</h2><p>Send your website, Maps link, service list and coverage areas. Tell us which jobs you want more of and how calls or quote requests reach the team. We will review the pages and the inquiry route against that brief, and scope the work in a written proposal.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View Case Studies" /></div></div></div></section>
  </main><Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#ffffff; color:#19212e; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.hero-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:26px; }
.hero-proof article, .panel, .fit-card, .process-card, .qa-card, .faq-item, .cta-card { border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; box-shadow:0 18px 48px rgba(25, 33, 46, 0.09); }
.hero-proof article { padding:18px; } .hero-proof strong { display:block; color:#19212e; font-size:1.05rem; margin-bottom:6px; } .hero-proof span { color:#465365; font-size:.92rem; line-height:1.5; }
.service-page section { padding:78px 0; content-visibility:visible !important; } .service-page section:nth-child(even) { background:#ffffff; }
.eyebrow { display:block; color:#b83e12; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#19212e; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; } h3 { color:#19212e; font-size:1.16rem; margin:0 0 10px; } p, li { color:#465365; font-size:1.02rem; line-height:1.72; } a { color:#b83e12; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; } .panel { padding:28px; } .panel ul { margin:0; padding-left:20px; }
.fit-grid, .process-grid, .qa-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; } .fit-card, .process-card, .qa-card, .link-grid a { padding:24px; }
.process-card span { display:inline-grid; place-items:center; width:42px; height:42px; border-radius:14px; color:#19212e; background:rgba(240,98,42,.25); font-weight:900; margin-bottom:18px; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; } .link-grid span { display:block; color:#19212e; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; } .faq-item { overflow:hidden; } .faq-item summary { cursor:pointer; padding:22px 24px; color:#19212e; font-weight:900; list-style:none; } .faq-item summary::-webkit-details-marker { display:none; } .faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255, 255, 255, 0.045)); } .cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){ .hero-proof,.intro-grid,.two-column,.fit-grid,.process-grid,.qa-grid,.link-grid,.faq-layout{grid-template-columns:1fr;} }
</style>

