---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";
const canonical = "https://brightforge.com.ph/home-services-seo/";
const proof = [
  {
    "title": "Jobs you want to take",
    "text": "Separate emergency repairs, planned installations and recurring maintenance before choosing target pages."
  },
  {
    "title": "Coverage customers can check",
    "text": "State the areas served, hours and contact route so visitors can decide whether to call."
  },
  {
    "title": "Enquiries your team can assess",
    "text": "Compare search activity with the job types and locations your office actually receives."
  }
];
const inclusions = [
  "Service and location page coverage",
  "Google Business Profile and local visibility signals",
  "Review, proof and trust gaps",
  "Technical health, speed and mobile usability",
  "Calls, forms and quote request tracking"
];
const fit = [
  {
    "title": "Repair or replacement?",
    "text": "A leaking pipe and a bathroom installation need different information. We map urgent service searches separately from planned work, then review symptoms, scope, exclusions and the next step on each page."
  },
  {
    "title": "Area and availability",
    "text": "We check coverage against the actual dispatch area, not a radius invented for SEO. The site and profile should agree on hours. Emergency or same-day wording needs confirmation from the team answering the phone."
  },
  {
    "title": "Proof beside the service",
    "text": "Use approved job photos, current qualifications and relevant customer feedback where the buyer is making a choice. A roofing page should explain the work shown rather than rely on an unrelated testimonial."
  }
];
const process = [
  {
    "title": "Define the work",
    "text": "Start with priority job types, areas, opening hours and capacity. Confirm services the team does not offer so the page does not attract avoidable mismatches."
  },
  {
    "title": "Review existing pages",
    "text": "Compare service and area pages with Search Console queries. Decide which page already answers the search before proposing another town or service URL."
  },
  {
    "title": "Check profile and website",
    "text": "Compare GBP coverage, phone number and hours with the website. Flag eligibility or ownership issues before changing business details."
  },
  {
    "title": "Brief the page changes",
    "text": "Specify the missing service details, approved proof, internal links and contact instructions. Your operations contact checks availability and claims before release."
  },
  {
    "title": "Test the enquiry route",
    "text": "Check the call link on mobile and the agreed form fields, confirmation and recipient with the site owner. A click event alone does not show whether the call connected."
  },
  {
    "title": "Review job fit",
    "text": "Ask the office to distinguish missed calls, out-of-area requests, unsuitable jobs and booked work in its records. Use available feedback to adjust pages and priorities."
  }
];
const qa = [
  {
    "title": "Can we take this job?",
    "text": "Service pages should name the work accepted and any important exclusions. For example, a domestic electrician should not imply industrial coverage unless that is genuinely offered."
  },
  {
    "title": "Can we reach this customer?",
    "text": "List actual areas and explain any booking restrictions. If the form asks for a postcode or suburb, confirm who checks it and how the customer hears back."
  },
  {
    "title": "Did the enquiry become work?",
    "text": "Your office owns qualification and follow-up. We can compare supplied outcome records with available website data; handling calls or running dispatch is not assumed to be part of SEO."
  }
];
const faqs = [
  {
    "question": "What is home services SEO?",
    "answer": "It helps customers find and assess a trade business for a specific job in a real service area. The work covers service pages, local profile information, approved proof, mobile contact paths and measurement. A repair call and a planned installation may need different pages and enquiry routes."
  },
  {
    "question": "Should every suburb have a page?",
    "answer": "No. We first check whether the business serves the area and whether a separate page would answer a distinct need. A useful area page might explain coverage, services and relevant local work. Repeating the same text with a different suburb name is not a reason to create another URL."
  },
  {
    "question": "Can we advertise emergency or same-day service?",
    "answer": "Only when the business can support that claim. Confirm staffed hours, dispatch coverage and any restrictions. If the website takes requests after hours but nobody answers until morning, make that clear instead of presenting the form as emergency assistance."
  },
  {
    "question": "How do you measure enquiry quality?",
    "answer": "Phone-button clicks and form submissions show activity. Your office records whether requests were genuine, within the service area, suitable and booked. We agree which records can be shared and used before reporting qualified enquiries. Call recording or a new CRM integration needs separate scoping and privacy review."
  },
  {
    "question": "Can you work with our existing developer?",
    "answer": "Yes. We can supply page briefs, technical recommendations and QA while your developer implements changes. Agree who updates hours and coverage, tests the form recipient and maintains tracking after release."
  },
  {
    "question": "When should we expect results?",
    "answer": "The starting pages, local competition, profile eligibility and pace of approved changes affect the plan. We distinguish completed fixes from later search movement and booked work. Rankings and call volumes are not guaranteed."
  }
];
---
<MainLayout title="Home Services SEO Philippines | Bright Forge" description="SEO for plumbers, HVAC, roofing, cleaning and trade businesses that need better local visibility, service pages and enquiry quality." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Home Services SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Home Services <span>SEO</span>" breadcrumbCurrent="Home Services SEO">
    <Fragment slot="story"><p class="hero-subtitle">SEO for plumbers, HVAC teams, roofers and other trades that need customers to find the right service and contact the right team.</p><p>We review the work you want to book, where you can send a team and what the website tells a customer before they call. That sets the priorities for service pages, Google Business Profile and the enquiry route.</p><div class="hero-proof">{proof.map((item) => (<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
    <Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="#included" text="See What We Check" /></Fragment>
  </Hero>
  <main class="service-page">
    <section><div class="page-container intro-grid"><div><p class="eyebrow">SEO focus</p><h2><span>Home services SEO</span> should help urgent buyers choose the right provider</h2><p>Home service searches are practical, local and often urgent. People want to know who serves their area, what the business does, whether they can trust it and how quickly they can get help.</p><p>A homeowner should be able to check whether you handle their job, serve their address and answer at the time they need help. We review those details alongside <a href="/local-seo-for-google-maps-and-gbp/">local SEO and Google Business Profile</a>, then identify the page and contact-path changes.</p><p>The pest-control comparison above reports organic search clicks, not plumbing or HVAC bookings. Its <a href="/case-studies/pest-control-core-update-seo/">case study</a> explains the available evidence; it is not a forecast for another trade.</p></div><aside class="panel"><h3>What we check first</h3><ul>{inclusions.map((item) => <li>{item}</li>)}</ul></aside></div></section>
    <section id="included"><div class="page-container"><p class="eyebrow">What we focus on</p><h2>What <span>home services SEO</span> should cover</h2><div class="fit-grid">{fit.map((item) => (<article class="fit-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>Match <span>local demand</span> to the jobs your team can take</h2><p>This suits trades with defined services and someone responsible for incoming work. Philippine coverage might be described by city or barangay; Australian and UK teams may use suburb or postcode, while US teams may use city and ZIP code. Use the boundaries the business actually dispatches to, not a translated list of place names.</p></div><div class="panel"><h3>Not the right fit when</h3><p>the team cannot confirm service coverage, approve availability claims or respond to new requests. Resolve those operational questions before expanding the pages that attract calls.</p></div></div></section>
    <section><div class="page-container"><p class="eyebrow">Process</p><h2>From service coverage to a <span>tested enquiry route</span></h2><div class="process-grid">{process.map((item, index) => (<article class="process-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Quality control</p><h2>The questions that define a <span>suitable enquiry</span></h2><div class="qa-grid">{qa.map((item) => (<article class="qa-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Related work</p><h2><span>Useful next steps</span> from here</h2><div class="link-grid"><a href="/seo-services-philippines/"><span>SEO services</span>Connect industry work to the wider SEO system.</a><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Fix crawl, speed, structure and indexation limits.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Build pages that answer real buyer questions.</a></div></div></section>
    <section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>Home services SEO</span> questions worth answering</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section><div class="page-container"><div class="cta-card"><h2>Want more useful <span>local enquiries</span>, not just more traffic?</h2><p>Send your website, Maps link, service list and coverage areas. Tell us which jobs you want more of and how calls or quote requests reach the team. We can then review the pages and enquiry route against that brief.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View Case Studies" /></div></div></div></section>
  </main><Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#ffffff; color:#19212e; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.hero-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:26px; }
.hero-proof article, .panel, .fit-card, .process-card, .qa-card, .faq-item, .cta-card { border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; box-shadow:0 18px 48px rgba(25, 33, 46, 0.09); }
.hero-proof article { padding:18px; } .hero-proof strong { display:block; color:#19212e; font-size:1.05rem; margin-bottom:6px; } .hero-proof span { color:#465365; font-size:.92rem; line-height:1.5; }
.service-page section { padding:78px 0; content-visibility:visible !important; } .service-page section:nth-child(even) { background:#ffffff; }
.eyebrow { display:block; color:#b83e12; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#19212e; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; } h3 { color:#19212e; font-size:1.16rem; margin:0 0 10px; } p, li { color:#465365; font-size:1.02rem; line-height:1.72; } a { color:#b83e12; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; } .panel { padding:28px; } .panel ul { margin:0; padding-left:20px; }
.fit-grid, .process-grid, .qa-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; } .fit-card, .process-card, .qa-card, .link-grid a { padding:24px; }
.process-card span { display:inline-grid; place-items:center; width:42px; height:42px; border-radius:14px; color:#19212e; background:rgba(240,98,42,.25); font-weight:900; margin-bottom:18px; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; } .link-grid span { display:block; color:#19212e; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; } .faq-item { overflow:hidden; } .faq-item summary { cursor:pointer; padding:22px 24px; color:#19212e; font-weight:900; list-style:none; } .faq-item summary::-webkit-details-marker { display:none; } .faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255, 255, 255, 0.045)); } .cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){ .hero-proof,.intro-grid,.two-column,.fit-grid,.process-grid,.qa-grid,.link-grid,.faq-layout{grid-template-columns:1fr;} }
</style>

