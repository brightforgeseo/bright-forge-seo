---
import MainLayout from '../layouts/MainLayout.astro';
import BuyerDecisionSection from "../components/BuyerDecisionSection.astro";
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'Google Business Profile first',
    copy: 'We start by confirming who owns the profile, which location it represents and whether its categories, hours and contact details match the business as it trades today. Only then do we review the features Google makes available on your profile.'
  },
  {
    title: 'Local search plus conversion',
    copy: 'A direction request, a website click and a booked job are three different outcomes. We follow the route from profile to branch page, phone or booking form, so the report can tell them apart.'
  },
  {
    title: 'Clean local signals',
    copy: 'We correct inconsistent name, address and phone (NAP) data, thin location and service pages, duplicate listings and citation gaps. Each one gives Google or a customer a reason to doubt which details are current.'
  }
];

const serviceBlocks = [
  {
    title: 'Google Business Profile optimisation',
    copy: 'We review categories, description, hours, service areas, photos and contact links against information the owner has confirmed. Products, posts, booking links and other features are included where Google offers them on that profile and they suit the business.'
  },
  {
    title: 'Google Maps and local pack strategy',
    copy: 'We compare the services you want to be found for with the places people search from, then review profile relevance, business information and supporting pages. Distance is a fixed constraint: editing a service area does not move the premises or guarantee coverage across a city.'
  },
  {
    title: 'Citation and NAP cleanup',
    copy: 'We check that your business name, address, phone number, website and core details agree across the local platforms, directories and data sources that matter. Where they disagree, you receive the listing, the wrong detail and the correct one, so the fix can be made once and at the source.'
  },
  {
    title: 'Review growth and response systems',
    copy: 'We plan a neutral review request that staff send after a genuine customer interaction, and draft responses the business can approve. Three rules hold throughout: no incentives, no filtering requests to happy customers only, and no private customer details in replies.'
  },
  {
    title: 'Location and service page support',
    copy: 'We improve the pages your listing sends people to: city pages, service pages and contact pages. A visitor from Google Business Profile who lands on a slow, generic or unclear page leaves without calling, so the page gets the same attention as the profile.'
  },
  {
    title: 'Local SEO tracking and reporting',
    copy: 'GBP reports show call-button clicks, website clicks and direction requests. Connected calls, qualified enquiries and bookings need separate records. Before defining the report, we agree which data is available and who supplies the outcome information.'
  }
];

const fitBlocks = [
  {
    title: 'Service-area businesses',
    copy: 'Eligible businesses that travel to customers, such as mobile repair or cleaning teams. If customers are not served at the business address, hide the address and use an accurate service area. Online-only service coverage is not enough for GBP eligibility.'
  },
  {
    title: 'Physical locations',
    copy: 'Shops, clinics, showrooms and other eligible locations that receive customers during stated hours. A hybrid business can also travel to customers. We check the operating model first, because not every clinic or law firm is a service-area business.'
  },
  {
    title: 'Multi-location brands',
    copy: 'Businesses with several branches that need the same standard at each one: GBP management, location-page structure, review handling and reporting, with the differences between branches kept intact.'
  },
  {
    title: 'Growing businesses with messy local data',
    copy: 'Companies carrying duplicate listings, old phone numbers, a previous address, inconsistent citations, few reviews or location pages that do not turn visits into enquiries.'
  }
];

const processSteps = [
  {
    label: '01',
    title: 'Local visibility audit',
    copy: 'We review your GBP, local rankings, competitor listings, citations, reviews, landing pages, tracking and service-area settings. The audit separates the blockers from the cosmetic profile tweaks that change nothing.'
  },
  {
    label: '02',
    title: 'Profile and signal cleanup',
    copy: 'We correct business data, set categories and services, resolve listing issues, improve profile content and make sure the public information matches the website. Wrong details elsewhere are fixed in the same pass.'
  },
  {
    label: '03',
    title: 'Page and proof improvements',
    copy: 'We strengthen the pages the listing links to: service pages, location pages, internal links, trust signals, photos, reviews and a clear way to enquire. The review request process goes in at this stage.'
  },
  {
    label: '04',
    title: 'Ongoing local growth',
    copy: 'We monitor rankings, GBP actions, reviews, competitor changes, citation health and enquiry quality. The listing is kept current, and the campaign follows the locations and services that matter most to the business.'
  }
];

const signals = [
  'Correct primary and secondary GBP categories',
  'Accurate business name, address, phone and opening hours',
  'Service areas that match how the business actually operates',
  'Specific service descriptions and product or service entries',
  'Fresh photos that show real people, premises, work or results',
  'Review requests and responses handled without spam or scripts',
  'Citation consistency across useful local platforms',
  'Location or service pages that match GBP intent',
  'Tracking for calls, forms, clicks and direction requests',
  'Internal links from relevant service and contact pages'
];

const faqs = [
  { question: 'How is local SEO different from general SEO?', answer: 'General SEO works on website pages that can rank for a search anywhere. Local SEO works on the map results and the short list of nearby businesses, where Google weighs relevance, distance and prominence, and where the Google Business Profile matters as much as the website. The two share the same site, so a strong service page helps both. The difference is the asset we work on first and the outcome we measure: calls, direction requests and visits from a defined area.' },
  { question: 'What does local SEO actually change?', answer: 'It changes what a customer sees and uses before they call: the Google Business Profile, the map pin, categories, hours, service area, photos, reviews, the page the listing opens, and whether a person can call or visit without hunting. Directory details that conflict are checked against the correct business information and corrected.' },
  { question: 'Is this only for shops with a front door?', answer: 'No. An eligible business can visit customers and still appear, as a service-area business with its address hidden when customers are not served there. Storefront, hybrid, organisation and individual-practitioner eligibility each need their own check; serving a city does not automatically justify another profile.' },
  { question: 'How long does local SEO take?', answer: 'An approved information change and a ranking change run on different timelines. Verification, review of edits, the starting profile, competition and proximity all affect progress. We scope the first corrections after reviewing access and eligibility, then compare visibility over agreed reporting periods. We do not promise a map-pack deadline.' },
  { question: 'What do you do on Google Business Profile?', answer: 'We review the name, categories, address or service area, hours, contact details, photos and website destination. We check which profile features are available before including them in the work, and agree who supplies photos, approves changes and handles ongoing customer replies.' },
  { question: 'Will this put us in Google Maps?', answer: 'Eligibility and verification come first. An eligible, verified profile can appear in Maps, but placement varies with relevance, distance and prominence. Distance from the searcher counts for a great deal and cannot be changed. We check the profile and supporting pages; we cannot guarantee a top-three result.' },
  { question: 'Do reviews matter?', answer: 'Yes, for trust, calls and map visibility. We do not buy reviews or script customers. The work is a request process someone on the floor will actually use, plus replies that sound like the business.' },
  { question: 'Do we need a page per city?', answer: 'Only for places you truly serve or a branch that exists. A page that only swaps the city name gives customers no useful local information. Multi-location work starts with a branch inventory and profile eligibility. A suburb template is never the starting point.' },
  { question: 'How do you measure it?', answer: 'We separate map visibility and profile actions from customer outcomes. The GBP Calls metric counts call-button clicks, not answered calls. Where the business supplies call or booking records, we compare those outcomes directly, and we never count every direction request or website click as a lead.' }
];
---

<MainLayout
  title="Local SEO for Google Maps and GBP | Bright Forge"
  description="Local SEO from our Quezon City team: Google Business Profile, citations, reviews and location pages, so nearby customers find the right branch and call it."
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Local SEO for Google Maps and GBP',
          item: 'https://brightforge.com.ph/local-seo-for-google-maps-and-gbp/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Local SEO for Google Maps and GBP',
      url: 'https://brightforge.com.ph/local-seo-for-google-maps-and-gbp/',
      inLanguage: 'en',
      description: 'Google Maps and Google Business Profile work for a real service area. Quezon City based, serving single and multi-location businesses.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: serviceBlocks.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          description: item.copy
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-map-marker-alt"
    badgeText="Local SEO"
    title="Local SEO for <span>Google Maps and GBP</span>"
    breadcrumbCurrent="Local SEO for Google Maps and GBP"
  >
    <Fragment slot="story">
      <p>When someone searches for a service nearby or in a named place, Google shows a map and a short list of businesses. Local SEO is the work of being on that list, and of making sure the customer who taps your listing finds the right hours, the right phone number and a reason to choose you. We correct the Google Business Profile and the page it opens together, so a person can call the correct branch, book an appointment or check whether you cover their area.</p>
      <p>Our team is based in Quezon City and works with single-location businesses, multi-branch brands and businesses that travel to their customers. Philippine campaigns start with your actual premises and coverage. For businesses in Australia, the UK and the USA, the same review is scoped around the client location, profile access and a local owner who can confirm operating details.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Get a Local SEO Audit" />
      <ButtonSecondary href="#local-work" text="See What We Fix" />
    </Fragment>

    <Fragment slot="stats">
      <div class="hero-stats">
        <div class="stat"><strong>GBP</strong><span>Profile ownership, eligibility, services, hours and contact details.</span></div>
        <div class="stat"><strong>Maps</strong><span>Local pack visibility for the services you sell in the areas you cover.</span></div>
        <div class="stat"><strong>Actions</strong><span>Profile clicks and directions, reported separately from enquiries and bookings.</span></div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">What you get</span>
          <h2>An accurate listing, a landing page that answers, and <span>a change list someone can approve</span></h2>
          <p>Send the Maps link, website, branch list and the contact route customers should use. Before proposing any change, we identify conflicting information, eligibility questions and the gaps between the profile and the page.</p>
          <p>You receive three things: a Google Business Profile that matches how the business trades, a destination page that answers the question the customer arrived with, and a written list of every correction with the person who must confirm it. What goes on that list depends on the business. For a Philippine clinic, the branch page may need appointment instructions, practitioner information and current opening hours. A repair team needs service coverage and a phone route that works.</p>
          <p>A small example shows the method. A branch closing early for a holiday needs matching hours on its profile and its website. We identify the conflicting entries and the owner who must confirm the change. Customer-facing information like this is put right before we add a single new directory listing.</p>
          <p>Our pest-control case study shows how we report evidence. ThermoPest's Search Console clicks rose from 10.3k to 23.5k between two six-month windows, a measure of organic search clicks, not Google Maps actions or booked jobs. The <a href="/case-studies/pest-control-core-update-seo/">published comparison</a> gives that growth its context, and we present it as search performance rather than the isolated effect of GBP work.</p>
        </div>
        <aside class="local-panel" aria-label="Local SEO commercial outcomes">
          <h3>What the work is meant to produce</h3>
          <ul>
            <li>More qualified calls from the service areas you target</li>
            <li>Better visibility in Google Maps and local pack results</li>
            <li>Business details that agree on every listing</li>
            <li>A clear path from the profile to the right page, phone or form</li>
            <li>More useful reviews, with professional responses</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="proof-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="proof-grid">
        {proofItems.map((item) => (
          <article class="proof-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="local-vs-general-seo">
    <div class="pf-wrap">
      <p class="eyebrow">Which one you need</p>
      <h2>How <span>local SEO differs</span> from general SEO</h2>
      <p class="pf-lede">Both work on the same website, and most businesses with premises or a service area need some of each. The table shows where the effort goes.</p>
      <div class="pf-table-wrap"><table class="pf-table">
        <thead><tr><th scope="col">Question</th><th scope="col">General SEO</th><th scope="col" class="pf-us">Local SEO</th></tr></thead>
        <tbody>
          <tr><th scope="row">Where the result appears</th><td>The standard list of website results, for searchers anywhere.</td><td class="pf-us">Google Maps and the short list of nearby businesses shown with the map.</td></tr>
          <tr><th scope="row">What Google weighs</th><td>The page: its content, its links and how well the site can be crawled.</td><td class="pf-us">Relevance, distance from the searcher and prominence. Distance cannot be edited.</td></tr>
          <tr><th scope="row">The asset we work on first</th><td>Service, category and article pages.</td><td class="pf-us">The Google Business Profile, then the branch or service page it opens.</td></tr>
          <tr><th scope="row">Who has to be involved</th><td>Whoever approves content and site changes.</td><td class="pf-us">Someone at each location who can confirm hours, coverage and contact details.</td></tr>
          <tr><th scope="row">What we report</th><td>Search clicks, rankings and enquiries from the site.</td><td class="pf-us">Call-button clicks, website clicks and direction requests, kept separate from answered calls and bookings.</td></tr>
        </tbody>
      </table></div>
      <p class="pf-note">If you sell nationally or online with no premises and no service area, start with our <a href="/seo-services-philippines/">SEO services</a> instead.</p>
    </div>
  </section>

  <section id="local-work" class="services-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading narrow">
        <span class="eyebrow">What we fix</span>
        <h2>Six <span>local SEO</span> services, from the Google Business Profile to the report</h2>
        <p>The work covers the places customers actually see before they call: your Google Business Profile, map results, reviews, service pages, location pages and local citations. Each service below ends in something you can check.</p>
      </div>
      <div class="service-list">
        {serviceBlocks.map((service) => (
          <article class="service-item">
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="local-audit-deliverables">
    <div class="pf-wrap">
      <p class="eyebrow">What the audit hands you</p>
      <h2>Six documents from a <span>local SEO audit</span></h2>
      <p class="pf-lede">Each is a list someone can act on, with the listing or URL it refers to and the person who approves the change.</p>
      <ul class="pf-ticks">
        <li><strong>Profile and eligibility review.</strong> Who owns each Google Business Profile, which location it represents, and whether its categories, hours and service area match how the business trades.</li>
        <li><strong>Local competitor benchmark.</strong> The listings that appear for your services in your area, compared with yours on categories, reviews, photos and the pages they link to.</li>
        <li><strong>Citation discrepancy list.</strong> Every listing where the name, address, phone number or website disagrees, with the wrong detail and the correct one.</li>
        <li><strong>Local schema check.</strong> Whether the business markup on each branch or service page matches the visible name, address, hours and contact details, and the profile.</li>
        <li><strong>Landing page review.</strong> What a visitor from the listing finds on arrival: the service, the area covered and a working way to call, book or enquire.</li>
        <li><strong>Measurement plan.</strong> Which profile actions and which customer records are available, and who supplies the calls and bookings data.</li>
      </ul>
    </div>
  </section>

  <section class="pf-section" id="philippine-local-search">
    <div class="pf-wrap">
      <p class="eyebrow">Local search in the Philippines</p>
      <h2>How <span>Philippine customers search</span> for a nearby business</h2>
      <p class="pf-lede">A diner looking for lunch in Makati and a parent looking for a clinic in Cebu do the same thing. They open Maps, or they type a job plus a place. Four habits follow from that, and each one shapes the work.</p>
      <ul class="pf-ticks">
        <li><strong>They check who is open.</strong> Hours must match the door, including public holidays. A listing that says Open when the shutters are down loses the customer and invites a poor review.</li>
        <li><strong>They look for recent, real photos.</strong> The premises, the people and the work as they are today. A profile with only a logo looks unfinished.</li>
        <li><strong>They read reviews that sound like people.</strong> The right request is a neutral invitation sent after a completed visit. Buying reviews can get the listing removed.</li>
        <li><strong>Verification comes before all of it.</strong> Google chooses the method. In the Philippines a postcard can stall at a building admin desk or a village gate, so we plan for that first.</li>
      </ul>
      <p class="pf-note">Further reading: <a href="/blog/local-seo-for-restaurants-and-clinics-in-the-philippines/">local SEO for restaurants and clinics in the Philippines</a>.</p>
    </div>
  </section>

  <section class="fit-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="fit-layout">
        <div class="fit-copy">
          <span class="eyebrow">Who this is for</span>
          <h2>Four kinds of business where <span>location decides who gets the call</span></h2>
          <p>Local SEO earns the most where customers choose on area, availability, reviews, trust and convenience. That covers walk-in businesses and service-area companies that travel to their customers. Tradespeople and home-service firms will find more on our <a href="/home-services-seo/">home services SEO</a> page.</p>
          <p>The business needs someone who can confirm changes to hours, coverage and services. For several branches, name that contact per location, so one central update does not overwrite local differences.</p>
        </div>
        <div class="fit-grid">
          {fitBlocks.map((fit) => (
            <article class="fit-card">
              <h3>{fit.title}</h3>
              <p>{fit.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <BuyerDecisionSection id="branch-governance" eyebrow="Multi-location SEO" title="One listing, one page and one owner" emphasis="for every real branch.">
    <p>We start with a branch inventory: operating locations, their Google Business Profiles, the pages they should link to and the people responsible for changes. Profile eligibility is checked before any listing is created. A service area or a virtual address is not automatically another eligible branch, and we do not create listings or pages for places where you have no premises and no staff.</p>
    <p>Each location needs an owner for hours, contact details, closures and review responses. Duplicate or conflicting profiles are investigated before anyone edits them; creating another listing can compound the problem. Location pages should describe the actual branch and its services. Swapping a suburb name into the same copy helps nobody, and our guide to <a href="/blog/multi-location-local-seo-without-doorway-pages/">multi-location local SEO without doorway pages</a> explains why.</p>
    <p>That structure gives per-location reporting a sound basis. We can tell a data problem at one branch from a wider site issue before applying the same fix everywhere.</p>
  </BuyerDecisionSection>

  <section class="signals-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="signals-layout">
        <div class="signals-copy">
          <span class="eyebrow">Local trust signals</span>
          <h2>The ten details every <span>local SEO</span> review records, with an owner for each</h2>
          <p>An old phone number is a different task from a weak service page. For each discrepancy we record four things: the wrong information, the correct information, the affected listing or URL, and the person who can approve the correction. The business receives a change list it can work through. A profile-completeness score would tell it far less.</p>
        </div>
        <div class="signals-list">
          {signals.map((signal) => <span>{signal}</span>)}
        </div>
      </div>
    </div>
  </section>

  <BuyerDecisionSection id="local-authority" eyebrow="Relevance beyond the listing" title="Local link building starts with" emphasis="relationships the business already has.">
    <p>Local SEO link building is a different job from submitting the business to every directory. A citation keeps business details consistent. An editorial link gives people a useful route from a relevant organisation to your business. A paid directory membership should have a genuine business purpose; paid links also need appropriate sponsored or nofollow qualification.</p>
    <dl>
      <dt>Start with relationships that exist</dt><dd>We assess relevant trade bodies, suppliers, community organisations and publications against the work the business actually does. Memberships, partnerships and service areas must be genuine; we do not invent affiliations to obtain links.</dd>
      <dt>Send visitors to the right location</dt><dd>For multi-location local SEO, each branch needs accurate details and a useful destination. A reference to one branch should never send someone to an unrelated office, or to a generic page that leaves them searching again.</dd>
      <dt>Measure more than a link count</dt><dd>We review relevance, destination quality and referral context alongside local search performance. More backlinks cannot move a business physically closer to the searcher or replace a complete Google Business Profile.</dd>
    </dl>
    <p>For broader authority work, see our <a href="/backlink-seo-services-philippines/">link building service</a>. Local targeting stays with the branch pages and profiles that serve those customers.</p>
    <p>Related reading: <a href="/blog/google-business-profile-verification-in-the-philippines/">GBP verification</a>, <a href="/blog/service-area-business-vs-storefront-on-google-maps/">service-area vs storefront</a>, <a href="/blog/google-business-profile-and-local-pack-work-in-the-philippines/">Google Business Profile and local pack work</a>, and <a href="/blog/nap-consistency-for-philippine-businesses/">NAP consistency</a>.</p>
  </BuyerDecisionSection>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading">
        <span class="eyebrow">How we work</span>
        <h2>Our <span>local SEO</span> process: audit, clean up, improve the pages, keep it current</h2>
      </div>
      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-card">
            <span>{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="cta-panel">
        <span class="eyebrow">Next step</span>
        <h2>Send us your Maps link and see <span>what to correct first</span></h2>
        <p>We review your Google Business Profile, local search footprint, citations, reviews, landing pages and tracking, then show which corrections come first and what they should change for local visibility. The work is scoped in a written proposal.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Get a Local SEO Audit" />
          <ButtonSecondary href="/seo-services-philippines/" text="View SEO Services" />
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="section-heading">
        <span class="eyebrow">Questions</span>
        <h2><span>Local SEO</span> questions about Maps, reviews, timing and measurement</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.hero-stats {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
}

.stat {
  background: rgba(25, 33, 46, 0.09);
  border: 1px solid rgba(240, 98, 42, 0.28);
  border-radius: 18px;
  padding: 1.25rem;
}

.stat strong {
  display: block;
  color: #19212e;
  font-size: 1.1rem;
  margin-bottom: 0.35rem;
}

.stat span {
  color: #465365;
  line-height: 1.55;
}

.intro-section,
.services-section,
.signals-section,
.faq-section {
  background: #f7f8fa;
  padding: 5rem 0;
}

.proof-section,
.fit-section,
.process-section,
.cta-section {
  background: #ffffff;
  padding: 5rem 0;
}

.intro-layout,
.fit-layout,
.signals-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
  gap: 4rem;
  align-items: start;
}

.intro-copy h2,
.fit-copy h2,
.signals-copy h2,
.section-heading h2,
.cta-panel h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.1;
  margin: 0.75rem 0 1.25rem;
  font-weight: 850;
}

.intro-copy p,
.fit-copy p,
.signals-copy p,
.section-heading p,
.cta-panel p {
  color: #465365;
  font-size: 1.05rem;
  line-height: 1.75;
  margin-bottom: 1rem;
}

.eyebrow {
  display: inline-flex;
