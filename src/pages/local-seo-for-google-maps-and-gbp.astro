---
import MainLayout from '../layouts/MainLayout.astro';
import BuyerDecisionSection from "../components/BuyerDecisionSection.astro";
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'Google Business Profile first',
    copy: 'We treat your GBP as a commercial asset, not a directory listing. Categories, services, photos, posts, reviews, Q&A and tracking all need to support enquiries.'
  },
  {
    title: 'Local search plus conversion',
    copy: 'Local SEO should lead to calls, direction requests, form fills and booked jobs. Rankings are useful only when the page and profile help people choose you.'
  },
  {
    title: 'Clean local signals',
    copy: 'We fix inconsistent NAP data, weak location pages, thin service pages, duplicate listings and citation gaps that make local trust harder to build.'
  }
];

const serviceBlocks = [
  {
    title: 'Google Business Profile optimisation',
    copy: 'We review categories, services, business description, opening hours, service areas, products, photos, posts, Q&A, tracking links and profile completeness. The goal is a profile that is accurate, active and built around how customers search.'
  },
  {
    title: 'Google Maps and local pack strategy',
    copy: 'We identify the search terms, locations and competitor profiles that matter, then improve the signals that influence map visibility: relevance, proximity, prominence, reviews, landing pages and business data consistency.'
  },
  {
    title: 'Citation and NAP cleanup',
    copy: 'We check whether your business name, address, phone number, website and core details are consistent across important local platforms, directories and data sources. Messy citations weaken trust and waste effort.'
  },
  {
    title: 'Review growth and response systems',
    copy: 'We help build ethical review collection and response processes. No fake reviews, no spam, no risky shortcuts. Local trust comes from real customer feedback handled professionally.'
  },
  {
    title: 'Location and service page support',
    copy: 'We improve the pages connected to your local visibility, including city pages, service pages and contact pages. GBP traffic often leaks if the landing page is weak, slow, generic or unclear.'
  },
  {
    title: 'Local SEO tracking and reporting',
    copy: 'We track the metrics that matter: local rankings, GBP actions, calls, website clicks, direction requests, form enquiries, Search Console visibility and changes in qualified lead flow.'
  }
];

const fitBlocks = [
  {
    title: 'Service-area businesses',
    copy: 'Plumbers, clinics, repair companies, trades, consultants, legal services, cleaning companies and other businesses that need calls or enquiries from a defined location.'
  },
  {
    title: 'Physical locations',
    copy: 'Shops, offices, clinics, showrooms, gyms, restaurants, schools and customer-facing locations that need stronger visibility in Maps and near-me searches.'
  },
  {
    title: 'Multi-location brands',
    copy: 'Businesses with several branches that need consistent GBP management, location-page structure, review standards and reporting across each location.'
  },
  {
    title: 'Growing businesses with messy local data',
    copy: 'Companies with duplicate listings, old phone numbers, moved addresses, inconsistent citations, weak reviews or location pages that do not convert.'
  }
];

const processSteps = [
  {
    label: '01',
    title: 'Local visibility audit',
    copy: 'We review your GBP, local rankings, competitors, citations, reviews, landing pages, tracking and service-area signals. This separates real blockers from cosmetic profile tweaks.'
  },
  {
    label: '02',
    title: 'Profile and signal cleanup',
    copy: 'We correct business data, optimise categories and services, clean up listing issues, improve profile content and make sure the public information matches the website.'
  },
  {
    label: '03',
    title: 'Page and proof improvements',
    copy: 'We strengthen the pages that support local search, including service pages, location pages, internal links, trust signals, photos, reviews and clear enquiry paths.'
  },
  {
    label: '04',
    title: 'Ongoing local growth',
    copy: 'We monitor rankings, GBP actions, reviews, competitor changes, citation health and enquiry quality, then adjust the campaign around the locations and services that matter most.'
  }
];

const signals = [
  'Correct primary and secondary GBP categories',
  'Accurate business name, address, phone and opening hours',
  'Service areas that match how the business actually operates',
  'Strong service descriptions and product or service entries',
  'Fresh photos that show real people, premises, work or results',
  'Review requests and responses handled without spam or scripts',
  'Citation consistency across useful local platforms',
  'Location or service pages that match GBP intent',
  'Tracking for calls, forms, clicks and direction requests',
  'Internal links from relevant service and contact pages'
];

const faqs = [
  { question: 'What does local SEO actually change?', answer: 'The Google Business Profile, the map pin, categories, hours, service area, photos, reviews, the page the listing opens, and whether a person can call or visit without hunting. Directories only help if the name, address and phone number already match.' },
  { question: 'Is this only for shops with a front door?', answer: 'No. Trades, clinics, legal work, repair and home services still need a listing that matches how they actually operate. A service-area business is not a fake branch. We will not invent a pin in a city we cannot defend.' },
  { question: 'How long does local SEO take?', answer: 'Incomplete listings can look better within weeks once categories, hours and the phone number are right. Competitive map packs usually take two to six months. Reviews, proximity and the landing page set the ceiling, not a posting calendar.' },
  { question: 'What do you do on Google Business Profile?', answer: 'Categories, services, the description, hours, service area, photos of real work, posts, Q&A, review replies, tracking links, duplicate listing checks, and making the website agree with the profile. Completeness is the start. Accuracy is the job.' },
  { question: 'Will this put us in Google Maps?', answer: 'That is the commercial test. Maps uses relevance, proximity and prominence. We fix the profile, reviews, citations and landing pages so Google can tell when you are a real answer. We cannot move your premises closer to the searcher.' },
  { question: 'Do reviews matter?', answer: 'Yes, for trust, calls and map visibility. We do not buy reviews or script customers. The work is a request process someone on the floor will actually use, plus replies that sound like the business.' },
  { question: 'Do we need a page per city?', answer: 'Only for places you truly serve or a branch that exists. A page that only swaps the city name is a doorway. Multi-location work starts with a branch inventory and profile eligibility, not a suburb template.' },
  { question: 'How do you measure it?', answer: 'Map visibility, GBP calls, website clicks, direction requests, forms, Search Console, and whether the landing page wastes the click. Rankings without calls are not the report.' }
];
---

<MainLayout
  title="Local SEO for Google Maps and GBP | Bright Forge"
  description="Google Maps and Google Business Profile work for businesses that need calls and visits from a real service area. Quezon City based. No fake branches."
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Local SEO for Google Maps and GBP',
          item: 'https://brightforge.com.ph/local-seo-for-google-maps-and-gbp/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Local SEO for Google Maps and GBP',
      url: 'https://brightforge.com.ph/local-seo-for-google-maps-and-gbp/',
      inLanguage: 'en',
      description: 'Google Maps and Google Business Profile work for a real service area. Quezon City based. No fake branches.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: serviceBlocks.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          description: item.copy
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-map-marker-alt"
    badgeText="Local SEO"
    title="Local SEO for <span>Google Maps and GBP</span>"
    breadcrumbCurrent="Local SEO for Google Maps and GBP"
  >
    <Fragment slot="story">
      <p>If the job starts with someone searching nearby, the Google Business Profile and the page it lands on have to agree. Categories, hours, the pin, the phone number and the service area are the product. A city page that only swaps the place name is not.</p>
      <p>We work this from Quezon City. If you trade in Cebu or Davao, that is a service area or a real branch, not a Bright Forge office. We will not invent a pin to win a pack we cannot defend.</p>
      <p>The test is simple. Can a person on a phone find you, trust the listing, and call or visit without hunting. Rankings on a spreadsheet are not that test.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Get a Local SEO Audit" />
      <ButtonSecondary href="#local-work" text="See What We Fix" />
    </Fragment>

    <Fragment slot="stats">
      <div class="hero-stats">
        <div class="stat"><strong>GBP</strong><span>Profile accuracy, services, photos, posts, Q&A and tracking.</span></div>
        <div class="stat"><strong>Maps</strong><span>Local pack visibility for the services and areas that matter.</span></div>
        <div class="stat"><strong>Leads</strong><span>Calls, forms, direction requests and website actions, not vanity traffic.</span></div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">Why local SEO matters</span>
          <h2>Local customers make quick decisions from search <span>results</span></h2>
          <p>We are a local search partner for Philippine businesses that live or die on nearby searches. When someone looks for a nearby service, they compare a small set of listings. The Google Business Profile, the pin, reviews, photos, the landing page and the call button decide it before anyone reads a long sales page.</p>
          <p>That is why local SEO needs more than citation submissions. We do not sell Manila-focused campaigns from a fake office. The listing has to match a real service area or a real branch, the profile has to stay accurate, and the enquiry path has to work on a phone.</p>
        </div>
        <aside class="local-panel" aria-label="Local SEO commercial outcomes">
          <h3>Local SEO should support real actions</h3>
          <ul>
            <li>More qualified calls from target service areas</li>
            <li>Better visibility in Google Maps and local pack results</li>
            <li>Cleaner trust signals across business listings</li>
            <li>Stronger conversion paths from GBP to website</li>
            <li>More useful reviews and professional responses</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="proof-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="proof-grid">
        {proofItems.map((item) => (
          <article class="proof-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="local-work" class="services-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading narrow">
        <span class="eyebrow">What we fix</span>
        <h2><span>Local SEO</span> services built around Maps visibility, trust and enquiries</h2>
        <p>The work starts with the places customers actually see: your Google Business Profile, map results, review profile, service pages, location pages and local citations.</p>
      </div>
      <div class="service-list">
        {serviceBlocks.map((service) => (
          <article class="service-item">
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="fit-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="fit-layout">
        <div class="fit-copy">
          <span class="eyebrow">Who this is for</span>
          <h2>Best fit for businesses where <span>location affects buying decisions</span></h2>
          <p>Local SEO is strongest when customers choose based on area, availability, reviews, trust and convenience. That includes both walk-in businesses and service-area companies that travel to customers.</p>
          <p>It is not a shortcut for weak service, fake reviews or low-effort city pages. The campaign has to reflect how the business really operates.</p>
        </div>
        <div class="fit-grid">
          {fitBlocks.map((fit) => (
            <article class="fit-card">
              <h3>{fit.title}</h3>
              <p>{fit.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <BuyerDecisionSection id="branch-governance" eyebrow="Multi-location SEO" title="Keep each branch accurate" emphasis="without creating competing listings.">
    <p>We start with a branch inventory: operating locations, their Google Business Profiles, the pages they should link to and the people responsible for changes. Check profile eligibility before creating a listing. A service area or a virtual address is not automatically another eligible branch.</p>
    <p>Each location needs an owner for hours, contact details, closures and review responses. Duplicate or conflicting profiles need investigation before edits are made; creating another listing can compound the problem. Location pages should explain the actual branch and its services, not swap a suburb name into the same copy.</p>
    <p>That structure gives per-location reporting a useful basis. We can distinguish a data problem at one branch from a wider site issue before applying the same fix everywhere.</p>
  </BuyerDecisionSection>

  <section class="signals-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="signals-layout">
        <div class="signals-copy">
          <span class="eyebrow">Local trust signals</span>
          <h2>The small details decide whether <span>local SEO</span> works</h2>
          <p>Most local SEO failures are not caused by one dramatic issue. They are usually caused by weak signals stacking up: an incomplete profile, old phone numbers, thin service pages, no review process, generic photos, poor tracking and inconsistent business information.</p>
        </div>
        <div class="signals-list">
          {signals.map((signal) => <span>{signal}</span>)}
        </div>
      </div>
    </div>
  </section>

  <BuyerDecisionSection id="local-authority" eyebrow="Relevance beyond the listing" title="Local links should reflect" emphasis="real local relationships.">
    <p>Local SEO link building is not the same as submitting the business to every directory. A citation helps keep business details consistent. An editorial link can give people a useful route from a relevant organisation to your business. Neither justifies a paid listing nobody uses.</p>
    <dl>
      <dt>Start with relationships that exist</dt><dd>We assess relevant trade bodies, suppliers, community organisations and publications against the business's actual work. Memberships, partnerships and service areas must be genuine; we do not invent affiliations to obtain links.</dd>
      <dt>Send visitors to the right location</dt><dd>For multi-location local SEO, each branch needs accurate details and a useful destination. A branch-specific reference should not send someone to an unrelated office or a generic page that leaves them searching again.</dd>
      <dt>Measure more than a link count</dt><dd>We review relevance, destination quality and referral context alongside local search performance. More backlinks cannot move a business physically closer to the searcher or replace a complete Google Business Profile.</dd>
    </dl>
    <p>For broader authority work, see our <a href="/backlink-seo-services-philippines/">link building service</a>. Local targeting remains with the branch pages and profiles that serve those customers.</p>
    <p>Related reading: <a href="/blog/google-business-profile-verification-in-the-philippines/">GBP verification</a>, <a href="/blog/service-area-business-vs-storefront-on-google-maps/">service-area vs storefront</a>, <a href="/blog/how-long-local-pack-rankings-take/">how long local pack rankings take</a>, and <a href="/blog/nap-consistency-for-philippine-businesses/">NAP consistency</a>.</p>
  </BuyerDecisionSection>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading">
        <span class="eyebrow">How we work</span>
        <h2>A <span>local SEO</span> process that starts with diagnosis, not guesswork</h2>
      </div>
      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-card">
            <span>{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="cta-panel">
        <span class="eyebrow">Next step</span>
        <h2>Find out what is holding back your local <span>visibility</span></h2>
        <p>We can review your Google Business Profile, local search footprint, citations, reviews, landing pages and tracking, then show where the biggest local SEO opportunities are.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Get a Local SEO Audit" />
          <ButtonSecondary href="/seo-services-philippines/" text="View SEO Services" />
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="section-heading">
        <span class="eyebrow">Questions</span>
        <h2><span>Local SEO</span> questions businesses usually ask before investing</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.hero-stats {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
}

.stat {
  background: rgba(13, 15, 26, 0.82);
  border: 1px solid rgba(240, 98, 42, 0.28);
  border-radius: 18px;
  padding: 1.25rem;
}

.stat strong {
  display: block;
  color: #ffffff;
  font-size: 1.1rem;
  margin-bottom: 0.35rem;
}

.stat span {
  color: #d0d4e8;
  line-height: 1.55;
}

.intro-section,
.services-section,
.signals-section,
.faq-section {
  background: #131627;
  padding: 5rem 0;
}

.proof-section,
.fit-section,
.process-section,
.cta-section {
  background: #0d0f1a;
  padding: 5rem 0;
}

.intro-layout,
.fit-layout,
.signals-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
  gap: 4rem;
  align-items: start;
}

.intro-copy h2,
.fit-copy h2,
.signals-copy h2,
.section-heading h2,
.cta-panel h2 {
  color: #ffffff;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.1;
  margin: 0.75rem 0 1.25rem;
  font-weight: 850;
}

.intro-copy p,
.fit-copy p,
.signals-copy p,
.section-heading p,
.cta-panel p {
  color: #d0d4e8;
  font-size: 1.05rem;
  line-height: 1.75;
  margin-bottom: 1rem;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  color: #f0622a;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.78rem;
}

.local-panel {
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.12), rgba(13, 15, 26, 0.92));
  border: 1px solid rgba(240, 98, 42, 0.28);
  border-radius: 24px;
  padding: 2rem;
  position: sticky;
  top: 2rem;
}

.local-panel h3 {
  color: #ffffff;
  font-size: 1.45rem;
  margin-bottom: 1rem;
}

.local-panel ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.9rem;
}

.local-panel li {
  color: #e8eaf2;
  line-height: 1.55;
  padding-left: 1.45rem;
  position: relative;
}

.local-panel li::before {
  content: '';
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 999px;
  background: #f0622a;
  position: absolute;
  left: 0;
  top: 0.55rem;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.proof-card,
.service-item,
.fit-card,
.process-card,
.faq-list details {
  background: #131627;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 1.6rem;
}

.proof-card h3,
.service-item h3,
.fit-card h3,
.process-card h3 {
  color: #ffffff;
  font-size: 1.2rem;
  margin-bottom: 0.75rem;
}

.proof-card p,
.service-item p,
.fit-card p,
.process-card p,
.faq-list p {
  color: #d0d4e8;
  line-height: 1.68;
  margin: 0;
}

.section-heading {
  text-align: center;
  max-width: 850px;
  margin: 0 auto 3rem;
}

.section-heading.narrow {
  max-width: 760px;
}

.service-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}

.service-item {
  border-left: 4px solid #f0622a;
}

.fit-grid {
  display: grid;
  gap: 1rem;
}

.signals-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.signals-list span {
  color: #ffffff;
  background: rgba(240, 98, 42, 0.11);
  border: 1px solid rgba(240, 98, 42, 0.24);
  border-radius: 999px;
  padding: 0.8rem 1rem;
  line-height: 1.4;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}

.process-card span {
  color: #f0622a;
  font-size: 0.85rem;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.cta-panel {
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.18), rgba(19, 22, 39, 0.96));
  border: 1px solid rgba(240, 98, 42, 0.32);
  border-radius: 28px;
  padding: clamp(2rem, 5vw, 4rem);
  text-align: center;
}

.cta-actions {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}

.faq-list {
  display: grid;
  gap: 1rem;
}

.faq-list summary {
  color: #ffffff;
  cursor: pointer;
  font-weight: 750;
  font-size: 1.05rem;
  line-height: 1.45;
}

.faq-list details[open] summary {
  color: #f0622a;
  margin-bottom: 0.9rem;
}

@media (max-width: 1024px) {
  .intro-layout,
  .fit-layout,
  .signals-layout,
  .service-list,
  .process-grid,
  .proof-grid {
    grid-template-columns: 1fr 1fr;
  }

  .local-panel {
    position: static;
  }
}

@media (max-width: 760px) {
  .intro-section,
  .services-section,
  .signals-section,
  .faq-section,
  .proof-section,
  .fit-section,
  .process-section,
  .cta-section {
    padding: 3.5rem 0;
  }

  .intro-layout,
  .fit-layout,
  .signals-layout,
  .service-list,
  .process-grid,
  .proof-grid {
    grid-template-columns: 1fr;
  }

  .cta-actions {
    flex-direction: column;
    align-items: stretch;
  }
}

</style>
