---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";
const canonical = "https://brightforge.com.ph/pet-seo-services/";
const proof = [
  {
    "title": "Appointments",
    "text": "Show the services, animals accepted, actual location and way to request an appointment."
  },
  {
    "title": "Product suitability",
    "text": "Help shoppers compare sizes, materials and compatibility using approved product details."
  },
  {
    "title": "Clinical review",
    "text": "Medical advice and treatment claims require a qualified veterinary reviewer before publication."
  }
];
const inclusions = [
  "Appointment-led service or product catalogue priority",
  "Actual locations, hours and animals accepted",
  "Booking requirements and availability",
  "Approved specifications and suitability sources",
  "Clinical review and outcome tracking owners"
];
const fit = [
  {
    "title": "Clinics and veterinary services",
    "text": "Review routine appointment pages separately from urgent-care information. Opening hours, animals treated, service availability and the clinic’s approved emergency instructions must match what the practice can actually provide."
  },
  {
    "title": "Groomers, trainers and boarding",
    "text": "Explain who the service suits, what is included, location or collection arrangements and booking requirements. For example, a groomer might need separate information about coat condition, size-based pricing and appointment preparation, supplied by the operator."
  },
  {
    "title": "Pet stores and product brands",
    "text": "Organise categories around the products people need to compare. Product pages should show dimensions, materials, variants and delivery terms; suitability and care claims need support from the manufacturer or qualified reviewer."
  }
];
const process = [
  {
    "title": "Choose the business priority",
    "text": "Start with the appointment types or product categories you want to support. A clinic with limited appointment capacity needs a different brief from a store expanding delivery coverage."
  },
  {
    "title": "Confirm service facts",
    "text": "Collect actual locations, hours, accepted animals, booking policies and review sources. For a catalogue, collect product specifications, variants and shipping restrictions instead."
  },
  {
    "title": "Review the existing journey",
    "text": "Follow a visitor from search landing page to booking request or product selection. Check missing information, mobile usability, indexability and whether local profile details agree with the site."
  },
  {
    "title": "Prepare the page brief",
    "text": "For example, a boarding page may need accepted species, drop-off times, required records, accommodation details and enquiry steps. The operator confirms each requirement; we use the approved facts to specify sections and internal links."
  },
  {
    "title": "Get the right approval",
    "text": "Your clinical reviewer approves medical advice; your service or product owner approves operational facts. We check that titles and FAQs retain important qualifications and that the published page matches the approved copy."
  },
  {
    "title": "Check requests against outcomes",
    "text": "Report search visibility and website actions. Where the business supplies the records, distinguish booking requests, confirmed appointments and attended visits, or orders and completed sales. A click-to-call event is not a connected call."
  }
];
const qa = [
  {
    "title": "Real locations and availability",
    "text": "Do not create a branch page or claim emergency coverage for a service that is not available there. Check opening hours and contact routes when the practice changes its schedule."
  },
  {
    "title": "Care claims with an owner",
    "text": "A general copy edit cannot approve diagnosis, treatment, dosage or therapeutic product claims. Agree the qualified veterinary reviewer and sources before those passages are published."
  },
  {
    "title": "Truthful reviews",
    "text": "Use genuine reviews with permission and accurate context. Review requests should not be restricted to happy customers or exchanged for incentives."
  }
];
const faqs = [
  {
    "question": "Is pet SEO mainly local SEO?",
    "answer": "For a clinic, groomer or boarding business, local discovery and accurate service information are often central. A pet ecommerce business may instead need category structure, product detail and delivery information. We establish the priority from the business model and existing search data."
  },
  {
    "question": "Who approves veterinary advice?",
    "answer": "A qualified veterinary reviewer supplied by your practice must approve medical advice and treatment claims. We can structure the brief and improve readability, but SEO work does not replace clinical judgement."
  },
  {
    "question": "Can you improve a booking page without changing our booking system?",
    "answer": "Often the missing information sits before the booking tool: services offered, animals accepted, requirements or hours. We review that page and its links first. Changes inside a third-party booking system require access and a separately agreed implementation scope."
  },
  {
    "question": "What about pet products with health claims?",
    "answer": "Provide the product evidence and approved wording. Manufacturer copy is an input, not permission to add treatment promises. Claims that need professional review stay with the appropriate reviewer before publication."
  },
  {
    "question": "How do you measure appointment enquiries?",
    "answer": "Keep website form submissions and call clicks separate from confirmed bookings and attended appointments. If your practice can share aggregate outcome records, we can agree how to compare them without treating every website action as a new patient."
  },
  {
    "question": "Can you guarantee map rankings or more appointments?",
    "answer": "No. Location, competition, service availability and follow-up affect outcomes. We can check the pages, business information and enquiry journey, then report the changes and observed performance."
  }
];
---
<MainLayout title="Pet SEO Services Philippines | Bright Forge" description="SEO for vets, groomers, trainers, stores and pet brands that need better local visibility, service pages and enquiry quality." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Pet SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Pet <span>SEO Services</span>" breadcrumbCurrent="Pet SEO">
    <Fragment slot="story"><p class="hero-subtitle">SEO for veterinary practices, pet services and stores that need clearer appointment or product pages.</p><p>Can the practice see this animal? What does the grooming appointment include? Will this harness fit? We review the search pages that should answer those questions and help owners take the appropriate next step.</p><div class="hero-proof">{proof.map((item) => (<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
    <Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="#included" text="See What We Check" /></Fragment>
  </Hero>
  <main class="service-page">
    <section><div class="page-container intro-grid"><div><p class="eyebrow">SEO focus</p><h2><span>Pet SEO</span> starts with what an owner needs to book or buy</h2><p>An appointment page needs current services and a usable contact route. A product page needs enough detail to judge suitability. Publishing more care articles will not resolve either gap on its own.</p><p>We agree which pages matter first, identify the facts your team needs to supply and separate clinical approval from SEO editing. Technical checks support those pages rather than becoming a disconnected checklist.</p></div><aside class="panel"><h3>What we check first</h3><ul>{inclusions.map((item) => <li>{item}</li>)}</ul></aside></div></section>
    <section id="included"><div class="page-container"><p class="eyebrow">What we focus on</p><h2>What <span>pet SEO</span> should cover</h2><div class="fit-grid">{fit.map((item) => (<article class="fit-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>For <span>pet businesses</span> reviewing bookings or catalogue discovery</h2><p>This suits veterinary clinics, groomers, trainers, pet stores, shelters, ecommerce brands and service businesses that need stronger local or commercial search visibility.</p></div><div class="panel"><h3>Bring the operational details</h3><p>Send your service list or priority products, current hours or delivery coverage, and the person who approves the facts. That lets us review what a customer can actually book or buy.</p></div></div></section>
    <section><div class="page-container"><p class="eyebrow">Process</p><h2>Improve the path to <span>an appointment or purchase</span></h2><div class="process-grid">{process.map((item, index) => (<article class="process-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Quality control</p><h2>How we keep <span>pet SEO</span> useful and trustworthy</h2><div class="qa-grid">{qa.map((item) => (<article class="qa-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Related work</p><h2><span>Useful next steps</span> from here</h2><div class="link-grid"><a href="/seo-services-philippines/"><span>SEO services</span>Plan appointment or catalogue improvements within the wider search campaign.</a><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Check service-page access, product variants and mobile usability.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Brief service and product pages with the right factual review.</a></div></div></section>
    <section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>Pet SEO</span> questions worth answering</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section><div class="page-container"><div class="cta-card"><h2><span>Want pet owners</span> to find the right service faster?</h2><p>We can audit your local visibility, service pages, reviews, content and enquiry paths before recommending the next work.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View Case Studies" /></div></div></div></section>
  </main><Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#ffffff; color:#19212e; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.hero-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:26px; }
.hero-proof article, .panel, .fit-card, .process-card, .qa-card, .faq-item, .cta-card { border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; box-shadow:0 18px 48px rgba(25, 33, 46, 0.09); }
.hero-proof article { padding:18px; } .hero-proof strong { display:block; color:#19212e; font-size:1.05rem; margin-bottom:6px; } .hero-proof span { color:#465365; font-size:.92rem; line-height:1.5; }
.service-page section { padding:78px 0; content-visibility:visible !important; } .service-page section:nth-child(even) { background:#ffffff; }
.eyebrow { display:block; color:#b83e12; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#19212e; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; } h3 { color:#19212e; font-size:1.16rem; margin:0 0 10px; } p, li { color:#465365; font-size:1.02rem; line-height:1.72; } a { color:#b83e12; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; } .panel { padding:28px; } .panel ul { margin:0; padding-left:20px; }
.fit-grid, .process-grid, .qa-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; } .fit-card, .process-card, .qa-card, .link-grid a { padding:24px; }
.process-card span { display:inline-grid; place-items:center; width:42px; height:42px; border-radius:14px; color:#19212e; background:rgba(240,98,42,.25); font-weight:900; margin-bottom:18px; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; } .link-grid span { display:block; color:#19212e; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; } .faq-item { overflow:hidden; } .faq-item summary { cursor:pointer; padding:22px 24px; color:#19212e; font-weight:900; list-style:none; } .faq-item summary::-webkit-details-marker { display:none; } .faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255, 255, 255, 0.045)); } .cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){ .hero-proof,.intro-grid,.two-column,.fit-grid,.process-grid,.qa-grid,.link-grid,.faq-layout{grid-template-columns:1fr;} }
</style>

