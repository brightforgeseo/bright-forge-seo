---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";
const canonical = "https://brightforge.com.ph/gaming-seo-services/";
const proof = [
  {
    "title": "Before purchase",
    "text": "Explain platforms, editions, requirements and where the game can be bought or tried."
  },
  {
    "title": "After an update",
    "text": "Keep guides tied to the version and platform they actually describe."
  },
  {
    "title": "Website to storefront",
    "text": "Measure outbound store clicks without calling them installs or purchases."
  }
];
const inclusions = [
  "Titles, editions, platforms and release dates",
  "Discovery queries versus existing-player questions",
  "HTML descriptions alongside video and interactive media",
  "Patch/version accuracy and named review owner",
  "Store-link clicks versus confirmed downstream actions"
];
const fit = [
  {
    "title": "Game and studio pages",
    "text": "Check that the page explains the game in readable HTML alongside trailers and screenshots. Players should be able to find supported platforms, release status, system requirements and the correct store link."
  },
  {
    "title": "Guides and support libraries",
    "text": "Separate discovery searches from questions asked by existing players. Review guide navigation, duplicate tags and version labels so useful answers are reachable without relying on an internal search box."
  },
  {
    "title": "Gaming products and accessories",
    "text": "For a store, category and product work centres on compatibility, specifications, stock and delivery. A controller page needs supported devices and connection details, not the same brief as a studio launch page."
  }
];
const process = [
  {
    "title": "Define the title and release",
    "text": "List the games, platforms, territories and launch or update dates in scope. Confirm whether the goal is store visits, account registrations, product sales or support discovery."
  },
  {
    "title": "Check the search results",
    "text": "Compare discovery, comparison and help queries separately. Record which existing URL can answer each question and where a video, community discussion or store listing dominates the results."
  },
  {
    "title": "Review the page delivery",
    "text": "Check whether important descriptions, requirements and links are present in crawlable pages. Inspect trailer loading, mobile layout, canonical URLs and archive navigation before proposing new content."
  },
  {
    "title": "Brief the missing answers",
    "text": "For example, a co-op game page may need player count, online versus local play, controller support and platform availability. Your product team confirms those details against the current build."
  },
  {
    "title": "Review against the current build",
    "text": "Ask the product or editorial owner to verify mechanics, screenshots and patch version. Agree who flags future changes and which guides need a correction rather than a new URL."
  },
  {
    "title": "Follow the next step",
    "text": "Test outbound store and signup links. Report store clicks separately from installs, wishlists or sales unless the destination supplies reliable attribution for those actions."
  }
];
const qa = [
  {
    "title": "Version accuracy",
    "text": "Show which release and platform a guide covers when the answer differs. A publication date alone does not establish that a walkthrough still works after a patch."
  },
  {
    "title": "Owned and community content",
    "text": "Identify official pages separately from community posts. Moderation policy and user safety stay with the community operator; SEO review can flag unwanted indexed duplicates but does not provide moderation."
  },
  {
    "title": "Assets and access",
    "text": "Confirm rights and approvals for screenshots, trailers and quoted material. Check public pages without requiring login; do not expose private account content to make it crawlable."
  }
];
const faqs = [
  {
    "question": "Does gaming SEO include Steam or app-store optimisation?",
    "answer": "This service focuses on your website and its search visibility. Store listing optimisation, paid acquisition and platform campaigns need a separate agreed scope. We can check that website links reach the correct store listing without claiming control over store rankings."
  },
  {
    "question": "Do you cover casino or gambling SEO?",
    "answer": "This page describes video games, gaming content and related products. It is not an offer of gambling compliance or casino acquisition services."
  },
  {
    "question": "Should every patch have a new page?",
    "answer": "Not necessarily. Keep a useful changelog where players can find it, and update an existing guide when its answer changes. A substantial new feature may justify a separate page; a small correction usually does not."
  },
  {
    "question": "Can a trailer-led site still support SEO?",
    "answer": "Yes, if essential game information and useful links are available as readable page content. We review video delivery and mobile usability without treating the trailer or artwork as disposable."
  },
  {
    "question": "What do you need from our studio?",
    "answer": "Send the site, target markets, release calendar, approved product facts and store destinations. Name the person who can verify gameplay and patch-specific details. No unreleased feature is treated as confirmed without approval."
  },
  {
    "question": "How will we know whether search brings players?",
    "answer": "Search Console shows website impressions and clicks. Analytics can record outbound store clicks or registrations where configured. Those actions are not proof of installs, active players or revenue, and SEO cannot guarantee those outcomes."
  }
];
---
<MainLayout title="Gaming SEO Services Philippines | Bright Forge" description="SEO for gaming brands, studios, apps and communities that need stronger organic visibility, technical foundations and player acquisition pages." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Gaming SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Gaming <span>SEO Services</span>" breadcrumbCurrent="Gaming SEO">
    <Fragment slot="story"><p class="hero-subtitle">Website SEO for game studios, gaming publishers and stores, from title discovery to the right product or support page.</p><p>We review how players find your titles, compare platforms and get answers after an update. The brief identifies the pages to improve, the facts your product team needs to confirm and the next actions the website can actually measure.</p><div class="hero-proof">{proof.map((item) => (<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
    <Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="#included" text="See What We Check" /></Fragment>
  </Hero>
  <main class="service-page">
    <section><div class="page-container intro-grid"><div><p class="eyebrow">SEO focus</p><h2><span>Gaming SEO</span> needs to distinguish finding a game from playing it</h2><p>Someone comparing co-op games has a different need from a player troubleshooting a recent patch. Sending both to a broad homepage leaves important questions unanswered.</p><p>We map those questions to game pages, comparisons or support content, then check whether the visitor can reach a relevant store, signup or answer. The choice depends on your catalogue and release stage.</p></div><aside class="panel"><h3>What we check first</h3><ul>{inclusions.map((item) => <li>{item}</li>)}</ul></aside></div></section>
    <section id="included"><div class="page-container"><p class="eyebrow">What we focus on</p><h2>What <span>gaming SEO</span> should actually cover</h2><div class="fit-grid">{fit.map((item) => (<article class="fit-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>For <span>gaming teams</span> with a release, catalogue or guide library</h2><p>This suits studios, gaming apps, communities, media brands and ecommerce stores that have real search demand behind games, tools, guides or products.</p></div><div class="panel"><h3>Define the website job</h3><p>Tell us which titles and markets matter, what is available now and where visitors should go next. A launch announcement, a store page and a player-support library require different priorities.</p></div></div></section>
    <section><div class="page-container"><p class="eyebrow">Process</p><h2>From release plans to <span>search-ready pages</span></h2><div class="process-grid">{process.map((item, index) => (<article class="process-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Quality control</p><h2>How we keep <span>gaming SEO</span> credible</h2><div class="qa-grid">{qa.map((item) => (<article class="qa-card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section><div class="page-container"><p class="eyebrow">Related work</p><h2><span>Useful next steps</span> from here</h2><div class="link-grid"><a href="/seo-services-philippines/"><span>SEO services</span>Connect title launches and catalogue priorities to the wider search campaign.</a><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Check trailer delivery, crawlable descriptions and guide archives.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Plan game pages and guides around discovery and player questions.</a></div></div></section>
    <section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>Gaming SEO</span> questions worth answering</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section><div class="page-container"><div class="cta-card"><h2>Ready to find the searches your <span>players already make</span>?</h2><p>We can audit your current pages, search demand and technical setup before recommending page changes, technical fixes or a content brief.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View Case Studies" /></div></div></div></section>
  </main><Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#ffffff; color:#19212e; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.hero-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:26px; }
.hero-proof article, .panel, .fit-card, .process-card, .qa-card, .faq-item, .cta-card { border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; box-shadow:0 18px 48px rgba(25, 33, 46, 0.09); }
.hero-proof article { padding:18px; } .hero-proof strong { display:block; color:#19212e; font-size:1.05rem; margin-bottom:6px; } .hero-proof span { color:#465365; font-size:.92rem; line-height:1.5; }
.service-page section { padding:78px 0; content-visibility:visible !important; } .service-page section:nth-child(even) { background:#ffffff; }
.eyebrow { display:block; color:#b83e12; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#19212e; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; } h3 { color:#19212e; font-size:1.16rem; margin:0 0 10px; } p, li { color:#465365; font-size:1.02rem; line-height:1.72; } a { color:#b83e12; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; } .panel { padding:28px; } .panel ul { margin:0; padding-left:20px; }
.fit-grid, .process-grid, .qa-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; } .fit-card, .process-card, .qa-card, .link-grid a { padding:24px; }
.process-card span { display:inline-grid; place-items:center; width:42px; height:42px; border-radius:14px; color:#19212e; background:rgba(240,98,42,.25); font-weight:900; margin-bottom:18px; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; } .link-grid span { display:block; color:#19212e; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; } .faq-item { overflow:hidden; } .faq-item summary { cursor:pointer; padding:22px 24px; color:#19212e; font-weight:900; list-style:none; } .faq-item summary::-webkit-details-marker { display:none; } .faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255, 255, 255, 0.045)); } .cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){ .hero-proof,.intro-grid,.two-column,.fit-grid,.process-grid,.qa-grid,.link-grid,.faq-layout{grid-template-columns:1fr;} }
</style>

