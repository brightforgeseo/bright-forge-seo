---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'Intent before edits',
    copy: 'First we establish what the page has to satisfy: the search result it appears in, the buyer reading it, the offer and the next step. Only then do we decide what changes.'
  },
  {
    title: 'Search and conversion in one pass',
    copy: 'Titles, headings and internal links bring the visitor. Proof, page flow, FAQs and a clear call to action decide whether that visitor enquires. We edit both together.'
  },
  {
    title: 'Priority pages first',
    copy: 'We choose pages on evidence. Service pages, local pages, category pages and landing pages that can move rankings and enquiries come before everything else.'
  }
];

const optimisationAreas = [
  {
    title: 'Search intent alignment',
    copy: 'We check that the page matches the reason someone searched, that its angle fits the results Google already shows and that the offer answers the buyer in the opening lines.'
  },
  {
    title: 'Title tags and meta descriptions',
    copy: 'We write titles and descriptions so the search result says what you offer and to whom. They support relevance and click-through without repeating the same keyword in every line.'
  },
  {
    title: 'H1 and heading structure',
    copy: 'We rework the headings so a visitor can scan the page and find their answer, and so search engines can map the main topic and the supporting questions around it.'
  },
  {
    title: 'Service and offer copy',
    copy: 'We add the facts a buyer needs and the page lacks: what is included, who it suits, the proof, the answers to common objections, how the process runs and what to do next.'
  },
  {
    title: 'Internal links and anchors',
    copy: 'We connect related service pages, supporting articles and priority URLs with descriptive anchor text, so relevance and authority reach the pages that need to rank.'
  },
  {
    title: 'FAQs and answer blocks',
    copy: 'We add question-led content where customers really do ask. It handles objections, supports long-tail searches and gives AI answers clearer source material to draw on.'
  },
  {
    title: 'Schema recommendations',
    copy: 'We check that page-level schema matches the visible content, covering FAQ, Service, Breadcrumb and WebPage markup where appropriate, so the markup describes what a visitor can actually see.'
  },
  {
    title: 'Proof and conversion signals',
    copy: 'We improve how the page uses trust signals, examples, case-study links, call-to-action placement and contact prompts, and check the next step works on a phone, so a ranking has a better chance of becoming a lead.'
  }
];

const pageTypes = [
  {
    title: 'Service pages',
    copy: 'Pages that must explain a high-value offer, rank for commercial searches and turn visitors into enquiries.'
  },
  {
    title: 'Local landing pages',
    copy: 'Location and service-area pages, where local relevance, proof, contact details and internal links have to work together.'
  },
  {
    title: 'Category and ecommerce pages',
    copy: 'Collection pages, where crawlability, indexable copy, product discovery, filters and commercial copy all affect organic sales.'
  },
  {
    title: 'Blog and support assets',
    copy: 'Articles that already earn impressions and need a better structure, fuller answers, fresher information or clearer internal links to the pages they support.'
  }
];

const prioritySignals = [
  'Pages with plenty of Search Console impressions and a poor click-through rate',
  'Pages on page two, or low on page one, for commercial searches that matter to you',
  'Service pages that get visits and too few enquiries',
  'Two of your own pages competing for one search, or an unclear keyword map',
  'Important pages with weak headings, thin copy, little proof or vague calls to action',
  'Pages that should inform AI search answers but lack clear, extractable detail',
  'Pages with few internal links from related service, blog or location content',
  'Pages where a modest gain would support a larger SEO campaign goal'
];

const processSteps = [
  {
    label: '01',
    title: 'Page audit and baseline',
    copy: 'We record the current rankings, Search Console data, copy, metadata, headings, internal links, schema and conversion path, and note how competing pages handle the same search.'
  },
  {
    label: '02',
    title: 'Intent and page mapping',
    copy: 'We confirm the search the page should serve, its supporting topics and its related pages and its role in the wider SEO campaign. Rewriting waits until this is confirmed.'
  },
  {
    label: '03',
    title: 'Structure and copy improvements',
    copy: 'We draft the new title, headings, body copy, FAQs, proof and calls to action beside the current version, so the page reads clearly to search engines and to buyers. The service owner checks coverage, inclusions and operational claims before the page is approved.'
  },
  {
    label: '04',
    title: 'Internal links and technical checks',
    copy: 'We add or refine contextual internal links, check indexability signals, review schema fit and confirm the page sits correctly in the wider site structure. Crawl, speed and rendering problems belong to technical SEO work.'
  },
  {
    label: '05',
    title: 'QA and measurement',
    copy: 'We check the page once the changes are live, then watch rankings, impressions, clicks, CTR, enquiries and behaviour signals to decide the next improvement.'
  }
];

const avoidItems = [
  {
    title: 'Title and missing buyer facts',
    copy: 'We would replace a title such as Our Cleaning Solutions with Commercial Office Cleaning plus the confirmed service area. A new scope section would state supported premises, cleaning frequency, access arrangements and exclusions, using facts supplied by the operator.'
  },
  {
    title: 'Links and enquiry instructions',
    copy: 'We would link a relevant office-cleaning case study beside the scope, if approved evidence exists. The quote prompt would ask for premises size, location, required frequency and suitable access times. We would not add an emergency-response promise without confirmation.'
  },
  {
    title: 'Client approval',
    copy: 'The service owner checks coverage, inclusions and operational claims. We show the proposed title, copy and link destinations together, flag unresolved facts and agree revision rounds before the page is approved.'
  },
  {
    title: 'Publishing responsibility',
    copy: 'Your publisher applies the approved changes, or we implement them where access and scope allow. We then check the live title, headings, links, mobile layout and form route, record the release date and keep the previous copy available for rollback.'
  }
];

const measurementItems = [
  'Keyword movement for the mapped primary and secondary queries',
  'Search Console impressions, clicks and click-through rate',
  'Organic landing page sessions and engagement quality',
  'Enquiries, form submissions, call clicks and tracked conversion actions',
  'Internal link flow to and from related priority pages',
  'Changes in search appearance and snippets; separately scoped AI-answer observations'
];

const connectedServices = [
  {
    title: 'SEO services Philippines',
    href: '/seo-services-philippines/',
    copy: 'The wider campaign that joins on-page work to technical SEO, content, authority and reporting.'
  },
  {
    title: 'SEO content writing services',
    href: '/content-seo-services-philippines/',
    copy: 'New or rewritten page copy, content briefs, article strategy and search-led content when a page needs more than revision.'
  },
  {
    title: 'Technical SEO services',
    href: '/technical-seo-services-philippines/',
    copy: 'Crawl, indexation, site speed, schema, rendering and architecture issues that hold a page back whatever its copy says.'
  },
  {
    title: 'Keyword research services',
    href: '/keyword-research-services/',
    copy: 'The right search intent mapped to the right page before content or optimisation work starts.'
  },
  {
    title: 'SEO audit services',
    href: '/seo-audit-services/',
    copy: 'A deeper diagnosis when rankings, traffic or conversions are underperforming and the cause is unclear.'
  },
  {
    title: 'Link building services',
    href: '/backlink-seo-services-philippines/',
    copy: 'Authority growth once the target pages are strong enough to deserve more links and to benefit from them.'
  }
];

const faqs = [
  { question: 'What is included in on-page SEO?', answer: 'Search intent checks, title tags, meta descriptions, H1s, heading structure, body copy, internal links, image alt text, schema recommendations, FAQs, proof placement and calls to action. You receive the proposed changes beside the current page for approval.' },
  { question: 'Is on-page SEO just keyword placement?', answer: 'No. Keyword placement is one part of it. The larger part is making the page clearer, more useful, better structured and more persuasive for the person reading it.' },
  { question: 'Can you improve existing pages instead of writing new ones?', answer: 'Yes. In many SEO campaigns, improving existing commercial pages is worth more than publishing more blog posts. We look for pages that already have impressions, rankings or commercial value, then fix the parts holding them back.' },
  { question: 'How does on-page SEO help conversions?', answer: 'Better page structure, clearer copy, stronger proof, useful FAQs, internal links and better calls to action help a visitor understand the offer faster. That gives organic traffic a better chance of turning into leads. We do not promise a conversion rate.' },
  { question: 'How do you choose which pages to optimise first?', answer: 'By search demand, current rankings, impressions, traffic, commercial value, conversion potential, internal-link importance and how much room the page has to improve against competing pages. The agreed page list records the reason for each revision, so your team can review priority before work starts.' },
  { question: 'Will you rewrite all the copy on a page?', answer: 'Only if the page needs it. Some pages need a full rewrite. Others need a better title, a stronger introduction, clearer sections, improved FAQs, better internal links or more proof around the existing offer.' },
  { question: 'How long does on-page SEO take to work?', answer: 'We can check the published edits as soon as they are live. Search engines need time to process changes, and enquiries need enough data to assess. We agree the observation window around traffic levels and the scope, and we do not promise a fixed ranking date.' },
  { question: 'Does on-page SEO help AI search visibility?', answer: 'Clear service information, accessible text and accurate proof can make a page easier to interpret. They do not guarantee inclusion in an AI answer. If AI visibility is part of the scope, we agree a separate measurement method and do not count added FAQs as a result.' }
];
---

<MainLayout
  title="On-Page SEO Services Philippines | Bright Forge"
  description="On-page SEO from our Philippines team: we rewrite titles, headings, copy and internal links on your key pages and show every change beside the original."
  keywords="on-page SEO services Philippines, on-page SEO services, on-page optimization services, website SEO optimization, internal linking services"
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'On-Page SEO Services Philippines',
          item: 'https://brightforge.com.ph/on-page-seo-services-philippines/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'On-Page SEO Services Philippines',
      url: 'https://brightforge.com.ph/on-page-seo-services-philippines/',
      inLanguage: 'en',
      description: 'On-page SEO services for improving search intent alignment, page structure, internal links, content depth, trust signals and conversion paths.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: optimisationAreas.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          description: item.copy
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-edit"
    badgeText="On-Page SEO Specialists"
    title="On-Page SEO Services Philippines for <span>Pages That Rank and Convert</span>"
    breadcrumbCurrent="On-Page SEO Services Philippines"
  >
    <Fragment slot="story">
      <p>We revise titles, headings, copy and internal links on the pages that should be bringing you enquiries. Our Philippines-based team shows the existing and proposed versions side by side so you can approve the work. Your publisher then applies the approved changes, or we implement them where access and scope allow.</p>
      <p>The service suits a business whose pages already appear in search but are rarely clicked, sit on the second page of results or bring visits without enquiries. We start from an agreed page list that records the reason for each revision.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=on-page-seo#contactForm" text="Get a Page SEO Audit" />
      <ButtonSecondary href="#optimise" text="See What We Optimise" />
    </Fragment>

    <Fragment slot="stats">
      <div class="onpage-hero-stats">
        <div class="stat"><strong>Clarify</strong><span>Intent, titles, headings, copy and the job of each page.</span></div>
        <div class="stat"><strong>Connect</strong><span>Internal links to and from related services and supporting content.</span></div>
        <div class="stat"><strong>Convert</strong><span>Proof, FAQs, calls to action and the enquiry route.</span></div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">What you get</span>
          <h2>What our <span>on-page SEO</span> changes, and what you approve</h2>
          <p>A buyer lands on your service page but cannot tell what is included, whether you cover their location or what to send for a quote. The page may rank and still lose that enquiry. We revise the page around those missing decisions while checking the searches it should answer.</p>
          <p>We provide on-page SEO from the Philippines for service, location, category and landing pages. For each page you receive one handover: the existing copy beside the proposed title, meta description, headings, sections, internal links and calls to action. You approve the actual changes, with unresolved facts flagged for you.</p>
          <p>We work on Philippine, Australian, UK and US campaigns. Before editing, we agree the URLs, target market, revision rounds and whether your team or ours will publish. A page refresh is not permission to change your offer, prices or service coverage.</p>
          <p>Ranking is one job of a commercial page. The page also has to explain the offer, match the searcher’s intent, show enough proof, answer objections and give the visitor a clear next step, so each of those is checked in the same pass.</p>
          <p>If a page gets impressions but few clicks, attracts the wrong visitors or receives visits without enquiries, we check query fit, tracking and the enquiry route before choosing edits. The answer may be clearer copy, a repaired form or a different target page.</p>
        </div>
        <aside class="diagnosis-panel" aria-label="On-page SEO diagnosis questions">
          <h3>Five questions we ask of every page</h3>
          <ul>
            <li>Does the page match what the searcher wanted?</li>
            <li>Is the offer clear in the first few seconds?</li>
            <li>Do the title, H1 and headings say the same thing?</li>
            <li>Does the page show enough proof to earn trust?</li>
            <li>Is there one clear route to an enquiry?</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="proof-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="proof-grid">
        {proofItems.map((item) => (
          <article class="proof-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="optimise" class="optimise-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">What we optimise</span>
          <h2>Eight parts of a page our <span>on-page SEO</span> revises</h2>
        </div>
        <p>On-page SEO is more than a checklist of keyword placements. We read each page three ways: as a search result, as a sales page and as one part of the site structure. These are the eight areas we review and revise.</p>
      </div>
      <div class="optimise-grid">
        {optimisationAreas.map((item) => (
          <article class="optimise-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-types-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">Where it applies</span>
        <h2>Four page types where <span>on-page SEO</span> pays first</h2>
        <p>On-page work does most on pages with commercial value, existing search signals or a clear role in the customer journey. In practice that means these four.</p>
      </div>
      <div class="page-types-grid">
        {pageTypes.map((item) => (
          <article class="page-type-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="priority-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="priority-layout">
        <div class="priority-copy">
          <span class="eyebrow">Page prioritisation</span>
          <h2>Eight signals that decide which pages we <span>optimise first</span></h2>
          <p>A thin old article and a high-value service page do not deserve the same effort. We use search demand, performance data and commercial value to decide where on-page SEO will do most. We do not optimise pages at random: we start with the pages where the signals listed here are strongest.</p>
          <p>The agreed page list records the reason for each revision, so your team can review priority and budget before work starts.</p>
        </div>
        <ul class="priority-list">
          {prioritySignals.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">Our process</span>
          <h2>Five steps from <span>page audit</span> to measured result</h2>
        </div>
        <p>We diagnose first, map intent second and change the page third. We record the release date and keep the previous copy available for rollback, so the comparison after release rests on a known change. The page list and reporting are set out in a written proposal.</p>
      </div>
      <div class="process-rail">
        {processSteps.map((step) => (
          <article class="process-step">
            <span>{step.label}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="avoid-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="avoid-layout">
        <div class="avoid-copy">
          <span class="eyebrow">Illustrative page revision</span>
          <h2>One <span>page revision</span>, from general pitch to usable quote request</h2>
          <p>Example, not a client result: a commercial cleaning page says “quality cleaning for every business” but leaves the buyer unsure about premises, hours and site access. We would ask the operator for those facts before revising the page. The four cards here show what the deliverable contains. They do not show a measured ranking lift.</p>
        </div>
        <div class="avoid-grid">
          {avoidItems.map((item) => (
            <article class="avoid-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="measurement-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="measurement-layout">
        <div class="measurement-panel">
          <span class="eyebrow">Measurement</span>
          <h2>Six measures we report after an <span>on-page SEO</span> release</h2>
          <p>We retain the release date and compare the affected page and its mapped queries over complete periods. Country and device splits help explain changes in click-through. Call clicks and form events are reported separately from qualified enquiries, and we need your sales feedback to assess lead quality. Our <a href="/case-studies/">published case studies</a> report Search Console figures in the same way, with their limits stated.</p>
        </div>
        <ul class="measurement-list">
          {measurementItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="internal-links-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">Connected SEO work</span>
          <h2>Six services that work alongside <span>on-page SEO</span></h2>
        </div>
        <p>A page can carry only so much alone. Technical health, keyword research, content quality, internal linking and authority all decide whether an on-page gain holds, which is why on-page work is planned alongside these six services.</p>
      </div>
      <div class="connected-grid">
        {connectedServices.map((service) => (
          <a class="connected-card" href={service.href}>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </a>
        ))}
      </div>
      <p>Need page optimisation as part of agency fulfilment? Our <a href="/white-label-seo-services-philippines/">white-label SEO outsourcing</a> supports your delivery while your agency keeps the client relationship.</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="max-w-4xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">Questions buyers ask</span>
        <h2><span>On-page SEO</span> FAQs</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="cta-panel">
        <span class="eyebrow">Start with one page</span>
        <h2>Send us an <span>underperforming page</span> and we’ll show what is holding it back</h2>
        <p>We review its search intent, structure, metadata, internal links, copy, proof and conversion path, then tell you which changes are likely to matter most and which can wait.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/?service=on-page-seo#contactForm" text="Get a Page SEO Audit" />
          <ButtonSecondary href="/case-studies/" text="View Case Studies" />
        </div>
      </div>
    </div>
  </section>

  <ContactSection href="/contact/?service=on-page-seo#contactForm" />
  <Footer slot="footer" />
</MainLayout>

<style>
:root {
  --bf-bg: #ffffff;
  --bf-panel: #f7f8fa;
  --bf-panel-2: #f7f8fa;
  --bf-text: #19212e;
  --bf-muted: #465365;
  --bf-orange: #f0622a;
  --bf-border: rgba(25, 33, 46, 0.09);
}

.onpage-hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.5rem;
}

.stat {
  background: rgba(25, 33, 46, 0.09);
  border: 1px solid rgba(240, 98, 42, 0.24);
  border-radius: 18px;
  padding: 1rem;
}

.stat strong {
  display: block;
  color: var(--bf-link, #b83e12);
  font-size: 1.35rem;
  margin-bottom: 0.35rem;
}

.stat span {
  color: #465365;
  font-size: 0.92rem;
  line-height: 1.45;
}

.intro-section,
.proof-section,
.optimise-section,
.page-types-section,
.priority-section,
.process-section,
.avoid-section,
.measurement-section,
.internal-links-section,
.faq-section,
.cta-section,
:global(.contact-cta-section) {
  content-visibility: visible !important;
  background: var(--bf-bg);
  color: var(--bf-text);
}

.intro-section,
.optimise-section,
.priority-section,
.measurement-section,
.faq-section {
  padding: 5.5rem 0;
  background: var(--bf-panel);
}

.proof-section,
.page-types-section,
.process-section,
.avoid-section,
.internal-links-section,
.cta-section {
  padding: 5.5rem 0;
  background: var(--bf-bg);
}

.intro-layout,
.priority-layout,
.avoid-layout,
.measurement-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
  gap: 3rem;
  align-items: start;
}

.eyebrow {
  display: inline-flex;
  color: var(--bf-link, #b83e12);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.35rem);
  line-height: 1.08;
  font-weight: 900;
  margin: 0 0 1.25rem;
}

h3 {
  color: #19212e;
  font-weight: 800;
  margin: 0 0 0.75rem;
}

p {
  color: #465365;
  line-height: 1.75;
  font-size: 1rem;
}

.intro-copy p,
.priority-copy p,
.avoid-copy p,
.measurement-panel p,
.cta-panel p {
  font-size: 1.08rem;
}

.diagnosis-panel,
.measurement-panel,
.cta-panel {
  background: linear-gradient(135deg, rgba(240, 98, 42, 0.12), rgba(25, 33, 46, 0.09));
  border: 1px solid rgba(240, 98, 42, 0.26);
  border-radius: 28px;
  padding: 2rem;
  box-shadow: 0 28px 70px rgba(25, 33, 46, 0.09);
}

.diagnosis-panel ul,
.priority-list,
.measurement-list {
  list-style: none;
  margin: 1.25rem 0 0;
  padding: 0;
}

.diagnosis-panel li,
.priority-list li,
.measurement-list li {
  position: relative;
  padding: 0.85rem 0 0.85rem 1.8rem;
  color: #465365;
  line-height: 1.55;
