---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/on-page-seo-services-philippines/',
  title: 'On-Page SEO Services Philippines | Bright Forge Page Edits',
  description: 'On-page SEO from our Philippines team: we rewrite titles, headings, copy and internal links on your key pages and show every change beside the original.',
  h1: 'On-Page SEO Services in the Philippines',
  crumb: 'On-page SEO',
  enquiry: '/contact/?service=on-page-seo#contactForm',
  lead: [
    'We improve the pages that should be bringing you customers. For each one we revise the title, meta description, headings, body copy and internal links, and send you the current and proposed versions side by side. Nothing changes on your site until you approve it.',
  ],
  sections: [
    {
      h2: 'Which pages we work on first',
      html: `<p>We choose with you, using Search Console data. The usual candidates:</p>
<ul class="bf-list">
<li>pages on the second page of results for a search that matters to you;</li>
<li>pages that appear often in search but are rarely clicked;</li>
<li>service pages that get visits and few enquiries;</li>
<li>two pages of yours competing for the same search.</li>
</ul>`,
    },
    {
      h2: 'What we change on each page',
      html: `<dl class="bf-deliverables">
<dt>Title and meta description</dt><dd>So the search result says what you offer and to whom.</dd>
<dt>H1 and headings</dt><dd>So the page answers the search it is meant for.</dd>
<dt>Body copy</dt><dd>We add the facts a buyer needs and the page lacks: what is included, where you work, prices or how pricing works, proof.</dd>
<dt>Internal links</dt><dd>To and from related pages, with descriptive anchor text.</dd>
<dt>FAQs</dt><dd>Where customers really do ask them.</dd>
<dt>Structured data</dt><dd>Recommendations for your developer.</dd>
<dt>The enquiry route</dt><dd>Is there a clear next step, and does it work on a phone.</dd>
</dl>`,
    },
    {
      h2: 'How we do it, step by step',
      html: `<ol class="bf-steps">
<li>Audit the page and record its current rankings, clicks and enquiries.</li>
<li>Confirm which search the page should serve, and that no other page of yours is competing. Where that is unclear, <a href="/keyword-research-services/">keyword research</a> comes first.</li>
<li>Draft the changes in a side-by-side document.</li>
<li>You review, with your subject expert where facts need checking.</li>
<li>We publish, or hand over to whoever manages your site.</li>
<li>We compare results after publication and report.</li>
</ol>`,
    },
    {
      h2: 'Pricing',
      html: `<p>We do not publish a rate card. On-page work is scoped in a written proposal, either as a batch of pages or as part of our <a href="/seo-services-philippines/">monthly SEO services</a>.</p>`,
    },
  ],
  faqs: [
    { question: 'Will you rewrite our whole site?', answer: 'Rarely. A handful of pages usually carry most of the opportunity, and we start there. New pages are a job for <a href="/content-seo-services-philippines/">SEO content writing</a>.' },
    { question: 'Do you write in our tone of voice?', answer: 'Yes. Send existing material you like and we will match it.' },
    { question: 'What if the page needs technical work too?', answer: 'We flag it and pass it to <a href="/technical-seo-services-philippines/">technical SEO</a>.' },
  ],
};
---
<EditorialPage page={page} />
