---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/b2b-seo-services/',
  title: 'B2B SEO Services for Consultancies and Firms | Bright Forge',
  description: 'B2B SEO for consultancies and service firms: clear capability pages, case evidence and enquiry tracking. See our published work for one UK consultancy.',
  h1: 'B2B SEO Services for Consultancies and Service Firms',
  crumb: 'B2B SEO',
  parents: [{ name: 'Industries', url: '/industries/' }],
  lead: [
    'A business buyer searches several times over weeks, compares a shortlist and consults colleagues. Your website has to explain what you do, show that you have done it before and make the next step obvious. We work on those three things.',
  ],
  secondary: { href: '/case-studies/consulting-firm-seo/', label: 'Read the Conscient case study' },
  sections: [
    {
      h2: 'Published result',
      html: `<ul class="bf-results">
<li><span class="bf-num">13,200 to 15,700</span><span class="bf-what"><strong>Conscient</strong> (conscient.co.uk), a UK consultancy: organic clicks over six months, compared with the previous six. Impressions increased and click-through rate fell by 1.2 percentage points</span><a class="bf-src" href="/case-studies/consulting-firm-seo/">Case study</a></li>
</ul>
<p>The figures do not measure enquiry quality.</p>`,
    },
    {
      h2: 'What we work on',
      html: `<dl class="bf-deliverables">
<dt>Capability pages</dt><dd>One per service, written for the person who has the problem.</dd>
<dt>Sector pages</dt><dd>Where you have real experience in the sector.</dd>
<dt>Case studies</dt><dd>The situation, what you did, the result.</dd>
<dt>Articles</dt><dd>That answer questions buyers ask early. See <a href="/content-seo-services-philippines/">SEO content writing</a>.</dd>
<dt>Enquiry routes</dt><dd>And tracking of forms, downloads and calls.</dd>
</dl>`,
    },
    {
      h2: 'How we do it',
      html: `<ol class="bf-steps">
<li>Interview the people who sell and deliver the work.</li>
<li><a href="/keyword-research-services/">Keyword research</a> for each service.</li>
<li>Rewrite the capability pages first.</li>
<li>Add proof.</li>
<li>Report monthly on enquiries from search.</li>
</ol>
<p>For software companies, see <a href="/saas-seo-services/">SaaS SEO</a>.</p>`,
    },
  ],
  faqs: [
    { question: 'Our buyers take months to decide. How do you measure progress?', answer: 'By enquiries from search and by the pages that produced them, alongside clicks and rankings for the services that matter. We agree what counts as an enquiry before reporting starts.' },
  ],
};
---
<EditorialPage page={page} />
