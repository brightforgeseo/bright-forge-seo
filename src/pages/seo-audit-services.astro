---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceEvidencePanel from '../components/ServiceEvidencePanel.astro';
import serviceEvidence from '../data/serviceEvidence.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'Evidence before recommendations',
    copy: 'We review crawl data, Search Console signals, rankings, page performance, content quality, internal links and conversion paths before we tell you what to change. Each finding records its source, its date and the exact page behind it.'
  },
  {
    title: 'Prioritised by commercial impact',
    copy: 'A long issue list helps nobody decide. We sort every finding into one of four groups: urgent blockers, growth opportunities, work to plan into a campaign and low-value noise you can leave alone.'
  },
  {
    title: 'Built for implementation',
    copy: 'The findings are written for the people who will act on them: owners, marketers, developers and content teams. Each one names the URL, the proposed change, the reason and the likely owner, so no one has to interpret a tool export.'
  }
];

const auditTriggers = [
  'Organic traffic has dropped and nobody can say why',
  'Important keywords are stuck despite ongoing SEO work',
  'The site earns impressions but too few clicks or leads',
  'A redesign, migration, CMS change or domain move is planned',
  'Google Search Console is showing crawl, indexing or page experience warnings',
  'Content keeps being published but the pages that matter are not moving',
  'A developer or agency changed the site and rankings shifted afterwards',
  'You want a clear SEO roadmap before spending more on content, links or technical work'
];

const auditAreas = [
  {
    title: 'Crawlability and indexation',
    copy: 'Can Google discover, crawl, render and index the right URLs, and only those? We check robots.txt, noindex tags, canonicals, sitemap quality, redirects and crawl waste.'
  },
  {
    title: 'Site architecture and internal links',
    copy: 'We trace how authority and relevance move through the site, find the priority pages buried too deep and check whether internal anchor text supports the right topics.'
  },
  {
    title: 'Technical SEO and performance',
    copy: 'We assess Core Web Vitals, mobile usability, status codes, duplicate URLs, JavaScript risks, schema fit, structured data errors and problems that repeat across a page template.'
  },
  {
    title: 'Content quality and search intent',
    copy: 'We compare each key page with the search results it competes in. Does it answer the buyer, avoid competing with your other pages and offer enough depth, proof and clarity to deserve its place?'
  },
  {
    title: 'Keyword and opportunity mapping',
    copy: 'We compare current rankings, missed opportunities and competitor coverage, so every recommendation is tied to real search demand and to business value.'
  },
  {
    title: 'Authority and backlink profile',
    copy: 'We review backlink quality, risky patterns, lost links, anchor text, the authority gap to competitors and the pages most likely to benefit from safer link growth.'
  },
  {
    title: 'Local and service-page signals',
    copy: 'For Philippine and local service businesses, we review location relevance, service clarity, trust signals, NAP consistency and the local route to an enquiry.'
  },
  {
    title: 'Conversion and enquiry path',
    copy: 'Search traffic has to become leads. We check calls to action, proof, form paths, contact details and page flow, and ask whether the visitor has been given enough reason to act.'
  }
];

const toolLimits = [
  {
    title: 'Automated scans report symptoms',
    copy: 'A tool can flag missing metadata, slow pages or duplicate titles. It cannot tell you whether the page matters commercially or whether the fix belongs in this month or next year.'
  },
  {
    title: 'Context changes priority',
    copy: 'A technical warning on a blocked tag page may be irrelevant. A milder issue on a core service page may be urgent, because that page carries rankings and enquiries.'
  },
  {
    title: 'SEO judgement matters',
    copy: 'We explain why a finding matters, which pages it affects and what evidence would justify acting on it. Where the cause remains uncertain, the roadmap names the next check to run. We do not present a guess as a fix.'
  }
];

const priorityFramework = [
  {
    label: 'Blockers',
    title: 'Fix first',
    copy: 'Indexation failures, broken templates, redirect errors, canonical conflicts, critical crawl issues and tracking problems that stop anyone judging performance properly.'
  },
  {
    label: 'Growth fixes',
    title: 'Fix next',
    copy: 'Pages with search demand, existing impressions, ranking potential or conversion value, where a technical, content or internal-link improvement can support growth.'
  },
  {
    label: 'Campaign support',
    title: 'Plan into the roadmap',
    copy: 'Content gaps, authority gaps, architecture improvements and template changes that belong in a wider SEO campaign and need a budget and an owner.'
  },
  {
    label: 'Low-value noise',
    title: 'Ignore or park',
    copy: 'Warnings that look dramatic in a tool but carry little commercial upside, low risk or no meaningful connection to organic performance. We list them so nobody spends a sprint on them.'
  }
];

const processSteps = [
  {
    label: '01',
    title: 'Access and baseline',
    copy: 'You grant read-only access to Search Console and analytics and tell us the decision the audit must inform. We confirm the business goals, priority pages, analytics setup and current rankings.'
  },
  {
    label: '02',
    title: 'Crawl and technical diagnosis',
    copy: 'We crawl the site, review indexation signals, inspect templates, test performance, check structured data and look for technical blockers.'
  },
  {
    label: '03',
    title: 'Content, intent and competitor review',
    copy: 'We assess priority pages against search intent, the competitors in the search results, keyword mapping, content depth, proof, internal links and conversion clarity.'
  },
  {
    label: '04',
    title: 'Authority and risk review',
    copy: 'We examine backlink quality, authority gaps, anchor patterns, lost links and off-page risks that may affect rankings or future growth.'
  },
  {
    label: '05',
    title: 'Roadmap and handover',
    copy: 'We deliver the prioritised roadmap with findings, evidence, recommended fixes, responsible teams and the order the work should happen in, then walk the people doing the work through it.'
  }
];

const deliverables = [
  {
    title: 'Audit summary for decision makers',
    copy: 'A plain-English overview for the person who signs off the budget: what is holding the site back, which fixes matter most and what the business should do next.'
  },
  {
    title: 'Technical and content findings',
    copy: 'The findings register. Each finding lists the affected URLs, the evidence with its source and date, the recommended change, the commercial reason and the check that will show the fix worked. It covers crawlability, indexation, site structure, performance, content quality, on-page SEO and conversion paths.'
  },
  {
    title: 'Prioritised implementation roadmap',
    copy: 'A task list grouped by impact, urgency, complexity and likely owner, with similar findings combined where one template repair addresses them. Developers, content teams and stakeholders can see what to do first, next and later.'
  },
  {
    title: 'Strategic next-step recommendations',
    copy: 'A clear view on what the site needs after the audit: technical SEO, content improvement, link building, local SEO, migration support or wider campaign work. Where the evidence says a planned spend should wait, we say that too.'
  }
];

const avoidItems = [
  {
    title: 'Evidence to collect',
    copy: 'We would compare the release date with complete Search Console periods, inspect the affected URL and check the HTML it returns. A site-wide average cannot explain what happened to this one page.'
  },
  {
    title: 'Decision and owner',
    copy: 'If the live template emits an unintended noindex directive, we would ask the developer to remove it from the affected public pages. The marketing owner confirms which pages should be searchable before the change is made.'
  },
  {
    title: 'Limits of the finding',
    copy: 'An audit identifies supported findings and unresolved questions. Implementation and measurement are needed to assess the recommendations, and neither guarantees rankings, traffic or leads.'
  },
  {
    title: 'Acceptance check',
    copy: 'We would test the live response and the rendered page after release, confirm the directive is gone and check that private pages remain excluded. Search Console recrawl and performance observations follow separately. A passed code check is not recovered traffic.'
  }
];

const connectedServices = [
  {
    title: 'Technical SEO services',
    href: '/technical-seo-services-philippines/',
    copy: 'For the crawl, indexation, rendering, performance, schema and architecture fixes the audit finds.'
  },
  {
    title: 'On-page SEO services',
    href: '/on-page-seo-services-philippines/',
    copy: 'For improving page structure, metadata, content depth, internal links, FAQs and conversion flow.'
  },
  {
    title: 'Keyword research services',
    href: '/keyword-research-services/',
    copy: 'For mapping search demand, intent and opportunity before content or page changes are planned.'
  },
  {
    title: 'Link building services',
    href: '/backlink-seo-services-philippines/',
    copy: 'For authority growth once the technical and content foundations are in place.'
  },
  {
    title: 'Website migration services',
    href: '/website-migration-services/',
    copy: 'For pre-migration and post-migration audits when a redesign, CMS change or URL move puts rankings at risk.'
  },
  {
    title: 'SEO services Philippines',
    href: '/seo-services-philippines/',
    copy: 'For turning audit findings into an ongoing SEO campaign across technical work, content, authority and reporting.'
  }
];

const faqs = [
  { question: 'What is included in an SEO audit?', answer: 'Our SEO audit reviews technical SEO, crawlability, indexation, site structure, internal links, content quality, search intent, keyword opportunities, the backlink profile, local signals where relevant and the conversion path from organic landing pages. You receive a summary for decision makers, a findings register with evidence for each recommendation, a prioritised roadmap and a handover for the people doing the work.' },
  { question: 'Is this different from an automated website scan?', answer: 'Yes. An automated scan lists surface-level warnings and gives them equal weight, with no sense of which pages earn the business money. We use the tools as evidence, then apply SEO judgement to decide which issues matter, which can wait and which can be ignored.' },
  { question: 'Do you need access to Google Search Console and GA4?', answer: 'Read-only access is strongly recommended. It lets us connect each finding to impressions, clicks, traffic, engagement and conversion data, and to tell a search visibility problem from a tracking change. We can still perform a crawl-led audit without access, but the recommendations will be less complete.' },
  { question: 'Can you audit a site before a redesign or migration?', answer: 'Yes, and it is often the best time, because ranking loss is easier to prevent than to recover. A pre-migration audit reviews URL structure, redirects, templates, content risk, tracking, internal links and launch QA before the changes go live.' },
  { question: 'Will you help implement the recommendations?', answer: 'You can give the findings to your own team or ask us to scope implementation. The register is written to be used either way. Coding, copy revisions, staging checks and post-release monitoring are separately agreed, so the audit fee does not imply an unlimited fix programme.' },
  { question: 'How long does an SEO audit take?', answer: 'Most small to mid-sized business audits take one to two weeks depending on site size, data access and complexity. Larger ecommerce, marketplace or multi-location sites may need a longer audit window, which we state in the quote.' },
  { question: 'Do you audit content and backlinks as well as technical SEO?', answer: 'Yes. Technical issues explain only part of SEO performance. The audit also reviews content quality, search intent, keyword mapping, internal links, authority signals, backlink quality and competitor gaps, then checks the enquiry route from the pages that rank.' },
  { question: 'What happens after the audit?', answer: 'You receive a prioritised roadmap. From there, the next step may be technical fixes, page rewrites, internal linking, content planning, link building, migration support or a wider SEO campaign. Your own team can carry it out, or we can scope the work.' },
  { question: 'What belongs in an SEO audit checklist?', answer: 'A useful SEO audit checklist covers crawlability, indexation, templates, performance, structured data, metadata, search intent, content quality, internal links, backlinks, competitor gaps, analytics and conversion paths. We adapt the checks to the site, because the same warning can be urgent on one site and irrelevant on another.' },
  { question: 'Which tools do you use for an SEO audit?', answer: 'We work from Google Search Console for queries, pages, coverage and crawl issues, GA4 or your analytics for traffic and enquiry actions, a crawl of the site for indexation, canonicals, status codes and internal links, and ranking software for tracked terms with the engine and location stated. The tools supply evidence. The findings, priorities and recommendations are written by a person.' },
  { question: 'How do we request an SEO audit and what happens next?', answer: 'Send the domain, the decision the audit has to inform and any relevant release dates through the contact form. We usually reply within one business day. We then agree which markets, templates and page groups are in scope, quote for that scope, and ask for read-only Search Console and analytics access before the audit begins.' }
];
---

<MainLayout
  title="SEO Audit Philippines | Bright Forge"
  description="SEO audits from the Philippines with page-level evidence, prioritised recommendations and an implementation handover for your marketing and development teams."
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'SEO Audit Services Philippines',
          item: 'https://brightforge.com.ph/seo-audit-services/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'SEO Audit Services Philippines',
      url: 'https://brightforge.com.ph/seo-audit-services/',
      inLanguage: 'en',
      description: 'SEO audit services for diagnosing ranking drops, technical SEO issues, content gaps, backlink risks and conversion problems.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: auditAreas.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          description: item.copy
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-search-plus"
    badgeText="SEO Audit Specialists"
    title="SEO <span>Audits</span> in the Philippines"
    breadcrumbCurrent="SEO Audit Services Philippines"
  >
    <Fragment slot="story">
      <p>An SEO audit tells you why a website is underperforming in search and what to do about it, in order. We crawl the site, study your Search Console and analytics data, and review the content and links. A traffic drop, a weak service page or a missed market gets traced back to the pages, search data and technical behaviour behind it.</p>
      <p>We provide SEO audits from the Philippines for businesses here and in Australia, the UK and the USA. You receive a prioritised findings register, the evidence for each recommendation and a handover explaining what your developer, writer or marketing team should do next. It is the check to run before you commission a rebuild or another content campaign.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Request an SEO Audit Review" />
      <ButtonSecondary href="#audit-coverage" text="See What We Check" />
    </Fragment>

    <Fragment slot="stats">
      <div class="audit-hero-stats">
        <div class="stat"><strong>Diagnose</strong><span>Crawl, indexation, content, link and conversion issues, each with evidence.</span></div>
        <div class="stat"><strong>Prioritise</strong><span>Fix first, fix next, plan or ignore.</span></div>
        <div class="stat"><strong>Roadmap</strong><span>Findings turned into tasks with an owner and an order.</span></div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">Why audit first</span>
          <h2>Find out <span>why organic performance is stuck</span> before you pay for more SEO</h2>
          <p>Send us the domain, the decision you need to make and any relevant release dates. We agree which markets, templates and page groups the audit covers before quoting. Read-only Search Console and analytics access lets us tell a search visibility problem from a tracking change.</p>
          <p>Many sites do not need more blog posts, another backlink package or another round of metadata edits. They need to know why organic performance is flat, falling or failing to produce enquiries, because each cause calls for different work and a different budget.</p>
          <p>Our SEO audit answers that question for owners and marketing leads who have to approve the next spend. It connects technical evidence, content quality, search demand, authority signals and buyer behaviour, and turns them into a roadmap your team can follow task by task.</p>
        </div>
        <aside class="diagnosis-panel" aria-label="SEO audit diagnosis questions">
          <h3>Five questions the audit answers</h3>
          <ul>
            <li>Can Google crawl and index the right pages?</li>
            <li>Do priority pages match real search intent?</li>
            <li>Are rankings held back by technical, content or authority gaps?</li>
            <li>Is organic traffic reaching pages that can convert?</li>
            <li>Which fixes should happen first?</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section id="seo-consultancy" class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">SEO strategy and consulting</span>
          <h2>What needs a <span>consultant</span>, and what needs a delivery team?</h2>
          <p>If you already have developers, writers or an agency, another supplier may not solve the problem. You may need an SEO consultant to challenge the plan, identify the constraint and turn competing recommendations into a sequence your team can deliver.</p>
          <p>The audit establishes what is happening. The consulting work decides what to do about it: which commercial pages deserve investment, where competitors hold an advantage and which technical dependencies must be resolved before content or links can help.</p>
          <p>If you want us to carry out the work as well, our <a href="/seo-services-philippines/">managed SEO service</a> covers ongoing delivery. The scope states which of the two you are buying, so a strategy engagement does not quietly become an open-ended retainer.</p>
        </div>
        <aside class="diagnosis-panel" aria-label="Decisions covered by SEO consultancy">
          <h3>Bring us the decision you need to make</h3>
          <ul>
            <li><strong>Before a rebuild:</strong> which URLs, content and search signals must survive the launch?</li>
            <li><strong>Before expanding:</strong> does the new service or market need its own page, or a better existing one?</li>
            <li><strong>When growth stalls:</strong> is the constraint relevance, authority, indexation or the enquiry path?</li>
            <li><strong>When teams disagree:</strong> what does the evidence support, who owns the work and how will it be checked?</li>
          </ul>
          <a href="/contact/">Discuss your SEO decision</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="proof-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="proof-grid">
        {proofItems.map((item) => (
          <article class="proof-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="triggers-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="triggers-layout">
        <div class="triggers-copy">
          <span class="eyebrow">When to audit</span>
          <h2>Eight signs your site needs an <span>SEO audit</span> before the next spend</h2>
          <p>If a site has one clear technical blocker, fix it. If the business already has a strong roadmap, execute it. An audit earns its fee when rankings, traffic, leads or stakeholder confidence have become unclear and the alternative is expensive guesswork.</p>
        </div>
        <ul class="trigger-list">
          {auditTriggers.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="audit-coverage" class="coverage-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">What we audit</span>
          <h2><span>Technical, content, authority and conversion</span> checks in one SEO audit</h2>
        </div>
        <p>To investigate a visibility problem, we review crawl access, content relevance, internal links and the competing search results. A page can also rank well and still fail to generate enquiries, so we examine its offer and contact path as a separate question. Not every commercial problem is a ranking problem.</p>
      </div>
      <div class="coverage-grid">
        {auditAreas.map((item) => (
          <article class="coverage-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="tool-limits-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">What tools miss</span>
        <h2>What an <span>automated scan</span> reports, and what we add to it</h2>
        <p>SEO tools are useful and we use them. A tool export is evidence, though, and someone still has to make the decision. The value of an audit lies in working out which of the warnings matter for this site, this market and this business.</p>
      </div>
      <div class="tool-grid">
        {toolLimits.map((item) => (
          <article class="tool-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="priority-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">Prioritisation</span>
          <h2>Every finding gets a priority, so <span>the next 90 days</span> have an order</h2>
        </div>
        <p>The same issue can be urgent on one site and irrelevant on another. We rank each finding by risk, business value, search demand, implementation effort and likely SEO upside, then place it in one of four groups.</p>
      </div>
      <div class="priority-grid">
        {priorityFramework.map((item) => (
          <article class="priority-card">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">Audit process</span>
          <h2>Five stages from <span>raw SEO evidence</span> to an implementation roadmap</h2>
        </div>
        <p>The error count is not the goal. We begin with what the site has to achieve and what is stopping it, and each stage narrows that down. Most audits for small to mid-sized businesses take one to two weeks.</p>
      </div>
      <div class="process-rail">
        {processSteps.map((step) => (
          <article class="process-step">
            <span>{step.label}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="deliverables" class="deliverables-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">What you receive</span>
        <h2>A findings register, <span>evidence</span> for each finding and a roadmap</h2>
        <p>Four documents. One helps the business decide, and three help the people doing the work make the right fixes in the right order. To see the row format we hand to developers, open this <a href="/samples/technical-review-handoff.csv">dated handoff excerpt</a> from a review of our own website: page URL, observed issue, recommended action, reason and acceptance check.</p>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => (
          <article class="deliverable-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="findings-extract">
    <div class="pf-wrap">
      <p class="eyebrow">A real extract</p>
      <h2>Three rows from a <span>findings handoff</span> on our own site</h2>
      <p class="pf-lede">These rows come from a review of brightforge.com.ph dated 13 October 2026. It is our own website, not a client campaign. An audit handoff reaches your developer in the same shape.</p>
      <div class="pf-table-wrap"><table class="pf-table">
        <thead><tr><th scope="col">Page</th><th scope="col">Observed issue</th><th scope="col">Recommended action</th><th scope="col">Acceptance check</th></tr></thead>
        <tbody>
          <tr><th scope="row">Home page</th><td>The hero enquiry button started below the 1440 x 900 first screen.</td><td>Move the existing button after the opening offer paragraph and keep the supporting proof.</td><td>Button fully visible at 1440 x 900 and 390 x 844, contact destination opens, one H1 preserved.</td></tr>
          <tr><th scope="row">UK SEO services page</th><td>Two Service definitions described the same canonical URL.</td><td>Keep the country-specific definition and remove the duplicate generic one.</td><td>Rendered JSON-LD parses with exactly one Service definition, country scope United Kingdom, visible FAQ content preserved.</td></tr>
          <tr><th scope="row">On-page SEO services page</th><td>No contextual route from the specialist offer to agency fulfilment.</td><td>Add a concise link to the existing white label SEO page.</td><td>Link present in the main content, destination returns HTTP 200, title and H1 unchanged.</td></tr>
        </tbody>
      </table></div>
      <p class="pf-note">Source: our published <a href="/samples/technical-review-handoff.csv">technical review handoff sample</a>, which also carries the reason for each action. It shows the format of a handoff. It is not a ranking result.</p>
    </div>
  </section>

  <section class="avoid-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="avoid-layout">
        <div class="avoid-copy">
          <span class="eyebrow">Illustrative audit decision</span>
          <h2>Should we rewrite this page or <span>repair its template</span>?</h2>
          <p>An example, not a client result. A service page lost impressions after a template release. Rewriting the page straight away could spend the budget and leave the fault in place, so we would investigate the release and the indexing evidence first. The four cards show how one finding moves from evidence to a tested fix.</p>
        </div>
        <div class="avoid-grid">
          {avoidItems.map((item) => (
            <article class="avoid-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pf-section" id="request-an-audit">
    <div class="pf-wrap">
      <p class="eyebrow">How to start</p>
      <h2>What happens after you <span>request an SEO audit</span></h2>
