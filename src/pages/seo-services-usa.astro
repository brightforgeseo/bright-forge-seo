---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceEvidencePanel from '../components/ServiceEvidencePanel.astro';
import serviceEvidence from '../data/serviceEvidence.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';
import { seoServicesHreflangs } from '../data/internationalSeoPages.js';

const faqs = [
  {
    question: 'How much do SEO services cost per month in the United States?',
    answer: "We prepare a USD proposal after reviewing your website, target market and implementation needs. It identifies deliverables, responsibilities, exclusions and review points. A national store, a software product and a contractor serving one metro area require different scopes."
  },
  {
    question: 'Is cheap $99-per-month SEO safe?',
    answer: "Price alone cannot tell you whether a service is useful or safe. Ask for the pages and tasks included, the source of any links, who reviews changes and what access is required. A small budget may suit a focused diagnostic rather than a promise to cover every part of SEO."
  },
  {
    question: 'How long does SEO take to show results?',
    answer: "Timing depends on the starting site, competition, access and the work your team can release. We agree delivery milestones and compare complete reporting periods. Another business's click growth is not a timetable for your campaign."
  },
  {
    question: 'Can you guarantee #1 rankings on Google?',
    answer: "No. We agree the work and measurement plan, not a guaranteed ranking. Reports distinguish completed changes, search visibility and tracked business actions so you can evaluate progress without treating every click as revenue."
  },
  {
    question: 'What is included in your monthly SEO services?',
    answer: "The agreed scope can include technical SEO, on-page optimization, American English content, relevant outreach, research and AI-search monitoring. Reports identify the pages and fixes completed, checks performed, results observed and decisions still needed."
  },
  {
    question: 'Who actually does the SEO work?',
    answer: "Our delivery team is based in Quezon City in the Philippines. Ben Lowe leads strategy and senior review, alongside co-founder Sassin Lowe, Head of Team Jani A. Ca\u00f1onero and SEO specialist Jewe O. Manalo. The proposal identifies responsibility for delivery and approval."
  },
  {
    question: 'How do you measure and report SEO results?',
    answer: "We use Search Console for search queries and landing pages, and GA4 for recorded site activity. US country data is separated from other markets. Reports identify changed URLs, comparison dates, tracked conversions and open decisions. Any dashboard or additional tracking requirements are agreed in scope."
  },
  {
    question: 'Do you require long-term contracts, and how does billing work?',
    answer: "We agree the USD fee, payment method, engagement length and notice terms in the proposal. Confirm those details before commissioning work rather than assuming a standard contract or billing arrangement."
  },
  {
    question: 'How do the time zones between the US and the Philippines work?',
    answer: "We agree a call window and handover schedule for your US time zone before work starts. The time difference can support asynchronous reviews, but it does not make every audit, fix or content assignment a next-day job. Delivery dates depend on scope, access and review requirements; ranking improvements follow their own timeline."
  },
  {
    question: 'Will my content be written in American English?',
    answer: "Yes. We use American English and check product terminology, units, delivery coverage and buyer questions for the US audience. Your team supplies or approves prices, warranties, eligibility and other commercial claims before publication."
  },
  {
    question: 'How do AI Overviews and ChatGPT search change SEO?',
    answer: "Search work still starts with pages buyers can find and use. AI-search work adds checks on product facts, answers to buying questions and a defined sample of prompts. We report observed mentions separately from referral sessions, and confirm event definitions before treating a tracked action as a signup, order or enquiry."
  },
  {
    question: 'Can you do local SEO for US cities?',
    answer: "Yes. We review Business Profile eligibility, actual service coverage, local landing pages and business information. Proximity depends on the real location. A remotely delivered campaign does not create an office or make a business eligible for every city."
  }
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'SEO Services USA',
      serviceType: 'Search engine optimization',
      description:
        'SEO services for United States businesses: technical SEO, American English content, relevant authority building and search measurement, delivered from the Philippines to an agreed scope.',
      url: 'https://brightforge.com.ph/seo-services-usa/',
      areaServed: { '@type': 'Country', name: 'United States' },
      provider: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://brightforge.com.ph/' },
        { '@type': 'ListItem', position: 2, name: 'SEO Services USA', item: 'https://brightforge.com.ph/seo-services-usa/' }
      ]
    }
  ]
});
---

<MainLayout
  title="SEO Services for US Businesses | Bright Forge"
  description="SEO for US businesses from our Philippines team. Technical audits, ecommerce and SaaS work with clear scope and reporting. Discuss your search priorities."
  canonical="https://brightforge.com.ph/seo-services-usa/"
  type="service"
  includeServiceSchema={false}
  faqs={faqs}
  hreflangs={seoServicesHreflangs}
  geoRegion="US"
  geoPlacename="United States"
  contentLanguage="en-US"
>
  <script type="application/ld+json" is:inline set:html={schema} />

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-globe-americas"
    badgeText="SEO for US Businesses"
    title="SEO Services USA for <span>Stores, Software and Service Businesses</span>"
    breadcrumbCurrent="SEO Services USA"
  >
    <Fragment slot="intro">
      <p>We help US stores, software companies and service businesses improve the pages customers use to choose a supplier. The work covers technical SEO, American English content and reporting against agreed US queries and landing pages.</p>
    </Fragment>
    <Fragment slot="story">
      <p>We are based in the Philippines. We agree the US market, delivery scope, access and review schedule before work starts. A national ecommerce campaign needs a different plan from a service business targeting one state.</p>
      <p>The linked case studies show project scope and Search Console comparisons from several markets. They are examples to inspect, not US-only results or a forecast for your business.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=seo-services&market=US#contactForm" text="Get a US SEO Proposal" />
      <ButtonSecondary href="#results" text="See Real Results" />
    </Fragment>

    <Fragment slot="visual">
      <div class="market-visual" aria-label="US SEO campaign snapshot">
        <div class="market-node">
          <span>Your market</span>
          <strong>google.com, US buyers, US competitors</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node forge">
          <span>Your SEO team</span>
          <strong>Senior delivery from the Philippines</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node">
          <span>Your advantage</span>
          <strong>Agreed handovers for your US time zone</strong>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="proof-strip" aria-label="US SEO proof points">
    <div class="container">
      <div class="proof-grid">
        <div><strong>+137.5% organic clicks</strong><span>Bridal ecommerce, 3-month comparison</span></div>
        <div><strong>US market reporting</strong><span>Country and landing-page comparisons</span></div>
        <div><strong>15+ years of expertise</strong><span>Founder-led senior review on all work</span></div>
        <div><strong>Clear review windows</strong><span>Delivery dates agreed before work starts</span></div>
      </div>
    </div>
  </section>

  <section class="section dark" id="results">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Proof, not promises</p>
        <h2>Results from <span>published, honest case studies</span></h2>
        <p class="portfolio-scope-note">These examples come from several client markets, not US-only campaigns. They show the work and published metrics from those engagements. We agree the relevant US market, competitors and measurement scope for your campaign.</p>
      </div>

      <div class="results-grid">
        <article class="result-card">
          <p class="result-stat">+137.5%</p>
          <h3>Bridal fashion ecommerce</h3>
          <p>The screenshot shows 17.6k clicks for Last 3 months against 7.41k for Same period last year. Average position is 14.9 versus 24.8; that site-wide average is not an individual page-one ranking.</p>
          <a href="/case-studies/bridal-dress-designer-seo/">Read the case study</a>
        </article>
        <article class="result-card">
          <p class="result-stat">+128%</p>
          <h3>Pest control: core update recovery</h3>
          <p>The published six-month Search Console comparison shows 23.5k clicks against 10.3k. It does not isolate which changes caused the difference or establish a recovery timetable for another site.</p>
          <a href="/case-studies/pest-control-core-update-seo/">Read the case study</a>
        </article>
        <article class="result-card">
          <p class="result-stat">+34%</p>
          <h3>Football app: 68k extra clicks</h3>
          <p>The screenshot compares 268k clicks for Last 3 months with 200k for Same period last year. Average position is 9.1 versus 11.4 across the site, not a count of first-page keywords.</p>
          <a href="/case-studies/football-app-seo/">Read the case study</a>
        </article>
        <article class="result-card">
          <p class="result-stat">+49.3%</p>
          <h3>DTC leather goods ecommerce</h3>
          <p>The screenshot compares 22.7k clicks with 15.2k and CTR of 4.5% with 3.1%, for Last 3 months versus Same period last year. It does not isolate a title or snippet effect.</p>
          <a href="/case-studies/leather-wallet-ecommerce-seo/">Read the case study</a>
        </article>
      </div>

      <div class="geo-banner"><p class="result-stat">AI search</p><div><h3>Check the buying information assistants can find</h3><p>For an online store, we review product specifications, availability, delivery and returns information. Referral visits and completed orders are measured separately. <a href="/case-studies/ai-leather-goods-ecommerce-geo/">Read the related ecommerce AI-search review</a>.</p></div></div>

      <p class="honesty-note">The <a href="/case-studies/car-auction-seo/">car auction case study</a> includes worse average position and lower CTR alongside higher clicks and impressions. Read the measures together rather than judging a campaign by its strongest number.</p>

      <div class="testimonial-grid">

        <blockquote class="quote-card">
          <p>&ldquo;We've been working with Ben and Bright Forge SEO for over 18 months, with the primary focus being our SEO needs. The results have been outstanding.&rdquo;</p>
          <footer><a href="https://www.google.com/maps/contrib/113689117491192336436/reviews?hl=en">UK Auction List</a></footer>
        </blockquote>

        <blockquote class="quote-card">
          <p>&ldquo;We’ve been working with Bright Forge SEO for about three years now and they’ve been great.&rdquo;</p>
          <footer><a href="https://www.google.com/maps/contrib/113085747629835627237/reviews?hl=en">Louise Maclean</a></footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section darker" id="why-us">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Why US businesses choose this SEO agency</p>
        <h2>Build the campaign around <span>where you can serve customers</span></h2>
        <p class="lead">A US campaign starts by deciding how far the business can sell or deliver. A national catalogue, a state-specific service and a software product with restricted eligibility need different search coverage.</p>
        <p>We map priority pages against US search results and the buying information your team can support. For a store that may mean shipping limits and product specifications; for a service business, actual coverage and the route to request an estimate.</p>
      </div>
      <div class="card-grid small">
        <article class="card"><h3>Ecommerce brands</h3><p>Category and product page SEO plus content that captures US buying intent against marketplace giants.</p></article>
        <article class="card"><h3>SaaS and platforms</h3><p>Comparison, feature and use-case pages that explain supported workflows, plan limits and US availability.</p></article>
        <article class="card"><h3>Service businesses</h3><p>Service and location page strategy, Google Business Profile work and local organic visibility for US cities.</p></article>
        <article class="card"><h3>US agencies</h3><p>White label SEO fulfillment under your brand: see our <a href="/white-label-seo-services-philippines/">white label SEO services</a> for the agreed delivery and review model.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark" id="services">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">What we deliver</p>
        <h2>Full-service <span>SEO for the US market</span></h2>
        <p>Every campaign is built around your market, your competitors and your commercial goals: not a fixed task list. These are the workstreams we draw on.</p>
      </div>

      <div class="service-grid">
        <article class="service-card"><i class="fas fa-search"></i><h3>SEO audits</h3><p>Technical, content and authority diagnosis against your real US competitors, with prioritized fixes. See our <a href="/seo-audit-services/">SEO audit services</a>.</p></article>
        <article class="service-card"><i class="fas fa-sitemap"></i><h3>Technical SEO</h3><p>Crawlability, indexation, site speed, schema and structure: the <a href="/technical-seo-services-philippines/">technical SEO</a> foundations US rankings are built on.</p></article>
        <article class="service-card"><i class="fas fa-pen-nib"></i><h3>US content SEO</h3><p>American-English <a href="/content-seo-services-philippines/">content SEO</a> mapped to US search demand, buyer language and commercial intent.</p></article>
        <article class="service-card"><i class="fas fa-link"></i><h3>US link building</h3><p>Relevance-led <a href="/backlink-seo-services-philippines/">link building</a> from American publications, directories and industry sites. No spam packages.</p></article>
        <article class="service-card"><i class="fas fa-key"></i><h3>Keyword research</h3><p>US search demand mapped to pages through <a href="/keyword-research-services/">keyword research</a> sized honestly against the competition you actually face.</p></article>
        <article class="service-card"><i class="fas fa-robot"></i><h3>AI Search Optimization</h3><p>Product facts and buyer-question coverage through <a href="/ai-search-optimization-services-philippines/">AI search optimization</a>, with an agreed sample of US buyer questions for monitoring.</p></article>
        <article class="service-card"><i class="fas fa-map-marker-alt"></i><h3>US local SEO</h3><p>Google Business Profile, local pages, citations and reviews: <a href="/local-seo-for-google-maps-and-gbp/">local SEO services</a> for location-based US businesses.</p></article>
        <article class="service-card"><i class="fas fa-truck-moving"></i><h3>Website migrations</h3><p>Replatforming or redesigning? Our <a href="/website-migration-services/">website migration services</a> cover redirect mapping, launch checks and post-launch monitoring.</p></article>
      </div>
      <p class="services-note">For US agencies, white-label delivery is scoped around your client approvals, reporting format and agreed deadlines.</p>
    </div>
  </section>

  <section class="section darker" id="process">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">How campaigns run</p>
        <h2>Your First 90 Days, <span>With Clear Review Points</span></h2>
        <p>We agree priorities and delivery dates around access, implementation effort and your review process. This is a campaign sequence, not a promise of overnight completion or a fixed ranking result.</p>
      </div>

      <div class="process-grid">
        <article class="month-card">
          <span class="month-tag">Month 1</span>
          <h3>Diagnose and fix</h3>
          <ul>
            <li>Full technical, content and authority audit against named US competitors</li>
            <li>Keyword and competitor-gap research mapped to specific pages</li>
            <li>Prioritized roadmap and delivery dates agreed with you</li>
            <li>Technical fixes scheduled with the implementation owner</li>
          </ul>
        </article>
        <article class="month-card">
          <span class="month-tag">Month 2</span>
          <h3>Build</h3>
          <ul>
            <li>On-page optimization rolled out across priority pages</li>
            <li>First batch of American-English content drafted, reviewed and published</li>
            <li>US link prospecting and outreach begins</li>
            <li>Google Business Profile and local pages for location-based businesses</li>
          </ul>
        </article>
        <article class="month-card">
          <span class="month-tag">Month 3</span>
          <h3>Review</h3>
          <ul>
            <li>Review outreach responses and approved content releases</li>
            <li>First full performance review against your baseline</li>
            <li>Strategy adjusted by data, not by gut feel</li>
            <li>Clear next-quarter targets in writing</li>
          </ul>
        </article>
      </div>
      <p class="process-note">Reporting includes completed work, comparison dates and the next decisions. Discuss any live dashboard requirements as part of the <a href="/seo-command-centre/">SEO Command Centre</a> scope.</p>
    </div>
  </section>

  <section class="section dark" id="pricing">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Pricing, honestly</p>
        <h2>What to include in <span>a US SEO proposal</span></h2>
        <p>Request a scope that separates research, writing, technical implementation and reporting. Compare the work and responsibilities before comparing monthly fees.</p>
      </div>

      <div class="pricing-grid">
        <article class="price-card avoid">
          <h3>A focused review</h3>
          <p class="price-tag">Diagnosis first</p>
          <p>A focused audit can be a sensible small engagement. Check what is examined, what you receive and whether implementation is included.</p>
        </article>
        <article class="price-card">
          <h3>Ongoing delivery</h3>
          <p class="price-tag">Named work and review points</p>
          <p>A retainer needs a defined backlog, named reviewers and room to adjust priorities. Ask how completed work is documented and what requires your own developers.</p>
        </article>
        <article class="price-card featured">
          <h3>The Bright Forge model</h3>
          <p class="price-tag">Scoped in USD, quoted up front</p>
          <p>We review your market and site before quoting in USD. The proposal identifies deliverables, exclusions and approval responsibilities.</p>
        </article>
      </div>

      <p class="pricing-note">Bring the website, target products or services, delivery area and developer availability to the scoping discussion. If the main constraint is a broken template or incomplete product information, that should be addressed before buying a larger content program.</p>
    </div>
  </section>

  <section class="section darker" id="choose">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Buyer's guide</p>
        <h2>How to choose an <span>SEO company in the United States</span></h2>
        <p>Compare who will do the work, what evidence supports the proposal and how changes will be reviewed. Use these checks with a local agency, a freelancer or our Philippine team.</p>
      </div>

      <div class="choose-grid">
        <article class="card"><h3>Ask who does the work</h3><p>Ask who handles research, writing, technical implementation and review. Confirm the responsibilities on both sides before commissioning work.</p></article>
        <article class="card"><h3>Demand dated, sourced metrics</h3><p>Check the original source, metric definition and comparison dates. A traffic increase alone does not establish revenue or the cause of a change.</p></article>
        <article class="card"><h3>Treat guarantees as a red flag</h3><p>No provider controls rankings. Agree deliverables and review points rather than treating a guaranteed position as a service specification.</p></article>
        <article class="card"><h3>Keep your own analytics access</h3><p>Confirm ownership and access for GA4, Search Console and Business Profile, including the handover arrangements if the engagement ends.</p></article>
        <article class="card"><h3>Compare the actual workload</h3><p>Compare the tasks, implementation effort, review requirements and exclusions. A lower fee may cover a narrower scope.</p></article>
        <article class="card"><h3>Check retention, not just wins</h3><p>Read the original client reviews as well as the proposed scope. The linked reviews above describe an auctions partnership and a longer-running SEO engagement.</p></article>
      </div>

      <div class="team-strip">
        <div>
          <h3>The people behind the work</h3>
          <p>Bright Forge SEO was founded by Ben Lowe, who leads strategy and senior review, alongside co-founder Sassin Lowe. Jani A. Cañonero is Head of Team and Jewe O. Manalo is an SEO specialist. Meet the team and read the public biographies on our <a href="/about-us/">about page</a>.</p>
        </div>
        <div class="team-names">
          <span>Ben Lowe<em>Founder &amp; CEO</em></span>
          <span>Sassin Lowe<em>Co-Founder</em></span>
          <span>Jani A. Cañonero<em>Head of Team</em></span>
          <span>Jewe O. Manalo<em>SEO Expert</em></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark" id="timezone">
    <div class="container two-col">
      <div>
        <p class="eyebrow">The practical stuff</p>
        <h2>Plan calls and handovers <span>for your US time zone</span></h2>
        <p class="lead">The time difference varies by US time zone and daylight saving. We agree a meeting window for your location and use written handovers for work reviewed outside that overlap.</p>
        <p>Asynchronous handovers let your team review work during its own day. We confirm meeting windows, deadlines and escalation contacts in advance rather than promise round-the-clock availability. Complex fixes and audits still need the time and access their scope requires.</p>
      </div>
      <div class="timezone-card">
        <h3>A typical working day</h3>
        <ul>
          <li><strong>Your Brief</strong>: agree priorities, access and the decision needed from your team.</li>
          <li><strong>Our Delivery Window</strong>: research, implementation and QA follow the agreed scope.</li>
          <li><strong>Your Review</strong>: receive completed work, open questions and the next agreed checkpoint.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section darker" id="industries">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Industries served</p>
        <h2>Choose a service scope <span>for your industry</span></h2>
        <p>These service links describe different page requirements. Choose the scope that matches the business rather than assuming one US-wide campaign covers every industry.</p>
      </div>

      <div class="industry-grid">
        <article class="card"><h3><a href="/real-estate-seo-services/">Real estate</a></h3><p>Agent, brokerage and listings-site SEO for hyper-local, high-value US searches.</p></article>
        <article class="card"><h3><a href="/home-services-seo/">Home services</a></h3><p>HVAC, plumbing, roofing and pest control: our core update recovery case was a pest control firm.</p></article>
        <article class="card"><h3><a href="/finance-crypto-seo-services/">Finance &amp; crypto</a></h3><p>Explain eligibility, supported products and material limitations, with regulated claims reviewed by the appropriate specialist before publication.</p></article>
        <article class="card"><h3><a href="/gaming-seo-services/">Gaming</a></h3><p>Publisher, platform and community SEO in fast-moving, high-volume entertainment SERPs.</p></article>
        <article class="card"><h3><a href="/pet-seo-services/">Pet businesses</a></h3><p>Product, stock and shipping information for pet stores; service coverage and booking details for groomers and other providers.</p></article>
        <article class="card"><h3><a href="/football-soccer-seo-services/">Soccer &amp; sports</a></h3><p>Football app project work, search comparisons and page requirements for sports platforms.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark" id="us-cities">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Across the USA</p>
        <h2>SEO for businesses in <span>every major US city</span></h2>
        <p>Campaigns can target US cities remotely from our Philippine team. A city page needs a real service offering, relevant coverage details and a useful next step. The examples below are scoping options, not claims of offices or clients in each city.</p>
      </div>

      <div class="cities-grid">
        <article class="city-card"><h3>New York</h3><p>For New York, distinguish a genuine local service from an offer available nationally before creating city pages.</p></article>
        <article class="city-card"><h3>Los Angeles</h3><p>DTC brands, entertainment and ecommerce across Southern California.</p></article>
        <article class="city-card"><h3>Chicago</h3><p>B2B, logistics, manufacturing and professional services across the Midwest.</p></article>
        <article class="city-card"><h3>Houston</h3><p>Energy, industrial and home services companies across Texas.</p></article>
        <article class="city-card"><h3>Miami</h3><p>Real estate, hospitality and international-facing brands in South Florida.</p></article>
        <article class="city-card"><h3>San Francisco</h3><p>SaaS and startups that need organic growth alongside paid acquisition.</p></article>
        <article class="city-card"><h3>Seattle</h3><p>Tech, ecommerce and B2B companies in the Pacific Northwest.</p></article>
        <article class="city-card"><h3>Atlanta</h3><p>Logistics, home services and fast-growing brands across the Southeast.</p></article>
      </div>
      <p class="cities-note">Not on the list? Campaigns can target Dallas, Phoenix, Denver, Boston, Austin, San Diego and everywhere in between: city-level and nationwide campaigns are scoped the same way: around your market and your competitors.</p>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container narrow">
      <div class="section-head centered">
        <p class="eyebrow">US SEO FAQs</p>
        <h2><span>Questions US businesses ask</span> before hiring an SEO agency</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container narrow cta-box">
      <p class="eyebrow">Ready to talk?</p>
      <h2>Get a straight answer about <span>SEO for your US business</span></h2>
      <p>Send your website, US target audience, products or service area, and the team available to implement changes. We will use those details to discuss a written USD scope.</p>
      <div class="cta-actions">
