---
import ForgeHero from '../../../components/ForgeHero.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import LegacyHeader from '../../../components/LegacyHeader.astro';
import Footer from '../../../components/Footer.astro';
import { getAllBlogPosts } from '../../../lib/contentful.js';
import { groupPostsByTopic, topicLabel } from '../../../lib/blogDisplay.js';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  const grouped = groupPostsByTopic(posts, 1);
  const forced = new Set(['seo', 'ai', 'local', 'business']);
  return grouped
    .filter((topic) => topic.posts.length >= 3 || forced.has(topic.slug))
    .map((topic) => ({
      params: { topic: topic.slug },
      props: { topic }
    }));
}

const { topic } = Astro.props;
const label = topic.label || topicLabel(topic.slug);
---

<MainLayout
  title={`${label} articles | Bright Forge`}
  description={`Browse ${label} articles grouped by existing article tags, or explore all topics and the full Bright Forge blog archive.`}
>
  <LegacyHeader slot="header" />
  <ForgeHero title={label} eyebrow="Blog topics" breadcrumb={label}>
    <p class="eyebrow"><a href="/blog/">Blog</a> / <a href="/blog/topics/">Topics</a></p>
    <p>{topic.posts.length} articles grouped by existing article tags. This list may not include every article on the subject.</p>
  </ForgeHero>
  <main class="topic-main">
    <div class="max-w-7xl mx-auto px-6">
      <h2>Articles in this topic</h2>
      <ul>
        {topic.posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>{post.title}</a>
          </li>
        ))}
      </ul>
      <nav class="topic-next" aria-label="More articles">
        <a href="/blog/topics/">Browse all topics</a>
        <a href="/blog/">Browse all articles</a>
      </nav>
    </div>
  </main>
  <Footer />
</MainLayout>

<style>
  .topic-main {
    background: #ffffff;
    color: #19212e;
    padding: 5rem 0 6rem;
  }
  .eyebrow, .lede { color: #465365; margin-bottom: 1rem; }
  .eyebrow a, ul a { color: #b83e12; text-decoration: none; }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .topic-next { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }
  .topic-next a { color: #b83e12; text-decoration: underline; padding: 0.75rem 0; }
  h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; }
  ul { list-style: none; padding: 0; columns: 2; gap: 2rem; }
  li { break-inside: avoid; margin: 0 0 0.6rem; }
  @media (max-width: 700px) { ul { columns: 1; } }
</style>
