---
import ForgeHero from '../../../components/ForgeHero.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import LegacyHeader from '../../../components/LegacyHeader.astro';
import Footer from '../../../components/Footer.astro';
import { getAllBlogPosts } from '../../../lib/contentful.js';
import { groupPostsByTopic } from '../../../lib/blogDisplay.js';

const topics = groupPostsByTopic(await getAllBlogPosts(), 3);
---

<MainLayout
  title="Blog topics | Bright Forge"
  description="Crawlable topic lists for Bright Forge articles. Each topic is a real page, not a JavaScript filter."
>
  <LegacyHeader slot="header" />
<ForgeHero title="Blog topics" eyebrow="Blog" breadcrumb="Blog"><p>Each topic lists the articles in HTML. Use this when the blog filter buttons are not enough for Google.</p></ForgeHero>
  <main class="topic-main">
    <div class="max-w-7xl mx-auto px-6">

      <ul>
        {topics.map((topic) => (
          <li>
            <a href={`/blog/topics/${topic.slug}/`}>{topic.label}</a>
            <span> {topic.posts.length}</span>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</MainLayout>

<style>
  .topic-main {
    background: #ffffff;
    color: #19212e;
    padding: 5rem 0 6rem;
  }
  .eyebrow, .lede, span { color: #465365; }
  .eyebrow a, ul a { color: #b83e12; text-decoration: none; }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0.8rem 0 1rem;
  }
  ul { list-style: none; padding: 0; }
  li { margin: 0 0 0.7rem; }
</style>
