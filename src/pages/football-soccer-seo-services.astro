---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/football-soccer-seo-services/',
  title: 'Football SEO Services for Clubs and Apps | Bright Forge',
  description: 'SEO for football clubs, academies and software: programme pages, season content and sign-up tracking. See our published Search Console work with TeamStats.',
  h1: 'Football SEO Services for Clubs, Academies and Apps',
  crumb: 'Football SEO',
  parents: [{ name: 'Industries', url: '/industries/' }],
  lead: [
    'We work with TeamStats, a team management app used by grassroots football managers and coaches. Football audiences search by age group, by season, by drill and by problem, and the pages have to match.',
  ],
  secondary: { href: '/case-studies/football-app-seo/', label: 'Read the TeamStats case study' },
  sections: [
    {
      h2: 'Published result',
      html: `<ul class="bf-results">
<li><span class="bf-num">200,000 to 268,000</span><span class="bf-what"><strong>TeamStats</strong> (teamstats.net): organic clicks over three months, compared with the same months a year earlier (rounded)</span><a class="bf-src" href="/case-studies/football-app-seo/">Case study</a></li>
<li><span class="bf-num">AI referral review</span><span class="bf-what"><strong>TeamStats:</strong> which pages AI tools sent visitors to</span><a class="bf-src" href="/case-studies/ai-sports-saas-geo/">Review</a></li>
</ul>
<p>A named review from the client appears on Google. The figures are search clicks, not sign-ups or bookings.</p>`,
    },
    {
      h2: 'What we work on',
      html: `<dl class="bf-deliverables">
<dt>For clubs and academies</dt><dd>Programme and age-group pages, trial and registration information, location details, seasonal updates.</dd>
<dt>For software and products</dt><dd>Feature pages, comparisons, coaching resources that lead to the product. See <a href="/saas-seo-services/">SaaS SEO</a>.</dd>
<dt>Calendar planning</dt><dd>Content timed to pre-season, registration and tournaments, written through our <a href="/content-seo-services-philippines/">SEO content</a> process.</dd>
<dt>Tracking</dt><dd>Of registrations and sign-ups.</dd>
</dl>`,
    },
    {
      h2: 'How we do it',
      html: `<ol class="bf-steps">
<li>Map the season and the decisions parents, players and coaches make in it.</li>
<li>Keyword research by audience.</li>
<li>Build or improve the pages.</li>
<li>Report monthly on sign-ups from search.</li>
</ol>`,
    },
  ],
  faqs: [
    { question: 'Is the TeamStats result evidence for clubs and academies?', answer: 'No. It is an organic-click comparison for team management software. It is not evidence of academy bookings or paid subscriptions.' },
  ],
};
---
<EditorialPage page={page} />
