---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceEvidencePanel from '../components/ServiceEvidencePanel.astro';
import serviceEvidence from '../data/serviceEvidence.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'A baseline taken before anything moves',
    copy: 'We record the existing URLs, traffic, rankings, backlinks, templates, metadata, canonicals, redirects, tracking and indexation rules before anything goes live, so the new site has something to be measured against.'
  },
  {
    title: 'Redirects matched page by page',
    copy: 'Each legacy URL is matched to the most relevant new destination. Pages with rankings, backlinks, conversions or meaningful organic traffic are mapped first and checked hardest.'
  },
  {
    title: 'Support through launch and after it',
    copy: 'We check the live site after release, watch Search Console and analytics, and help your developers triage issues while the cause is still easy to find.'
  }
];

const migrationRisks = [
  {
    title: 'Important URLs disappear',
    copy: 'Pages that bring in business get removed, renamed, blocked or redirected to weak destinations during a rebuild. A URL inventory, built first, makes sure the priority pages are accounted for.'
  },
  {
    title: 'Redirects leak relevance',
    copy: 'Bulk redirects to the homepage, chains, loops and poorly matched destinations all damage organic performance. We map each old URL to its closest useful replacement and test the result.'
  },
  {
    title: 'Metadata and headings change by accident',
    copy: 'New templates routinely overwrite titles, descriptions, H1s, copy blocks, schema and internal links. We compare the old templates with the new ones before launch, while changing them is still cheap.'
  },
  {
    title: 'Indexation controls are wrong',
    copy: 'A staging noindex left in place, a robots.txt rule, a stray canonical or an outdated sitemap can block or confuse search engines. We check all of them before go-live and again on the live site.'
  },
  {
    title: 'Tracking breaks during the move',
    copy: 'Analytics, form tracking, conversion events, Google Search Console and Tag Manager are easy to miss in a rebuild. We verify measurement so the effect of the migration can be judged on evidence.'
  },
  {
    title: 'Internal links point to the past',
    copy: 'Navigation, body links, breadcrumbs and XML sitemaps can go on pointing at old URLs. We check internal links so visitors and crawlers reach the live pages directly, without passing through a redirect.'
  }
];

const migrationTypes = [
  {
    title: 'Website redesigns',
    copy: 'The CMS stays and the design changes. Templates, page copy, headings, internal links and conversion paths can all shift without anyone deciding they should.'
  },
  {
    title: 'CMS changes',
    copy: 'Moves between WordPress, Shopify, Webflow, Magento, Drupal, custom builds, static sites or headless CMS setups, where each platform handles URLs, templates and redirects in its own way.'
  },
  {
    title: 'Domain changes',
    copy: 'Rebrands, domain moves, HTTP to HTTPS work, subdomain changes, international domain changes and consolidation projects. We moved this site from brightforgeseo.com to brightforge.com.ph ourselves.'
  },
  {
    title: 'Ecommerce replatforming',
    copy: 'Product, category, filter and collection migrations, where URL handling, faceted navigation and templates need SEO controls agreed before the catalog is imported.'
  },
  {
    title: 'URL structure changes',
    copy: 'New slugs, folders, service pages, location pages, category structures, blog paths or information architecture on a site that otherwise stays where it is.'
  },
  {
    title: 'Site consolidation',
    copy: 'Merging websites, old microsites, subdomains or duplicate brands, with a plan for the useful content, the externally linked URLs and the offers that overlap.'
  }
];

const preMigrationChecks = [
  'Old URL: /services/office-fitout/; proposed destination: /commercial-fitouts/offices/.',
  'Reason: the replacement serves the same office fit-out offer, rather than sending the visitor to a general homepage.',
  'Evidence: compare old copy, search landing-page data and externally linked URLs before approving removal or redirection.',
  'Implementation owner: the developer applies a permanent server-side redirect; the service owner approves destination relevance.',
  'Acceptance test: the old URL redirects directly to the approved destination, which returns 200 and has no unintended noindex directive.',
  'Destination check: confirm office fit-out content, inquiry route and canonical remain correct on desktop and mobile.',
  'Internal references: update navigation, contextual links and the sitemap to the new URL rather than relying on redirects.',
  'Exception decision: if no relevant replacement exists, review retention or a genuine 404/410 response instead of forcing a homepage redirect.',
  'Rollback decision: if the new template blocks priority pages, the release owner decides whether to restore the prior version or apply a verified fix.',
  'After launch: record the live test, monitor the affected page group and distinguish search processing from an actual redirect defect.'
];

const launchChecks = [
  {
    label: '01',
    title: 'Baseline and URL inventory',
    copy: 'We crawl the current site, export the priority URLs, identify the pages with traffic and rankings, and sort every URL into one of four groups: preserve, redirect, merge or remove.'
  },
  {
    label: '02',
    title: 'Redirect and destination mapping',
    copy: 'We prepare the redirect map, check each destination for relevance, flag the weak matches for discussion and write implementation notes for the CMS, server or development team.'
  },
  {
    label: '03',
    title: 'Staging SEO review',
    copy: 'We crawl the staging site and compare it with the map and the current site: templates, metadata, content, canonicals, structured data, internal links, sitemaps and indexation controls.'
  },
  {
    label: '04',
    title: 'Launch checklist and sign-off',
    copy: 'We report passed checks, unresolved defects and their impact to the release owner. Your team makes the go-live decision against agreed acceptance criteria. An SEO sign-off is not a promise that rankings will stay unchanged.'
  },
  {
    label: '05',
    title: 'Post-launch crawl and monitoring',
    copy: 'We test old URLs and new destinations on the public site, then compare crawl and search data during the agreed monitoring period. The scope names the review cadence, escalation contact and end date, so support does not silently end at deployment.'
  },
  {
    label: '06',
    title: 'Triage and recovery actions',
    copy: 'When issues appear, we rank the fixes by risk and commercial impact and hand each to the team responsible, so the problems that cost inquiries or orders are handled first.'
  }
];

const deliverables = [
  {
    title: 'Migration risk review',
    copy: 'What could go wrong on this particular move: the pages, templates, rankings, traffic sources and technical controls that need protecting, and what is at stake if each is missed.'
  },
  {
    title: 'URL and redirect map',
    copy: 'Every old URL listed against its recommended new destination, with redirect notes and a priority flag on pages that hold rankings, traffic or backlinks. A page with no equivalent is marked for a decision. It is never silently dropped.'
  },
  {
    title: 'Staging SEO QA notes',
    copy: 'Findings from a crawl of the staging site: indexation settings, metadata, page templates, canonical handling, internal links, schema and tracking gaps, written up so your developers can see what to change before launch.'
  },
  {
    title: 'Launch-day SEO checklist',
    copy: 'The checks to run at go-live: redirects, robots rules, sitemap files, analytics, Search Console, tracking, priority pages and the developer handoff.'
  },
  {
    title: 'Post-launch monitoring summary',
    copy: 'A written review after launch covering crawl issues, redirect behavior, Search Console coverage, rankings and organic landing pages, together with the urgent fixes that follow from them.'
  },
  {
    title: 'Developer-ready implementation notes',
    copy: 'Instructions written for the person making the change: what to do, why it matters, where the evidence is and how to verify the fix once it is live.'
  }
];

const noPromiseItems = [
  {
    title: 'Search changes after launch',
    copy: 'Rankings can change while search engines process the move. We compare the affected pages with the pre-launch baseline and investigate losses alongside redirect, indexing and content checks.'
  },
  {
    title: 'Redirect exceptions',
    copy: 'Some old URLs have no suitable replacement. We flag these for an explicit retain, remove or consolidate decision, with the relevant content and link evidence attached.'
  },
  {
    title: 'Tracking acceptance',
    copy: 'We agree which form, call and purchase events need testing and who will verify receipt. When we compare performance, we count a tracking event separately from a completed inquiry or order.'
  },
  {
    title: 'A named release owner',
    copy: 'We agree who can deploy, pause or roll back the release. A critical defect goes to that person with the affected URLs and evidence. The rollback plan must account for orders, inquiries and content changes made since launch.'
  }
];

const connectedServices = [
  {
    title: 'Technical SEO services',
    href: '/technical-seo-services-philippines/',
    copy: 'Crawl, indexation, performance, rendering, schema and architecture fixes, before the move or after it.'
  },
  {
    title: 'SEO audit services',
    href: '/seo-audit-services/',
    copy: 'A wider diagnosis first, when you are still deciding whether a migration, a rebuild or a technical cleanup is the right move.'
  },
  {
    title: 'On-page SEO services',
    href: '/on-page-seo-services-philippines/',
    copy: 'Titles, headings, copy, internal links, proof and conversion paths carried across a redesign and improved where they were weak.'
  },
  {
    title: 'Keyword research services',
    href: '/keyword-research-services/',
    copy: 'Search demand mapped to the new site structure before URLs and navigation are locked in.'
  },
  {
    title: 'SEO services Philippines',
    href: '/seo-services-philippines/',
    copy: 'Ongoing SEO once the migration has settled: content, technical fixes, links, reporting and growth planning.'
  },
  {
    title: 'Content SEO services',
    href: '/content-seo-services-philippines/',
    copy: 'Rewrites for pages that make it to the new site but still need a closer match to search intent, better proof or a clearer route to inquiry.'
  }
];

const faqs = [
  { question: 'What is website migration SEO?', answer: 'Website migration SEO is the planning, testing and monitoring that protects organic traffic during a redesign, CMS move, domain change, URL restructure or site consolidation. It covers redirects, indexation controls, metadata, internal links, tracking, sitemaps, templates and the checks that follow launch.' },
  { question: 'Will a website migration affect rankings?', answer: 'It can. Some short-term movement is normal when URLs, templates, content or platform signals change, even when the work is done well, and we cannot promise there will be none. The aim is to reduce avoidable losses by mapping important URLs, carrying across relevant content and signals, checking redirects and monitoring the site after launch.' },
  { question: 'When should SEO be involved in a migration?', answer: 'Before the new structure and templates are final. The best time is during planning, before developers lock in URLs, navigation, content templates, redirect logic and tracking setup. We can still help after launch, but recovering lost visibility costs more than protecting it before launch.' },
  { question: 'Do you create redirect maps?', answer: 'Yes. We create or review redirect maps using crawl data, ranking pages, traffic pages, backlinked URLs and the planned new structure. Each old URL is matched to the most relevant live destination. Redirecting everything to the homepage is the mistake the map exists to prevent.' },
  { question: 'Can you work with our developers?', answer: 'Yes. We work alongside internal teams, web developers, designers and ecommerce specialists. Everything we produce is written to be implemented: SEO requirements, QA notes, redirect guidance, staging feedback and post-launch checks, so the development team has clear actions.' },
  { question: 'Do you handle ecommerce migrations?', answer: 'Yes. Ecommerce migrations need extra care around product URLs, category pages, collections, filters, canonicals, discontinued products, faceted navigation, schema and internal links. We review each of those areas before and after launch.' },
  { question: 'What do you check after launch?', answer: 'We check live redirects, priority pages, crawl errors, robots.txt, noindex tags, canonicals, XML sitemaps, analytics, conversion tracking, Search Console coverage, ranking movement and organic landing-page behavior. The review cadence and the end date of monitoring are agreed in the scope.' },
  { question: 'Can you fix a migration that has already gone wrong?', answer: 'Yes, depending on the issue. We compare the old and new site data, identify lost URLs, redirect mistakes, indexation problems, content changes, tracking gaps and technical blockers, then list the recovery actions in priority order.' },
  { question: 'Who implements the redirects, you or our developer?', answer: 'Your developer applies the permanent server-side redirects. We prepare the redirect map with implementation notes for the CMS, server or development team, the service owner approves the relevance of each destination, and we test the live redirects against the agreed plan after release.' }
];
---

<MainLayout
  title="Website Migration SEO Services Philippines | Bright Forge"
  description="Changing domain, CMS or design? Our website migration SEO maps every URL, plans the redirects, tests the staging site and monitors search after launch."
  keywords="website migration SEO, SEO migration services, site migration SEO, website migration services Philippines, domain migration SEO, ecommerce migration SEO"
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Website Migration SEO Services',
          item: 'https://brightforge.com.ph/website-migration-services/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Website Migration SEO Services Philippines',
      url: 'https://brightforge.com.ph/website-migration-services/',
      description: 'Website migration SEO services for safer redesigns, CMS moves, domain changes, redirect mapping, staging QA and post-launch search monitoring.',
      isPartOf: {
        '@type': 'WebSite',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Website Migration SEO Services Philippines',
      serviceType: 'Website migration SEO, redirect mapping and launch QA',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/',
        telephone: '+63-969-620-6182',
        email: 'seo@brightforgeseo.com'
      },
      areaServed: ['Philippines', 'Australia', 'United Kingdom', 'United States'],
      url: 'https://brightforge.com.ph/website-migration-services/',
      description: 'SEO support for website migrations, including pre-migration audits, redirect mapping, staging QA, launch checks and post-launch monitoring.'
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-route"
    badgeText="Migration SEO"
    title="Website Migration SEO Services for <span>Safer Site Launches</span>"
    breadcrumbCurrent="Website Migration Services"
  >
    <Fragment slot="story">
      <p>A redesign, a change of CMS or a new domain can cost a site much of its search traffic when the old URLs, redirects and page content are not carried across properly. The damage usually comes from the things handled late: redirect rules, templates, tracking and indexation controls.</p>
      <p>We plan that part of the move, test it before launch and watch the results afterwards. We work with businesses in the Philippines, Australia, the UK and the USA to review the old site, map its URLs to the new structure and test the pages that must survive the move. Bring us in before navigation, templates and redirect rules are locked.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Plan a Safer Migration" />
      <ButtonSecondary href="#migration-process" text="Review the Process" />
    </Fragment>

    <Fragment slot="stats">
      <div class="migration-hero-stats">
        <div>
          <strong>Before</strong>
          <span>crawl, baseline and full URL inventory</span>
        </div>
        <div>
          <strong>During</strong>
          <span>redirect map, staging review and launch checks</span>
        </div>
        <div>
          <strong>After</strong>
          <span>live crawl, Search Console and traffic monitoring</span>
        </div>
      </div>
    </Fragment>

    <Fragment slot="visual">
      <div class="migration-visual" aria-label="Website migration SEO workflow">
        <div class="migration-node old-site">Old site</div>
        <div class="migration-line"></div>
        <div class="migration-node controls">SEO controls</div>
        <div class="migration-line"></div>
        <div class="migration-node new-site">New site</div>
        <div class="migration-checklist">
          <span>URL inventory</span>
          <span>Redirect map</span>
          <span>Staging crawl</span>
          <span>Launch QA</span>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="proof-strip" style="content-visibility: visible !important;">
    <div class="container-narrow">
      {proofItems.map((item) => (
        <article class="proof-card">
          <h2>{item.title}</h2>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="intro-section" style="content-visibility: visible !important;">
    <div class="container-grid two-col">
      <div>
        <span class="section-kicker">What you get, and who needs it</span>
        <h2>What our <span>website migration SEO</span> covers, and when to call us</h2>
      </div>
      <div class="rich-copy">
        <p>Every engagement starts from the current domain, staging access if available, the proposed launch date and the name of your development lead. Before work begins, we agree the release window, the sign-off owner, the rollback options and the post-launch monitoring period with you.</p>
        <p>If you are redesigning, changing CMS, restructuring URLs or moving domain, and organic search brings you inquiries or sales, this service is for you. You receive a risk review, a URL inventory and redirect map, a staging review, a launch-day checklist, post-launch monitoring and notes your developer can implement. One named person on your side approves the release.</p>
        <p>Search engines never see your project plan. They see changed URLs, new templates, different internal links, altered content, new status codes and different indexation signals. When a migration is run purely as a design or development project, the SEO risk surfaces after launch, when fixing the damage costs more than preventing it would have. We identify the pages and signals that already bring you visibility and protect them before the new site goes live.</p>
        <p>We have done this for ourselves. This website moved from brightforgeseo.com to brightforge.com.ph, and requests for the old domain are still redirected to the matching address here.</p>
      </div>
    </div>
  </section>

  <section class="risk-section" style="content-visibility: visible !important;">
    <div class="container-wide">
      <div class="section-heading">
        <span class="section-kicker">What can go wrong</span>
        <h2>Six <span>migration risks</span> that cost a site its search traffic</h2>
        <p>Each of these has its own check in our process. We look for all six whether the business is redesigning, replatforming, restructuring URLs or moving domain.</p>
      </div>
      <div class="card-grid three-col">
        {migrationRisks.map((risk) => (
          <article class="content-card">
            <h3>{risk.title}</h3>
            <p>{risk.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="types-section" style="content-visibility: visible !important;">
    <div class="container-wide">
      <div class="section-heading">
        <span class="section-kicker">Migration scenarios</span>
        <h2>Six kinds of <span>site migration</span> we plan and check</h2>
        <p>A domain change and a redesign fail in different ways. We build the checks around the move you are making: its platform, its URL changes and the constraints on its launch.</p>
      </div>
      <div class="card-grid three-col">
        {migrationTypes.map((type) => (
          <article class="content-card subtle-card">
            <h3>{type.title}</h3>
            <p>{type.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="checklist-section" style="content-visibility: visible !important;">
    <div class="container-grid two-col align-start">
      <div>
        <span class="section-kicker">Illustrative redirect-map entry</span>
        <h2>One <span>redirect-map entry</span>, from old URL to launch test</h2>
        <p class="section-lede">Example, not a completed client migration: an old /services/office-fitout/ page becomes /commercial-fitouts/offices/. We would confirm that the new page still covers office fit-outs, then record the redirect, the approval and the test as shown here. A real map records the same points for each priority URL. These illustrative paths are not links on this site.</p>
      </div>
      <div class="checklist-panel">
        {preMigrationChecks.map((check) => (
          <div class="check-row">
            <span class="check-icon">✓</span>
            <span>{check}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="migration-process" class="process-section" style="content-visibility: visible !important;">
    <div class="container-wide">
      <div class="section-heading">
        <span class="section-kicker">Migration process</span>
        <h2>Six stages of <span>migration SEO</span>, from baseline to recovery</h2>
        <p>We work before, during and after launch, so the SEO requirements are clear to the people building the site at every stage. Tell us the launch date as early as you can, because the stages before launch are where losses are prevented.</p>
      </div>
      <div class="process-grid">
        {launchChecks.map((step) => (
          <article class="process-card">
            <span class="process-label">{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="deliverables-section" style="content-visibility: visible !important;">
    <div class="container-wide">
      <div class="section-heading">
        <span class="section-kicker">What you get</span>
        <h2>Six <span>migration deliverables</span> your developer can act on</h2>
        <p>Each document answers a question someone on the project has to decide: what to protect, where each URL goes, whether staging is ready, what to check on the day and what to fix afterwards.</p>
      </div>
      <div class="card-grid three-col">
        {deliverables.map((item) => (
          <article class="content-card deliverable-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="who-does-what">
    <div class="pf-wrap">
      <p class="eyebrow">Responsibilities</p>
      <h2>Who does what in a <span>website migration</span></h2>
      <p class="pf-lede">A migration fails in the gaps between teams. This is how the work divides between your side and ours, including who implements the redirects.</p>
      <div class="pf-table-wrap"><table class="pf-table">
        <thead><tr><th scope="col">Task</th><th scope="col">Your team or developer</th><th scope="col" class="pf-us">Bright Forge</th></tr></thead>
        <tbody>
          <tr><th scope="row">URL inventory and baseline</th><td>Provides the current domain, staging access if available and existing search data.</td><td class="pf-us">Crawls the current site, exports the priority URLs and identifies the pages with traffic and rankings.</td></tr>
          <tr><th scope="row">Redirect map</th><td>The service owner approves the relevance of each destination.</td><td class="pf-us">Prepares the map, flags weak matches and writes implementation notes for the CMS, server or development team.</td></tr>
          <tr><th scope="row">Implementing redirects</th><td>The developer applies permanent server-side redirects.</td><td class="pf-us">Tests that each old URL redirects directly to the approved destination, which returns 200 with no unintended noindex.</td></tr>
          <tr><th scope="row">Staging review</th><td>Fixes the defects raised before launch.</td><td class="pf-us">Crawls staging and compares templates, metadata, canonicals, structured data, internal links, sitemaps and indexation controls.</td></tr>
          <tr><th scope="row">Go-live decision</th><td>The named release owner decides against the agreed acceptance criteria.</td><td class="pf-us">Reports passed checks, unresolved defects and their impact.</td></tr>
          <tr><th scope="row">Tracking</th><td>Verifies receipt of the agreed form, call and purchase events.</td><td class="pf-us">Agrees with you which events need testing, and checks that analytics, Search Console and Tag Manager carry across to the new site.</td></tr>
          <tr><th scope="row">After launch</th><td>Deploys the fixes; the release owner can pause or roll back.</td><td class="pf-us">Tests old URLs and new destinations on the live site, compares crawl and search data, and ranks fixes by risk and commercial impact.</td></tr>
        </tbody>
      </table></div>
    </div>
  </section>

  <section class="honest-section" style="content-visibility: visible !important;">
    <div class="container-grid two-col align-start">
      <div>
        <span class="section-kicker">Launch decisions</span>
        <h2>Four decisions to settle before <span>go-live</span></h2>
        <p class="section-lede">Before launch, your development and marketing teams need agreed answers on search changes, URL exceptions, tracking tests and release authority. We record these decisions alongside the redirect map and QA notes, so nobody is settling them during an incident.</p>
      </div>
      <div class="honest-grid">
        {noPromiseItems.map((item) => (
          <article class="honest-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="how-to-start">
    <div class="pf-wrap">
      <p class="eyebrow">How to start</p>
      <h2>Four things to agree before <span>migration work</span> begins</h2>
      <p class="pf-lede">The earlier we see the plan, the more of it can still be changed. This is what we ask for and what we settle with you first.</p>
      <ol class="pf-steps">
        <li><strong>Send the basics</strong><span>The current domain, staging access if available, the proposed launch date and the name of your development lead.</span></li>
        <li><strong>Agree the release terms</strong><span>The release window, the sign-off owner, the rollback options and the post-launch monitoring period.</span></li>
        <li><strong>Baseline the old site</strong><span>We crawl it, export the priority URLs and record the pages that hold traffic and rankings.</span></li>
        <li><strong>Bring us in before the lock</strong><span>We review the old site and map its URLs to the new structure before navigation, templates and redirect rules are locked.</span></li>
      </ol>
    </div>
  </section>

  <section class="connected-section" style="content-visibility: visible !important;">
    <div class="container-wide">
      <div class="section-heading">
        <span class="section-kicker">Connected SEO work</span>
        <h2>Services that connect to <span>migration SEO</span>, before and after launch</h2>
        <p>A safe launch depends on more than redirects. These six services feed the migration plan or take over once the new site has settled. For a self-serve starting point, read our <a href="/blog/website-migration-seo-checklist/">website migration SEO checklist</a>.</p>
      </div>
      <div class="connected-grid">
        {connectedServices.map((service) => (
          <a class="connected-card" href={service.href}>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
            <span>View service</span>
          </a>
        ))}
