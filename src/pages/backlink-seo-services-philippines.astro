---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'A person reads every prospect',
    copy: 'We read the publication, the page that would carry the link and the reason its readers would use your resource. A high domain score does not rescue a placement that nobody relevant will ever see.'
  },
  {
    title: 'The destination is checked first',
    copy: 'Before outreach, we confirm that the page being referenced answers the question behind the link. A supplier reference should land on the relevant product or specification page. Sending readers to the homepage to hunt for it wastes the link.'
  },
  {
    title: 'Every placement is written down',
    copy: 'The report names the source URL, the destination, the link text, the placement context and any payment or sponsorship. Referral visits and search changes are reported separately from the count of links acquired.'
  }
];

const linkTypes = [
  {
    title: 'Editorial outreach links',
    copy: 'We write to publishers, resource owners, niche websites and businesses whose readers have a reason to follow a link to you. The placement is earned on the merit of your page, and the editor chooses the wording.'
  },
  {
    title: 'Competitor link gap opportunities',
    copy: 'We go through the pages that link to the competitors outranking you and pull out the publications, associations and resources relevant to your buyers. A competitor holding a link is a research lead. It does not prove the link caused their rankings.'
  },
  {
    title: 'Resource and citation links',
    copy: 'Directories, association pages, local citations, supplier pages, partner pages and resource listings. Each one is vetted for relevance first, because a listing supports trust only when the people who use it could become your customers.'
  },
  {
    title: 'Lost link and mention reclamation',
    copy: 'Broken backlinks, links that disappeared in a redesign, assets that now redirect and brand mentions that never carried a link. These can often be recovered, so we look here before chasing brand-new placements.'
  },
  {
    title: 'Content-led link assets',
    copy: 'Outreach needs something worth referencing. Where the site has nothing an editor would cite, we help shape a guide, data page, tool, case study or resource that gives the request a reason to be accepted.'
  },
  {
    title: 'Backlink profile cleanup guidance',
    copy: 'We investigate paid-link history, network patterns and Search Console manual actions. A low metric, or a spammy link that turned up unprompted, is no reason to submit a disavow file.'
  }
];

const qualityChecks = [
  'The linking page, the linking site and your target page share a topic',
  'The page is real and indexable, and was not built only to sell links',
  'The site shows organic visibility, a genuine readership or standing in its niche',
  'Its outbound links look normal, with no link-farm pattern',
  'The link sits in editorial context, away from footers and stuffed paragraphs',
  'The link text describes the destination and suits the sentence around it',
  'The target page fits the reference and can turn a visitor into an enquiry',
  'You would be content for your own customers to see the placement'
];

const avoidItems = [
  {
    title: 'No PBNs or link farms',
    copy: 'We do not build campaigns on private blog networks, spun sites, expired-domain farms or sites with an obvious paid-link footprint.'
  },
  {
    title: 'No bulk DA or DR packages',
    copy: 'Authority metrics are a useful first filter and nothing more. We do not sell fixed bundles of suspicious high-metric links.'
  },
  {
    title: 'No exact-match anchor abuse',
    copy: 'We do not make keyword-rich link text a condition of an editorial mention. The publisher decides whether to cite the resource and how to describe it.'
  },
  {
    title: 'No irrelevant placements',
    copy: 'A publication has to reach readers who matter to you. An international trade resource may serve an exporter better than an unrelated local blog. Country and domain metrics alone do not settle it.'
  }
];

const processSteps = [
  {
    label: '01',
    title: 'Backlink audit and baseline',
    copy: 'We review your referring domains, anchors, linked pages, link quality and lost links, set them against the competitors that outrank you and note any risk patterns. No new link is recommended until this is done.'
  },
  {
    label: '02',
    title: 'Target page mapping',
    copy: 'We agree which pages should earn links, which searches those pages support and whether content or technical fixes must come before outreach starts.'
  },
  {
    label: '03',
    title: 'Prospecting and qualification',
    copy: 'Each prospect is recorded with its source, intended audience, your target URL and the reason for contact. Prospects that fail the relevance and quality checks are left off the list. The outreach brief names who approves brand claims, content and any placement cost before contact begins.'
  },
  {
    label: '04',
    title: 'Outreach and placement review',
    copy: 'We handle outreach and agreed content support. When a mention is published, we check the destination, link text, context and link attributes. Any payment or sponsorship is recorded, and a paid link must carry sponsored or nofollow qualification. Editors can decline, change or remove a mention, so outreach is never a guaranteed placement.'
  },
  {
    label: '05',
    title: 'Reporting and adjustment',
    copy: 'Each report lists the links acquired or recovered, with rankings, Search Console visibility and referral signals for the target pages. We then adjust the link mix and the target pages as the site and the market change.'
  }
];

const fitBlocks = [
  {
    title: 'Competitive SEO campaigns',
    copy: 'Your content and technical foundations are decent, and you are still outranked by domains that more sites reference and trust.'
  },
  {
    title: 'Service pages that need authority',
    copy: 'The on-page work on a core commercial page is done, and the page still lacks the external references to compete with the results above it.'
  },
  {
    title: 'Brands with messy backlink profiles',
    copy: 'The site bought links in the past, or inherited poor SEO work, and you need to know which links help, which are harmless and which carry risk.'
  },
  {
    title: 'Agency outreach support',
    copy: 'You run an agency and need a prospect list, an approval trail and a placement report you can review with your client. Agree who may contact publishers under the client brand before outreach starts.'
  }
];

const reportFields = [
  'Linking URL and domain',
  'Target page on your site',
  'Anchor text used, as the publisher wrote it',
  'Placement type and the context around the link',
  'Relevance notes: why this site, for this page',
  'Quality and risk observations, including any payment or sponsorship',
  'Date acquired or recovered',
  'Ranking and visibility movement on the target page, where relevant'
];

const faqs = [
  { question: 'What are link building services?', answer: 'Link building services help a website earn relevant backlinks from other websites. Ours cover a backlink audit, prospect research, outreach and a placement report, so that pages worth citing reach publishers whose readers would use them. Whether to link, and in what words, stays with the publisher.' },
  { question: 'Are backlinks still important for SEO?', answer: 'Yes. Backlinks remain an important authority signal, especially in competitive markets. They do most when the site already has sound technical SEO, useful content, clear target pages and sensible internal linking, which is why we check those before outreach.' },
  { question: 'Do you use PBNs or link farms?', answer: 'No. We do not build campaigns around PBNs, expired-domain networks, link farms or bulk guest-post packages. Those shortcuts can produce short-term movement. They also leave a risk on the domain that a serious business has no need to carry.' },
  { question: 'How do you assess a backlink prospect?', answer: 'We examine the readership, topic, page context, outbound links and destination, and we record commercial terms and required link attributes. These checks inform a decision. They cannot certify a link as risk-free.' },
  { question: 'How many backlinks do we need?', answer: 'It depends on the market, the competitors, the target pages and the current authority gap. Some campaigns need a small number of strong, relevant links. Others need sustained authority building over several months. We start with a backlink audit and competitor review instead of guessing a number, and we do not start by promising a fixed number of links, because editors can decline, change or remove a mention.' },
  { question: 'Can bad backlinks hurt rankings?', answer: 'Manipulative link schemes can lead to a manual action or algorithmic effects. Disavowing is an exceptional step: Google recommends it when a considerable number of artificial links have caused, or are likely to cause, a manual action. Investigate that evidence and the removal options first. A toxic score in a tool is not, by itself, a reason to disavow.' },
  { question: 'Do you provide backlink reports?', answer: 'Yes. Each report shows the linking URL, target page, anchor text, placement type, relevance notes, quality checks and campaign impact where it can be measured. The linking URL is given for every placement, so each one can be opened and checked.' },
  { question: 'Should we build links before fixing content and technical SEO?', answer: 'Often not. If the target pages are thin, slow, poorly structured or misaligned with search intent, the links may be wasted. We check technical health, content quality and target-page readiness before scaling link acquisition, and we say so plainly when the pages need work first.' }
];
---

<MainLayout
  title="Link Building Services Philippines | Backlink Outreach"
  description="Link building services in the Philippines: backlink audits, relevant outreach, prospect review, paid-link qualification and transparent placement reporting."
  keywords="link building services Philippines, backlink services Philippines, SEO link building Philippines, white hat link building, backlink audit services"
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Link Building Services Philippines',
          item: 'https://brightforge.com.ph/backlink-seo-services-philippines/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Link Building Services Philippines',
      url: 'https://brightforge.com.ph/backlink-seo-services-philippines/',
      inLanguage: 'en',
      description: 'Link building services for backlink audits, prospect assessment, outreach and placement reporting.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: linkTypes.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          description: item.copy
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-link"
    badgeText="Link Building"
    title="Link Building Services Philippines for <span>Relevant Backlinks</span>"
    breadcrumbCurrent="Link Building Services Philippines"
  >
    <Fragment slot="story">
      <p>Your pages are sound, yet competitors with more referring sites sit above you. Or someone bought links for the domain years ago and nobody can say which of them still matter. Both problems start in the same place: a hard look at the links you have, before anyone pays for more.</p>
      <p>Bright Forge provides link building services in the Philippines for businesses and agency partners. You get a backlink audit, prospect research, outreach handled by our team and a placement report that records each link and the terms it was placed on. The outreach brief names who approves brand claims, content and any placement cost before contact begins, and we check that the destination page deserves the reference before asking for it.</p>
      <p>Philippine businesses and teams targeting Australia, the UK or the USA can use the service directly or through an agency. The prospect list follows the audience: a local trade association, an industry publication and an overseas distributor each reach different readers and call for a different approach.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Get a Backlink Audit" />
      <ButtonSecondary href="#safe-links" text="See How We Build Links" />
    </Fragment>

    <Fragment slot="stats">
      <div class="link-hero-stats">
        <div class="stat"><strong>Audit</strong><span>Your current links, anchors, linked pages, risk patterns and the gap to competitors.</span></div>
        <div class="stat"><strong>Qualify</strong><span>Each prospect checked for relevance, indexation, editorial context and outbound links.</span></div>
        <div class="stat"><strong>Report</strong><span>Linking URL, target page, anchor, placement terms and what moved afterwards.</span></div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="intro-layout">
        <div class="intro-copy">
          <span class="eyebrow">What you get, and who it suits</span>
          <h2>What a <span>backlink campaign</span> with us delivers</h2>
          <p>This service suits a business whose important pages are well built but sit behind competitors that more websites link to. It also suits a domain with a history of bought links, where someone needs to say which can be left alone. The audit tells you which of the two you are dealing with, and which of your pages lack the links their competitors have.</p>
          <p>Search engines treat links as a sign of trust, and they also recognise patterns. One editorial reference from a relevant publication to a useful service page carries weight. A batch of exact-match anchors on thin websites built to sell placements is a pattern, and it is the kind that gets a site noticed for the wrong reason. So we start with the site, the target pages and the market. If a page is too weak to rank, or the profile already carries risk, we tell you to deal with that first, because a link to a poor page is wasted.</p>
        </div>
        <aside class="authority-panel" aria-label="Link building judgement points">
          <h3>Five questions we answer before outreach starts</h3>
          <ul>
            <li>Which of your pages need more authority, and which do not?</li>
            <li>Which competitor links are worth studying?</li>
            <li>Who controls the editorial wording and the link attributes?</li>
            <li>Which placements would we turn down, and why?</li>
            <li>How will the link work connect to rankings and enquiries?</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="proof-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="proof-grid">
        {proofItems.map((item) => (
          <article class="proof-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="safe-links" class="service-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">What we build</span>
          <h2>Six <span>backlink services</span>, mixed to suit your domain</h2>
        </div>
        <p>Few campaigns need all six in equal measure. One site needs new editorial links. Another gains more from recovering lost links, tidying citations, claiming brand mentions or publishing something worth referencing. The audit decides the mix, based on the domain, the competitors and the target pages.</p>
      </div>
      <div class="service-grid">
        {linkTypes.map((item) => (
          <article class="service-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="avoid-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="avoid-layout">
        <div class="avoid-copy">
          <span class="eyebrow">Placement terms and what we refuse</span>
          <h2>Paid, sponsored or earned: agree the <span>placement terms</span> before outreach</h2>
          <p>Payment for advertising is different from an earned editorial reference. Paid or sponsored links need rel="sponsored" or rel="nofollow" qualification, and we report them as paid. We do not count an unqualified paid link as an editorial win. Our article on <a href="/blog/why-cheap-link-building-in-the-philippines-fails/">why cheap link building in the Philippines fails</a> sets out what the shortcuts cost later.</p>
          <p>An illustrative prospect decision: a manufacturer could pursue a genuine trade-association listing if it meets the membership requirements and the listing helps specifiers find it. An unrelated blog offering keyword anchors for a fee would be rejected as an editorial prospect, whatever its metrics.</p>
        </div>
        <div class="avoid-grid">
          {avoidItems.map((item) => (
            <article class="avoid-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="quality-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="quality-layout">
        <div class="quality-panel">
          <span class="eyebrow">Link quality framework</span>
          <h2>Eight checks we run on every <span>backlink prospect</span></h2>
          <p>DA, DR and traffic estimates help us sort a long list, and that is all we use them for. A link earns its place when it is relevant, crawlable, editorially defensible and useful to the wider SEO plan, and each prospect is read against the eight points here before it goes into the outreach brief.</p>
        </div>
        <ul class="quality-list">
          {qualityChecks.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="fit-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">Who this is for</span>
        <h2>When <span>link building</span> is the right next spend</h2>
        <p>Backlinks push a sound SEO campaign further. They do far less when the target pages are thin, the site is technically messy or nobody has decided which commercial searches matter. These are the four situations where we expect link work to pay, including agencies that resell it through our <a href="/white-label-seo-services-philippines/">white label SEO service</a>.</p>
      </div>
      <div class="fit-grid">
        {fitBlocks.map((item) => (
          <article class="fit-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow">Our process</span>
          <h2>Five steps from <span>backlink audit</span> to placement report</h2>
        </div>
        <p>Before any number of links is discussed, we establish the authority gap, the risk profile and the pages that deserve support. Editors can decline, change or remove a mention, and some campaigns need sustained authority building over several months. We publish no rate card: the scope and reporting are set out in a written proposal.</p>
      </div>
      <div class="process-rail">
        {processSteps.map((step) => (
          <article class="process-step">
            <span>{step.label}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reporting-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="reporting-layout">
        <div>
          <span class="eyebrow">Reporting</span>
          <h2>The <span>placement report</span>: eight fields for every link</h2>
          <p>You should be able to open any link we report and see why it was chosen. A monthly count leaves out the publication, the page the link points to and the terms of the placement, the three things you need to judge it.</p>
          <p>So every link is reported in context, with the fields listed here. We then connect the work to the target pages, ranking movement, Search Console visibility and the wider SEO roadmap.</p>
        </div>
        <ul class="report-list">
          {reportFields.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="internal-links-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="internal-panel">
        <div>
          <span class="eyebrow">Connected SEO work</span>
          <h2>Four services that make <span>backlinks</span> worth more</h2>
          <p>Link building is usually one part of a wider SEO campaign. A link sends authority to a page, and the page still has to earn the ranking and the enquiry. If your service pages, content, technical health or local signals are weak, we flag that before any budget goes on authority.</p>
        </div>
        <div class="internal-links">
          <a href="/seo-services-philippines/">SEO services Philippines</a>
          <a href="/content-seo-services-philippines/">SEO content writing services</a>
          <a href="/technical-seo-services-philippines/">Technical SEO services</a>
          <a href="/seo-audit-services/">SEO audit services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="max-w-4xl mx-auto px-6">
      <div class="section-heading centered">
        <span class="eyebrow">Questions buyers ask</span>
        <h2><span>Backlink and link building FAQs</span></h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="cta-panel">
        <span class="eyebrow">Start with the audit</span>
        <h2>Find out what your <span>backlink profile</span> is doing for you</h2>
        <p>Send us the domain. We review your current links, anchor text, linked pages, the authority gap to your competitors and any obvious risk patterns, then show where link building fits in the wider SEO plan and which pages should be supported first.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Get a Backlink Audit" />
          <ButtonSecondary href="/case-studies/" text="View Case Studies" />
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.link-hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.5rem;
}

.stat {
  background: rgba(25, 33, 46, 0.09);
  border: 1px solid rgba(240, 98, 42, 0.24);
  border-radius: 18px;
  padding: 1rem;
}

.stat strong {
  display: block;
  color: #b83e12;
  font-size: 1.35rem;
  margin-bottom: 0.35rem;
}

.stat span {
  color: #465365;
  font-size: 0.92rem;
  line-height: 1.45;
}

section {
  background: #ffffff;
  color: #19212e;
}

.intro-section,
.service-section,
.fit-section,
.reporting-section,
.faq-section {
  padding: 5.5rem 0;
  background: #f7f8fa;
}

.proof-section,
.avoid-section,
.quality-section,
.process-section,
.internal-links-section,
.cta-section {
  padding: 5.5rem 0;
  background: #ffffff;
}

.intro-layout,
.avoid-layout,
.quality-layout,
.reporting-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: 3rem;
  align-items: start;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: #b83e12;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.35rem);
  line-height: 1.08;
  font-weight: 900;
  margin: 0 0 1.25rem;
}

h3 {
  color: #19212e;
  font-weight: 800;
  margin: 0 0 0.75rem;
}

p {
  color: #465365;
  line-height: 1.75;
  font-size: 1rem;
}

.intro-copy p,
.avoid-copy p,
.quality-panel p,
.reporting-layout p,
.cta-panel p {
  font-size: 1.08rem;
}

.authority-panel,
.quality-panel,
.internal-panel,
.cta-panel {
  background: linear-gradient(135deg, rgba(240, 98, 42, 0.12), rgba(25, 33, 46, 0.09));
  border: 1px solid rgba(240, 98, 42, 0.26);
  border-radius: 28px;
  padding: 2rem;
  box-shadow: 0 28px 70px rgba(25, 33, 46, 0.09);
}

.authority-panel ul,
.quality-list,
.report-list {
  list-style: none;
  margin: 1.25rem 0 0;
  padding: 0;
}

.authority-panel li,
.quality-list li,
.report-list li {
  position: relative;
  padding: 0.85rem 0 0.85rem 1.8rem;
  color: #465365;
  line-height: 1.55;
  border-bottom: 1px solid rgba(25, 33, 46, 0.08);
}

.authority-panel li::before,
.quality-list li::before,
.report-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 1.25rem;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #f0622a;
  box-shadow: 0 0 0 5px rgba(240, 98, 42, 0.16);
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.proof-card,
.service-card,
.avoid-card,
.fit-card,
.process-step,
.faq-item {
  background: rgba(25, 33, 46, 0.09);
  border: 1px solid rgba(25, 33, 46, 0.08);
  border-radius: 22px;
  padding: 1.6rem;
}

.proof-card {
  border-color: rgba(240, 98, 42, 0.24);
}

.proof-card p,
.service-card p,
.avoid-card p,
.fit-card p,
.process-step p,
.faq-item p {
  margin: 0;
}

.section-heading {
  margin-bottom: 2.5rem;
}

.split-heading {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.75fr);
  gap: 3rem;
  align-items: end;
}

.split-heading p,
.centered p {
  margin: 0;
  font-size: 1.08rem;
}

.centered {
  text-align: center;
  max-width: 850px;
  margin-left: auto;
  margin-right: auto;
