---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const proofItems = [
  {
    title: 'Every search group assigned to a page',
    copy: 'The work goes past a keyword list. We decide which terms belong on service pages, category pages, local pages, articles, FAQs and supporting assets.'
  },
  {
    title: 'Priorities with reasons',
    copy: 'Every recommendation is filtered by intent, realistic ranking potential, commercial value, existing visibility and the work needed to win the query.'
  },
  {
    title: 'A roadmap your team can use',
    copy: 'You get page targets, content actions, internal-link opportunities and implementation notes. A raw export from a keyword tool gives you none of those.'
  }
];

const researchDeliverables = [
  {
    title: 'Keyword opportunity set',
    copy: 'A cleaned, grouped keyword set. Each group carries its search intent, commercial relevance, difficulty signals, volume context and a priority note, with irrelevant and duplicate terms already removed.'
  },
  {
    title: 'Page mapping',
    copy: 'Primary and secondary terms assigned to an existing URL or a recommended new page, each with a plain action label: create, rewrite, merge, expand or monitor.'
  },
  {
    title: 'Competitor keyword gaps',
    copy: 'A competitor gap analysis filtered for business fit. We separate the searches worth pursuing from brand noise, weak-fit queries and vanity rankings, and we never copy a term simply because a competitor ranks for it.'
  },
  {
    title: 'Search intent and SERP notes',
    copy: 'Search-result checks recording which page types appear for the query: service pages, collections, guides, comparisons, local results or videos. Mixed results are recorded as mixed and are not forced into one page type.'
  },
  {
    title: 'Quick-win targets',
    copy: 'Queries where an existing page already has enough relevance or impressions to justify focused on-page, content or internal-link work, so the first gains do not have to wait for new pages.'
  },
  {
    title: 'Content and page roadmap',
    copy: 'The order of work: which pages to build or improve first, how they link to one another and what each page is there to achieve.'
  }
];

const mappingFields = [
  'Primary keyword and its close variants',
  'Search intent and how near the searcher is to buying',
  'The existing URL that should rank, or a recommendation for a new page',
  'Recommended page type',
  'Priority level, with the reason',
  'Content action required: rewrite, expand, merge or create',
  'Related questions for FAQs or supporting articles',
  'Internal links to add',
  'Notes on competitors and the current search results',
  'How to measure progress: rankings, impressions and enquiries'
];

const siteTypes = [
  {
    title: 'Philippines: coverage and buyer language',
    copy: 'We start with the actual service area, customer enquiries and the language used by buyers. We compare those with Philippine search data rather than assuming an English-only national keyword list represents every local audience.'
  },
  {
    title: 'Australia: delivery areas and local terms',
    copy: 'We check Australian search results alongside the states, suburbs or delivery zones you serve. Catalogue research also needs stock and shipping restrictions, so a high-demand product is not prioritised where it cannot be supplied.'
  },
  {
    title: 'United Kingdom: service scope and terminology',
    copy: 'We use UK query data and locally relevant results, then check whether searches imply a national supplier, a nearby provider or information. Your sales team confirms the terms buyers use and the areas in which the offer is available.'
  },
  {
    title: 'United States: national versus state-level intent',
    copy: 'We distinguish national research from city or state targeting. Product eligibility, service boundaries and American terminology can change the useful query set; a national volume figure cannot answer those questions.'
  }
];

const avoidItems = [
  {
    title: 'Market, query and existing page',
    copy: 'Illustrative example: Australia. Query: commercial roof replacement cost. Existing page: /commercial-roof-replacement/. Buyer decision: whether the contractor handles this building type and what information is needed for a quote.'
  },
  {
    title: 'Proposed action and reason',
    copy: 'Expand the existing service page with the factors used to scope a quote: roof area, material, access and removal requirements. Link to the enquiry form asking for those details. Publish price ranges only if the contractor supplies and approves them.'
  },
  {
    title: 'Rejected alternative',
    copy: 'Do not create a second service page solely to repeat the cost phrase. It may duplicate the existing offer. A separate cost guide needs distinct buyer value and search-result evidence, not just a different title.'
  },
  {
    title: 'Approval and measurement',
    copy: 'The contractor confirms service coverage and quote requirements; the editor revises the mapped page. We would record its release date and monitor the relevant query group and landing page rather than judging the change by whole-site traffic.'
  }
];

const processSteps = [
  {
    label: '01',
    title: 'Business and site context',
    copy: 'You tell us what you sell, where you can deliver it and which enquiries you do not want. We review the offer, ideal customers, priority services, locations, margins, current pages, conversion goals and any existing Search Console or ranking data.'
  },
  {
    label: '02',
    title: 'Keyword discovery and cleanup',
    copy: 'We collect candidate terms from Search Console queries, competitor rankings and keyword tool data for your market, then remove noise, duplicates, impossible terms and anything the business cannot serve.'
  },
  {
    label: '03',
    title: 'SERP and intent validation',
    copy: 'For each group we look at what Google actually shows in the target country, because volume figures alone mislead. The recommendation then matches the page type, format, depth and searcher expectation the results reveal.'
  },
  {
    label: '04',
    title: 'Page mapping and prioritisation',
    copy: 'We group terms into page targets, flag the existing pages that can be improved, identify the pages that are missing and order the work by likely commercial impact.'
  },
  {
    label: '05',
    title: 'Roadmap and handoff',
    copy: 'You receive the keyword map with actions, priorities, page notes and next steps for content, on-page SEO, internal links and tracking. If you only need the research, the roadmap goes to your internal team.'
  }
];

const connectedServices = [
  {
    title: 'SEO services Philippines',
    href: '/seo-services-philippines/',
    copy: 'The wider campaign that turns research into technical fixes, page improvements, content, links and reporting.'
  },
  {
    title: 'SEO content writing services',
    href: '/content-seo-services-philippines/',
    copy: 'Writing or rewriting the pages, articles and FAQs the keyword map identifies.'
  },
  {
    title: 'On-page SEO services',
    href: '/on-page-seo-services-philippines/',
    copy: 'Mapped pages improved with stronger metadata, structure, copy, internal links, proof and calls to action.'
  },
  {
    title: 'SEO audit services',
    href: '/seo-audit-services/',
    copy: 'A diagnosis of why existing pages are not ranking, converting or supporting the wider SEO campaign.'
  },
  {
    title: 'Technical SEO services',
    href: '/technical-seo-services-philippines/',
    copy: 'Crawl, indexation, rendering, schema and architecture issues that decide whether a keyword target can perform at all.'
  },
  {
    title: 'Local SEO services',
    href: '/local-seo-for-google-maps-and-gbp/',
    copy: 'Service, location and Google Maps intent mapped into local landing pages, GBP work and citation strategy.'
  }
];

const faqs = [
  { question: 'What is included in keyword research services?', answer: 'More than a keyword list. The work covers keyword discovery, search intent checks, a competitor gap review, page mapping, priority scoring, existing-page opportunities, new-page recommendations, FAQ ideas and an SEO roadmap your team can follow.' },
  { question: 'How is this different from exporting keywords from Ahrefs or SEMrush?', answer: 'A tool export tells you what people search for. A keyword map tells you which page should answer each search, whether the site can realistically compete and what work is needed. We turn the data into decisions your team can act on.' },
  { question: 'Do you map keywords to existing pages?', answer: 'Yes. We review existing URLs and decide whether each priority keyword belongs on a current page, a rewritten page, a merged page or a new page. Assigning each group of searches to one page is what prevents duplication and keyword cannibalisation.' },
  { question: 'Can you find competitor keyword gaps?', answer: 'Yes. We compare relevant competitors, then filter the gaps for business fit. A keyword is not recommended just because a competitor ranks for it. It has to match your offer, market, page type and commercial opportunity.' },
  { question: 'How do you prioritise keywords?', answer: 'By search intent, volume context, keyword difficulty signals, current rankings, Search Console visibility, commercial value, page fit, competitor strength and the amount of work needed to compete. Each priority in the map carries its reason.' },
  { question: 'Do you include a content plan?', answer: 'Yes, when content is the right action. Some keywords need new articles. Others need stronger service pages, category pages, location pages, FAQs or internal links. The map labels each action separately, so an article is not commissioned where a page edit would do.' },
  { question: 'Can our content team use the keyword map directly?', answer: 'Yes. The keyword map is built for implementation. It gives page targets, priority terms, intent notes, page actions and supporting topics, so writers, SEOs and developers know what to do next.' },
  { question: 'Do you help implement the keyword research?', answer: 'Yes. Keyword research feeds into our SEO services, content SEO, on-page SEO, local SEO and technical SEO work. If you only need the research, we hand the roadmap to your internal team.' }
];
---

<MainLayout
  title="Keyword Research Services Philippines | SEO Keyword Mapping"
  description="Keyword research from our Philippines team: we find what your customers search for and map each group of searches to one page, with priorities and next steps."
  keywords="keyword research services Philippines, SEO keyword research services, keyword mapping services, keyword analysis services, SEO content planning"
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Keyword Research Services Philippines',
          item: 'https://brightforge.com.ph/keyword-research-services/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Keyword Research Services Philippines',
      url: 'https://brightforge.com.ph/keyword-research-services/',
      description: 'Keyword research services in the Philippines for SEO keyword mapping, content planning, competitor gaps and practical page-by-page search strategy.',
      isPartOf: {
        '@type': 'WebSite',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Keyword Research Services Philippines',
      serviceType: 'SEO keyword research and keyword mapping',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/',
        telephone: '+63-969-620-6182',
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'PH'
        }
      },
      areaServed: ['Philippines', 'Australia', 'United Kingdom', 'United States'],
      url: 'https://brightforge.com.ph/keyword-research-services/',
      description: 'SEO keyword research, keyword mapping, competitor gap analysis and content roadmap planning for businesses that need practical search strategy.'
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-map-signs"
    badgeText="SEO Keyword Mapping"
    title="Keyword Research Services Philippines for <span>SEO Roadmaps That Get Used</span>"
    breadcrumbCurrent="Keyword Research Services"
  >
    <Fragment slot="story">
      <p>Do you need a new service page, a better category page or an answer on a page you already have? We find out what your customers type into Google and settle that question before you spend on writing or development.</p>
      <p>We group related searches by what the person wants, inspect the search results in the target market and assign each useful group to one page: an existing URL or a proposed new one. You receive a keyword map your writers and developers can work from, with the reason for each recommendation, its priority and the next content or technical action.</p>
      <p>Our Philippines-based team supports Philippine, Australian, UK and US campaigns. Tell us what you sell, where you can deliver it and which enquiries you do not want. Those details let us reject attractive-looking searches that would bring the wrong customer.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=keyword-research#contactForm" text="Request a Keyword Map" />
      <ButtonSecondary href="#deliverables" text="See What You Get" />
    </Fragment>

    <Fragment slot="stats">
      <div class="keyword-hero-proof">
        {proofItems.map((item) => (
          <article>
            <strong>{item.title}</strong>
            <span>{item.copy}</span>
          </article>
        ))}
      </div>
    </Fragment>

    <Fragment slot="visual">
      <div class="keyword-map-panel" aria-label="Keyword map example">
        <div class="panel-header">
          <span>Keyword map</span>
          <strong>Priority view</strong>
        </div>
        <div class="map-row high">
          <span>SEO services Philippines</span>
          <strong>Service page</strong>
        </div>
        <div class="map-row medium">
          <span>SEO pricing Philippines</span>
          <strong>Guide or sales page</strong>
        </div>
        <div class="map-row medium">
          <span>local SEO consultant Manila</span>
          <strong>Local service page</strong>
        </div>
        <div class="map-row low">
          <span>what is SEO</span>
          <strong>Support content</strong>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="intro-section visible-section">
    <div class="content-wrap split-layout">
      <div>
        <p class="eyebrow">Search demand into decisions</p>
        <h2>What our <span>keyword research</span> settles before you write or build</h2>
        <p>This service is for a business about to commission pages, plan content or restructure a site, and for an in-house team holding a keyword export with no agreement on what to do with it. It answers practical questions. Do we need a new service page or a better existing one? Which searches bring buyers and which bring students? Where are competitors visible while we are absent?</p>
        <p>A pricing question may belong on the service page where a buyer is choosing a supplier. A comparison may need its own page if it serves a different decision. We inspect the current results and your existing coverage before treating either as a new writing brief.</p>
        <p>For each query group, we compare the current page with the information buyers need. The recommendation may be a new landing page, an expanded section or a useful FAQ. We also record the terms to leave out when the business cannot serve the search.</p>
        <p>The map records the research date, country, data source and any missing evidence. Search volumes are estimates, not forecasts of visits or sales.</p>
      </div>
      <aside class="statement-card">
        <span>Bright Forge approach</span>
        <strong>Research only matters when it changes the page plan.</strong>
        <p>We connect each keyword group to a URL, a page type, a content action and a way to measure progress.</p>
      </aside>
    </div>
  </section>

  <section id="deliverables" class="deliverables-section visible-section">
    <div class="content-wrap">
      <div class="section-heading">
        <p class="eyebrow">What you get</p>
        <h2>Six <span>keyword research</span> deliverables, and what each one decides</h2>
        <p>Together they turn a list of searches into a page strategy, a content plan and an order of work. The keyword map and the roadmap carry all six.</p>
      </div>
      <div class="deliverable-grid">
        {researchDeliverables.map((item) => (
          <article class="deliverable-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mapping-section visible-section">
    <div class="content-wrap mapping-layout">
      <div>
        <p class="eyebrow">Keyword mapping</p>
        <h2>The <span>keyword map</span>: ten fields for every group of searches</h2>
        <p>The map gives writers, SEOs and developers the page targets, priority terms, intent notes and page actions they need. It shows where each search opportunity belongs. Without it, content teams build pages that overlap, miss the intent or chase the wrong terms.</p>
        <p>We map keywords to the structure of the site, then order the work by commercial value, ranking potential and what the business can realistically implement. Repeating a phrase more often is no part of the plan: our article on <a href="/blog/keyword-density-in-2026-dead-metric-or-misunderstood-signal/">keyword density in 2026</a> explains why.</p>
        <a class="text-link" href="/on-page-seo-services-philippines/">See how this connects to on-page SEO</a>
      </div>
      <div class="field-panel">
        <h3>Fields in a typical keyword map</h3>
        <ul>
          {mappingFields.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="site-types-section visible-section">
    <div class="content-wrap">
      <div class="section-heading narrow">
        <p class="eyebrow">Market inputs</p>
        <h2><span>Keyword research</span> by market: the Philippines, Australia, the UK and the US</h2>
        <p>Search habits differ from country to country, so we research each one separately. We keep the country datasets apart and record the location used for search-result checks. A searcher abroad may still want a Philippine service, so the country of the search does not settle intent.</p>
      </div>
      <div class="type-list">
        {siteTypes.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="avoid-section visible-section">
    <div class="content-wrap split-layout reverse">
      <div class="avoid-list">
        {avoidItems.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
      <div>
        <p class="eyebrow">Illustrative keyword-map row</p>
        <h2>One <span>keyword-map row</span>, worked from query to decision</h2>
        <p>This example shows our decision format. It is not measured demand or a completed client recommendation. The URL and query are illustrative, and no search volume or ranking is implied.</p>
        <p>Before approving the action, we would inspect the market-specific search results and check Search Console for the existing page. If the evidence showed that buyers want a separate comparison and not a supplier quote, the recommendation would change.</p>
      </div>
    </div>
  </section>

  <section class="process-section visible-section">
    <div class="content-wrap">
      <div class="section-heading narrow">
        <p class="eyebrow">Process</p>
        <h2>Five steps from <span>keyword data</span> to an SEO roadmap</h2>
      </div>
      <div class="process-list">
        {processSteps.map((step) => (
          <article>
            <span>{step.label}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="implementation-section visible-section">
    <div class="content-wrap split-layout">
      <div>
        <p class="eyebrow">After the research</p>
        <h2>After the <span>keyword map</span>: six ways to put it to work</h2>
        <p>Keyword research earns its fee when it feeds straight into implementation. That might mean rewriting a service page, building a new location page, improving internal links, creating supporting articles or fixing the technical issues that block the target pages.</p>
        <p>If you only need the research, we hand over the roadmap and your team takes it from there. If you want execution, we turn the plan into content, on-page improvements, technical fixes and campaign tracking. Either way, the scope is set out in a written proposal.</p>
      </div>
      <div class="implementation-links">
        {connectedServices.map((service) => (
          <a href={service.href}>
            <strong>{service.title}</strong>
            <span>{service.copy}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band visible-section">
    <div class="content-wrap cta-inner">
      <div>
        <p class="eyebrow">Start with the map</p>
        <h2>Need a clearer <span>SEO content plan</span>?</h2>
        <p>Send us the site, the market and the main services you want to grow. We will review whether keyword research, an SEO audit or page-level optimisation is the right first step.</p>
      </div>
      <ButtonPrimary href="/contact/?service=keyword-research#contactForm" text="Request a Keyword Map" />
    </div>
  </section>

  <section class="faq-section visible-section">
    <div class="content-wrap narrow">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2><span>Keyword research</span> questions, answered plainly</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactSection href="/contact/?service=keyword-research#contactForm" id="contact" />
  <Footer slot="footer" />
</MainLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #ffffff;
    color: #19212e;
  }

  .visible-section,
  .intro-section,
  .deliverables-section,
  .mapping-section,
  .site-types-section,
  .avoid-section,
  .process-section,
  .implementation-section,
  .cta-band,
  .faq-section {
    content-visibility: visible !important;
    contain-intrinsic-size: auto !important;
    padding: 5.5rem 0;
    background: #ffffff;
    color: #19212e;
  }

  .deliverables-section,
  .site-types-section,
  .implementation-section,
  .faq-section {
    background: #f7f8fa;
  }

  .content-wrap {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .content-wrap.narrow,
  .section-heading.narrow {
    max-width: 860px;
  }

  .split-layout,
  .mapping-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 3rem;
    align-items: center;
  }

  .split-layout.reverse {
    grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.05fr);
  }

  .eyebrow {
    color: #b83e12;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
  }

  h2 {
    color: #19212e;
    font-size: clamp(2rem, 4vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 1.2rem;
  }

  h3 {
    color: #19212e;
    font-size: 1.12rem;
    line-height: 1.25;
    margin: 0 0 0.65rem;
  }

  p {
    color: #465365;
    font-size: 1.02rem;
    line-height: 1.75;
    margin: 0 0 1rem;
  }

  .keyword-hero-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .keyword-hero-proof article {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-radius: 18px;
    padding: 1rem;
  }

  .keyword-hero-proof strong,
  .keyword-hero-proof span {
    display: block;
  }

  .keyword-hero-proof strong {
    color: #19212e;
    font-size: 0.92rem;
    margin-bottom: 0.45rem;
  }

  .keyword-hero-proof span {
    color: #465365;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .keyword-map-panel {
    background: linear-gradient(145deg, rgba(25, 33, 46, 0.09), rgba(25, 33, 46, 0.09));
    border: 1px solid rgba(240, 98, 42, 0.28);
    border-radius: 26px;
    box-shadow: 0 28px 90px rgba(25, 33, 46, 0.09);
    padding: 1.4rem;
    width: min(100%, 460px);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #19212e;
    margin-bottom: 1rem;
  }

  .panel-header span {
    color: #b83e12;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.76rem;
  }

  .map-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-left: 4px solid #f0622a;
    border-radius: 16px;
    color: #19212e;
    margin-top: 0.75rem;
    padding: 0.95rem;
  }

  .map-row strong {
    background: rgba(240, 98, 42, 0.15);
    border-radius: 999px;
    color: #b83e12;
    font-size: 0.75rem;
    padding: 0.35rem 0.65rem;
    white-space: nowrap;
  }

  .map-row.medium {
    border-left-color: #f59e0b;
  }

  .map-row.low {
    border-left-color: #64748b;
  }

  .statement-card,
  .field-panel {
    background: linear-gradient(145deg, rgba(240, 98, 42, 0.13), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(240, 98, 42, 0.24);
    border-radius: 26px;
    padding: 2rem;
  }

  .statement-card span {
    color: #b83e12;
    display: block;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .statement-card strong {
    color: #19212e;
    display: block;
