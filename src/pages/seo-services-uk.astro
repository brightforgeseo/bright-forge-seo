---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceEvidencePanel from '../components/ServiceEvidencePanel.astro';
import serviceEvidence from '../data/serviceEvidence.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';
import { seoServicesHreflangs } from '../data/internationalSeoPages.js';

const faqs = [
  {
    question: 'How much do SEO services cost in the UK?',
    answer: "We prepare a GBP proposal around the pages, technical work and review support your site needs. The scope should separate research, writing, implementation and reporting, identify exclusions and state the payment terms. A local service site and a national catalogue need different workloads."
  },
  {
    question: 'How long does SEO take to work in the UK market?',
    answer: 'The first stage is groundwork: audit, technical fixes and content foundations. Competitive campaigns need time, and the useful comparison depends on your market, current site and agreed scope. We report against dated evidence rather than promise fixed results by a fixed date.'
  },
  {
    question: 'Can you guarantee page 1 rankings on Google?',
    answer: "No. We can agree the work, review points and measures of progress, but cannot control rankings. We review UK query and landing-page performance alongside completed changes, including periods where results do not improve."
  },
  {
    question: 'What does a monthly SEO retainer actually include?',
    answer: 'A typical month covers technical monitoring and fixes, on-page optimisation, British English content production or briefs, UK-relevant link outreach, and a plain-English report showing rankings, traffic, work completed and next steps. The mix shifts with your campaign phase: month one is audit-heavy, later months lean into content and authority. You keep full access to your Google Analytics and Search Console data throughout.'
  },
  {
    question: 'Why would a UK business use an SEO agency in the Philippines?',
    answer: "We offer technical review, British English content and implementation support from Quezon City. Compare our proposed responsibilities, relevant work and review windows with the capacity your team needs. The linked Speediance UK project lets you inspect an example of our ecommerce scope."
  },
  {
    question: 'How do the time zones work between the UK and the Philippines?',
    answer: "Manila is eight hours ahead of GMT and seven ahead of BST. A 9:00 UK call is 17:00 in Manila on GMT or 16:00 on BST. We agree meeting windows and delivery dates around the work and your approval process."
  },
  {
    question: 'Will my content be written in British English?',
    answer: "Yes. We use British English and check terminology against your products and customers. For a UK store, that includes the actual GBP prices, delivery coverage and returns information supplied by your team, rather than simply changing spelling."
  },
  {
    question: 'Can you build links from UK websites?',
    answer: 'Yes. Link relevance matters for country-level rankings, so UK campaigns prioritise UK-relevant opportunities: publications, industry directories, supplier and partner sites, and digital PR angles that make sense to a British audience. We do not sell bulk link packages, and we will show you where every link comes from.'
  },
  {
    question: 'Do you tie clients into long contracts?',
    answer: "Engagement length, payment terms and any notice period belong in the written proposal. Before agreeing a retainer, confirm the work included, the review schedule and what files and account access are handed over at the end."
  },
  {
    question: 'How do you measure and report SEO results?',
    answer: "Search Console shows query and landing-page performance; GA4 shows recorded site activity. We agree the UK segments, comparison periods and conversion definitions, then report completed work and the next priorities. Rank tracking or AI monitoring is included where agreed in scope."
  },
  {
    question: 'Does SEO still work now that people use ChatGPT and AI Overviews?',
    answer: "Search work still starts with pages buyers can find and use. AI-search work adds checks on product facts, answers to buying questions and a defined sample of prompts. We report observed mentions separately from referral sessions, and confirm event definitions before treating a tracked action as a signup, order or enquiry."
  },
  {
    question: 'Should I hire a UK agency, a freelancer or an offshore team?',
    answer: "A freelancer may suit a focused task; a team may suit work spanning technical SEO, content and implementation. Ask who will deliver and review each part, what your own team must provide, and how changes will be checked before release."
  }
];
---

<MainLayout
  title="SEO Services for UK Businesses | Bright Forge"
  description="SEO for UK businesses from our Philippines team. Technical work, British English content and published case studies. Discuss your site and priorities."
  canonical="https://brightforge.com.ph/seo-services-uk/"
  type="service"
  includeServiceSchema={false}
  faqs={faqs}
  hreflangs={seoServicesHreflangs}
  geoRegion="GB"
  geoPlacename="United Kingdom"
  contentLanguage="en-GB"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'SEO Services UK',
          item: 'https://brightforge.com.ph/seo-services-uk/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'SEO Services UK',
      serviceType: 'Search engine optimisation',
      url: 'https://brightforge.com.ph/seo-services-uk/',
      areaServed: {
        '@type': 'Country',
        name: 'United Kingdom'
      },
      availableLanguage: 'en-GB',
      provider: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      description: 'Search engine optimisation services for UK businesses: technical SEO, British English content, UK-relevant link building, AI search optimisation and transparent monthly reporting.'
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-globe-europe"
    badgeText="SEO for UK Businesses"
    title="SEO Services for UK Businesses With <span>Work You Can Verify</span>"
    breadcrumbCurrent="SEO Services UK"
  >
    <Fragment slot="intro">
      <p>We help UK ecommerce brands, SaaS products and service businesses win visibility on google.co.uk: senior technical SEO, British English content, UK-relevant links and reporting you can verify in your own analytics.</p>
    </Fragment>
    <Fragment slot="story">
      <p>We deliver from Quezon City in the Philippines. Your proposal identifies the pages we will work on, who implements the changes and how your team reviews them.</p>
      <p>Our UK work includes the Speediance fitness ecommerce campaign. UK Auction List has also publicly reviewed us after more than 18 months of partnership. Explore the project work and client feedback below.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=seo-services&market=UK#contactForm" text="Get a UK SEO Proposal" />
      <ButtonSecondary href="#uk-results" text="See UK Client Results" />
    </Fragment>

    <Fragment slot="visual">
      <div class="market-visual" aria-label="UK SEO campaign snapshot">
        <div class="market-node">
          <span>Your market</span>
          <strong>google.co.uk, AI search, UK buyers and competitors</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node forge">
          <span>Your SEO team</span>
          <strong>Named senior specialists in the Philippines</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node">
          <span>Your advantage</span>
          <strong>Agreed delivery dates and UK review windows</strong>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="proof-strip" aria-label="UK SEO proof points">
    <div class="container">
      <div class="proof-grid">
        <div><strong>UK ecommerce work</strong><span>Speediance UK campaign</span></div>
        <div><strong>British English content</strong><span>Product terminology checked with your team</span></div>
        <div><strong>18+ month UK partnership</strong><span>Publicly reviewed by UK Auction List</span></div>
        <div><strong>GBP pricing available</strong><span>Calls in your morning, our afternoon</span></div>
      </div>
    </div>
  </section>

  <section class="section dark" id="why-us">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Why UK businesses choose us</p>
        <h2>UK campaign delivery <span>with clear responsibilities</span></h2>
        <p class="lead">Start with the part of the website that is holding the campaign back: a catalogue shoppers cannot filter usefully, service pages that omit coverage, or product comparisons that do not explain the differences.</p>
        <p>We agree the priority URLs and the information needed from your team before commissioning content. For a UK store, delivery coverage, GBP prices and returns conditions matter alongside category demand. For a service business, the page must explain what can be delivered and where.</p>
      </div>
      <div class="card-grid small">
        <article class="card"><h3>Ecommerce brands</h3><p>Category and product page SEO, technical health and content that captures UK buying intent.</p></article>
        <article class="card"><h3>SaaS &amp; B2B</h3><p>Feature, comparison and use-case pages plus authority building for competitive UK software terms.</p></article>
        <article class="card"><h3>Service businesses</h3><p>Service and location page strategy for firms that win work through enquiries, not footfall.</p></article>
        <article class="card"><h3>UK agencies</h3><p>Fulfilment under your brand via our <a href="/white-label-seo-services-philippines/">white label SEO services</a>.</p></article>
      </div>
    </div>
  </section>

  <section class="section darker" id="uk-results">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">UK client results</p>
        <h2>UK project work <span>and buying questions to resolve</span></h2>
        <p>The Speediance link describes UK project work. The other cards show examples of buying questions we would review, with related AI-search reading. They are not claims of completed changes or measured sales.</p>
      </div>

      <div class="results-grid">
        <article class="result-card">
          <p class="result-tag">Fitness Ecommerce</p>
          <p class="result-metric">UK</p>
          <h3>Speediance UK fitness ecommerce</h3>
          <p>Technical review, product search intent and content work for a UK home-gym storefront. Review the project scope and campaign approach.</p>
          <a href="/case-studies/speediance-uk-fitness-seo/">Read the case study →</a>
        </article>
        <article class="result-card">
          <p class="result-tag">Review focus · AI search</p>
          <h3>Sports software: explain the product</h3>
          <p>For team-management software, a buyer needs to compare squad administration, fixtures and reporting. We review whether those tasks have clear pages and a useful route into the product.</p>
          <a href="/case-studies/ai-sports-saas-geo/">Related AI-search review →</a>
        </article>
        <article class="result-card">
          <p class="result-tag">Review focus · AI search</p>
          <h3>Storage: answer the booking questions</h3>
          <p>Unit size, access hours, site location and booking conditions belong together. We review these details before adding more location pages or expanding AI-search monitoring.</p>
          <a href="/case-studies/ai-self-storage-geo/">Related AI-search review →</a>
        </article>
        <article class="result-card">
          <p class="result-tag">Review focus · AI search</p>
          <h3>Bridal retail: support the appointment decision</h3>
          <p>Design ranges, sizing, stockists and appointment information answer different questions. We check where those details belong and how a shopper moves from a dress to an enquiry.</p>
          <a href="/case-studies/ai-bridal-ecommerce-geo/">Related AI-search review →</a>
        </article>
      </div>

      <div class="quote-grid">

        <figure class="quote-card">
          <blockquote>“We've been working with Ben and Bright Forge SEO for over 18 months, with the primary focus being our SEO needs. The results have been outstanding.”</blockquote>
          <figcaption><a href="https://www.google.com/maps/contrib/113689117491192336436/reviews?hl=en">UK Auction List, property auctions platform</a></figcaption>
        </figure>
        <figure class="quote-card">
          <blockquote>“Working with Bright Forge SEO has been a huge benefit for TeamStats.”</blockquote>
          <figcaption><a href="https://www.google.com/maps/contrib/116331598386131030776/reviews?hl=en">Tom Stanbury, TeamStats (UK)</a></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section dark" id="services">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">What we deliver</p>
        <h2>Full-service search engine optimisation <span>for the UK market</span></h2>
        <p>We combine technical SEO, on-page work, content, link outreach and AI-search review. The priorities depend on your UK competitors, existing pages and the changes your team can implement.</p>
      </div>

      <div class="service-grid">
        <article class="service-card"><i class="fas fa-search"></i><h3>SEO audits</h3><p>A review of technical problems, page coverage and relevant links, with affected URLs and prioritised fixes.</p><a class="card-link" href="/seo-audit-services/">SEO audit services →</a></article>
        <article class="service-card"><i class="fas fa-sitemap"></i><h3>Technical SEO</h3><p>Crawlability, indexation, site speed, schema and structure: the foundations UK rankings sit on.</p><a class="card-link" href="/technical-seo-services-philippines/">Technical SEO services →</a></article>
        <article class="service-card"><i class="fas fa-file-alt"></i><h3>On-page SEO</h3><p>Titles, headings, internal links and page structure tuned to how UK buyers actually search.</p><a class="card-link" href="/on-page-seo-services-philippines/">On-page SEO services →</a></article>
        <article class="service-card"><i class="fas fa-pen-nib"></i><h3>Content SEO</h3><p>British English content mapped to UK search demand, buyer language and commercial intent.</p><a class="card-link" href="/content-seo-services-philippines/">Content SEO services →</a></article>
        <article class="service-card"><i class="fas fa-key"></i><h3>Keyword research</h3><p>UK demand mapped to pages, including the spelling, phrasing and intent differences that matter.</p><a class="card-link" href="/keyword-research-services/">Keyword research →</a></article>
        <article class="service-card"><i class="fas fa-link"></i><h3>Link building &amp; digital PR</h3><p>Relevance-led links from UK publications, directories and industry sites. Prospects are reviewed for relevance before outreach.</p><a class="card-link" href="/backlink-seo-services-philippines/">Link building services →</a></article>
        <article class="service-card"><i class="fas fa-robot"></i><h3>AI Search Optimization</h3><p>Product and service facts, buyer-question coverage and a defined sample of AI answers to monitor.</p><a class="card-link" href="/ai-search-optimization-services-philippines/">AI search services →</a></article>
        <article class="service-card"><i class="fas fa-map-marker-alt"></i><h3>Local SEO</h3><p>Local visibility for UK businesses that win customers city by city, suburb by suburb.</p><a class="card-link" href="/local-seo-for-google-maps-and-gbp/">Local SEO services →</a></article>
      </div>
      <p class="grid-note">Replatforming or redesigning? Our <a href="/website-migration-services/">website migration services</a> cover redirect mapping, launch checks and post-launch monitoring.</p>
    </div>
  </section>

  <section class="section darker" id="campaign">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Month by month</p>
        <h2>What a UK SEO campaign <span>actually looks like</span></h2>
        <p>This is an example sequence. Access, implementation effort and approvals determine delivery dates; the phases are not a schedule of ranking gains.</p>
      </div>

      <div class="phase-grid">
        <article class="phase-card">
          <p class="phase-step">Month 1</p>
          <h3>Diagnose</h3>
          <p>Review the site and UK search results, confirm analytics access and agree the priority pages. Identify fixes your developer needs to schedule.</p>
        </article>
        <article class="phase-card">
          <p class="phase-step">Months 2–3</p>
          <h3>Fix &amp; build</h3>
          <p>Release approved technical and page changes, review British English copy and begin agreed outreach. Check the live pages after implementation.</p>
        </article>
        <article class="phase-card">
          <p class="phase-step">Months 4–6</p>
          <h3>Momentum</h3>
          <p>Compare query and landing-page performance with the baseline. Check enquiries where tracking is reliable and revisit priorities where the work has not helped.</p>
        </article>
        <article class="phase-card">
          <p class="phase-step">Months 7–12</p>
          <h3>Review the next phase</h3>
          <p>Review coverage, competing pages and changes in the offer. Decide whether to expand the campaign or concentrate on unresolved problems.</p>
        </article>
      </div>
      <p class="grid-note">Reporting should show completed changes, dated search comparisons and decisions still needed from your team. Discuss any dashboard requirements alongside the <a href="/seo-command-centre/">SEO Command Centre</a> scope.</p>
    </div>
  </section>

  <section class="section dark" id="pricing">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Pricing, honestly</p>
        <h2>How much do SEO services <span>cost in the UK?</span></h2>
        <p>The proposal sets out the GBP fee and the work it covers. These campaign types need different information before we can recommend a scope.</p>
      </div>

      <div class="price-table">
        <div class="price-row price-head">
          <span>Campaign type</span><span>Scope to agree</span><span>Information needed</span>
        </div>
        <div class="price-row">
          <span>Local &amp; small business SEO</span><span>Service-area review</span><span>Actual service boundaries, existing pages and Business Profile eligibility.</span>
        </div>
        <div class="price-row">
          <span>SME / national campaigns</span><span>Priority-page programme</span><span>Products or services to prioritise, competitors and implementation capacity.</span>
        </div>
        <div class="price-row">
          <span>B2B &amp; mid-market</span><span>Buyer and content research</span><span>Decision-makers, sales questions and subject experts available for review.</span>
        </div>
        <div class="price-row">
          <span>Enterprise</span><span>Cross-team delivery plan</span><span>Regional ownership, approvals, technical dependencies and reporting requirements.</span>
        </div>
      </div>

      <div class="two-col pricing-cols">
        <div>
          <h3>What changes the price</h3>
          <ul class="tick-list">
            <li>How competitive your niche is on google.co.uk</li>
            <li>Site size and accumulated technical debt</li>
            <li>Content volume needed to close the gap</li>
            <li>Your authority deficit versus ranking competitors</li>
            <li>Local, national or international scope</li>
          </ul>
        </div>
        <div>
          <h3>What to bring to the scoping discussion</h3>
          <p>Send your website, priority products or services, target locations and the people available to review and implement changes. We use those details to separate essential fixes from later expansion.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section darker" id="choose">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Buyer's guide</p>
        <h2>How to choose an SEO agency <span>in the UK</span></h2>
        <p>Compare the proposed work, evidence and handover arrangements across your shortlist. These questions help reveal responsibilities that a fee alone cannot explain.</p>
      </div>

      <div class="choose-grid">
        <article class="choose-card"><span class="choose-num">1</span><h3>Demand named humans</h3><p>Ask who researches, writes, implements and reviews the work. Confirm which decisions need your approval and who answers technical questions.</p></article>
        <article class="choose-card"><span class="choose-num">2</span><h3>Ask for numbers, not adjectives</h3><p>Ask for the starting point, comparison period, source and metric definition. Check what a case establishes and what information is unavailable.</p></article>
        <article class="choose-card"><span class="choose-num">3</span><h3>Keep your own accounts</h3><p>GA4, Search Console and your website should live in your name. Walk away from any provider that insists on owning your data or access.</p></article>
        <article class="choose-card"><span class="choose-num">4</span><h3>Interrogate the links</h3><p>Ask for examples of proposed publications and directories, the reason each is relevant and any placement costs or editorial conditions.</p></article>
        <article class="choose-card"><span class="choose-num">5</span><h3>Treat guarantees as red flags</h3><p>No provider controls rankings. Ask what will be delivered and how progress will be reviewed instead of accepting a guaranteed position.</p></article>
        <article class="choose-card"><span class="choose-num">6</span><h3>Read the exit terms</h3><p>Check the notice period, ownership of commissioned work, account access and handover arrangements before signing.</p></article>
      </div>
      <p class="grid-note">Use the same checks when reviewing our proposal and ask us to clarify anything that affects delivery.</p>
    </div>
  </section>

  <section class="section dark" id="ai-search">
    <div class="container two-col">
      <div>
        <p class="eyebrow">AI search &amp; GEO</p>
        <h2>Check the information <span>AI answers use about your business</span></h2>
        <p class="lead">We check whether a prospective customer can find a clear answer about your service, product or location. The same approved facts should be available on the website and in the pages used for AI-search monitoring.</p>
        <p>Fintech pages need clear eligibility, product limitations and integration details. We work from information your team approves. <a href="/case-studies/ai-fintech-saas-geo/">Read the related fintech AI-search review</a>.</p>
      </div>
      <div class="timezone-card">
        <h3>What an AI-search review covers</h3>
        <ul>
          <li><strong>Referral sources</strong>: identifiable visits from AI platforms, reported separately from organic search</li>
          <li><strong>Answer samples</strong>: agreed questions, platforms and observation dates</li>
          <li><strong>Completed actions</strong>: verify the event and destination before counting an enquiry</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section darker" id="industries">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Sector experience</p>
        <h2>Specialist SEO for <span>your industry</span></h2>
        <p>A product comparison, a property listing and a local service page answer different buying questions. These specialist services explain the relevant page work.</p>
      </div>

      <div class="industry-grid">
        <article class="card"><h3><a href="/football-soccer-seo-services/">Football &amp; sports</a></h3><p>For club-management software, explain team administration, fixtures and reporting separately, with a clear path to try the product.</p></article>
        <article class="card"><h3><a href="/home-services-seo/">Home services &amp; trades</a></h3><p>Enquiry-driven SEO for the firms UK homeowners search for first: heating, electrics, roofing, clearance and more.</p></article>
        <article class="card"><h3><a href="/real-estate-seo-services/">Property &amp; real estate</a></h3><p>Listings visibility, local landing pages and authority building for agents, portals and property platforms.</p></article>
        <article class="card"><h3><a href="/finance-crypto-seo-services/">Finance &amp; fintech</a></h3><p>Finance content needs approved claims, named expertise and product limitations. Your compliance team reviews regulated statements; SEO work does not establish regulatory approval.</p></article>
        <article class="card"><h3><a href="/gaming-seo-services/">Gaming</a></h3><p>Search strategies for gaming brands competing in fast-moving, content-hungry UK niches.</p></article>
        <article class="card"><h3><a href="/pet-seo-services/">Pets</a></h3><p>Product information, stock and delivery pages for pet stores; location and booking details for service businesses.</p></article>
      </div>
      <p class="grid-note">Our published portfolio also spans fitness equipment, bridal, self-storage, boiler spares, consulting and more: browse <a href="/case-studies/">all case studies</a>.</p>
    </div>
  </section>

  <section class="section dark" id="team">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Who does the work</p>
        <h2>Named SEO specialists, <span>not an anonymous back office</span></h2>
        <p class="lead">Your proposal identifies delivery responsibilities and the approvals needed from your team. Meet the people who lead the work below.</p>
        <p>Bright Forge SEO was founded by Ben Lowe together with co-founder Sassin Lowe. Campaigns are delivered by our team in Quezon City, Philippines, with Jani A. Cañonero as Head of Team and Jewe O. Manalo as an SEO specialist. Ben leads strategy and senior review. Meet everyone on our <a href="/about-us/">about us page</a>, or see the scope of our <a href="/seo-services-philippines/">SEO services in the Philippines</a>.</p>
      </div>
      <div class="timezone-card">
        <h3>Accountability you can check</h3>
        <ul>
          <li><strong>Named team</strong>: biographies and responsibilities you can review</li>
          <li><strong>Clients across the UK, US and beyond</strong>: ecommerce, SaaS, local businesses and major corporations</li>
          <li><strong>Published case studies</strong>: project scope and source comparisons to inspect</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section darker" id="timezone">
    <div class="container two-col">
      <div>
        <p class="eyebrow">The practical stuff</p>
        <h2>The time difference is <span>an advantage, not a problem</span></h2>
        <p class="lead">Manila is eight hours ahead of GMT and seven ahead of BST. We agree a useful overlap between your morning and our late afternoon.</p>
        <p>Send the brief, access and approval requirements before the agreed delivery window. We return completed work or questions at the scheduled checkpoint.</p>
      </div>
      <div class="timezone-card">
        <h3>A typical working day</h3>
        <ul>
          <li><strong>9:00 UK</strong>: 17:00 Manila on GMT or 16:00 on BST</li>
          <li><strong>Delivery window</strong>: research, implementation and QA follow the agreed scope</li>
          <li><strong>Review checkpoint</strong>: deliverables reviewed, questions answered, next steps agreed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section dark" id="uk-cities">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">Across the UK</p>
        <h2>SEO for businesses in <span>every major UK city</span></h2>
        <p>We can scope campaigns for businesses across England, Scotland, Wales and Northern Ireland. The location pages should reflect real service coverage, not a list of cities added for rankings. Delivery remains based in the Philippines.</p>
      </div>

      <div class="cities-grid">
