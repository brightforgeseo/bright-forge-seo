---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';
import { seoServicesHreflangs } from '../data/internationalSeoPages.js';

const faqs = [
  {
    question: 'Why would a UK business use an SEO agency in the Philippines?',
    answer: 'Two reasons: senior SEO delivery and sensible pricing. UK agency retainers often start at £1,500 to £3,000 a month before much hands-on work happens. We deliver the same strategy, technical work, content direction and reporting from the Philippines, so more of your budget goes into actual SEO instead of agency overheads. Several of our longest-standing clients are UK businesses.'
  },
  {
    question: 'Do you understand the UK market and UK search results?',
    answer: 'Yes. We have run campaigns for UK ecommerce brands, SaaS products, auction platforms and service businesses. That means working daily with google.co.uk results, UK buyer language, UK competitors and UK-specific SERP features. Our case studies include Speediance UK and long-term partnerships with UK platforms such as UK Auction List and TeamStats.'
  },
  {
    question: 'How do the time zones work between the UK and the Philippines?',
    answer: 'The Philippines is 7 to 8 hours ahead of the UK. Our afternoon overlaps with your morning, so calls are easy to schedule, and work we complete during our day is ready in your inbox when you start yours. Most clients find the overlap works better than they expected.'
  },
  {
    question: 'Can you invoice in pounds?',
    answer: 'We can agree pricing in GBP so your costs are predictable, and we accept international bank transfer and card payments. There are no surprise conversion fees baked into the retainer.'
  },
  {
    question: 'Will my content be written in British English?',
    answer: 'Yes. Content for UK campaigns is written and edited in British English — optimisation, not optimization — with UK spelling, terminology, and buyer language. AI-assisted drafts always go through human editorial review before anything is delivered.'
  },
  {
    question: 'Can you build links from UK websites?',
    answer: 'Link relevance matters for country rankings, so for UK campaigns we prioritise UK-relevant link opportunities: UK publications, industry directories, supplier and partner sites, and digital PR angles that make sense to a UK audience. We do not sell spam link packages.'
  },
  {
    question: 'Do you work with UK agencies as well as businesses?',
    answer: 'Yes. Alongside direct campaigns we provide white label SEO for UK agencies that need reliable behind-the-scenes fulfilment. See our white label SEO page for how that partnership model works.'
  },
  {
    question: 'What results have you achieved for UK clients?',
    answer: 'Our published case studies include Speediance UK (fitness ecommerce), a UK car auction platform, and a UK football team management app, covering organic traffic growth, ranking recoveries and revenue-focused SEO. We are happy to walk you through the details on a call.'
  }
];
---

<MainLayout
  title="SEO Services UK | UK SEO Agency Support | Bright Forge SEO"
  description="SEO services for UK businesses from a senior Philippines-based team. Technical SEO, content, links and reporting for google.co.uk rankings — without London agency pricing."
  canonical="https://brightforge.com.ph/seo-services-uk/"
  type="service"
  faqs={faqs}
  hreflangs={seoServicesHreflangs}
  geoRegion="GB"
  geoPlacename="United Kingdom"
  contentLanguage="en-GB"
>
  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-globe-europe"
    badgeText="SEO for UK Businesses"
    title="SEO Services for UK Businesses That Want <span>Rankings Without London Retainer Prices</span>"
    breadcrumbCurrent="SEO Services UK"
  >
    <Fragment slot="story">
      <p>We help UK ecommerce brands, SaaS products and service businesses grow their visibility on google.co.uk with senior technical SEO, content strategy, UK-relevant link building and clear reporting.</p>
      <p>Bright Forge is based in the Philippines, and that is exactly why UK clients work with us: the same strategic depth you would get from a good UK agency, at a price that leaves budget for the work itself.</p>
      <p>Some of our longest client relationships are with UK businesses — including partnerships running for more than three years.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Get a UK SEO Proposal" />
      <ButtonSecondary href="#uk-results" text="See UK Client Results" />
    </Fragment>

    <Fragment slot="visual">
      <div class="market-visual" aria-label="UK SEO campaign snapshot">
        <div class="market-node">
          <span>Your market</span>
          <strong>google.co.uk, UK buyers, UK competitors</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node forge">
          <span>Your SEO team</span>
          <strong>Senior delivery from the Philippines</strong>
        </div>
        <div class="market-line"></div>
        <div class="market-node">
          <span>Your advantage</span>
          <strong>Work done overnight, ready each UK morning</strong>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="proof-strip" aria-label="UK SEO proof points">
    <div class="container">
      <div class="proof-grid">
        <div><strong>UK clients since 2021</strong><span>Multi-year partnerships</span></div>
        <div><strong>British English content</strong><span>Written for UK buyers</span></div>
        <div><strong>Morning call overlap</strong><span>PH afternoon = UK morning</span></div>
        <div><strong>GBP pricing available</strong><span>Predictable monthly costs</span></div>
      </div>
    </div>
  </section>

  <section class="section dark" id="why-us">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Why UK businesses choose us</p>
        <h2>Senior SEO delivery, <span>without the UK agency overhead</span></h2>
        <p class="lead">A good UK agency and Bright Forge do the same work: audits, technical fixes, content strategy, links, reporting. The difference is what a pound buys.</p>
        <p>UK retainers carry London offices, account layers and sales teams. Ours carry senior SEO time. That is the honest trade, and it is why UK businesses have stayed with us for years rather than months.</p>
      </div>
      <div class="card-grid small">
        <article class="card"><h3>Ecommerce brands</h3><p>Category and product page SEO, technical health, and content that captures UK buying intent.</p></article>
        <article class="card"><h3>SaaS and platforms</h3><p>Feature and comparison pages, content clusters, and authority building for competitive UK software terms.</p></article>
        <article class="card"><h3>Service businesses</h3><p>Service and location page strategy for UK firms that win work through enquiries, not footfall.</p></article>
        <article class="card"><h3>UK agencies</h3><p>White label SEO fulfilment under your brand — see our <a href="/white-label-seo-services-philippines/">white label SEO services</a>.</p></article>
      </div>
    </div>
  </section>

  <section class="section darker" id="uk-results">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">UK client results</p>
        <h2>We are already ranking <span>UK businesses</span></h2>
        <p>These are published case studies from real UK campaigns, not stock claims.</p>
      </div>

      <div class="results-grid">
        <article class="result-card">
          <p class="result-tag">Fitness Ecommerce</p>
          <h3>Speediance UK</h3>
          <p>SEO campaign for a smart home gym brand competing in the UK fitness equipment market.</p>
          <a href="/case-studies/speediance-uk-fitness-seo/">Read the case study →</a>
        </article>
        <article class="result-card">
          <p class="result-tag">Auction Platform</p>
          <h3>UK Car Auction Platform</h3>
          <p>Long-term SEO partnership with a UK auction listings platform, running for over 18 months.</p>
          <a href="/case-studies/car-auction-seo/">Read the case study →</a>
        </article>
        <article class="result-card">
          <p class="result-tag">Sports SaaS</p>
          <h3>UK Football Team App</h3>
          <p>Organic growth campaign for TeamStats, a UK football team management application.</p>
          <a href="/case-studies/football-app-seo/">Read the case study →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section dark" id="services">
    <div class="container">
      <div class="section-head centered">
        <p class="eyebrow">What we deliver</p>
        <h2>Full-service <span>SEO for the UK market</span></h2>
        <p>Every campaign is built around your market, your competitors and your commercial goals — not a fixed task list.</p>
      </div>

      <div class="service-grid">
        <article class="service-card"><i class="fas fa-search"></i><h3>SEO audits</h3><p>Technical, content and authority diagnosis against your real UK competitors, with prioritised fixes.</p></article>
        <article class="service-card"><i class="fas fa-sitemap"></i><h3>Technical SEO</h3><p>Crawlability, indexation, site speed, schema and structure — the foundations UK rankings are built on.</p></article>
        <article class="service-card"><i class="fas fa-pen-nib"></i><h3>UK content SEO</h3><p>British English content mapped to UK search demand, buyer language and commercial intent.</p></article>
        <article class="service-card"><i class="fas fa-link"></i><h3>UK link building</h3><p>Relevance-led links from UK publications, directories and industry sites. No spam packages.</p></article>
        <article class="service-card"><i class="fas fa-key"></i><h3>Keyword research</h3><p>UK search demand mapped to pages — including the spelling, phrasing and intent differences that matter.</p></article>
        <article class="service-card"><i class="fas fa-robot"></i><h3>AI search readiness</h3><p>Entity clarity and answer-ready structure so UK buyers find you in AI results, not just blue links.</p></article>
        <article class="service-card"><i class="fas fa-chart-line"></i><h3>Clear reporting</h3><p>Monthly reports in plain English: rankings, traffic, work completed, and what happens next.</p></article>
        <article class="service-card"><i class="fas fa-handshake"></i><h3>White label for agencies</h3><p>Behind-the-scenes fulfilment for UK agencies that need dependable SEO delivery.</p></article>
      </div>
    </div>
  </section>

  <section class="section darker" id="timezone">
    <div class="container two-col">
      <div>
        <p class="eyebrow">The practical stuff</p>
        <h2>The time difference is <span>an advantage, not a problem</span></h2>
        <p class="lead">The Philippines is 7 to 8 hours ahead of the UK. In practice that means your SEO work happens while you sleep.</p>
        <p>You brief us at the end of your day, we work through our day, and the results are waiting when you open your laptop. For calls, our afternoon lines up with your morning — no 5am meetings on either side.</p>
      </div>
      <div class="timezone-card">
        <h3>A typical working day</h3>
        <ul>
          <li><strong>9:00 UK / 17:00 PH</strong> — your morning catch-up call, our end-of-day handover</li>
          <li><strong>Overnight UK</strong> — audits, fixes, content and reporting completed in our working hours</li>
          <li><strong>Your next morning</strong> — deliverables reviewed, questions answered, next steps agreed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container narrow">
      <div class="section-head centered">
        <p class="eyebrow">UK SEO FAQs</p>
        <h2><span>Questions UK businesses ask</span> before working with us</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container narrow cta-box">
      <p class="eyebrow">Ready to talk?</p>
      <h2>Get a straight answer about <span>SEO for your UK business</span></h2>
      <p>Tell us your market, your site and what growth needs to look like. We will tell you honestly what SEO can and cannot do for you — before any money changes hands.</p>
      <div class="cta-actions">
        <a href="/contact/" class="cta-primary">Get a UK SEO Proposal</a>
        <a href="/case-studies/" class="cta-secondary">View All Case Studies</a>
      </div>
    </div>
  </section>

  <ContactSection slot="contact" />
  <Footer slot="footer" />
</MainLayout>

<style>
.container {
  width: min(1180px, calc(100% - 2rem));
  margin: 0 auto;
}

.narrow {
  width: min(900px, calc(100% - 2rem));
}

.market-visual {
  position: relative;
  display: grid;
  gap: 1.1rem;
  max-width: 480px;
  margin: 0 auto;
  padding: 1.5rem;
  border: 1px solid rgba(255, 107, 53, 0.25);
  border-radius: 28px;
  background: linear-gradient(145deg, rgba(19, 22, 39, 0.96), rgba(13, 15, 26, 0.92));
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.35);
}

.market-node {
  padding: 1.2rem;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.market-node span {
  display: block;
  color: #ff8a5c;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.35rem;
}

.market-node strong {
  display: block;
  color: #fff;
  font-size: 1.05rem;
}

.market-line {
  height: 26px;
  width: 2px;
  background: linear-gradient(#ff6b35, transparent);
  margin-left: 1.2rem;
}

.proof-strip {
  background: #0d0f1a;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding: 1.5rem 0;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}

.proof-grid div {
  padding: 1.1rem;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.proof-grid strong,
.proof-grid span {
  display: block;
}

.proof-grid strong {
  color: #fff;
  margin-bottom: 0.25rem;
}

.proof-grid span {
  color: #cfd3e6;
  font-size: 0.92rem;
}

.section {
  padding: 5.5rem 0;
}

.dark {
  background: #131627;
}

.darker {
  background: #0d0f1a;
}

.two-col {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 3rem;
  align-items: center;
}

.eyebrow {
  color: #ff8a5c;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.82rem;
  margin-bottom: 0.85rem;
}

h2 {
  color: #fff;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.05;
  margin-bottom: 1.25rem;
}

h3 {
  color: #fff;
  font-size: 1.2rem;
  margin-bottom: 0.75rem;
}

p,
li {
  color: #d0d4e8;
  line-height: 1.75;
}

.lead {
  font-size: 1.15rem;
  color: #e4e7f5;
}

.section-head {
  max-width: 820px;
  margin-bottom: 3rem;
}

.centered {
  text-align: center;
  margin-left: auto;
  margin-right: auto;
}

.card-grid,
.service-grid,
.results-grid {
  display: grid;
  gap: 1.25rem;
}

.card-grid.small {
  grid-template-columns: repeat(2, 1fr);
}

.card,
.service-card,
.result-card,
.timezone-card,
.faq-item {
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 22px;
  padding: 1.5rem;
}

.card a {
  color: #ff8a5c;
}

.service-grid {
  grid-template-columns: repeat(4, 1fr);
}

.service-card i {
  display: inline-grid;
  place-items: center;
  width: 46px;
  height: 46px;
  margin-bottom: 1rem;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff9f1c);
}

.results-grid {
  grid-template-columns: repeat(3, 1fr);
}

.result-tag {
  color: #ff8a5c;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
}

.result-card a {
  display: inline-block;
  margin-top: 0.75rem;
  color: #ff8a5c;
  font-weight: 700;
  text-decoration: none;
}

.timezone-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
}

.timezone-card ul {
  list-style: none;
  padding: 0;
  margin: 1.25rem 0 0;
}

.timezone-card li {
  position: relative;
  padding-left: 1.75rem;
  margin-bottom: 0.8rem;
}

.timezone-card li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #ff8a5c;
  font-weight: 800;
}

.faq-section {
  background: #131627;
}

.faq-list {
  display: grid;
  gap: 1rem;
}

.faq-item summary {
  cursor: pointer;
  color: #fff;
  font-weight: 700;
  font-size: 1.08rem;
}

.faq-item p {
  margin-top: 1rem;
}

.cta-section {
  padding: 5rem 0;
  background: #0d0f1a;
}

.cta-box {
  text-align: center;
  padding: 3rem;
  border-radius: 28px;
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.18), rgba(255, 159, 28, 0.08));
  border: 1px solid rgba(255, 107, 53, 0.28);
}

.cta-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

.cta-primary,
.cta-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0.85rem 1.4rem;
  border-radius: 999px;
  font-weight: 800;
  text-decoration: none;
}

.cta-primary {
  color: #0d0f1a;
  background: #fff;
}

.cta-secondary {
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.35);
}

@media (max-width: 980px) {
  .proof-grid,
  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .results-grid {
    grid-template-columns: 1fr;
  }

  .two-col {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .section {
    padding: 4rem 0;
  }

  .proof-grid,
  .service-grid,
  .card-grid.small {
    grid-template-columns: 1fr;
  }

  .cta-box {
    padding: 2rem 1.25rem;
  }
}
</style>
