---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "custom-home-builder-search-growth",
  metaTitle: "Home Builder SEO: +34% Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a custom home builder growing organic clicks by 33.8% across two 90-day periods.",
  title: "A custom home builder added 2,433 organic clicks",
  breadcrumb: "Custom Home Builder Growth",
  industry: "Custom home building",
  period: "31 May to 28 August 2026, compared with 2 March to 30 May 2026",
  lede: "Organic clicks rose from 7,201 to 9,634 across two 90-day periods. Impressions grew by a more modest 8.8%, click-through rate improved from 1.67% to 2.05%, and average position weakened from 18.0 to 24.0. We publish all four figures because the weaker blended rank is part of the result. This is an observational comparison and does not identify which queries changed.",
  evidenceImage: "/images/case-studies/custom-home-builder-search-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Search Console totals chart showing 9,634 clicks for an anonymised custom home builder.",
  metrics: [
    { value: "+33.8%", label: "Organic clicks", note: "7,201 to 9,634" },
    { value: "+2,433", label: "Additional clicks", note: "Latest 90 days" },
    { value: "1.67% → 2.05%", label: "Click-through rate", note: "Stronger click capture" },
    { value: "90 days", label: "Comparison window", note: "Two 90-day periods" }
  ],
  evidenceHeading: "More clicks alongside a weaker average position",
  evidenceIntro: "The chart shows redacted Search Console totals for 2 March to 30 May 2026 and 31 May to 28 August 2026. Clicks and impressions both rose. Because it presents totals only, it cannot show the underlying query distribution. The reported average position moved from 18.0 to 24.0. Average-position values are retained from the published comparison and are not displayed in this totals chart.",
  problemHeading: "Home-builder search splits across design, location, cost and build-stage language",
  problem: [
    "People looking for a custom builder rarely settle on one commercial phrase. They search by suburb, house style, rebuild, extension and cost. A site earns that range of searches only when it has a real page for each of them.",
    "This page reports the aggregate Search Console movement and nothing more. It does not name the builder, the site or the queries, it does not record what work was done or when, and it cannot prove which page created each extra click."
  ],
  readingHeading: "CTR improved even as blended position softened",
  reading: [
    "Clicks rose by 2,433 and impressions rose by 37,993. Click-through rate moved from 1.67% to 2.05%. Average position moved from 18.0 to 24.0.",
    "Two readings fit these numbers. A shift towards new queries could explain it: appearing for new, lower-ranked queries pulls the blended average down while adding clicks. Or rankings may have moved within the queries it already held. The totals cannot separate the two. Our next step would be to compare the same page and query groups in both periods before choosing where to intervene."
  ],
  takeaways: [
    "Judge builder SEO on clicks and enquiry quality. A single average-position headline hides too much.",
    "A weaker blended rank can sit next to more clicks when the site reaches a wider set of local and design searches.",
    "Search Console is the starting map. Page-level query work still has to follow, alongside a record of the quote requests those clicks produce."
  ],
  results: [
    { metric: "Organic clicks", before: "7,201", after: "9,634", note: "+33.8%, or 2,433 additional clicks" },
    { metric: "Impressions", before: "431,104", after: "469,097", note: "+8.8%, or 37,993 additional impressions" },
    { metric: "Average position", before: "18.0", after: "24.0", note: "Weaker blended rank; the cause is not established" },
    { metric: "Click-through rate", before: "1.67%", after: "2.05%", note: "Higher aggregate CTR; query mix is not shown" }
  ],
  boundary: "This anonymised case study reports Google Search Console organic-search data for two equal 90-day periods. The client, property, pages and queries are withheld. It records visibility and clicks, not quotes, deposits or completed builds. Search Console cannot attribute the movement to a single action, and this result is not a guarantee. It is published as a Search Console comparison: the page does not record what work was done on the site, by whom or when."
};
---
<GscCaseStudyPage data={data} />
