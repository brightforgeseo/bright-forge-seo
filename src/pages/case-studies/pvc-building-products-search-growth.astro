---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "pvc-building-products-search-growth",
  metaTitle: "Building Products SEO Case Study: 671% More Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a PVC building-products supplier growing organic clicks from 170 to 1,311 in 90 days.",
  title: "How a building-products supplier moved from 170 to 1,311 organic clicks",
  breadcrumb: "Building Products Growth",
  industry: "PVC and building products",
  period: "31 May to 28 August 2026, compared with 2 March to 30 May 2026",
  lede: "Organic clicks rose from 170 to 1,311. Impressions rose from 10,660 to 85,190 and average position improved from 21.7 to 11.2. Reported click-through rate stayed almost flat. The totals do not isolate the effect of any page or snippet change.",
  evidenceImage: "/images/case-studies/pvc-building-products-search-growth-gsc-evidence.png",
  evidenceAlt: "Redacted presentation chart of reported Search Console totals showing 1,311 clicks for an anonymised building-products supplier.",
  metrics: [
    { value: "+671%", label: "Organic clicks", note: "170 to 1,311" },
    { value: "+1,141", label: "Additional clicks", note: "Latest 90 days" },
    { value: "21.7 → 11.2", label: "Average position", note: "Improved reported aggregate position" },
    { value: "90 days", label: "Comparison window", note: "Two like-for-like periods" }
  ],
  evidenceHeading: "Higher click and impression totals across two 90-day periods",
  evidenceIntro: "The redacted presentation chart shows 170 to 1,311 clicks and 10,660 to 85,190 impressions for 2 March to 30 May versus 31 May to 28 August 2026. The case also reports a 10.5-position improvement and CTR near 1.5%; those metrics are not shown in the chart. It is not a raw account export.",
  problemHeading: "Recommended product-page checks: make specifications usable",
  problem: [
    "For a building-products supplier, review whether product pages make dimensions, profiles, finish options and suitable uses clear. Where compliance documentation is relevant, link the actual specification rather than describing a product as suitable for every job.",
    "These are recommendations, not a diagnosis of this supplier’s pages. The public case does not identify its catalogue or URLs. Confirm the actual range before creating application pages, and make pack quantities, delivery coverage and quote requirements clear for that range."
  ],
  readingHeading: "The percentage looks dramatic because the starting base was small",
  reading: [
    "Clicks rose by 1,141 from a base of 170. Impressions rose by 74,530. Average position moved from 21.7 to 11.2. CTR moved from 1.59% to 1.54%.",
    "The 671% increase starts from 170 clicks; the absolute gain is 1,141. The reported average position does not show how many queries ranked on page one or establish that every product improved. Inspect a fixed product-query set to understand that movement."
  ],
  takeaways: [
    "Link product variants to the dimensions and application information needed to choose between them.",
    "A large percentage from a small base still needs a click count next to it.",
    "Measure suitable quote requests and orders separately; extra clicks alone do not establish buyer fit or sales."
  ],
  results: [
    { metric: "Organic clicks", before: "170", after: "1,311", note: "+671%, or 1,141 additional clicks" },
    { metric: "Impressions", before: "10,660", after: "85,190", note: "+699%, or 74,530 additional impressions" },
    { metric: "Average position", before: "21.7", after: "11.2", note: "Improved by 10.5 positions" },
    { metric: "Click-through rate", before: "1.59%", after: "1.54%", note: "Slightly lower reported CTR" }
  ],
  boundary: "This anonymised case study presents reported Google Search Console totals for two equal 90-day periods. The published chart supports clicks and impressions; position and CTR are additional case-reported figures, not independently verifiable from that image. The client, property, pages and queries are withheld. It records visibility and clicks, not quotes, orders or revenue. Search Console cannot attribute the movement to a single action, and this result is not a guarantee."
};
---
<GscCaseStudyPage data={data} />
