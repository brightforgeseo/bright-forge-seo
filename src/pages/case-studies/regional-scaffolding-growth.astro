---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "regional-scaffolding-growth",
  metaTitle: "Scaffolding SEO: +20% Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing how a regional scaffolding contractor grew organic clicks by 19.7% while improving average position.",
  title: "How a regional scaffolder earned 20% more organic clicks",
  breadcrumb: "Regional Scaffolding Growth",
  industry: "Regional construction services",
  period: "Reported 90-day comparison; visual trend 6 February to 3 August 2026",
  lede: "The site earned 1,216 Google organic clicks in the latest 90 days, up from 1,016. Reported average position improved from 18.1 to 14.7 while impressions fell. These aggregate figures do not establish the quality of the additional traffic.",
  evidenceImage: "/images/case-studies/regional-scaffolding-growth-gsc-evidence.png",
  evidenceAlt: "Redacted presentation of reported Google Search Console performance showing 1,216 clicks and an improved average position for an anonymised regional scaffolding contractor.",
  metrics: [
    { value: "+19.7%", label: "Organic clicks", note: "1,016 to 1,216" },
    { value: "18.1 → 14.7", label: "Average position", note: "3.4-position improvement" },
    { value: "+33.8%", label: "Click-through rate", note: "0.37% to 0.50%" },
    { value: "90 days", label: "Comparison window", note: "Two like-for-like periods" }
  ],
  evidenceHeading: "More clicks, even with less total impression volume",
  evidenceIntro: "The redacted presentation visual reports 1,216 clicks, 244,153 impressions and average position 14.7. Its trend runs from 6 February to 3 August 2026, with a split at 6 May. It labels a 90-day comparison but does not provide exact comparison endpoints; those require the underlying export.",
  problemHeading: "Recommended service-page review: establish project and location fit",
  problem: [
    "For a regional scaffolder, review whether a customer can check the service radius, supported project types and information needed for a quote. Access constraints, approximate dimensions and required hire dates help explain a project before a site assessment.",
    "These are recommendations, not a record of work completed on the anonymous site. No project types or customer locations are disclosed, so the comparison cannot establish whether the additional clicks came from suitable construction enquiries."
  ],
  readingHeading: "Higher reported CTR does not explain which searches changed",
  reading: [
    "Reported average position improved by 3.4 places and CTR increased from 0.37% to 0.50%. The 33.8% relative CTR increase is calculated from the reported click and impression totals before rounding the displayed rates. It is not proof of better snippets or improved rank for the same queries.",
    "Impressions fell 10.6% while clicks rose by 200. A change in query mix is one possible explanation, alongside changes within existing queries. Compare the same regional and project-related query groups before attributing the movement to a particular page change."
  ],
  takeaways: [
    "Separate suitable project enquiries from job applications, supplier contact and out-of-area requests when assessing commercial value.",
    "Make service coverage and quote requirements clear; do not infer customer suitability from an impression or click total.",
    "A 90-day comparison is a starting point for diagnosis, not a revenue claim or a ranking guarantee."
  ],
  results: [
    { metric: "Organic clicks", before: "1,016", after: "1,216", note: "+19.7%, or 200 additional clicks" },
    { metric: "Impressions", before: "272,961", after: "244,153", note: "-10.6% total impressions; query mix not shown" },
    { metric: "Average position", before: "18.1", after: "14.7", note: "Improved by 3.4 positions" },
    { metric: "Click-through rate", before: "0.37%", after: "0.50%", note: "Approximately +33.8%, calculated before rate rounding" }
  ],
  boundary: "This case presents a redacted visual and reported Google Search Console comparison values. The visual shows the latest click, impression and position totals and their changes, but not every previous-period value or CTR. The table preserves the reported comparison; it is not an independently authenticated raw export. It does not reveal the client, property, queries or commercial data, and it does not claim that any one activity caused the result. Search performance is not a guarantee of future leads, sales or rankings."
};
---
<GscCaseStudyPage data={data} />
