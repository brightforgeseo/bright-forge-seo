---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/ContactSection.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/case-studies/bridal-dress-designer-seo/";
const image = "/images/case-studies/bridal-dress-seo.webp";

const metrics = [
  {
    label: "Organic clicks",
    before: "7.41k",
    after: "17.6k",
    change: "+137.5%",
    note: "Organic clicks in the last three months compared with the same period a year earlier. The figures are rounded."
  },
  {
    label: "Impressions",
    before: "342k",
    after: "746k",
    change: "+118.1%",
    note: "Recorded search impressions more than doubled. The screenshot does not show which queries gained visibility."
  },
  {
    label: "Average position",
    before: "24.8",
    after: "14.9",
    change: "9.9 positions",
    note: "The blended average improved from 24.8 to 14.9. It does not show how many queries ranked on any particular results page."
  },
  {
    label: "CTR",
    before: "2.2%",
    after: "2.4%",
    change: "+0.2pp",
    note: "The displayed CTR rose by 0.2 percentage points alongside the higher impression total."
  }
];

const workstreams = [
  {
    title: "Commercial intent mapping",
    text: "Separate dress inspiration, designer comparisons and local appointment searches in the query report. Each may need a different destination."
  },
  {
    title: "Page relevance improvements",
    text: "Check that collection pages identify the designers and dress styles available, and link to the information a customer needs before booking."
  },
  {
    title: "Gallery and image SEO checks",
    text: "Keep dress photography, but check loading speed, descriptive alt text and crawlable collection details. A gallery should help customers identify the dress and the next step."
  },
  {
    title: "Structured data and page trust signals",
    text: "Match structured data to the visible business and dress information. Check location, opening details and appointment links for consistency."
  },
  {
    title: "Long-tail content and internal linking",
    text: "Use actual customer questions and query data to decide whether dress-style guidance is needed. Link relevant guidance to the collections and appointment information it supports."
  }
];

const lessons = [
  "Bridal SEO needs to separate inspiration traffic from commercial research. Both can matter, but they do not deserve the same pages or the same success metrics.",
  "An average-position improvement does not identify which collections or queries improved. Review those rows before choosing the next page to work on.",
  "More clicks only become a commercial result when they lead to useful enquiries, appointments or sales. Measure those separately from search visibility.",
  "Image-led ecommerce pages need more than attractive photography. Search engines still need crawlable context, useful copy, internal links and clear page purpose."
];

const faqs = [
  {
    question: "What does the bridal Search Console comparison show?",
    answer: "Clicks rose from 7.41k to 17.6k and impressions from 342k to 746k. The screenshot compares the last three months with the same period last year. It does not document the implementation history."
  },
  {
    question: "Does this show growth over three consecutive months?",
    answer: "No. It compares a three-month total with the same period a year earlier, not with the immediately preceding three months. Impressions, displayed CTR and average position all improved, but the totals do not isolate the cause."
  },
  {
    question: "Is moving from position 24.8 to 14.9 enough to matter?",
    answer: "It is a 9.9-position improvement in the blended average. That does not mean every query moved by 9.9 positions, or establish how many terms reached the first page. The query and page reports are needed for that assessment."
  },
  {
    question: "What SEO work matters most for bridal retailers and designers?",
    answer: "Bridal SEO usually needs strong collection pages, clear dress style coverage, useful buyer guidance, optimised imagery, structured data, internal links and page copy that matches how brides research before booking or buying."
  },
  {
    question: "Should bridal brands focus on blogs or commercial pages first?",
    answer: "Commercial pages should usually come first. Blog and guide content can support the journey, but dress collections, designer pages, appointment pages and high-intent buying pages normally carry the clearest business value."
  },
  {
    question: "Does Bright Forge guarantee the same result for other bridal brands?",
    answer: "No. Results depend on the market, starting position, site quality, product range, competition and how much can be improved. This case study shows the type of diagnostic work and SEO thinking involved, not a guaranteed outcome."
  }
];

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Bridal Dress SEO Case Study",
  description: "Emily Bridalwear Search Console comparison: higher clicks and impressions and improved average position versus the same three-month period a year earlier.",
  image: `https://brightforge.com.ph${image}`,
  author: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    url: "https://brightforge.com.ph/"
  },
  publisher: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    logo: {
      "@type": "ImageObject",
      url: "https://brightforge.com.ph/images/header-logo-360w.webp"
    }
  },
  mainEntityOfPage: canonical,
  articleSection: "SEO Case Studies",
  about: ["Bridal SEO", "Ecommerce SEO", "Content SEO", "On-page SEO", "Image SEO"]
};
---

<MainLayout
  title="Bridal Dress SEO Case Study | Bright Forge"
  description="Emily Bridalwear recorded 7.41k to 17.6k organic clicks in a year-on-year three-month comparison. See the search figures and bridal-page review priorities."
  canonical={canonical}
  image={image}
  type="article"
  author={{ name: "Bright Forge SEO", url: "https://brightforge.com.ph/" }}
  article={{ section: "SEO Case Studies", tags: ["Bridal SEO", "Ecommerce SEO", "Content SEO", "Case Study"] }}
  breadcrumbs={[
    { name: "Home", url: "https://brightforge.com.ph/" },
    { name: "Case Studies", url: "https://brightforge.com.ph/case-studies/" },
    { name: "Bridal Dress SEO", url: canonical }
  ]}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    title="Emily Bridalwear <span>SEO Case Study</span>"
    breadcrumbCurrent="Emily Bridalwear"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span>Bridal fashion</span>
        <span>Ecommerce and appointments</span>
        <span>Last 3 months versus Same period last year</span>
      </div>
      <p class="hero-subtitle">Emily Bridalwear recorded about 137.5% more organic clicks than in the same three-month period a year earlier.</p>
      <p>Emily Bridalwear is a Sheffield bridal shop. Live site: <a href="https://www.emilybridalwear.co.uk/" rel="noopener">emilybridalwear.co.uk</a>. The comparison shows higher clicks and impressions, alongside an improved average position. It does not identify which dress searches contributed or whether the extra clicks led to appointments.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Results" />
      <ButtonSecondary href="/contact/" text="Request an SEO Review" />
    </Fragment>
  </Hero>

  <main class="case-study-page">
    <section class="proof-strip" aria-label="Case study summary metrics">
      <div class="case-container">
        <div class="proof-grid">
          {metrics.map((metric) => (
            <article class="proof-card">
              <span class="proof-label">{metric.label}</span>
              <strong>{metric.change}</strong>
              <span>{metric.before} to {metric.after}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-section">
      <div class="case-container overview-grid">
        <div>
          <p class="eyebrow">The short version</p>
          <h2>Better <span>visibility</span> during the bridal research window</h2>
          <p>The earlier three-month window recorded 7.41k clicks, 342k impressions and an average position of 24.8. The screenshot supplies an aggregate comparison, not a ranking distribution or a breakdown of bridal buying intent.</p>
          <p>In the last three months shown, clicks reached 17.6k, impressions 746k and average position 14.9. The reported 137.5% click increase is approximate; rounded screenshot totals should not be treated as exact underlying counts.</p>
        </div>
        <aside class="case-summary-card">
          <h3>Campaign snapshot</h3>
          <dl>
            <div><dt>Industry</dt><dd>Bridal fashion and dress retail</dd></div>
            <div><dt>Market type</dt><dd>Image-led ecommerce and appointments</dd></div>
            <div><dt>Timeframe</dt><dd>Last 3 months versus Same period last year</dd></div>
            <div><dt>Main KPI</dt><dd>Organic clicks from Google Search</dd></div>
            <div><dt>Recommended review</dt><dd>Collection information, imagery, local appointment searches and internal links</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="visual-proof-section">
      <div class="case-container">
        <div class="case-image-card">
          <img src={image} alt="Google Search Console performance comparison for a bridal dress designer SEO campaign" loading="eager" decoding="async" />
        </div>
        <p class="image-note">Search Console metrics used in this case study: 7.41k to 17.6k clicks, 342k to 746k impressions, average position 24.8 to 14.9 and CTR 2.2% to 2.4%. The selector is Last 3 months versus Same period last year. Exact calendar dates and country/device filters are not visible.</p>
      </div>
    </section>

    <section class="content-section" id="challenge">
      <div class="case-container two-column">
        <div>
          <p class="eyebrow">Starting problem</p>
          <h2>Bridal pages need to distinguish <span>dress research</span> from booking a visit</h2>
        </div>
        <div class="section-copy">
          <p>Bridal dress SEO has a difficult mix of intent. Some searches are early inspiration. Some are style research. Some come from shoppers comparing designers, boutiques or appointment options. Treating all of those searches as the same opportunity leads to vague pages and wasted effort.</p>
          <p>A review should check whether a customer can move from a dress or designer page to the shop location and appointment details. Those checks are relevant to bridal retail, but this screenshot does not prove they were implemented.</p>
        </div>
      </div>
    </section>

    <section class="constraints-section">
      <div class="case-container">
        <p class="eyebrow">Constraints</p>
        <h2>Why bridal SEO needs more than <span>pretty pages</span> and generic content</h2>
        <div class="constraint-grid">
          <article>
            <h3>Mixed buyer intent</h3>
            <p>Brides search across inspiration, dress styles, designers, prices, locations and appointment intent. A page review should account for those differences.</p>
          </article>
          <article>
            <h3>Image-heavy pages</h3>
            <p>Strong photography helps users, but search engines still need useful text, alt context, fast loading and clear page structure.</p>
          </article>
          <article>
            <h3>Competitive commercial terms</h3>
            <p>Compare the results for specific dress and local-shop searches before deciding whether a collection page, location page or guide is the right fit.</p>
          </article>
          <article>
            <h3>Short comparison window</h3>
            <p>The two three-month windows are a year apart. The comparison is useful, but it does not isolate changes in demand, competitors or the site itself.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="case-container">
        <div class="section-header">
          <p class="eyebrow">Recommended bridal-page checks</p>
          <h2>Review <span>collection information</span>, imagery and the appointment path</h2>
          <p>The checks below are recommendations for an image-led bridal site, not a verified list of changes delivered during this comparison. Start with the actual collections, customer questions and appointment process.</p>
        </div>
        <div class="work-list">
          {workstreams.map((item, index) => (
            <article class="work-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="results-section" id="results">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">What moved</p>
          <h2>Clicks and impressions grew while <span>average position</span> improved by 9.9 positions</h2>
          <p>Clicks and impressions more than doubled, and the blended average position improved. A fixed set of pages and queries would be needed to separate ranking changes from changes in the search mix.</p>
        </div>
        <div class="result-grid">
          {metrics.map((metric) => (
            <article class="result-card">
              <div class="result-topline">
                <span>{metric.label}</span>
                <strong>{metric.change}</strong>
              </div>
              <div class="before-after">
                <div><span>Before</span><strong>{metric.before}</strong></div>
                <div><span>After</span><strong>{metric.after}</strong></div>
              </div>
              <p>{metric.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="commercial-section">
      <div class="case-container commercial-card">
        <div>
          <p class="eyebrow">Commercial meaning</p>
          <h2>The next question is whether <span>search clicks</span> led to appointments</h2>
          <p>Bridal purchases are high-consideration decisions. Searchers compare styles, designers, locations, galleries and appointment options before they commit. Collection details and a clear appointment route can help them decide whether to visit.</p>
          <p>The search totals do not prove appointments, sales or revenue. To assess commercial value, review which landing pages received the additional clicks and compare them with measured appointment enquiries.</p>
        </div>
        <div class="meaning-points">
          <article><strong>Higher search exposure</strong><span>Recorded impressions increased from 342k to 746k.</span></article>
          <article><strong>Improved blended position</strong><span>The aggregate average moved from 24.8 to 14.9.</span></article>
          <article><strong>Appointment measurement</strong><span>Check whether collection-page visits lead to useful enquiries.</span></article>
        </div>
      </div>
    </section>

    <section class="lessons-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Lessons for similar businesses</p>
          <h2>What bridal and <span>fashion ecommerce brands</span> should take from this</h2>
        </div>
        <div class="lesson-grid">
          {lessons.map((lesson) => (
            <article>
              <p>{lesson}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="related-services-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Relevant services</p>
          <h2>Where this work connects to Bright Forge <span>SEO services</span></h2>
        </div>
        <div class="service-link-grid">
          <a href="/content-seo-services-philippines/">
            <span>Content SEO</span>
            <p>Dress style, collection and buying-intent content shaped around how customers actually search.</p>
          </a>
          <a href="/on-page-seo-services-philippines/">
            <span>On-page SEO</span>
            <p>Titles, headings, internal links and page copy that make relevance clearer on commercial pages.</p>
          </a>
          <a href="/technical-seo-services-philippines/">
            <span>Technical SEO</span>
            <p>Speed, crawlability, structured data and image-led page checks for ecommerce and catalogue sites.</p>
          </a>
          <a href="/seo-services-philippines/">
            <span>SEO services</span>
            <p>Senior SEO strategy for businesses that need commercial visibility, not just more content volume.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="case-container faq-layout">
        <div>
          <p class="eyebrow">Questions this case study should answer</p>
          <h2><span>Bridal dress SEO</span> case study FAQs</h2>
          <p>Useful case studies should explain the work, the limits and the meaning behind the metrics.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="case-cta-section">
      <div class="case-container case-cta-card">
        <p class="eyebrow">Selling products where visuals and search intent both matter?</p>
        <h2>We can inspect the pages, queries and technical signals limiting <span>organic growth</span>.</h2>
        <p>If your ecommerce or appointment-led site has strong products but uneven search visibility, start with a focused SEO review. We will look at Search Console data, page relevance, crawlability, image-led page quality and the work most likely to move the campaign forward.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Request an SEO Review" />
          <ButtonSecondary href="/case-studies/" text="View More Case Studies" />
        </div>
      </div>
    </section>
  </main>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.case-study-page,
.case-study-page * {
  box-sizing: border-box;
}

.case-study-page {
  background: #ffffff;
  color: #19212e;
}

.case-container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

.case-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.case-meta span {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 7px 12px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: #19212e;
  font-size: 0.88rem;
  font-weight: 700;
}

.hero-subtitle {
  color: #19212e;
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.35;
  font-weight: 800;
  margin-bottom: 18px;
}

.proof-strip,
.overview-section,
.visual-proof-section,
.content-section,
.constraints-section,
.work-section,
.results-section,
.commercial-section,
.lessons-section,
.related-services-section,
.faq-section,
.case-cta-section {
  content-visibility: visible !important;
  contain-intrinsic-size: auto none !important;
}

.proof-strip {
  padding: 34px 0;
  background: #f7f8fa;
  border-top: 1px solid rgba(25, 33, 46, 0.08);
  border-bottom: 1px solid rgba(25, 33, 46, 0.08);
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.proof-card,
.result-card,
.case-summary-card,
.constraint-grid article,
.lesson-grid article,
.service-link-grid a,
.faq-item,
.case-cta-card {
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 18px 60px rgba(25, 33, 46, 0.09);
}

.proof-card {
  min-height: 154px;
  padding: 24px;
  border-radius: 22px;
}

.proof-label,
.eyebrow {
  display: block;
  color: #b83e12;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.proof-card strong {
  display: block;
  margin: 12px 0 8px;
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
}

.proof-card span:last-child {
  color: #465365;
  font-size: 0.95rem;
}

.overview-section,
.content-section,
.work-section,
.commercial-section,
.related-services-section,
.case-cta-section {
  padding: 92px 0;
  background: #ffffff;
}

.visual-proof-section,
.constraints-section,
.results-section,
.lessons-section,
.faq-section {
  padding: 92px 0;
  background: #f7f8fa;
}

.overview-grid,
.two-column,
.faq-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
  gap: clamp(32px, 6vw, 72px);
  align-items: start;
}

h2,
h3,
p {
  margin-top: 0;
}

h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.04em;
  margin-bottom: 22px;
}

h3 {
  color: #19212e;
  font-size: 1.22rem;
  line-height: 1.25;
  margin-bottom: 12px;
}

p {
  color: #465365;
  font-size: 1.04rem;
  line-height: 1.75;
  margin-bottom: 18px;
}

.case-summary-card {
  position: sticky;
  top: 110px;
  padding: 28px;
  border-radius: 24px;
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.13), rgba(255, 255, 255, 0.045));
}

.case-summary-card dl {
  margin: 0;
}

.case-summary-card div {
  padding: 14px 0;
  border-bottom: 1px solid rgba(25, 33, 46, 0.09);
}

.case-summary-card div:last-child {
  border-bottom: 0;
}

.case-summary-card dt {
  color: #465365;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
  margin-bottom: 5px;
}

.case-summary-card dd {
  color: #19212e;
  margin: 0;
  font-weight: 700;
}

.case-image-card {
  overflow: hidden;
  border-radius: 26px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: #ffffff;
  box-shadow: 0 24px 80px rgba(25, 33, 46, 0.09);
}

.case-image-card img {
  display: block;
  width: 100%;
  height: auto;
  background: #ffffff;
}

.image-note {
  max-width: 820px;
  margin: 18px auto 0;
  text-align: center;
  color: #465365;
  font-size: 0.95rem;
}

.section-copy p:last-child,
.case-cta-card p:last-child {
  margin-bottom: 0;
}

.constraint-grid,
.result-grid,
.lesson-grid,
.service-link-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 34px;
}

.constraint-grid article,
.lesson-grid article,
.service-link-grid a {
  border-radius: 24px;
  padding: 28px;
}

.constraint-grid p,
.lesson-grid p,
.service-link-grid p {
  margin-bottom: 0;
}

.section-header {
  max-width: 840px;
  margin-bottom: 40px;
}

.section-header.compact {
  margin-bottom: 30px;
}

.work-list {
  display: grid;
  gap: 18px;
}

.work-item {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 24px;
  padding: 28px;
  border-radius: 24px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
}

.work-item > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: #f0622a;
  color: #19212e;
  font-weight: 900;
}

.work-item p {
  margin-bottom: 0;
}

.result-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.result-card {
  border-radius: 24px;
  padding: 24px;
}

.result-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 22px;
}

.result-topline span {
  color: #465365;
  font-weight: 800;
}

.result-topline strong {
  color: #b83e12;
  font-size: 1.5rem;
  white-space: nowrap;
}

.before-after {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}

.before-after div {
  padding: 14px;
  border-radius: 16px;
  background: rgba(25, 33, 46, 0.09);
}

.before-after span {
  display: block;
  color: #465365;
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.before-after strong {
  color: #19212e;
  font-size: 1.25rem;
}

.result-card p {
  color: #465365;
  font-size: 0.95rem;
  line-height: 1.6;
