---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/case-studies/football-app-seo/";
const image = "/images/case-studies/football-app-seo-case-study.webp";
const metrics = [
  {
    "label": "Organic clicks",
    "before": "200k",
    "after": "268k",
    "change": "+34%"
  },
  {
    "label": "Impressions",
    "before": "7.14M",
    "after": "9.23M",
    "change": "+29.3%"
  },
  {
    "label": "Average position",
    "before": "11.4",
    "after": "9.1",
    "change": "+2.3 places"
  },
  {
    "label": "Average CTR",
    "before": "2.8%",
    "after": "2.9%",
    "change": "+0.1pp"
  }
];
const workstreams = [
  {
    "title": "Technical SEO foundation",
    "text": "Check which public pages Google can crawl and index before proposing changes to an app site. Private team-management screens and public discovery pages serve different purposes."
  },
  {
    "title": "Manager and coach search intent",
    "text": "Separate searches for team-management software from searches for a particular team or fixture. Review their landing pages and conversion paths separately."
  },
  {
    "title": "Internal linking and page signals",
    "text": "Check whether public feature pages link to relevant product information and a clear signup route without exposing private team information."
  },
  {
    "title": "Snippet relevance",
    "text": "Review titles and descriptions against the queries each public page actually receives, rather than assuming all football searches indicate software demand."
  },
  {
    "title": "Performance monitoring",
    "text": "Compare the same queries, pages and devices over matched periods before attributing an aggregate change to a particular intervention."
  }
];
const results = [
  {
    "metric": "Organic clicks",
    "before": "200k",
    "after": "268k",
    "change": "+34%",
    "note": "The app gained 68k extra organic clicks during the comparison period."
  },
  {
    "metric": "Impressions",
    "before": "7.14M",
    "after": "9.23M",
    "change": "+29.3%",
    "note": "Recorded impressions increased. The screenshot does not identify which queries or pages account for the change."
  },
  {
    "metric": "Average position",
    "before": "11.4",
    "after": "9.1",
    "change": "+2.3 places",
    "note": "The blended average improved by 2.3 positions. It does not show how many queries reached page one."
  },
  {
    "metric": "Average CTR",
    "before": "2.8%",
    "after": "2.9%",
    "change": "+0.1pp",
    "note": "Displayed CTR increased by 0.1 percentage points alongside higher impressions and clicks. These totals do not isolate a cause."
  }
];
const constraints = [
  {
    "title": "Aggregate data",
    "text": "The screenshot combines searches and pages. It cannot distinguish manager-acquisition searches from team or supporter visits."
  },
  {
    "title": "Year-on-year comparison",
    "text": "The comparison is with the same period last year, not the immediately preceding three months. Exact calendar dates are not displayed."
  },
  {
    "title": "Mobile expectations",
    "text": "Managers and coaches may use team tools on a phone. Mobile usability is a sensible review priority, not an outcome measured by this chart."
  },
  {
    "title": "CTR barely moved",
    "text": "CTR went from 2.8% to 2.9%, a rise of 0.1 percentage points. Clicks and impressions increased by much larger relative percentages."
  }
];
const lessons = [
  "Use query-level data to assess ranking distribution. An average of 9.1 does not establish broad page-one rankings.",
  "Higher clicks are worth investigating even when CTR changes little. Identify the pages behind the gain before choosing a follow-up.",
  "For a team-management product, distinguish people looking for software from those looking for team information.",
  "Connect search landing pages with signup and usage data before assessing customer acquisition."
];
const faqs = [
  {
    "question": "What was the main result in this football app SEO case study?",
    "answer": "Organic clicks increased from 200k to 268k, a 34% lift, comparing Last 3 months / Same period last year. Impressions grew from 7.14M to 9.23M."
  },
  {
    "question": "Did the football app reach page one?",
    "answer": "Average position improved from 11.4 to 9.1. This blended metric does not show how many queries reached page one; a query-level comparison is needed."
  },
  {
    "question": "Was CTR the main reason traffic grew?",
    "answer": "CTR moved from 2.8% to 2.9%, while impressions and clicks increased. The aggregate screenshot does not establish which campaign actions caused those changes."
  },
  {
    "question": "What SEO work matters for football apps?",
    "answer": "Review public-page crawlability, mobile usability, product information, internal links and query intent. These are recommendations, not a verified change log for this case."
  },
  {
    "question": "Can this approach work for other sports platforms?",
    "answer": "The measurement approach can be used for other sports platforms, but product searches and supporter searches need separate assessment. This result does not predict their performance."
  },
  {
    "question": "Does Bright Forge guarantee the same sports SEO result?",
    "answer": "No. Results depend on competition, authority, technical condition, content quality and user demand. This case shows a search comparison, not a promise."
  }
];
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Football App SEO Case Study",
  "description": "TeamStats recorded 34% more organic clicks in a three-month year-on-year Search Console comparison. See the figures, ranking limits and next checks.",
  "image": "https://brightforge.com.ph/images/case-studies/football-app-seo-case-study.webp",
  "author": {
    "@type": "Organization",
    "name": "Bright Forge SEO",
    "url": "https://brightforge.com.ph/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bright Forge SEO",
    "logo": {
      "@type": "ImageObject",
      "url": "https://brightforge.com.ph/images/header-logo-360w.webp"
    }
  },
  "mainEntityOfPage": "https://brightforge.com.ph/case-studies/football-app-seo/",
  "articleSection": "SEO Case Studies",
  "about": [
    "Sports SEO",
    "Technical SEO",
    "Content SEO",
    "App SEO"
  ]
};
---

<MainLayout
  title="Football App SEO Case Study | Bright Forge"
  description="TeamStats recorded 34% more organic clicks in a three-month year-on-year Search Console comparison. See the figures, ranking limits and next checks."
  canonical={canonical}
  image={image}
  type="article"
  author={{ name: "Bright Forge SEO", url: "https://brightforge.com.ph/" }}
  article={{ section: "SEO Case Studies", tags: [
  "Sports SEO",
  "Technical SEO",
  "Content SEO",
  "App SEO"
] }}
  breadcrumbs={[
    { name: "Home", url: "https://brightforge.com.ph/" },
    { name: "Case Studies", url: "https://brightforge.com.ph/case-studies/" },
    { name: "TeamStats SEO", url: canonical }
  ]}
  faqs={faqs}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} /></Fragment>
  <LegacyHeader slot="header" />
  <Hero title="TeamStats <span>SEO Case Study</span>" breadcrumbCurrent="TeamStats">
    <Fragment slot="story">
      <div class="case-meta"><span>Football team management</span><span><a href="https://www.teamstats.net/" rel="noopener">teamstats.net</a></span><span>3 months, year on year</span></div>
      <p class="hero-subtitle">TeamStats recorded 34% more organic clicks year on year, with average position improving from 11.4 to 9.1.</p>
      <p>TeamStats is a football team management app for grassroots managers and coaches, with tools for fixtures, availability, communication, statistics and finances. Its search comparison records more clicks, but does not identify which visits became app users.</p>
    </Fragment>
    <Fragment slot="actions"><ButtonPrimary href="#results" text="View Results" /><ButtonSecondary href="/contact/" text="Request an SEO Review" /></Fragment>
  </Hero>
  <main class="case-study-page">
    <section class="proof-strip"><div class="case-container"><div class="proof-grid">{metrics.map((metric) => (<article class="proof-card"><span class="proof-label">{metric.label}</span><strong>{metric.change}</strong><span>{metric.before} to {metric.after}</span></article>))}</div></div></section>
    <section class="overview-section"><div class="case-container overview-grid"><div><p class="eyebrow">The short version</p><h2><span>68k more search clicks</span> in the year-on-year comparison</h2><p>The published Search Console screenshot compares Last 3 months / Same period last year. It shows Google Search performance for TeamStats, rather than app-store downloads or paid subscriptions.</p><p>Clicks increased from 200k to 268k and impressions increased from 7.14M to 9.23M. Average position moved from 11.4 to 9.1 and CTR from 2.8% to 2.9%. The figures show a stronger aggregate search result, not the ranking distribution or the value of each visit.</p></div><aside class="case-summary-card"><h3>Comparison snapshot</h3><dl><div><dt>Industry</dt><dd>TeamStats football team management</dd></div><div><dt>Market type</dt><dd>Grassroots clubs and coaches</dd></div><div><dt>Timeframe</dt><dd>3 months, year on year</dd></div><div><dt>Main KPI</dt><dd>Organic clicks from Google Search</dd></div><div><dt>Evidence</dt><dd>Published Google Search Console comparison</dd></div></dl></aside></div></section>
    <section class="visual-proof-section"><div class="case-container"><div class="case-image-card"><img src={image} alt="Search Console comparison for TeamStats SEO" loading="eager" decoding="async" /></div><p class="image-note">Last 3 months / Same period last year. Exact calendar dates and query filters are not shown. Rounded Search Console metrics: 200k to 268k clicks, 7.14M to 9.23M impressions, average position 11.4 to 9.1 and CTR 2.8% to 2.9%.</p></div></section>
    <section class="content-section" id="challenge"><div class="case-container two-column"><div><p class="eyebrow">Product context</p><h2>A <span>team-management product</span> with more than one search audience</h2></div><div><p>A manager choosing a team app needs to understand how it handles fixtures, availability and communication. A parent or supporter looking for team news has a different task. TeamStats serves both kinds of audience; this chart does not separate them.</p><p>For an acquisition review, the useful next step is to identify the landing pages gaining clicks and connect those visits to signup data. No signup or subscription result is included here.</p></div></div></section>
    <section class="constraints-section"><div class="case-container"><p class="eyebrow">Constraints</p><h2>How to <span>read this comparison</span></h2><div class="constraint-grid">{constraints.map((item) => (<article><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section class="work-section" id="work"><div class="case-container"><p class="eyebrow">Recommendations</p><h2>What to check next for a <span>team-management app</span></h2><p>The screenshot is not a record of delivered work. These checks describe a follow-up review, not actions credited with this result.</p><div class="work-grid">{workstreams.map((item, index) => (<article class="work-item"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section class="results-section" id="results"><div class="case-container"><p class="eyebrow">What moved</p><h2>More clicks and impressions, with a better <span>average position</span></h2><div class="result-grid">{results.map((result) => (<article class="result-card"><div><span class="proof-label">{result.metric}</span><strong>{result.change}</strong></div><div class="before-after"><div><span>Same period last year</span><strong>{result.before}</strong></div><div><span>Last 3 months</span><strong>{result.after}</strong></div></div><p>{result.note}</p></article>))}</div></div></section>
    <section class="commercial-section"><div class="case-container commercial-card"><div><p class="eyebrow">Commercial meaning</p><h2>Search clicks and <span>app acquisition</span> are different measures</h2><p>The comparison shows 68k more Google Search clicks using the displayed rounded totals. It does not report app usage, signups, subscriptions or revenue.</p><p>To judge commercial value, compare product-page visits and signup activity over the same windows. Team-information traffic should not automatically be counted as software-buyer demand.</p></div><div class="case-summary-card"><h3>What matters here</h3><p>Keep the search result and the acquisition question separate: the first is visible in the chart; the second needs conversion data.</p></div></div></section>
    <section class="lessons-section"><div class="case-container"><p class="eyebrow">Lessons</p><h2>What <span>sports platforms</span> should take from this</h2><div class="lesson-grid">{lessons.map((lesson) => (<article><p>{lesson}</p></article>))}</div></div></section>
    <section class="related-services-section"><div class="case-container"><p class="eyebrow">Related services</p><h2>Where this kind of <span>work fits</span></h2><div class="service-link-grid"><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Fix crawl, structure, performance and indexation issues.</a><a href="/on-page-seo-services-philippines/"><span>On-page SEO</span>Improve page relevance, snippets and conversion paths.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Turn search intent into stronger pages and supporting content.</a></div></div></section>
    <section class="faq-section"><div class="case-container faq-layout"><div><p class="eyebrow">FAQ</p><h2>Questions this <span>case study</span> should answer</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section class="case-cta-section"><div class="case-container"><div class="case-cta-card"><h2>Want to know what is holding your <span>search traffic</span> back?</h2><p>We can review the pages, queries and technical signals that matter before recommending any rewrite, content plan or link activity.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View More Case Studies" /></div></div></div></section>
  </main>
  <Footer slot="footer" />
</MainLayout>

<style>
.case-study-page { background: #ffffff; color: #19212e; }
.case-container { width: min(100% - 40px, 1120px); margin: 0 auto; }
.case-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
.case-meta span { padding: 8px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.09); color: #465365; font-size: .86rem; font-weight: 800; }
.hero-subtitle { color: #19212e; font-weight: 900; font-size: clamp(1.15rem, 2vw, 1.45rem); }
.proof-strip, .overview-section, .visual-proof-section, .content-section, .constraints-section, .work-section, .results-section, .commercial-section, .lessons-section, .related-services-section, .faq-section, .case-cta-section { padding: 78px 0; content-visibility: visible !important; }
.proof-grid, .constraint-grid, .work-grid, .result-grid, .lesson-grid, .service-link-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
.proof-card, .case-summary-card, .case-image-card, .constraint-grid article, .work-item, .result-card, .lesson-grid article, .service-link-grid a, .faq-item, .case-cta-card { border: 1px solid rgba(25, 33, 46, 0.09); background: rgba(255, 255, 255, 0.045); border-radius: 24px; box-shadow: 0 18px 48px rgba(25, 33, 46, 0.09); }
.proof-card { padding: 24px; }
.proof-label, .eyebrow { display: block; color: #b83e12; font-size: .78rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; }
.proof-card strong { display: block; color: #19212e; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; margin-bottom: 8px; }
.proof-card span:last-child { color: #465365; }
.overview-section, .constraints-section, .results-section, .lessons-section, .faq-section { background: #ffffff; }
.overview-grid, .two-column, .commercial-card, .faq-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: clamp(30px, 5vw, 60px); align-items: start; }
h2 { color: #19212e; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; margin: 0 0 22px; }
h3 { color: #19212e; font-size: 1.15rem; margin: 0 0 10px; }
p, li, dd { color: #465365; font-size: 1.02rem; line-height: 1.72; }
a { color: #b83e12; }
.case-summary-card, .constraint-grid article, .work-item, .result-card, .lesson-grid article, .service-link-grid a { padding: 24px; }
.case-summary-card dl { display: grid; gap: 14px; margin: 0; }
.case-summary-card div { display: grid; gap: 4px; padding-bottom: 14px; border-bottom: 1px solid rgba(25, 33, 46, 0.08); }
dt { color: #465365; font-weight: 900; text-transform: uppercase; font-size: .75rem; letter-spacing: .08em; }
.case-image-card { overflow: hidden; padding: 10px; background: rgba(255, 255, 255, 0.07); }
.case-image-card img { width: 100%; border-radius: 18px; display: block; }
.image-note { font-size: .92rem; margin-top: 14px; color: #465365; }
.work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.work-item span { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; color: #19212e; background: rgba(240,98,42,.25); font-weight: 900; margin-bottom: 18px; }
.result-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.result-card strong { color: #b83e12; font-size: 1.7rem; }
.before-after { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 18px 0; }
.before-after div { padding: 14px; border-radius: 16px; background: rgba(25, 33, 46, 0.09); }
.before-after span { display: block; color: #465365; font-size: .75rem; font-weight: 900; text-transform: uppercase; margin-bottom: 6px; }
.commercial-card { padding: clamp(32px, 5vw, 58px); border-radius: 32px; background: linear-gradient(145deg, rgba(240,98,42,.14), rgba(255, 255, 255, 0.04)); }
.lesson-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.service-link-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.service-link-grid a { color: inherit; text-decoration: none; }
.service-link-grid span { display: block; color: #19212e; font-weight: 900; margin-bottom: 8px; }
.faq-list { display: grid; gap: 14px; }
.faq-item { overflow: hidden; }
.faq-item summary { cursor: pointer; padding: 22px 24px; color: #19212e; font-weight: 900; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item p { padding: 0 24px 24px; margin: 0; }
.case-cta-card { text-align: center; padding: clamp(36px, 6vw, 68px); background: radial-gradient(circle at top left, rgba(240,98,42,.22), rgba(255, 255, 255, 0.045)); }
.cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
@media (max-width: 920px) { .proof-grid, .constraint-grid, .work-grid, .result-grid, .lesson-grid, .service-link-grid, .overview-grid, .two-column, .commercial-card, .faq-layout { grid-template-columns: 1fr; } }
</style>

