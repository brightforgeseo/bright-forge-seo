---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "garden-products-search-growth",
  metaTitle: "Garden Products SEO: +49% Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a garden-products supplier growing organic clicks by 48.9% with a stronger click-through rate.",
  title: "A garden-products supplier added 921 organic clicks from almost the same impression base",
  breadcrumb: "Garden Products Growth",
  industry: "Garden products and mulch",
  period: "31 May to 28 August 2026, compared with 2 March to 30 May 2026",
  lede: "Organic clicks rose from 1,883 to 2,804 across two 90-day periods while impressions barely moved. Click-through rate rose from 3.29% to 4.83% and average position held at 9.6 to 9.4. The site earned more clicks from almost the same number of appearances. Similar impression totals do not mean the same searches produced them, so the cause is still open.",
  evidenceImage: "/images/case-studies/garden-products-search-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Search Console totals chart showing 2,804 clicks for an anonymised garden-products supplier.",
  metrics: [
    { value: "+48.9%", label: "Organic clicks", note: "1,883 to 2,804" },
    { value: "+921", label: "Additional clicks", note: "Latest 90 days" },
    { value: "3.29% → 4.83%", label: "Click-through rate", note: "Higher aggregate click rate" },
    { value: "90 days", label: "Comparison window", note: "Two 90-day periods" }
  ],
  evidenceHeading: "Similar impression totals, a higher click rate",
  evidenceIntro: "The chart shows redacted Search Console totals for 2 March to 30 May 2026 and 31 May to 28 August 2026. Impressions rose by only 827, from 57,221 to 58,048. Clicks rose by 921. The click-through rates on this page are calculated from those totals. Average-position values are retained from the published comparison and are not displayed in this totals chart.",
  problemHeading: "Garden-product pages need to answer product and delivery questions",
  problem: [
    "A mulch or soil buyer usually has three things to settle before ordering: how much to buy, whether the product suits the job, and whether the supplier delivers to the address. Those details are where we would start a page review. They are review priorities, not explanations established by this comparison.",
    "The public case does not name the supplier, the products or the URLs, and it does not record what work was done or when. It shows the aggregate Search Console movement only."
  ],
  readingHeading: "Average position held while aggregate CTR rose",
  reading: [
    "Clicks rose by 921. Impressions rose from 57,221 to 58,048. Average position moved from 9.6 to 9.4. CTR moved from 3.29% to 4.83%.",
    "A higher click rate at a steady position is the pattern a better title or description would produce, but these totals do not prove a snippet change caused it. A seasonal shift in what people searched for would look the same. We would test the explanation by comparing the same queries and pages across both periods, then check whether the additional clicks became orders."
  ],
  takeaways: [
    "Similar impression totals can contain different searches. Use a fixed query and page comparison before attributing a CTR increase to the result itself.",
    "For seasonal products, check the period, the query mix and delivery-area demand. March to May and June to August are different seasons for a garden, and the page does not say which market this is.",
    "Search Console still cannot prove sales. Connect it to order and delivery data."
  ],
  results: [
    { metric: "Organic clicks", before: "1,883", after: "2,804", note: "+48.9%, or 921 additional clicks" },
    { metric: "Impressions", before: "57,221", after: "58,048", note: "+1.4%, similar impression total" },
    { metric: "Average position", before: "9.6", after: "9.4", note: "Held, with a slight improvement" },
    { metric: "Click-through rate", before: "3.29%", after: "4.83%", note: "Higher aggregate click rate" }
  ],
  boundary: "This anonymised case study reports Google Search Console organic-search data for two equal 90-day periods. The client, property, pages and queries are withheld. It records visibility and clicks, not orders, delivery volume or revenue. Search Console cannot attribute the movement to a single action, and this result is not a guarantee. It is published as a Search Console comparison: the page does not record what work was done on the site, by whom or when."
};
---
<GscCaseStudyPage data={data} />
