---
import MainLayout from '../../layouts/MainLayout.astro';
import LegacyHeader from '../../components/LegacyHeader.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const caseStudyData = {
  title: "Speediance AU Search Console Organic Click Growth",
  client: "Speediance AU",
  website: "https://speediance.com.au/",
  industry: "Fitness Equipment",
  duration: "6-month comparison",
  heroImage: "/images/case-studies/SEO Case Study- Increasing Organic Traffic for Speediance AU – Fitness Equipment Supplier .webp",
  challenge: "Speediance AU sells Gym Monster and home-gym equipment in an Australian market where established equipment retailers already hold the obvious search results. The campaign needed to reach two kinds of buyer, commercial gym owners and people equipping a home, and to do it in a category where search demand rises and falls with the season.",
  solution: "The campaign covered five areas: keyword research for Australian fitness-equipment searches, content and meta tag changes, technical SEO, local link building and ongoing Search Console review. The steps below describe each. The Search Console comparison records clicks and impressions for the whole storefront, and does not isolate the effect of an individual tactic.",
  keyMetrics: [
    { label: "Organic Clicks", value: "+66%", description: "6,550 → 10,900" },
    { label: "Search Visibility", value: "+22%", description: "279k → 339k" },
    { label: "CTR", value: "+33%", description: "2.4% → 3.2%" },
    { label: "Avg. Position", value: "24.9 → 28.1", description: "Worse aggregate position" }
  ],
  strategySteps: [
    { title: "Australian-Specific Keyword Research", description: "We researched Australian fitness-equipment search terms, focusing on the terminology and search patterns Australian buyers use for home-gym kit." },
    { title: "Content & Meta Tag Optimisation", description: "We revised website content, meta tags and product pages to match the search intent of commercial gym owners and individual buyers." },
    { title: "Technical SEO Improvements", description: "We worked on technical SEO elements such as site speed and mobile usability. This page does not include before-and-after speed measurements." },
    { title: "Local Backlink Development", description: "We pursued backlinks from local fitness communities, blogs and directories. This page does not list the placements." },
    { title: "Continuous Performance Analysis", description: "We reviewed Google Search Console data throughout the campaign and adjusted tactics in response." }
  ],
  results: [
    { metric: "Total Clicks", before: "6,550", after: "10,900", improvement: "+66%" },
    { metric: "Total Impressions", before: "279,000", after: "339,000", improvement: "+22%" },
    { metric: "Click-Through Rate", before: "2.4%", after: "3.2%", improvement: "+33%" },
    { metric: "Average Position", before: "24.9", after: "28.1", improvement: "Worse aggregate position" }
  ],
  keyTakeaways: [
    "Clicks rose from 6,550 to 10,900 while average position worsened from 24.9 to 28.1. More clicks at a weaker blended rank can mean a wider spread of searches, and the position figure needs query-level review before anyone acts on it",
    "A gym owner and a home buyer are different customers with different questions, and each needs pages planned for them",
    "Assess technical changes and user engagement separately from Search Console click totals",
    "The comparison does not isolate the effect of keyword research, content changes or link building"
  ]
};
---

<MainLayout title="Speediance AU Fitness SEO Case Study | Bright Forge" description="Speediance Australia's archived Search Console comparison shows increased clicks and impressions. Review the campaign work, screenshot and metric scope.">
  <LegacyHeader slot="header" />

  <Hero
    title={caseStudyData.client}
    breadcrumbCurrent="Speediance AU"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span class="meta-item">{caseStudyData.industry}</span>
        <span class="meta-divider">•</span>
        <span class="meta-item">{caseStudyData.duration}</span>
      </div>
      <p>We worked on <a href="https://speediance.com.au/" rel="noopener">speediance.com.au</a>. The job was Australian search for Gym Monster and home-gym kit, against established equipment retailers. The starting point was 6,550 Search Console clicks in the previous six months; the last six months recorded 10,900.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Full Results" />
      <ButtonSecondary href="/contact/" text="Discuss Your Project" />
    </Fragment>
  </Hero>

  <!-- Key Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="metrics-grid">
        {caseStudyData.keyMetrics.map((metric) => (
          <div class="metric-card">
            <div class="metric-value">{metric.value}</div>
            <div class="metric-label">{metric.label}</div>
            <div class="metric-description">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hero Image Section -->
  <section class="image-section">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="case-image-container">
        <img src={caseStudyData.heroImage} alt={`${caseStudyData.client} Performance Dashboard`} />
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">The <span>Challenge</span></h2>
      <p class="section-text">{caseStudyData.challenge}</p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="content-section gray">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">Our <span>Approach</span></h2>
      <p class="section-text">{caseStudyData.solution}</p>
      <p class="section-text mt-6">What the data shows: on the rounded totals, about 4,350 more clicks and 60,000 more impressions than in the previous six months, with click-through rate up from 2.4% to 3.2%. What it does not show: orders, or which pages earned the extra clicks. Average position moved the wrong way, from 24.9 to 28.1, and we report that beside the gains. This page does not give the dates of each piece of work, so the comparison cannot be lined up against a change log.</p>
    </div>
  </section>

  <!-- Strategy Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Strategy</span></h2>

      <div class="strategy-list">
        {caseStudyData.strategySteps.map((step, index) => (
          <div class="strategy-item">
            <div class="strategy-number">{index + 1}</div>
            <div class="strategy-content">
              <h3 class="strategy-title">{step.title}</h3>
              <p class="strategy-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="content-section gray" id="results">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Results</span></h2>
      <p class="section-text comparison-scope-note">Source: the published Search Console comparison image. Its selectors show Last 6 months and Previous 6 months. Exact calendar dates and country/search filters are not visible, so these figures are not presented as a country-filtered series or a conversion result.</p>

      <div class="results-table">
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Before</th>
              <th>After</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            {caseStudyData.results.map((result) => (
              <tr>
                <td class="metric-name">{result.metric}</td>
                <td>{result.before}</td>
                <td>{result.after}</td>
                <td class:list={["improvement", { "metric-decline": /Worse|decreased/.test(result.improvement) }]}>{result.improvement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Key Takeaways Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Key Takeaways</span></h2>

      <ul class="takeaways-list">
        {caseStudyData.keyTakeaways.map((takeaway) => (
          <li>{takeaway}</li>
        ))}
      </ul>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.results-table .improvement.metric-decline { color: #465365; }

/* Case Study Meta */
.case-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #19212e;
}

.meta-item {
  color: #19212e;
}

.meta-divider {
  opacity: 0.5;
}

/* Metrics Section */
.metrics-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 48px;
}

.metric-card {
  text-align: center;
  padding: 24px 0;
}

.metric-value {
  font-size: 3rem;
  font-weight: 800;
  color: #b83e12;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.metric-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.metric-description {
  font-size: 0.875rem;
  color: #19212e;
}

/* Image Section */
.image-section {
  background: #f7f8fa;
}

.case-image-container {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(25, 33, 46, 0.08);
}

.case-image-container img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  background: #ffffff;
}

/* Content Sections */
.content-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.content-section.gray {
  background: #ffffff;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: #19212e;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.section-text {
  font-size: 1.125rem;
  line-height: 1.8;
  color: #19212e;
}

/* Strategy List */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 32px;
  margin-top: 32px;
}

.strategy-item {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.strategy-number {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: #f0622a;
  color: #19212e;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
}

.strategy-content {
  flex: 1;
}

.strategy-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #19212e;
  margin-bottom: 8px;
}

.strategy-description {
  font-size: 1rem;
  line-height: 1.6;
  color: #19212e;
}

/* Results Table */
.results-table {
  margin-top: 32px;
  overflow-x: auto;
}

.results-table table {
  width: 100%;
  border-collapse: collapse;
}

.results-table th {
  text-align: left;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.05);
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #e2e8f0;
}

.results-table td {
  padding: 20px;
  font-size: 1rem;
  color: #19212e;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table .metric-name {
  font-weight: 600;
}

.results-table .improvement {
  color: #b83e12;
  font-weight: 600;
}

/* Takeaways List */
.takeaways-list {
  list-style: none;
  padding: 0;
  margin: 32px 0 0 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.takeaways-list li {
  font-size: 1.125rem;
  line-height: 1.7;
  color: #19212e;
  padding-left: 32px;
  position: relative;
}

.takeaways-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  width: 6px;
  height: 6px;
  background: #f0622a;
  border-radius: 50%;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .metric-value {
    font-size: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
  }

  .strategy-item {
    gap: 16px;
  }

  .strategy-number {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .results-table {
    font-size: 0.875rem;
  }

  .results-table th,
  .results-table td {
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>
