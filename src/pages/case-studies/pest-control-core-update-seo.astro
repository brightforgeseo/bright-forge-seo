---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/ContactSection.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/case-studies/pest-control-core-update-seo/";
const image = "/images/case-studies/SEO Case Study- Recovering and Growing Organic Traffic for a Pest Control Firm After Core Update .webp";

const metrics = [
  {
    label: "Organic clicks",
    before: "10.3k",
    after: "23.5k",
    change: "+128%",
    note: "Google Search clicks increased between the two six-month windows; clicks are not unique visitors or confirmed enquiries."
  },
  {
    label: "Impressions",
    before: "1.26M",
    after: "3.12M",
    change: "+147.6%",
    note: "Impressions increased. The totals do not show whether this came from new queries, existing queries or changing demand."
  },
  {
    label: "Average position",
    before: "19.1",
    after: "17.2",
    change: "Modest lift",
    note: "Average position improved by 1.9 places across the recorded impressions, not necessarily for every service or location."
  },
  {
    label: "CTR",
    before: "0.8%",
    after: "0.8%",
    change: "Steady",
    note: "Both rounded CTR values are 0.8%; they do not establish that every query group performed the same way."
  }
];

const workstreams = [
  {
    "title": "Bed bug treatment choices",
    "text": "For a heat-treatment specialist, review whether the service page explains the inspection, treatment method, preparation and aftercare. Keep eligibility and any guarantee conditions beside the offer."
  },
  {
    "title": "Service-area fit",
    "text": "Check whether a household or property manager can confirm the treatment area before requesting a quote. Publish locations actually served rather than interchangeable town pages."
  },
  {
    "title": "Access to important pages",
    "text": "Check that search engines and visitors can reach treatment, preparation and pricing information through crawlable internal links. Test indexability before attributing lost visibility to content."
  },
  {
    "title": "Quote information",
    "text": "Review whether the enquiry path collects the pest problem, property type, postcode and treatment needs without making the form difficult to complete on a phone."
  },
  {
    "title": "Page and query comparison",
    "text": "Compare the same treatment-page and query groups across complete periods. Review device, country and seasonal differences before choosing a page change."
  }
];

const lessons = [
  "A search decline after an update is a reason to investigate, not proof of a penalty or a specific quality failure.",
  "Separate bed bug treatment searches from general pest-information searches before deciding where extra clicks are useful.",
  "Check answered calls, suitable quote requests and booked treatments separately from Search Console clicks.",
  "Use preparation and aftercare information to help a customer assess treatment, not as filler added solely to create more pages."
];

const faqs = [
  {
    "question": "Can SEO recover after a Google core update?",
    "answer": "Search performance can improve, but update timing alone does not identify the cause of a decline. Compare affected pages and queries, check technical access and review the usefulness of the content before deciding what to change."
  },
  {
    "question": "What does the ThermoPest comparison show?",
    "answer": "The published screenshot shows Last 6 months versus Previous 6 months: 10.3k to 23.5k clicks and 1.26M to 3.12M impressions. It does not identify a core update, exact calendar dates or the work responsible for the change."
  },
  {
    "question": "Why did clicks grow while average position improved more modestly?",
    "answer": "Clicks, impressions and average position measure different things. Position moved from 19.1 to 17.2, but the aggregate figures cannot establish which queries contributed the additional clicks. That requires a page and query comparison."
  },
  {
    "question": "Is a flat CTR a concern in this result?",
    "answer": "Not in isolation. Both displayed CTR values round to 0.8%, while impressions increased. Inspect the individual treatment pages and query groups before deciding whether a title or snippet needs work."
  },
  {
    "question": "What should a pest control business review after a search decline?",
    "answer": "Check indexability and lost pages first, then compare treatment and location queries. For a heat-treatment service, assess whether customers can understand preparation, access requirements, service coverage and the next step for a quote."
  },
  {
    "question": "Does this result prove more pest control bookings?",
    "answer": "No. Search Console records search impressions and clicks, not booked treatments or revenue. Calls and quote requests need separate tracking and qualification; this comparison does not guarantee the same result for another site."
  }
];

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "ThermoPest SEO Case Study: Six-Month Search Comparison",
  description: "ThermoPest search comparison: higher clicks and impressions, a modest average-position improvement and unchanged rounded CTR. No causal or booking claim.",
  image: `https://brightforge.com.ph${image}`,
  author: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    url: "https://brightforge.com.ph/"
  },
  publisher: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    logo: {
      "@type": "ImageObject",
      url: "https://brightforge.com.ph/images/header-logo-360w.webp"
    }
  },
  mainEntityOfPage: canonical,
  articleSection: "SEO Case Studies",
  about: ["Pest control SEO", "Local SEO", "Core update recovery", "Technical SEO", "Content SEO"]
};
---

<MainLayout
  title="ThermoPest SEO Case Study | Search Comparison"
  description="ThermoPest’s published six-month comparison shows approximately 128% more clicks and 147.6% more impressions. Read the metrics and their limits."
  canonical={canonical}
  image={image}
  type="article"
  author={{ name: "Bright Forge SEO", url: "https://brightforge.com.ph/" }}
  article={{ section: "SEO Case Studies", tags: ["Pest Control SEO", "Local SEO", "Core Update Recovery", "Case Study"] }}
  breadcrumbs={[
    { name: "Home", url: "https://brightforge.com.ph/" },
    { name: "Case Studies", url: "https://brightforge.com.ph/case-studies/" },
    { name: "ThermoPest SEO Comparison", url: canonical }
  ]}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    title="ThermoPest <span>SEO Case Study</span>"
    breadcrumbCurrent="ThermoPest"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span>Local services</span>
        <span>Search performance comparison</span>
        <span>Six months versus previous six months</span>
      </div>
      <p class="hero-subtitle">ThermoPest’s published comparison shows more Google Search clicks and impressions, with a smaller improvement in average position.</p>
      <p>ThermoPest operates <a href="https://pest.co.uk/" rel="noopener">pest.co.uk</a>, which currently presents specialist bed bug heat treatment. The archived search screenshot records a six-month comparison. It does not identify a core update or show which changes produced the movement.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Results" />
      <ButtonSecondary href="/contact/" text="Request an SEO Review" />
    </Fragment>
  </Hero>

  <main class="case-study-page">
    <section class="proof-strip" aria-label="Case study summary metrics">
      <div class="case-container">
        <div class="proof-grid">
          {metrics.map((metric) => (
            <article class="proof-card">
              <span class="proof-label">{metric.label}</span>
              <strong>{metric.change}</strong>
              <span>{metric.before} to {metric.after}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-section">
      <div class="case-container overview-grid">
        <div>
          <p class="eyebrow">The short version</p>
          <h2>A six-month increase in pest control <span>search visibility</span></h2>
          <p>The published screenshot compares Last 6 months versus Previous 6 months. Exact calendar dates, country and device filters are not visible. It supports a comparison of aggregate search performance, not a diagnosis of an algorithm hit.</p>
          <p>Organic clicks increased from 10.3k to 23.5k and impressions from 1.26M to 3.12M. Average position moved from 19.1 to 17.2. The approximate 128% and 147.6% increases use the rounded totals displayed in the screenshot.</p>
        </div>
        <aside class="case-summary-card">
          <h3>Comparison snapshot</h3>
          <dl>
            <div><dt>Industry</dt><dd>Pest control and home services</dd></div>
            <div><dt>Market type</dt><dd>Local service SEO</dd></div>
            <div><dt>Timeframe</dt><dd>Last six months versus previous six months</dd></div>
            <div><dt>Main KPI</dt><dd>Organic clicks from Google Search</dd></div>
            <div><dt>Evidence</dt><dd>Published Search Console screenshot, not a campaign change log</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="visual-proof-section">
      <div class="case-container">
        <div class="case-image-card">
          <img src={image} alt="Google Search Console six-month performance comparison for ThermoPest" loading="eager" decoding="async" />
        </div>
        <p class="image-note">Search Console metrics used in this case study: 10.3k to 23.5k clicks, 1.26M to 3.12M impressions, average position 19.1 to 17.2 and CTR steady at 0.8%.</p>
      </div>
    </section>

    <section class="content-section" id="challenge">
      <div class="case-container two-column">
        <div>
          <p class="eyebrow">Starting problem</p>
          <h2>Help a customer assess <span>treatment suitability</span></h2>
        </div>
        <div class="section-copy">
          <p>A person looking for bed bug treatment needs to know whether the method suits the property, how to prepare and what happens after the visit. These are concrete page-review questions for a heat-treatment business; the screenshot does not establish that the historical site lacked this information.</p>
          <p>Review treatment and location searches separately from pest-identification advice. An informational visit can be useful without being a quote request, and a postcode outside the service area may not be a suitable enquiry.</p>
        </div>
      </div>
    </section>

    <section class="constraints-section">
      <div class="case-container">
        <p class="eyebrow">Constraints</p>
        <h2>The limits of an aggregate <span>search comparison</span></h2>
        <div class="constraint-grid">
          <article>
            <h3>Core update uncertainty</h3>
            <p>No named update or dated decline is visible in the screenshot. A recovery diagnosis would require daily history and a chronology of site changes.</p>
          </article>
          <article>
            <h3>Local service intent</h3>
            <p>A treatment enquiry needs a serviceable location and a suitable pest problem. The screenshot supplies neither query nor customer-location detail.</p>
          </article>
          <article>
            <h3>Many small query groups</h3>
            <p>Pest type, treatment and location are useful groups to inspect. Their individual contribution is not shown in this aggregate comparison.</p>
          </article>
          <article>
            <h3>Honest metric interpretation</h3>
            <p>Clicks and impressions increased, but average position is an impression-weighted aggregate. It is not the rank of a typical treatment keyword.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="case-container">
        <div class="section-header">
          <p class="eyebrow">Recommended treatment-page checks</p>
          <h2>Review the route from <span>treatment question to quote</span></h2>
          <p>These are recommendations for a specialist pest-control site, not a record of changes proven by the screenshot. Prioritise them after checking the actual pages and search data.</p>
        </div>
        <div class="work-list">
          {workstreams.map((item, index) => (
            <article class="work-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="results-section" id="results">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">What moved</p>
          <h2>Clicks and impressions increased, while <span>average position</span> improved modestly</h2>
          <p>The screenshot records search activity, not the relevance of each additional impression. New queries, changes to existing queries and demand shifts are possible explanations; the totals alone cannot distinguish them.</p>
        </div>
        <div class="result-grid">
          {metrics.map((metric) => (
            <article class="result-card">
              <div class="result-topline">
                <span>{metric.label}</span>
                <strong>{metric.change}</strong>
              </div>
              <div class="before-after">
                <div><span>Before</span><strong>{metric.before}</strong></div>
                <div><span>After</span><strong>{metric.after}</strong></div>
              </div>
              <p>{metric.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="commercial-section">
      <div class="case-container commercial-card">
        <div>
          <p class="eyebrow">Commercial meaning</p>
          <h2>Connect search clicks to <span>suitable service enquiries</span></h2>
          <p>The additional clicks do not establish an increase in calls, quotes or booked treatments. A useful follow-up is to identify the landing pages receiving those clicks and compare their qualified enquiries over the same periods.</p>
          <p>For treatment enquiries, record service area, pest type and whether a booking followed. Keep repeat calls, unsuitable enquiries and confirmed jobs separate so a larger click total is not mistaken for a commercial result.</p>
        </div>
        <div class="meaning-points">
          <article><strong>Check landing pages</strong><span>Identify which treatment or advice pages received the additional clicks before changing them.</span></article>
          <article><strong>Qualify the enquiry</strong><span>Separate a serviceable treatment request from general advice, repeat contact or an out-of-area enquiry.</span></article>
          <article><strong>Measure booked work</strong><span>Compare confirmed treatments and their source separately from search clicks.</span></article>
        </div>
      </div>
    </section>

    <section class="lessons-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Lessons for similar businesses</p>
          <h2>What <span>other home service</span> companies should take from this</h2>
        </div>
        <div class="lesson-grid">
          {lessons.map((lesson) => (
            <article>
              <p>{lesson}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="related-services-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Relevant services</p>
          <h2>Related Bright Forge <span>SEO reviews</span></h2>
        </div>
        <div class="service-link-grid">
          <a href="/local-seo-for-google-maps-and-gbp/">
            <span>Local SEO</span>
            <p>Service-area visibility, local intent coverage and better organic presence for businesses that depend on location-based enquiries.</p>
          </a>
          <a href="/technical-seo-services-philippines/">
            <span>Technical SEO</span>
            <p>Crawl, indexation, internal linking and site-quality checks that support recovery work after visibility drops.</p>
          </a>
          <a href="/content-seo-services-philippines/">
            <span>Content SEO</span>
            <p>Service page improvements shaped around buyer intent, search demand and clear relevance rather than generic content volume.</p>
          </a>
          <a href="/seo-audit-services/">
            <span>SEO audits</span>
            <p>Investigate technical access, page usefulness and query changes before deciding how to respond to an organic decline.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="case-container faq-layout">
        <div>
          <p class="eyebrow">Questions this case study should answer</p>
          <h2><span>Pest control SEO</span> comparison FAQs</h2>
          <p>What the six-month comparison shows, what it cannot establish and how to investigate a search decline.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="case-cta-section">
      <div class="case-container case-cta-card">
        <p class="eyebrow">Hit by an update or losing organic leads?</p>
        <h2>We can inspect the <span>pages, queries and technical signals</span> behind the drop.</h2>
        <p>If your local service site has lost visibility, start with a focused SEO review. We will look at Search Console data, page quality, local intent coverage, indexation and the work most likely to move the campaign forward.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Request an SEO Review" />
          <ButtonSecondary href="/case-studies/" text="View More Case Studies" />
        </div>
      </div>
    </section>
  </main>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.case-study-page,
.case-study-page * {
  box-sizing: border-box;
}

.case-study-page {
  background: #ffffff;
  color: #19212e;
}

.case-container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

.case-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.case-meta span {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 7px 12px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: #19212e;
  font-size: 0.88rem;
  font-weight: 700;
}

.hero-subtitle {
  color: #19212e;
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.35;
  font-weight: 800;
  margin-bottom: 18px;
}

.proof-strip,
.overview-section,
.visual-proof-section,
.content-section,
.constraints-section,
.work-section,
.results-section,
.commercial-section,
.lessons-section,
.related-services-section,
.faq-section,
.case-cta-section {
  content-visibility: visible !important;
  contain-intrinsic-size: auto none !important;
}

.proof-strip {
  padding: 34px 0;
  background: #f7f8fa;
  border-top: 1px solid rgba(25, 33, 46, 0.08);
  border-bottom: 1px solid rgba(25, 33, 46, 0.08);
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.proof-card,
.result-card,
.case-summary-card,
.constraint-grid article,
.lesson-grid article,
.service-link-grid a,
.faq-item,
.case-cta-card {
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 18px 60px rgba(25, 33, 46, 0.09);
}

.proof-card {
  min-height: 154px;
  padding: 24px;
  border-radius: 22px;
}

.proof-label,
.eyebrow {
  display: block;
  color: #b83e12;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.proof-card strong {
  display: block;
  margin: 12px 0 8px;
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
}

.proof-card span:last-child {
  color: #465365;
  font-size: 0.95rem;
}

.overview-section,
.content-section,
.work-section,
.commercial-section,
.related-services-section,
.case-cta-section {
  padding: 92px 0;
  background: #ffffff;
}

.visual-proof-section,
.constraints-section,
.results-section,
.lessons-section,
.faq-section {
  padding: 92px 0;
  background: #f7f8fa;
}

.overview-grid,
.two-column,
.faq-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
  gap: clamp(32px, 6vw, 72px);
  align-items: start;
}

h2,
h3,
p {
  margin-top: 0;
}

h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.04em;
  margin-bottom: 22px;
}

h3 {
  color: #19212e;
  font-size: 1.22rem;
  line-height: 1.25;
  margin-bottom: 12px;
}

p {
  color: #465365;
  font-size: 1.04rem;
  line-height: 1.75;
  margin-bottom: 18px;
}

.case-summary-card {
  position: sticky;
  top: 110px;
  padding: 28px;
  border-radius: 24px;
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.13), rgba(255, 255, 255, 0.045));
}

.case-summary-card dl {
  margin: 0;
}

.case-summary-card div {
  padding: 14px 0;
  border-bottom: 1px solid rgba(25, 33, 46, 0.09);
}

.case-summary-card div:last-child {
  border-bottom: 0;
}

.case-summary-card dt {
  color: #465365;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
  margin-bottom: 5px;
}

.case-summary-card dd {
  color: #19212e;
  margin: 0;
  font-weight: 700;
}

.case-image-card {
  overflow: hidden;
  border-radius: 26px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: #ffffff;
  box-shadow: 0 24px 80px rgba(25, 33, 46, 0.09);
}

.case-image-card img {
  display: block;
  width: 100%;
  height: auto;
  background: #ffffff;
}

.image-note {
  max-width: 820px;
  margin: 18px auto 0;
  text-align: center;
  color: #465365;
  font-size: 0.95rem;
}

.section-copy p:last-child,
.case-cta-card p:last-child {
  margin-bottom: 0;
}

.constraint-grid,
.result-grid,
.lesson-grid,
.service-link-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 34px;
}

.constraint-grid article,
.lesson-grid article,
.service-link-grid a {
  border-radius: 24px;
  padding: 28px;
}

.constraint-grid p,
.lesson-grid p,
.service-link-grid p {
  margin-bottom: 0;
}

.section-header {
  max-width: 840px;
  margin-bottom: 40px;
}

.section-header.compact {
  margin-bottom: 30px;
}

.work-list {
  display: grid;
  gap: 18px;
}

.work-item {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 24px;
  padding: 28px;
  border-radius: 24px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
}

.work-item > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: #f0622a;
  color: #19212e;
  font-weight: 900;
}

.work-item p {
  margin-bottom: 0;
}

.result-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.result-card {
  border-radius: 24px;
  padding: 24px;
}

.result-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 22px;
}

.result-topline span {
  color: #465365;
  font-weight: 800;
}

.result-topline strong {
  color: #b83e12;
  font-size: 1.5rem;
  white-space: nowrap;
}

.before-after {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}

.before-after div {
  padding: 14px;
  border-radius: 16px;
  background: rgba(25, 33, 46, 0.09);
}

.before-after span {
  display: block;
  color: #465365;
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.before-after strong {
  color: #19212e;
  font-size: 1.25rem;
}

.result-card p {
  color: #465365;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 0;
}

.commercial-card {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
  gap: clamp(28px, 5vw, 56px);
