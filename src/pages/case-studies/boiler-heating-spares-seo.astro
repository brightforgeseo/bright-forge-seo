---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/ContactSection.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/case-studies/boiler-heating-spares-seo/";
const image = "/images/case-studies/SEO Case Study- Driving Sustained Growth for a Boiler & Heating Spares Supplier .webp";

const metrics = [
  {
    label: "Organic clicks",
    before: "14.1k",
    after: "16.6k",
    change: "+18%",
    note: "More organic clicks in the later six-month window; the screenshot does not identify the queries or buyers."
  },
  {
    label: "Impressions",
    before: "1.06M",
    after: "1.17M",
    change: "+10%",
    note: "More recorded search appearances. The totals do not show which products or query groups gained visibility."
  },
  {
    label: "Average position",
    before: "18.5",
    after: "18.0",
    change: "Small lift",
    note: "Average position improved by 0.5 positions across the reported impressions."
  },
  {
    label: "CTR",
    before: "1.3%",
    after: "1.4%",
    change: "+0.1pp",
    note: "The displayed CTR rose by 0.1 percentage points. This comparison does not establish snippet causation."
  }
];

const workstreams = [
  {
    title: "Search demand mapping",
    text: "Group model numbers, spare-part names and compatibility questions separately. A buyer searching for a specific replacement needs a matching product page, not a general heating guide."
  },
  {
    title: "Category and product relevance",
    text: "Check that titles, headings and product copy identify the part, its compatible models and the relevant category. Keep compatibility statements tied to manufacturer information."
  },
  {
    title: "Crawl and architecture checks",
    text: "Trace links from categories to in-stock parts and useful support pages. Review duplicate filters and discontinued products before deciding what should remain indexed."
  },
  {
    title: "Authority and trust signals",
    text: "Make supplier details and product documentation easy to check. Review existing referring sites before recommending any link work; the chart cannot establish a backlink contribution."
  },
  {
    title: "Monthly Search Console review",
    text: "Compare the same pages and queries over time, separating model-number searches from broader repair questions. Use that breakdown to choose the next catalogue change."
  }
];

const lessons = [
  "Model numbers and compatibility information help buyers distinguish a suitable replacement from a similar-looking part.",
  "Check click movement alongside impressions and CTR. A small change in aggregate position does not describe every product page.",
  "Keep orders, returns and part-fit questions separate from search metrics when assessing the commercial value of catalogue traffic.",
  "Search Console should shape the next month of work. For parts suppliers, the data often reveals query variations that the catalogue structure has not caught yet."
];

const faqs = [
  {
    question: "What makes boiler spares search different from general retail?",
    answer: "Buyers can search by boiler model, part name, compatibility issue or repair symptom. Those are different information needs: a product page should confirm fit, while a support page may explain how to identify a part."
  },
  {
    question: "Were the results mainly from rankings or click-through improvements?",
    answer: "Clicks, impressions and displayed CTR increased, while average position improved from 18.5 to 18.0. These aggregate changes do not isolate the effect of rankings, snippets or a changing query mix."
  },
  {
    question: "Why does a 0.1 percentage point CTR lift matter?",
    answer: "It means the reported share of impressions producing clicks increased from 1.3% to 1.4%. Both values are rounded. Compare a fixed set of queries and pages before attributing that change to titles or descriptions."
  },
  {
    question: "What SEO work matters most for spare parts ecommerce sites?",
    answer: "Category structure, product naming, compatibility content, internal linking, indexation control, schema and search snippet clarity usually matter more than publishing generic blog content."
  },
  {
    question: "Can this approach work for other technical ecommerce catalogues?",
    answer: "Yes, when the catalogue has real search demand and the business can support useful product, category and compatibility information. The exact plan should still start with a crawl, Search Console review and keyword mapping."
  },
  {
    question: "Does Bright Forge guarantee the same growth for other ecommerce sites?",
    answer: "No. Results depend on the market, technical condition, competition, catalogue quality and available resources. We use case studies to show the kind of diagnostic work and commercial thinking involved, not to promise identical numbers."
  }
];

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Boiler and Heating Spares SEO Case Study",
  description: "A six-month Search Console comparison for a boiler and heating spares supplier: higher organic clicks and impressions, with catalogue checks for similar businesses.",
  image: `https://brightforge.com.ph${image}`,
  author: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    url: "https://brightforge.com.ph/"
  },
  publisher: {
    "@type": "Organization",
    name: "Bright Forge SEO",
    logo: {
      "@type": "ImageObject",
      url: "https://brightforge.com.ph/images/header-logo-360w.webp"
    }
  },
  mainEntityOfPage: canonical,
  articleSection: "SEO Case Studies",
  about: ["Ecommerce SEO", "Technical SEO", "Content SEO", "Internal linking", "Boiler spares"]
};
---

<MainLayout
  title="Boiler Spares SEO Case Study | Bright Forge"
  description="Boiler spares Search Console comparison: organic clicks rose from 14.1k to 16.6k across successive six-month periods. See the figures and their limits."
  canonical={canonical}
  image={image}
  type="article"
  author={{ name: "Bright Forge SEO", url: "https://brightforge.com.ph/" }}
  article={{ section: "SEO Case Studies", tags: ["Ecommerce SEO", "Technical SEO", "Content SEO", "Case Study"] }}
  breadcrumbs={[
    { name: "Home", url: "https://brightforge.com.ph/" },
    { name: "Case Studies", url: "https://brightforge.com.ph/case-studies/" },
    { name: "Boiler Spares SEO", url: canonical }
  ]}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    title="Boiler Spares <span>SEO Case Study</span>"
    breadcrumbCurrent="Boiler Spares SEO"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span>Specialist ecommerce</span>
        <span>Home and DIY</span>
        <span>Last 6 months versus Previous 6 months</span>
      </div>
      <p class="hero-subtitle">A boiler and heating spares supplier recorded about 18% more organic clicks across successive six-month periods.</p>
      <p>A replacement part has to fit the boiler. Model numbers, compatibility details and clear product categories matter to buyers who need the right item. This case shows the search comparison, followed by catalogue checks relevant to that buying process.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Results" />
      <ButtonSecondary href="/contact/" text="Request an SEO Review" />
    </Fragment>
  </Hero>

  <main class="case-study-page">
    <section class="proof-strip" aria-label="Case study summary metrics">
      <div class="case-container">
        <div class="proof-grid">
          {metrics.map((metric) => (
            <article class="proof-card">
              <span class="proof-label">{metric.label}</span>
              <strong>{metric.change}</strong>
              <span>{metric.before} to {metric.after}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-section">
      <div class="case-container overview-grid">
        <div>
          <p class="eyebrow">The short version</p>
          <h2>More <span>organic clicks</span> for a specialist parts catalogue</h2>
          <p>The comparison records 14.1k clicks in the previous six months and 16.6k in the last six months. Impressions increased from 1.06M to 1.17M. These are the rounded totals displayed in Search Console.</p>
          <p>Average position improved from 18.5 to 18.0 and CTR from 1.3% to 1.4%. The image does not reveal exact calendar dates, country or device filters, or which pages and queries changed. It is an observed comparison, not a record of completed SEO changes.</p>
        </div>
        <aside class="case-summary-card">
          <h3>Campaign snapshot</h3>
          <dl>
            <div><dt>Industry</dt><dd>Boiler and heating spare parts</dd></div>
            <div><dt>Market type</dt><dd>Technical ecommerce</dd></div>
            <div><dt>Timeframe</dt><dd>Last 6 months versus Previous 6 months</dd></div>
            <div><dt>Main KPI</dt><dd>Organic clicks from Google Search</dd></div>
            <div><dt>Recommended review</dt><dd>Part identification, compatibility information, category links and query analysis</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="visual-proof-section">
      <div class="case-container">
        <div class="case-image-card">
          <img src={image} alt="Google Search Console performance comparison for a boiler and heating spares SEO campaign" loading="eager" decoding="async" />
        </div>
        <p class="image-note">Search Console metrics used in this case study: 14.1k to 16.6k clicks, 1.06M to 1.17M impressions, average position 18.5 to 18.0 and CTR 1.3% to 1.4%.</p>
      </div>
    </section>

    <section class="content-section" id="challenge">
      <div class="case-container two-column">
        <div>
          <p class="eyebrow">Starting problem</p>
          <h2>Parts buyers need answers to <span>technical, high-intent searches</span></h2>
        </div>
        <div class="section-copy">
          <p>Boiler spare parts are searched for in messy ways. Some buyers know the exact part. Others search by boiler model, fault, compatibility or a category phrase. A useful SEO plan has to account for all of that without creating duplicate, thin or confusing pages.</p>
          <p>For a catalogue review, the practical question is whether each search leads to the correct part or category. Search clicks alone cannot tell us whether the part was suitable or an order followed.</p>
        </div>
      </div>
    </section>

    <section class="constraints-section">
      <div class="case-container">
        <p class="eyebrow">Constraints</p>
        <h2>What a <span>parts catalogue review</span> needs to address</h2>
        <div class="constraint-grid">
          <article>
            <h3>Technical product language</h3>
            <p>Searches often include part names, boiler models and compatibility clues. Generic ecommerce copy would miss the point.</p>
          </article>
          <article>
            <h3>Large long-tail spread</h3>
            <p>Model and part variants can create many distinct searches. Check the actual query list before choosing which pages to expand.</p>
          </article>
          <article>
            <h3>Category access</h3>
            <p>Check whether category links let buyers and crawlers reach the parts that are available to order.</p>
          </article>
          <article>
            <h3>Search metrics and orders</h3>
            <p>The image records search activity, not orders, revenue or the effect of a particular change.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="case-container">
        <div class="section-header">
          <p class="eyebrow">Recommended catalogue checks</p>
          <h2>Review <span>part identification</span>, catalogue structure and search demand</h2>
          <p>These are recommendations for a specialist parts catalogue, not a verified change log for this supplier. The available comparison does not establish which actions were implemented.</p>
        </div>
        <div class="work-list">
          {workstreams.map((item, index) => (
            <article class="work-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="results-section" id="results">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">What moved</p>
          <h2><span>Organic clicks</span> and visibility improved, with the caveat that average position only moved slightly</h2>
          <p>The later six-month window recorded more clicks and impressions. Average position and CTR also improved, but the totals cannot establish whether the same queries improved or the search mix changed.</p>
        </div>
        <div class="result-grid">
          {metrics.map((metric) => (
            <article class="result-card">
              <div class="result-topline">
                <span>{metric.label}</span>
                <strong>{metric.change}</strong>
              </div>
              <div class="before-after">
                <div><span>Before</span><strong>{metric.before}</strong></div>
                <div><span>After</span><strong>{metric.after}</strong></div>
              </div>
              <p>{metric.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="commercial-section">
      <div class="case-container commercial-card">
        <div>
          <p class="eyebrow">Commercial meaning</p>
          <h2>More clicks need to be connected to <span>correct-part orders</span></h2>
          <p>For ecommerce spare parts, the commercial value is rarely about making people interested in boilers. They already have a need. SEO has to help the right category or product appear when that need becomes a search.</p>
          <p>The click increase gives the supplier more search activity to investigate. To assess its value, compare landing pages with completed orders and returns caused by part mismatch. No order or revenue result is established here.</p>
        </div>
        <div class="meaning-points">
          <article><strong>Landing-page fit</strong><span>Check whether searches reach the correct part, model or category.</span></article>
          <article><strong>Compatibility details</strong><span>Confirm fit information against the product documentation.</span></article>
          <article><strong>Commercial measurement</strong><span>Connect search activity to orders and correct-part fulfilment.</span></article>
        </div>
      </div>
    </section>

    <section class="lessons-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Lessons for similar businesses</p>
          <h2>What <span>other technical ecommerce</span> sites should take from this</h2>
        </div>
        <div class="lesson-grid">
          {lessons.map((lesson) => (
            <article>
              <p>{lesson}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="related-services-section">
      <div class="case-container">
        <div class="section-header compact">
          <p class="eyebrow">Relevant services</p>
          <h2>Where this work connects to Bright Forge <span>SEO services</span></h2>
        </div>
        <div class="service-link-grid">
          <a href="/technical-seo-services-philippines/">
            <span>Technical SEO</span>
            <p>Crawl, indexation, site structure and performance checks for sites with many moving parts.</p>
          </a>
          <a href="/content-seo-services-philippines/">
            <span>Content SEO</span>
            <p>Better category, product and support content shaped around how buyers actually search.</p>
          </a>
          <a href="/on-page-seo-services-philippines/">
            <span>On-page SEO</span>
            <p>Titles, headings, internal links and page copy that make relevance obvious.</p>
          </a>
          <a href="/seo-audit-services/">
            <span>SEO audits</span>
            <p>Find the technical and content bottlenecks before spending months on the wrong tasks.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="case-container faq-layout">
        <div>
          <p class="eyebrow">Questions this case study should answer</p>
          <h2><span>Boiler spares SEO</span> case study FAQs</h2>
          <p>Useful case studies should explain the conditions, limits and practical lessons behind the numbers.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="case-cta-section">
      <div class="case-container case-cta-card">
        <p class="eyebrow">Want this kind of review for your site?</p>
        <h2>We can inspect the pages, queries and technical signals that are limiting <span>organic growth</span>.</h2>
        <p>If your ecommerce site has real demand but uneven organic performance, start with a focused SEO review. We will look at Search Console data, page structure, indexation and where the catalogue is leaking opportunity.</p>
        <div class="cta-actions">
          <ButtonPrimary href="/contact/" text="Request an SEO Review" />
          <ButtonSecondary href="/case-studies/" text="View More Case Studies" />
        </div>
      </div>
    </section>
  </main>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.case-study-page,
.case-study-page * {
  box-sizing: border-box;
}

.case-study-page {
  background: #ffffff;
  color: #19212e;
}

.case-container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

.case-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.case-meta span {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 7px 12px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: #19212e;
  font-size: 0.88rem;
  font-weight: 700;
}

.hero-subtitle {
  color: #19212e;
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.35;
  font-weight: 800;
  margin-bottom: 18px;
}

.proof-strip,
.overview-section,
.visual-proof-section,
.content-section,
.constraints-section,
.work-section,
.results-section,
.commercial-section,
.lessons-section,
.related-services-section,
.faq-section,
.case-cta-section {
  content-visibility: visible !important;
  contain-intrinsic-size: auto none !important;
}

.proof-strip {
  padding: 34px 0;
  background: #f7f8fa;
  border-top: 1px solid rgba(25, 33, 46, 0.08);
  border-bottom: 1px solid rgba(25, 33, 46, 0.08);
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.proof-card,
.result-card,
.case-summary-card,
.constraint-grid article,
.lesson-grid article,
.service-link-grid a,
.faq-item,
.case-cta-card {
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 18px 60px rgba(25, 33, 46, 0.09);
}

.proof-card {
  min-height: 154px;
  padding: 24px;
  border-radius: 22px;
}

.proof-label,
.eyebrow {
  display: block;
  color: #b83e12;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.proof-card strong {
  display: block;
  margin: 12px 0 8px;
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
}

.proof-card span:last-child {
  color: #465365;
  font-size: 0.95rem;
}

.overview-section,
.content-section,
.work-section,
.commercial-section,
.related-services-section,
.case-cta-section {
  padding: 92px 0;
  background: #ffffff;
}

.visual-proof-section,
.constraints-section,
.results-section,
.lessons-section,
.faq-section {
  padding: 92px 0;
  background: #f7f8fa;
}

.overview-grid,
.two-column,
.faq-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
  gap: clamp(32px, 6vw, 72px);
  align-items: start;
}

h2,
h3,
p {
  margin-top: 0;
}

h2 {
  color: #19212e;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.04em;
  margin-bottom: 22px;
}

h3 {
  color: #19212e;
  font-size: 1.22rem;
  line-height: 1.25;
  margin-bottom: 12px;
}

p {
  color: #465365;
  font-size: 1.04rem;
  line-height: 1.75;
  margin-bottom: 18px;
}

.case-summary-card {
  position: sticky;
  top: 110px;
  padding: 28px;
  border-radius: 24px;
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.13), rgba(255, 255, 255, 0.045));
}

.case-summary-card dl {
  margin: 0;
}

.case-summary-card div {
  padding: 14px 0;
  border-bottom: 1px solid rgba(25, 33, 46, 0.09);
}

.case-summary-card div:last-child {
  border-bottom: 0;
}

.case-summary-card dt {
  color: #465365;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
  margin-bottom: 5px;
}

.case-summary-card dd {
  color: #19212e;
  margin: 0;
  font-weight: 700;
}

.case-image-card {
  overflow: hidden;
  border-radius: 26px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: #ffffff;
  box-shadow: 0 24px 80px rgba(25, 33, 46, 0.09);
}

.case-image-card img {
  display: block;
  width: 100%;
  height: auto;
  background: #ffffff;
}

.image-note {
  max-width: 820px;
  margin: 18px auto 0;
  text-align: center;
  color: #465365;
  font-size: 0.95rem;
}

.section-copy p:last-child,
.case-cta-card p:last-child {
  margin-bottom: 0;
}

.constraint-grid,
.result-grid,
.lesson-grid,
.service-link-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 34px;
}

.constraint-grid article,
.lesson-grid article,
.service-link-grid a {
  border-radius: 24px;
  padding: 28px;
}

.constraint-grid p,
.lesson-grid p,
.service-link-grid p {
  margin-bottom: 0;
}

.section-header {
  max-width: 840px;
  margin-bottom: 40px;
}

.section-header.compact {
  margin-bottom: 30px;
}

.work-list {
  display: grid;
  gap: 18px;
}

.work-item {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 24px;
  padding: 28px;
  border-radius: 24px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: rgba(255, 255, 255, 0.045);
}

.work-item > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: #f0622a;
  color: #19212e;
  font-weight: 900;
}

.work-item p {
  margin-bottom: 0;
}

.result-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.result-card {
  border-radius: 24px;
  padding: 24px;
}

.result-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 22px;
}

.result-topline span {
  color: #465365;
  font-weight: 800;
}

.result-topline strong {
  color: #b83e12;
  font-size: 1.5rem;
  white-space: nowrap;
}

.before-after {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}

.before-after div {
  padding: 14px;
  border-radius: 16px;
  background: rgba(25, 33, 46, 0.09);
}

.before-after span {
  display: block;
  color: #465365;
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.before-after strong {
  color: #19212e;
  font-size: 1.25rem;
}

.result-card p {
  color: #465365;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 0;
}

.commercial-card {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
  gap: clamp(28px, 5vw, 56px);
  align-items: center;
  padding: clamp(32px, 5vw, 56px);
  border-radius: 32px;
  border: 1px solid rgba(240, 98, 42, 0.25);
  background: linear-gradient(145deg, rgba(240, 98, 42, 0.12), rgba(255, 255, 255, 0.035));
}

.meaning-points {
  display: grid;
