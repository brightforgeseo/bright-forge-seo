---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "industrial-parts-washing-search-growth",
  metaTitle: "Industrial SEO: +50% Clicks | Bright Forge",
  description: "An anonymized Google Search Console case study showing an industrial parts-washing equipment manufacturer growing organic clicks by 49.7%.",
  title: "An industrial manufacturer added 350 organic clicks",
  breadcrumb: "Industrial Equipment Growth",
  industry: "Industrial equipment manufacturing",
  period: "90-day comparison; visual shows a 6 February to 3 August 2026 trend",
  lede: "The latest 90 days produced 1,054 organic clicks, up from 704. Impressions grew faster, by 68.9%, so click-through rate slipped from 1.57% to 1.40% and average position moved from 13.6 to 15.6. More searchers saw the site, and more of them clicked. The comparison does not show which equipment or process searches gained visibility, or whether those clicks led to inquiries.",
  evidenceImage: "/images/case-studies/industrial-parts-washing-search-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Google Search Console performance visual showing 1,054 clicks for an anonymized industrial parts-washing equipment manufacturer.",
  metrics: [
    { value: "+49.7%", label: "Organic clicks", note: "704 to 1,054" },
    { value: "+68.9%", label: "Impressions", note: "44,715 to 75,544" },
    { value: "+350", label: "Additional clicks", note: "Latest 90 days" },
    { value: "90 days", label: "Comparison window", note: "Two 90-day periods" }
  ],
  evidenceHeading: "Higher industrial search impressions and clicks, with lower CTR",
  evidenceIntro: "The redacted presentation visual reports 1,054 clicks and 75,544 impressions, with increases against the prior 90 days. Its trend runs from 6 February to 3 August 2026 and marks a split at 6 May; the exact comparison endpoints need the underlying export. The reported comparison below also retains lower CTR and worse average position.",
  problemHeading: "Technical products need visibility across specific use cases, not only broad category terms",
  problem: [
    "Industrial buyers describe the same need in different ways: by equipment type, by the process problem, by a specification, by a maintenance need or by a purchasing route. A manufacturer is found for those searches only when it has a page that answers each one, which broad category pages rarely do.",
    "Search Console can establish whether organic discovery is increasing. It cannot, on its own, prove which product pages or technical changes created the movement, so we keep the claim to what the data supports."
  ],
  readingHeading: "More recorded exposure; the next check is which searches changed",
  reading: [
    "Impressions rose by 30,829 and clicks rose by 350. That establishes higher recorded exposure, not the relevance of the searches. The reported blended click-through rate slipped from 1.57% to 1.40%.",
    "Average position also moved from 13.6 to 15.6. A site that starts appearing for new searches at lower positions will show exactly this pattern, but so will one that lost ground on searches it already held. We would compare existing and newly appearing queries separately, then review the pages where impressions rose without matching click growth. The aggregate figures do not identify those groups."
  ],
  takeaways: [
    "Measure industrial visibility by product, service and process intent. A domain-wide average blends them into one number nobody can act on.",
    "A larger impression base is an opportunity to earn inquiries. It is not yet evidence of one.",
    "Search Console is strongest when it directs page-level and query-level improvements after the headline trend is understood."
  ],
  results: [
    { metric: "Organic clicks", before: "704", after: "1,054", note: "+49.7%, or 350 additional clicks" },
    { metric: "Impressions", before: "44,715", after: "75,544", note: "+68.9%, or 30,829 additional impressions" },
    { metric: "Average position", before: "13.6", after: "15.6", note: "Worse by 2.0 positions; review query-level changes before choosing work" },
    { metric: "Click-through rate", before: "1.57%", after: "1.40%", note: "Lower aggregate CTR; the cause is not established" }
  ],
  boundary: "This is an anonymized Google Search Console case study for a 90-day versus 90-day comparison. The client, property, search queries and URLs are redacted. The public visual is a redacted presentation, not a raw query export. Previous-window totals and CTR are retained from the published comparison; the visual does not display those values. It records organic-search visibility and clicks, not revenue, inquiries, product sales or a guaranteed future outcome. Search Console data alone cannot single out a tactic, and as a measured comparison rather than a work log, this case does not try to."
};
---
<GscCaseStudyPage data={data} />
