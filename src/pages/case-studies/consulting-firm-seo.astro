---
import MainLayout from '../../layouts/MainLayout.astro';
import LegacyHeader from '../../components/LegacyHeader.astro';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection.astro';
import Hero from '../../components/Hero.astro';
import ButtonPrimary from '../../components/ButtonPrimary.astro';
import ButtonSecondary from '../../components/ButtonSecondary.astro';

const caseStudyData = {
  title: "Conscient SEO: 19% More Organic Clicks",
  client: "Conscient",
  website: "https://www.conscient.co.uk/",
  industry: "Business Consulting",
  duration: "6-month comparison",
  heroImage: "/images/case-studies/SEO Case Study- Increasing Organic Traffic for a Consulting Firm .webp",
  challenge: "Conscient is a B2B tech marketing and strategy agency offering services including brand and messaging, content creation and consultancy. The commercial question is whether the extra search appearances reached businesses looking for that support. The aggregate comparison does not identify those buyers.",
  solution: "The published Google Search Console screenshot compares Last 6 months / Previous 6 months. Clicks increased from 13.2K to 15.7K and impressions from 398K to 742K, while CTR fell from 3.3% to 2.1%. It records search performance, not a sequence of implemented changes or a lead result.",
  keyMetrics: [
    {
      label: "Organic Clicks",
      value: "+19%",
      description: "Increase in total clicks from search"
    },
    {
      label: "Search Visibility",
      value: "+86%",
      description: "Growth in total impressions"
    },
    {
      label: "Average Position",
      value: "Improved",
      description: "Average position from 23.3 to 21.7"
    }
  ],
  strategySteps: [
    {
      title: "Separate buyer queries",
      description: "Review queries by service and buyer need. Brand searches, research questions and consultancy enquiries should not be treated as equally valuable.",
      icon: "fa-search"
    },
    {
      title: "Review service-page entry points",
      description: "Identify the pages receiving the additional impressions, then check whether their titles and descriptions accurately explain the service offered.",
      icon: "fa-file-alt"
    },
    {
      title: "Check navigation and internal links",
      description: "Check whether a visitor can move from an informational page to the relevant consulting service and an appropriate enquiry route.",
      icon: "fa-sitemap"
    },
    {
      title: "Assess supporting evidence",
      description: "Review the experience and supporting examples on service pages. The performance screenshot does not establish that backlinks were acquired.",
      icon: "fa-link"
    },
    {
      title: "Measure enquiries separately",
      description: "Match landing-page visits with recorded enquiries over the same period before assessing whether search growth brought suitable prospects.",
      icon: "fa-chart-line"
    }
  ],
  results: [
    {
      metric: "Total Clicks",
      before: "13,200",
      after: "15,700",
      improvement: "+19%"
    },
    {
      metric: "Total Impressions",
      before: "398,000",
      after: "742,000",
      improvement: "+86%"
    },
    {
      metric: "Average Position",
      before: "23.3",
      after: "21.7",
      improvement: "1.6 positions better"
    },
    {
      metric: "Click-Through Rate",
      before: "3.3%",
      after: "2.1%",
      improvement: "-1.2 percentage points"
    }
  ],
  keyTakeaways: [
    "Impressions rose faster than clicks: +86% versus +19%, using the rounded displayed totals.",
    "CTR fell from 3.3% to 2.1%. More search appearances did not translate into a proportionate rise in clicks.",
    "Average position improved from 23.3 to 21.7, but the screenshot does not show individual service-query rankings.",
    "Two period totals do not establish whether impressions increased before clicks or whether visitors were suitable buyers.",
    "The next useful check is which pages gained impressions and which generated enquiries, rather than assuming all additional visibility had equal value."
  ]
};
---

<MainLayout title="Organic Gains for Consultant Firm | Bright Forge SEO" description="Conscient recorded 19% more organic clicks and 86% more impressions in a six-month Search Console comparison, with CTR falling from 3.3% to 2.1%.">
  <LegacyHeader slot="header" />

  <!-- Hero Section -->
  <Hero
    title={caseStudyData.client}
    breadcrumbCurrent="Conscient"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span class="meta-item">{caseStudyData.industry}</span>
        <span class="meta-divider">•</span>
        <span class="meta-item">{caseStudyData.duration}</span>
      </div>
      <p>We worked on <a href="https://www.conscient.co.uk/" rel="noopener">conscient.co.uk</a>. The published comparison shows 19% more organic clicks and 86% more impressions. CTR fell from 3.3% to 2.1%; the figures do not measure enquiry quality.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Full Results" />
      <ButtonSecondary href="/contact/" text="Discuss Your Project" />
    </Fragment>
  </Hero>

  <!-- Key Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="metrics-grid">
        {caseStudyData.keyMetrics.map((metric) => (
          <div class="metric-card">
            <div class="metric-value">{metric.value}</div>
            <div class="metric-label">{metric.label}</div>
            <div class="metric-description">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hero Image Section -->
  <section class="image-section">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="case-image-container">
        <img src={caseStudyData.heroImage} alt={`${caseStudyData.client} Performance Dashboard`} />
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">The <span>business question</span></h2>
      <p class="section-text">{caseStudyData.challenge}</p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="content-section gray">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">What the <span>comparison shows</span></h2>
      <p class="section-text">{caseStudyData.solution}</p>
    </div>
  </section>

  <!-- Strategy Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Recommended follow-up checks</span></h2>
      <p class="section-text">These are review priorities, not a verified log of work delivered for Conscient. Exact calendar dates and query filters are not displayed in the screenshot.</p>

      <div class="strategy-list">
        {caseStudyData.strategySteps.map((step, index) => (
          <div class="strategy-item">
            <div class="strategy-number">{index + 1}</div>
            <div class="strategy-content">
              <h3 class="strategy-title">{step.title}</h3>
              <p class="strategy-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="content-section gray" id="results">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Results</span></h2>

      <div class="results-table">
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Previous 6 months</th>
              <th>Last 6 months</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            {caseStudyData.results.map((result) => (
              <tr>
                <td class="metric-name">{result.metric}</td>
                <td>{result.before}</td>
                <td>{result.after}</td>
                <td class="improvement">{result.improvement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Key Takeaways Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Key Takeaways</span></h2>

      <ul class="takeaways-list">
        {caseStudyData.keyTakeaways.map((takeaway) => (
          <li>{takeaway}</li>
        ))}
      </ul>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
/* Case Study Meta */
.case-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #19212e;
}

.meta-item {
  color: #19212e;
}

.meta-divider {
  opacity: 0.5;
}

/* Metrics Section */
.metrics-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 48px;
}

.metric-card {
  text-align: center;
  padding: 24px 0;
}

.metric-value {
  font-size: 3rem;
  font-weight: 800;
  color: #b83e12;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.metric-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.metric-description {
  font-size: 0.875rem;
  color: #19212e;
}

/* Image Section */
.image-section {
  background: #f7f8fa;
}

.case-image-container {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(25, 33, 46, 0.08);
}

.case-image-container img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  background: #ffffff;
}

/* Content Sections */
.content-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.content-section.gray {
  background: #ffffff;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: #19212e;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.section-text {
  font-size: 1.125rem;
  line-height: 1.8;
  color: #19212e;
}

/* Strategy List */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 32px;
  margin-top: 32px;
}

.strategy-item {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.strategy-number {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: #f0622a;
  color: #19212e;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
}

.strategy-content {
  flex: 1;
}

.strategy-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #19212e;
  margin-bottom: 8px;
}

.strategy-description {
  font-size: 1rem;
  line-height: 1.6;
  color: #19212e;
}

/* Results Table */
.results-table {
  margin-top: 32px;
  overflow-x: auto;
}

.results-table table {
  width: 100%;
  border-collapse: collapse;
}

.results-table th {
  text-align: left;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.05);
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #e2e8f0;
}

.results-table td {
  padding: 20px;
  font-size: 1rem;
  color: #19212e;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table .metric-name {
  font-weight: 600;
}

.results-table .improvement {
  color: #b83e12;
  font-weight: 600;
}

/* Takeaways List */
.takeaways-list {
  list-style: none;
  padding: 0;
  margin: 32px 0 0 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.takeaways-list li {
  font-size: 1.125rem;
  line-height: 1.7;
  color: #19212e;
  padding-left: 32px;
  position: relative;
}

.takeaways-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  width: 6px;
  height: 6px;
  background: #f0622a;
  border-radius: 50%;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .metric-value {
    font-size: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
  }

  .strategy-item {
    gap: 16px;
  }

  .strategy-number {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .results-table {
    font-size: 0.875rem;
  }

  .results-table th,
  .results-table td {
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>
