---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/case-studies/leather-wallet-ecommerce-seo/";
const image = "/images/case-studies/leather-wallet-ecommerce-seo.webp";
const metrics = [
  {
    "label": "Organic clicks",
    "before": "15.2k",
    "after": "22.7k",
    "change": "+49.3%"
  },
  {
    "label": "Impressions",
    "before": "485k",
    "after": "500k",
    "change": "+3.1%"
  },
  {
    "label": "Average CTR",
    "before": "3.1%",
    "after": "4.5%",
    "change": "+1.4pp"
  },
  {
    "label": "Average position",
    "before": "15.2",
    "after": "13.8",
    "change": "Modest lift"
  }
];
const workstreams = [
  {
    "title": "Snippet and title testing",
    "text": "Compare titles and descriptions with the actual wallet style, leather and gift information on each page. Test specific changes against a fixed query set before attributing a CTR improvement."
  },
  {
    "title": "Product and category alignment",
    "text": "Check whether product and category pages explain dimensions, capacity, material and available designs. A customer comparing wallets needs those details alongside the photographs."
  },
  {
    "title": "Internal link improvement",
    "text": "Link material, care and gift guidance to the relevant wallets and collections. Check that a buyer can get from the answer to an available product."
  },
  {
    "title": "Structured ecommerce signals",
    "text": "Check product structured data against visible price, availability and product details. Do not mark up information the customer cannot verify on the page."
  },
  {
    "title": "Search Console monitoring",
    "text": "Compare the same queries and pages year on year, then review devices and countries separately. Keep search clicks distinct from measured product sales."
  }
];
const results = [
  {
    "metric": "Organic clicks",
    "before": "15.2k",
    "after": "22.7k",
    "change": "+49.3%",
    "note": "The rounded totals show about 7.5k more clicks than in the same three-month period a year earlier."
  },
  {
    "metric": "Impressions",
    "before": "485k",
    "after": "500k",
    "change": "+3.1%",
    "note": "The impression total increased slightly. That does not establish that the query mix stayed the same."
  },
  {
    "metric": "Average CTR",
    "before": "3.1%",
    "after": "4.5%",
    "change": "+1.4pp",
    "note": "The displayed click-through rate rose by 1.4 percentage points. These totals do not isolate a snippet or page-change effect."
  },
  {
    "metric": "Average position",
    "before": "15.2",
    "after": "13.8",
    "change": "Modest lift",
    "note": "The blended average position improved by 1.4 positions. It does not show how many queries reached the first page."
  }
];
const constraints = [
  {
    "title": "Crowded ecommerce results",
    "text": "The brand had to compete with marketplaces, retailer category pages and other direct-to-consumer leather goods brands."
  },
  {
    "title": "CTR increased",
    "text": "Clicks grew faster than the impression total. The aggregate comparison cannot distinguish snippet changes from changes in query mix or search demand."
  },
  {
    "title": "Product intent varied",
    "text": "Style, material, capacity and gift suitability are useful product-page questions. The screenshot does not show the actual query groups."
  },
  {
    "title": "Ranking movement was modest",
    "text": "Average position improved from 15.2 to 13.8. Individual query movements may differ from that average."
  }
];
const lessons = [
  "CTR gains need context. A higher click-through rate matters most when the traffic lands on pages that can sell or move users to the next step.",
  "Product SEO is not just writing descriptions. Page structure, snippet language, internal links and commercial proof all affect how the page performs.",
  "Inspect the query distribution before deciding which product pages need ranking work. An aggregate average does not identify the pages closest to an improvement.",
  "Search Console can show whether the issue is visibility, CTR, ranking depth or page mismatch. Each problem needs a different fix."
];
const faqs = [
  {
    "question": "What was the main result in this leather wallet SEO case study?",
    "answer": "Organic clicks increased from 15.2k to 22.7k, a 49.3% lift. CTR also improved from 3.1% to 4.5%, while impressions rose only slightly."
  },
  {
    "question": "Was this mainly a ranking improvement?",
    "answer": "Average position improved from 15.2 to 13.8 and CTR rose from 3.1% to 4.5%. The aggregate comparison does not isolate how much of the click increase came from ranking changes, query mix or other factors."
  },
  {
    "question": "Which product-page checks are relevant to this comparison?",
    "answer": "Review wallet details, titles, descriptions, category links and product structured data. These are recommended checks, not a verified implementation history or a claim that they caused the recorded increase."
  },
  {
    "question": "Why does CTR matter for ecommerce SEO?",
    "answer": "CTR is the share of recorded impressions that generated clicks. It can help prioritise a page review, but it does not measure shopper qualification or sales. Compare like-for-like queries before judging a snippet change."
  },
  {
    "question": "Can this approach work for other ecommerce stores?",
    "answer": "Yes, when the store already has visibility or useful product demand. The exact plan should still begin with a crawl, keyword mapping and Search Console review."
  },
  {
    "question": "Does Bright Forge guarantee the same ecommerce SEO result?",
    "answer": "No. Results depend on the market, site quality, product demand, competition and implementation. Case studies show the kind of thinking involved, not a guaranteed outcome."
  }
];
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Leather Wallet SEO Case Study",
  "description": "Lost Dutchman Leather Search Console comparison: organic clicks rose from 15.2k to 22.7k versus the same three-month period a year earlier.",
  "image": "https://brightforge.com.ph/images/case-studies/leather-wallet-ecommerce-seo.webp",
  "author": {
    "@type": "Organization",
    "name": "Bright Forge SEO",
    "url": "https://brightforge.com.ph/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bright Forge SEO",
    "logo": {
      "@type": "ImageObject",
      "url": "https://brightforge.com.ph/images/header-logo-360w.webp"
    }
  },
  "mainEntityOfPage": "https://brightforge.com.ph/case-studies/leather-wallet-ecommerce-seo/",
  "articleSection": "SEO Case Studies",
  "about": [
    "Ecommerce SEO",
    "On-page SEO",
    "Content SEO",
    "Product SEO"
  ]
};
---

<MainLayout
  title="Leather Wallet SEO Case Study | Bright Forge"
  description="Lost Dutchman Leather Search Console comparison: organic clicks rose from 15.2k to 22.7k versus the same three-month period a year earlier."
  canonical={canonical}
  image={image}
  type="article"
  author={{ name: "Bright Forge SEO", url: "https://brightforge.com.ph/" }}
  article={{ section: "SEO Case Studies", tags: [
  "Ecommerce SEO",
  "On-page SEO",
  "Content SEO",
  "Product SEO"
] }}
  breadcrumbs={[
    { name: "Home", url: "https://brightforge.com.ph/" },
    { name: "Case Studies", url: "https://brightforge.com.ph/case-studies/" },
    { name: "Lost Dutchman Leather SEO", url: canonical }
  ]}
  faqs={faqs}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} /></Fragment>
  <LegacyHeader slot="header" />
  <Hero title="Lost Dutchman Leather <span>SEO Case Study</span>" breadcrumbCurrent="Lost Dutchman Leather">
    <Fragment slot="story">
      <div class="case-meta"><span>Handmade wallets</span><span><a href="https://www.lostdutchmanleather.com/" rel="noopener">lostdutchmanleather.com</a></span><span>Last 3 months versus Same period last year</span></div>
      <p class="hero-subtitle">How Lost Dutchman Leather increased organic clicks by 49.3% while average position only moved from 15.2 to 13.8.</p>
      <p>Arizona-based Lost Dutchman Leather makes full-grain wallets by hand in the USA. The screenshot records higher organic clicks and CTR than in the same three-month period a year earlier. It does not establish which page changes contributed.</p>
    </Fragment>
    <Fragment slot="actions"><ButtonPrimary href="#results" text="View Results" /><ButtonSecondary href="/contact/" text="Request an SEO Review" /></Fragment>
  </Hero>
  <main class="case-study-page">
    <section class="proof-strip"><div class="case-container"><div class="proof-grid">{metrics.map((metric) => (<article class="proof-card"><span class="proof-label">{metric.label}</span><strong>{metric.change}</strong><span>{metric.before} to {metric.after}</span></article>))}</div></div></section>
    <section class="overview-section"><div class="case-container overview-grid"><div><p class="eyebrow">The short version</p><h2><span>Better click capture</span> from a competitive ecommerce SERP</h2><p>The leather wallet market is crowded with marketplaces, established brands and product-led direct competitors. For a buyer comparing wallets, material, dimensions, capacity and delivery information can matter as much as appearance. Those are useful page-review priorities, separate from what the search totals establish.</p><p>Clicks increased from 15.2k to 22.7k, while impressions only rose from 485k to 500k. CTR rose alongside a modest average-position improvement. These are aggregate observations, not proof that the same queries improved or that most keywords occupied a particular results page.</p></div><aside class="case-summary-card"><h3>Campaign snapshot</h3><dl><div><dt>Industry</dt><dd>Lost Dutchman Leather wallets</dd></div><div><dt>Market type</dt><dd>Direct-to-consumer retail</dd></div><div><dt>Timeframe</dt><dd>Last 3 months versus Same period last year</dd></div><div><dt>Main KPI</dt><dd>Organic clicks from Google Search</dd></div><div><dt>Recommended review</dt><dd>Wallet details, snippets, category links and product structured data</dd></div></dl></aside></div></section>
    <section class="visual-proof-section"><div class="case-container"><div class="case-image-card"><img src={image} alt="Search Console comparison for a leather wallet ecommerce SEO campaign" loading="eager" decoding="async" /></div><p class="image-note">Search Console metrics used in this case study: 15.2k to 22.7k clicks, 485k to 500k impressions, CTR 3.1% to 4.5% and average position 15.2 to 13.8. The selector is Last 3 months versus Same period last year; exact calendar dates and country/device filters are not visible. Percentage changes are approximate because the displayed counts are rounded.</p></div></section>
    <section class="content-section" id="challenge"><div class="case-container two-column"><div><p class="eyebrow">Starting problem</p><h2>Wallet buyers need <span>product detail</span> before choosing a store</h2></div><div><p>A leather wallet buyer may be comparing material, design, delivery, durability, gift suitability and price before clicking. If title tags and descriptions look generic, the page can lose the click even when it appears for a useful query.</p><p>A review should check whether those product details are clear on the page and accurately reflected in search. The comparison image cannot diagnose which titles or product pages needed work.</p></div></div></section>
    <section class="constraints-section"><div class="case-container"><p class="eyebrow">Constraints</p><h2>What to check before explaining the <span>click increase</span></h2><div class="constraint-grid">{constraints.map((item) => (<article><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section class="work-section" id="work"><div class="case-container"><p class="eyebrow">Recommended product-page checks</p><h2>Review wallet details, search snippets and <span>page quality</span></h2><p>These checks are recommendations for a product-page review, not a verified record of work completed during the comparison.</p><div class="work-grid">{workstreams.map((item, index) => (<article class="work-item"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
    <section class="results-section" id="results"><div class="case-container"><p class="eyebrow">What moved</p><h2><span>Clicks rose faster</span> than impressions, which makes CTR the important story</h2><div class="result-grid">{results.map((result) => (<article class="result-card"><div><span class="proof-label">{result.metric}</span><strong>{result.change}</strong></div><div class="before-after"><div><span>Before</span><strong>{result.before}</strong></div><div><span>After</span><strong>{result.after}</strong></div></div><p>{result.note}</p></article>))}</div></div></section>
    <section class="commercial-section"><div class="case-container commercial-card"><div><p class="eyebrow">Commercial meaning</p><h2>The next measure is <span>product sales</span>, not clicks alone</h2><p>The comparison establishes search clicks, not orders or revenue. A click may come from a potential customer, an existing customer or someone researching leather goods; the screenshot cannot distinguish them.</p><p>To choose the next improvement, identify which landing pages gained clicks and whether those visits led to product views, carts and completed orders. Keep the reported 49.3% click lift separate from that commercial assessment.</p></div><div class="case-summary-card"><h3>What matters here</h3><p>This case shows how clicks, impressions, CTR and average position can move by different amounts. It does not diagnose weak snippets or prove that a product-page edit caused the change.</p></div></div></section>
    <section class="lessons-section"><div class="case-container"><p class="eyebrow">Lessons</p><h2>What <span>ecommerce brands</span> should take from this</h2><div class="lesson-grid">{lessons.map((lesson) => (<article><p>{lesson}</p></article>))}</div></div></section>
    <section class="related-services-section"><div class="case-container"><p class="eyebrow">Related services</p><h2>Where this kind of <span>work fits</span></h2><div class="service-link-grid"><a href="/technical-seo-services-philippines/"><span>Technical SEO</span>Fix crawl, structure, performance and indexation issues.</a><a href="/on-page-seo-services-philippines/"><span>On-page SEO</span>Improve page relevance, snippets and conversion paths.</a><a href="/content-seo-services-philippines/"><span>SEO content</span>Turn search intent into stronger pages and supporting content.</a></div></div></section>
    <section class="faq-section"><div class="case-container faq-layout"><div><p class="eyebrow">FAQ</p><h2>Questions this <span>case study</span> should answer</h2></div><div class="faq-list">{faqs.map((faq) => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
    <section class="case-cta-section"><div class="case-container"><div class="case-cta-card"><h2>Want to know what is holding your <span>search traffic</span> back?</h2><p>We can review the pages, queries and technical signals that matter before recommending any rewrite, content plan or link activity.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request an SEO Review" /><ButtonSecondary href="/case-studies/" text="View More Case Studies" /></div></div></div></section>
  </main>
  <Footer slot="footer" />
</MainLayout>

<style>
.case-study-page { background: #ffffff; color: #19212e; }
.case-container { width: min(100% - 40px, 1120px); margin: 0 auto; }
.case-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
.case-meta span { padding: 8px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.09); color: #465365; font-size: .86rem; font-weight: 800; }
.hero-subtitle { color: #19212e; font-weight: 900; font-size: clamp(1.15rem, 2vw, 1.45rem); }
.proof-strip, .overview-section, .visual-proof-section, .content-section, .constraints-section, .work-section, .results-section, .commercial-section, .lessons-section, .related-services-section, .faq-section, .case-cta-section { padding: 78px 0; content-visibility: visible !important; }
.proof-grid, .constraint-grid, .work-grid, .result-grid, .lesson-grid, .service-link-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
.proof-card, .case-summary-card, .case-image-card, .constraint-grid article, .work-item, .result-card, .lesson-grid article, .service-link-grid a, .faq-item, .case-cta-card { border: 1px solid rgba(25, 33, 46, 0.09); background: rgba(255, 255, 255, 0.045); border-radius: 24px; box-shadow: 0 18px 48px rgba(25, 33, 46, 0.09); }
.proof-card { padding: 24px; }
.proof-label, .eyebrow { display: block; color: #b83e12; font-size: .78rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; }
.proof-card strong { display: block; color: #19212e; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; margin-bottom: 8px; }
.proof-card span:last-child { color: #465365; }
.overview-section, .constraints-section, .results-section, .lessons-section, .faq-section { background: #ffffff; }
.overview-grid, .two-column, .commercial-card, .faq-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: clamp(30px, 5vw, 60px); align-items: start; }
h2 { color: #19212e; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; margin: 0 0 22px; }
h3 { color: #19212e; font-size: 1.15rem; margin: 0 0 10px; }
p, li, dd { color: #465365; font-size: 1.02rem; line-height: 1.72; }
a { color: #b83e12; }
.case-summary-card, .constraint-grid article, .work-item, .result-card, .lesson-grid article, .service-link-grid a { padding: 24px; }
.case-summary-card dl { display: grid; gap: 14px; margin: 0; }
.case-summary-card div { display: grid; gap: 4px; padding-bottom: 14px; border-bottom: 1px solid rgba(25, 33, 46, 0.08); }
dt { color: #465365; font-weight: 900; text-transform: uppercase; font-size: .75rem; letter-spacing: .08em; }
.case-image-card { overflow: hidden; padding: 10px; background: rgba(255, 255, 255, 0.07); }
.case-image-card img { width: 100%; border-radius: 18px; display: block; }
.image-note { font-size: .92rem; margin-top: 14px; color: #465365; }
.work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.work-item span { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; color: #19212e; background: rgba(240,98,42,.25); font-weight: 900; margin-bottom: 18px; }
.result-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.result-card strong { color: #b83e12; font-size: 1.7rem; }
.before-after { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 18px 0; }
.before-after div { padding: 14px; border-radius: 16px; background: rgba(25, 33, 46, 0.09); }
.before-after span { display: block; color: #465365; font-size: .75rem; font-weight: 900; text-transform: uppercase; margin-bottom: 6px; }
.commercial-card { padding: clamp(32px, 5vw, 58px); border-radius: 32px; background: linear-gradient(145deg, rgba(240,98,42,.14), rgba(255, 255, 255, 0.04)); }
.lesson-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.service-link-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.service-link-grid a { color: inherit; text-decoration: none; }
.service-link-grid span { display: block; color: #19212e; font-weight: 900; margin-bottom: 8px; }
.faq-list { display: grid; gap: 14px; }
.faq-item { overflow: hidden; }
.faq-item summary { cursor: pointer; padding: 22px 24px; color: #19212e; font-weight: 900; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item p { padding: 0 24px 24px; margin: 0; }
.case-cta-card { text-align: center; padding: clamp(36px, 6vw, 68px); background: radial-gradient(circle at top left, rgba(240,98,42,.22), rgba(255, 255, 255, 0.045)); }
.cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
@media (max-width: 920px) { .proof-grid, .constraint-grid, .work-grid, .result-grid, .lesson-grid, .service-link-grid, .overview-grid, .two-column, .commercial-card, .faq-layout { grid-template-columns: 1fr; } }
</style>

