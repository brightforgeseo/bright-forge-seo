---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/ContactSection.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const caseStudyData = {
  title: "SEO Case Study: 29% More Organic Clicks for a Car Recycling Company",
  client: "Confidential Car Recycler",
  industry: "Car Recycling",
  duration: "3-month comparison",
  heroImage: "/images/case-studies/SEO Case Study- Boosting Organic Traffic for a Car Recycling Client.webp",
  challenge: "For this anonymous car recycler, the search comparison shows more clicks and impressions. Whether those visits became suitable enquiries is a separate question: the screenshot does not measure leads, calls or completed transactions.",
  solution: "The published Search Console screenshot compares Last 3 months / Previous 3 months. Clicks increased from 4.96K to 6.38K and impressions from 120K to 213K. Average position improved from 29.1 to 24.9, while CTR fell from 4.1% to 3.0%.",
  keyMetrics: [
    { label: "Total Clicks", value: "+29%", description: "4,960 ➜ 6,380" },
    { label: "Total Impressions", value: "+78%", description: "120k ➜ 213k" },
    { label: "Average Position", value: "29.1 ➜ 24.9", description: "Improved" },
    { label: "CTR", value: "4.1% ➜ 3.0%", description: "CTR decreased" }
  ],
  strategySteps: [
    { title: "Keyword Research", description: "Review the queries behind the extra impressions and separate service enquiries from general recycling research.", icon: "fas fa-search" },
    { title: "On-Page Optimisation", description: "Check whether the landing pages explain the actual service and its geographic coverage. Confirm those details with the business before changing copy.", icon: "fas fa-file-alt" },
    { title: "Technical SEO", description: "Check crawlability and mobile enquiry paths before proposing technical changes. The chart does not identify a technical defect or fix.", icon: "fas fa-cogs" },
    { title: "Compare landing pages", description: "Find which pages gained clicks and which lost CTR, then compare their query mix over the same windows.", icon: "fas fa-link" },
    { title: "Performance Monitoring", description: "Measure calls and enquiries separately from search clicks, with a consistent reporting period and clear event definitions.", icon: "fas fa-chart-line" }
  ],
  results: [
    { metric: "Total Clicks", before: "4,960", after: "6,380", improvement: "+29%" },
    { metric: "Total Impressions", before: "120,000", after: "213,000", improvement: "+78%" },
    { metric: "Average Position", before: "29.1", after: "24.9", improvement: "Improved" },
    { metric: "Click-Through Rate", before: "4.1%", after: "3.0%", improvement: "-1.1 percentage points" }
  ],
  keyTakeaways: [
    "Clicks rose by about 29% using the rounded totals. This one comparison does not establish how quickly another business could grow.",
    "Impressions rose faster than clicks, while CTR declined from 4.1% to 3.0%. The decline should remain visible alongside the gains.",
    "Average position improved, but no backlink, lead or revenue outcome can be attributed from this screenshot alone."
  ]
};
---

<MainLayout title="Car Recycling Company SEO Case Study | Bright Forge SEO" description="An anonymous car recycler recorded 29% more organic clicks in a three-month Search Console comparison. CTR fell from 4.1% to 3.0%; lead outcomes are not measured.">
  <LegacyHeader slot="header" />

  <!-- Hero Section -->
  <Hero
    title={caseStudyData.client}
    breadcrumbCurrent="Car Recycling Business"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span class="meta-item">{caseStudyData.industry}</span>
        <span class="meta-divider">•</span>
        <span class="meta-item">{caseStudyData.duration}</span>
      </div>
      <p>This anonymous car recycler recorded 6,380 organic clicks, up from 4,960 in the previous three-month period. Impressions and average position improved, but CTR fell from 4.1% to 3.0%.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Full Results" />
      <ButtonSecondary href="/contact/" text="Discuss Your Project" />
    </Fragment>
  </Hero>

  <!-- Key Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="metrics-grid">
        {caseStudyData.keyMetrics.map((metric) => (
          <div class="metric-card">
            <div class="metric-value">{metric.value}</div>
            <div class="metric-label">{metric.label}</div>
            <div class="metric-description">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hero Image Section -->
  <section class="image-section">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="case-image-container">
        <img src={caseStudyData.heroImage} alt={`${caseStudyData.client} Performance Dashboard`} />
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">The <span>business question</span></h2>
      <p class="section-text">{caseStudyData.challenge}</p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="content-section gray">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">What the <span>comparison shows</span></h2>
      <p class="section-text">{caseStudyData.solution}</p>
    </div>
  </section>

  <!-- Strategy Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Recommended follow-up checks</span></h2>
      <p class="section-text">These checks are recommendations, not a record of completed work. The screenshot does not show exact calendar dates, query filters or which changes were implemented.</p>

      <div class="strategy-list">
        {caseStudyData.strategySteps.map((step, index) => (
          <div class="strategy-item">
            <div class="strategy-number">{index + 1}</div>
            <div class="strategy-content">
              <h3 class="strategy-title">{step.title}</h3>
              <p class="strategy-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="content-section gray" id="results">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Results</span></h2>

      <div class="results-table">
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Previous 3 months</th>
              <th>Last 3 months</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            {caseStudyData.results.map((result) => (
              <tr>
                <td class="metric-name">{result.metric}</td>
                <td>{result.before}</td>
                <td>{result.after}</td>
                <td class="improvement">{result.improvement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Key Takeaways Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Key Takeaways</span></h2>

      <ul class="takeaways-list">
        {caseStudyData.keyTakeaways.map((takeaway) => (
          <li>{takeaway}</li>
        ))}
      </ul>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
/* Case Study Meta */
.case-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #19212e;
}

.meta-item {
  color: #19212e;
}

.meta-divider {
  opacity: 0.5;
}

/* Metrics Section */
.metrics-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 48px;
}

.metric-card {
  text-align: center;
  padding: 24px 0;
}

.metric-value {
  font-size: 3rem;
  font-weight: 800;
  color: #b83e12;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.metric-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.metric-description {
  font-size: 0.875rem;
  color: #19212e;
}

/* Image Section */
.image-section {
  background: #f7f8fa;
}

.case-image-container {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(25, 33, 46, 0.08);
}

.case-image-container img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  background: #ffffff;
}

/* Content Sections */
.content-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.content-section.gray {
  background: #ffffff;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: #19212e;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.section-text {
  font-size: 1.125rem;
  line-height: 1.8;
  color: #19212e;
}

/* Strategy List */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 32px;
  margin-top: 32px;
}

.strategy-item {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.strategy-number {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: #f0622a;
  color: #19212e;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
}

.strategy-content {
  flex: 1;
}

.strategy-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #19212e;
  margin-bottom: 8px;
}

.strategy-description {
  font-size: 1rem;
  line-height: 1.6;
  color: #19212e;
}

/* Results Table */
.results-table {
  margin-top: 32px;
  overflow-x: auto;
}

.results-table table {
  width: 100%;
  border-collapse: collapse;
}

.results-table th {
  text-align: left;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.05);
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #e2e8f0;
}

.results-table td {
  padding: 20px;
  font-size: 1rem;
  color: #19212e;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table .metric-name {
  font-weight: 600;
}

.results-table .improvement {
  color: #b83e12;
  font-weight: 600;
}

/* Takeaways List */
.takeaways-list {
  list-style: none;
  padding: 0;
  margin: 32px 0 0 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.takeaways-list li {
  font-size: 1.125rem;
  line-height: 1.7;
  color: #19212e;
  padding-left: 32px;
  position: relative;
}

.takeaways-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  width: 6px;
  height: 6px;
  background: #f0622a;
  border-radius: 50%;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .metric-value {
    font-size: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
  }

  .strategy-item {
    gap: 16px;
  }

  .strategy-number {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .results-table {
    font-size: 0.875rem;
  }

  .results-table th,
  .results-table td {
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>
