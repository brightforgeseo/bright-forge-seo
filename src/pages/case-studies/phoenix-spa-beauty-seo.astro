---
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import ContactSection from "../../components/ContactSection.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

const caseStudyData = {
  title: "Phoenix Brighton Spa SEO Case Study",
  client: "Phoenix Brighton Spa",
  website: "https://www.phoenixbrighton.co.uk/",
  industry: "Beauty & Wellness",
  duration: "6 Months",
  heroImage: "/images/case-studies/SEO Case Study- Growing Organic Traffic for Phoenix Spa and Beauty – Beauty Salon and Spa .webp",
  challenge: "Breaking through a competitive local spa & beauty market while targeting location-based service keywords and building online trust.",
  solution: "Local keyword research, content optimisation, Google Business Profile improvements, on-page technical fixes and authority link building drove significant traffic growth.",
  keyMetrics: [
    { label: "Total Clicks", value: "+70%", description: "5,570 → 9,480" },
    { label: "Total Impressions", value: "+188%", description: "145k → 418k" },
    { label: "Avg. Position", value: "17.8 → 21.5", description: "Worse aggregate position" },
    { label: "CTR", value: "3.8% → 2.3%", description: "CTR decreased" }
  ],
  strategySteps: [
    { title: "Local Keyword Research", description: "Focused on geo-targeted spa & beauty service terms." },
    { title: "Content Optimisation", description: "Optimised service pages & blog content for local intent." },
    { title: "Technical SEO", description: "Improved site speed & mobile UX for appointment bookings." },
    { title: "GBP & Schema", description: "Enhanced Google Business Profile & added structured data." },
    { title: "Authority Backlinks", description: "Earned links from wellness blogs and local directories." }
  ],
  results: [
    { metric: "Total Clicks", before: "5,570", after: "9,480", improvement: "+70%" },
    { metric: "Total Impressions", before: "145,000", after: "418,000", improvement: "+188%" },
    { metric: "Average Position", before: "17.8", after: "21.5", improvement: "Worse aggregate position" },
    { metric: "Click-Through Rate", before: "3.8%", after: "2.3%", improvement: "CTR decreased" }
  ],
  keyTakeaways: [
    "Local SEO focus drives foot-traffic oriented businesses.",
    "GBP enhancements complement on-site optimisation.",
    "Authority citations build consumer trust in service niches."
  ]
};
---

<MainLayout title="Phoenix Brighton Spa SEO Case Study | Bright Forge" description="Phoenix Brighton Spa's archived Search Console comparison shows higher clicks and impressions alongside lower CTR. Review the source and campaign scope.">
  <LegacyHeader slot="header" />

  <!-- Hero Section -->
  <Hero
    title={caseStudyData.client}
    breadcrumbCurrent="Phoenix Brighton Spa"
  >
    <Fragment slot="story">
      <div class="case-meta">
        <span class="meta-item">{caseStudyData.industry}</span>
        <span class="meta-divider">•</span>
        <span class="meta-item">{caseStudyData.duration}</span>
      </div>
      <p>We worked on <a href="https://www.phoenixbrighton.co.uk/" rel="noopener">phoenixbrighton.co.uk</a>. Local spa and beauty search in Brighton is crowded. The job was service pages, GBP and location relevance, not a national brand campaign.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="#results" text="View Full Results" />
      <ButtonSecondary href="/contact/" text="Discuss Your Project" />
    </Fragment>
  </Hero>

  <!-- Key Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="metrics-grid">
        {caseStudyData.keyMetrics.map((metric) => (
          <div class="metric-card">
            <div class="metric-value">{metric.value}</div>
            <div class="metric-label">{metric.label}</div>
            <div class="metric-description">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hero Image Section -->
  <section class="image-section">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="case-image-container">
        <img src={caseStudyData.heroImage} alt={`${caseStudyData.client} Performance Dashboard`} />
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">The <span>Challenge</span></h2>
      <p class="section-text">{caseStudyData.challenge}</p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="content-section gray">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title">Our <span>Approach</span></h2>
      <p class="section-text">{caseStudyData.solution}</p>
    </div>
  </section>

  <!-- Strategy Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Strategy</span></h2>

      <div class="strategy-list">
        {caseStudyData.strategySteps.map((step, index) => (
          <div class="strategy-item">
            <div class="strategy-number">{index + 1}</div>
            <div class="strategy-content">
              <h3 class="strategy-title">{step.title}</h3>
              <p class="strategy-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="content-section gray" id="results">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Results</span></h2>
      <p class="section-text comparison-scope-note">Source: the published Search Console comparison image. Its selectors show Last 6 months and Previous 6 months. Exact calendar dates and country/search filters are not visible, so these figures are not presented as a country-filtered series or a booking result.</p>

      <div class="results-table">
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Before</th>
              <th>After</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            {caseStudyData.results.map((result) => (
              <tr>
                <td class="metric-name">{result.metric}</td>
                <td>{result.before}</td>
                <td>{result.after}</td>
                <td class:list={["improvement", { "metric-decline": /Worse|decreased/.test(result.improvement) }]}>{result.improvement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Key Takeaways Section -->
  <section class="content-section">
    <div class="max-w-4xl mx-auto px-6 py-20">
      <h2 class="section-title"><span>Key Takeaways</span></h2>

      <ul class="takeaways-list">
        {caseStudyData.keyTakeaways.map((takeaway) => (
          <li>{takeaway}</li>
        ))}
      </ul>
    </div>
  </section>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
.results-table .improvement.metric-decline { color: #465365; }

/* Case Study Meta */
.case-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  font-size: 16px;
  font-weight: 500;
  color: #19212e;
}

.meta-item {
  color: #19212e;
}

.meta-divider {
  opacity: 0.5;
}

/* Metrics Section */
.metrics-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 48px;
}

.metric-card {
  text-align: center;
  padding: 24px 0;
}

.metric-value {
  font-size: 3rem;
  font-weight: 800;
  color: #b83e12;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.metric-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.metric-description {
  font-size: 0.875rem;
  color: #19212e;
}

/* Image Section */
.image-section {
  background: #f7f8fa;
}

.case-image-container {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(25, 33, 46, 0.08);
}

.case-image-container img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  background: #ffffff;
}

/* Content Sections */
.content-section {
  background: #f7f8fa;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.content-section.gray {
  background: #ffffff;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: #19212e;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.section-text {
  font-size: 1.125rem;
  line-height: 1.8;
  color: #19212e;
}

/* Strategy List */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 32px;
  margin-top: 32px;
}

.strategy-item {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}

.strategy-number {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: #f0622a;
  color: #19212e;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
}

.strategy-content {
  flex: 1;
}

.strategy-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #19212e;
  margin-bottom: 8px;
}

.strategy-description {
  font-size: 1rem;
  line-height: 1.6;
  color: #19212e;
}

/* Results Table */
.results-table {
  margin-top: 32px;
  overflow-x: auto;
}

.results-table table {
  width: 100%;
  border-collapse: collapse;
}

.results-table th {
  text-align: left;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.05);
  font-size: 0.875rem;
  font-weight: 600;
  color: #19212e;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #e2e8f0;
}

.results-table td {
  padding: 20px;
  font-size: 1rem;
  color: #19212e;
  border-bottom: 1px solid rgba(25, 33, 46, 0.07);
}

.results-table tr:last-child td {
  border-bottom: none;
}

.results-table .metric-name {
  font-weight: 600;
}

.results-table .improvement {
  color: #b83e12;
  font-weight: 600;
}

/* Takeaways List */
.takeaways-list {
  list-style: none;
  padding: 0;
  margin: 32px 0 0 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.takeaways-list li {
  font-size: 1.125rem;
  line-height: 1.7;
  color: #19212e;
  padding-left: 32px;
  position: relative;
}

.takeaways-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  width: 6px;
  height: 6px;
  background: #f0622a;
  border-radius: 50%;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2.5rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .metric-value {
    font-size: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
  }

  .strategy-item {
    gap: 16px;
  }

  .strategy-number {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .results-table {
    font-size: 0.875rem;
  }

  .results-table th,
  .results-table td {
    padding: 12px;
  }
}

@media (max-width: 480px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>