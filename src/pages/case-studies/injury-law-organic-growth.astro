---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "injury-law-organic-growth",
  metaTitle: "Injury Law SEO: +107% Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a personal-injury law firm increasing organic clicks by 106.5% across two 90-day periods.",
  title: "How a personal-injury firm doubled organic clicks",
  breadcrumb: "Personal Injury Law Growth",
  industry: "Personal-injury legal services",
  period: "31 May to 28 August 2026, compared with 2 March to 30 May 2026",
  lede: "Organic clicks rose from 1,000 to 2,065. Impressions rose from 307,001 to 342,564. Click-through rate nearly doubled and average position improved. This is an efficiency case in a high-consideration legal market, not a claim about signed matters.",
  evidenceImage: "/images/case-studies/injury-law-organic-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Search Console totals chart showing 2,065 clicks for an anonymised personal-injury law firm.",
  metrics: [
    { value: "+106.5%", label: "Organic clicks", note: "1,000 to 2,065" },
    { value: "+1,065", label: "Additional clicks", note: "Latest 90 days" },
    { value: "0.33% → 0.60%", label: "Click-through rate", note: "Nearly doubled" },
    { value: "20.0 → 17.3", label: "Average position", note: "2.7-position improvement" }
  ],
  evidenceHeading: "A stronger result from only a modest lift in exposure",
  evidenceIntro: "The chart uses redacted Search Console totals. Impressions rose 11.6%. Clicks more than doubled. Position and click-through rate both improved, which is why the result is more than a market-size story.",
  problemHeading: "Legal search needs trust and relevance before a click can become an enquiry",
  problem: [
    "People searching for personal-injury help are weighing urgency, eligibility and whether a firm looks relevant to their situation. Visibility without a credible click has limited value.",
    "The case does not publish the firm, services, queries or pages. It uses aggregate Search Console evidence only."
  ],
  readingHeading: "Clicks, CTR and position moved together",
  reading: [
    "Organic clicks grew by 1,065 while impressions increased by 35,563. Average position improved from 20.0 to 17.3. Click-through rate increased from 0.33% to 0.60%.",
    "That combination is consistent with a stronger search result. It is not proof of enquiries or signed matters. The next measure is page-level query analysis alongside lead quality."
  ],
  takeaways: [
    "In high-consideration services, click-through rate can reveal more than a large impression total.",
    "Rank improvement and snippet relevance need to move together.",
    "Search Console evidence should sit next to lead-quality data before a law firm makes commercial decisions from traffic alone."
  ],
  results: [
    { metric: "Organic clicks", before: "1,000", after: "2,065", note: "+106.5%, or 1,065 additional clicks" },
    { metric: "Impressions", before: "307,001", after: "342,564", note: "+11.6%, modest extra exposure" },
    { metric: "Average position", before: "20.0", after: "17.3", note: "Improved by 2.7 positions" },
    { metric: "Click-through rate", before: "0.33%", after: "0.60%", note: "Nearly doubled" }
  ],
  boundary: "This anonymised case study reports Google Search Console organic-search data for two equal 90-day periods. It does not publish the client, property, pages, queries, enquiries, matter values or other confidential data. Search Console does not establish legal outcomes or attribute the movement to a single SEO action, and this result is not a guarantee."
};
---
<GscCaseStudyPage data={data} />
