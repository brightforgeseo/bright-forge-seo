---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "injury-law-organic-growth",
  metaTitle: "Personal Injury Law SEO Case Study: 82% More Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a personal-injury law firm increasing organic clicks by 81.8% across two 90-day periods.",
  title: "How a personal-injury law firm increased organic clicks by 82% with a stronger search result",
  breadcrumb: "Personal Injury Law Growth",
  industry: "Personal-injury legal services",
  period: "7 May to 4 August 2026, compared with the prior 90 days",
  lede: "Google organic clicks increased from 940 to 1,709 in the latest 90-day period. Impressions changed only modestly, but average position improved and click-through rate rose sharply. That makes this a stronger efficiency case than a simple reach story.",
  evidenceImage: "/images/case-studies/injury-law-organic-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Google Search Console performance visual showing 1,709 clicks and a stronger average position for an anonymised personal-injury law firm.",
  metrics: [
    { value: "+81.8%", label: "Organic clicks", note: "940 to 1,709" },
    { value: "+73.7%", label: "Click-through rate", note: "0.30% to 0.52%" },
    { value: "20.4 → 18.5", label: "Average position", note: "2.0-position improvement" },
    { value: "+4.6%", label: "Impressions", note: "Broadly stable reach" }
  ],
  evidenceHeading: "A stronger result from almost the same level of search exposure",
  evidenceIntro: "The redacted Google Search Console data shows a relatively small rise in impressions producing a much larger rise in clicks. Position and click-through rate both improved, which makes the result more substantial than a broad exposure increase alone.",
  problemHeading: "Legal search needs trust and relevance before a click can become an enquiry",
  problem: [
    "People searching for personal-injury legal help are not simply browsing categories. They are weighing urgency, eligibility, trust and whether a firm appears relevant to their situation. Visibility without a credible click decision has limited value.",
    "The case does not publish the firm’s services, queries or pages. It uses the aggregate Search Console evidence to show a change in how often the site appeared, where it ranked on average and how often searchers selected it."
  ],
  readingHeading: "The click and ranking signals improved together",
  reading: [
    "Organic clicks grew by 769 while impressions increased by only 14,560. Average position improved from 20.4 to 18.5 and click-through rate increased from 0.30% to 0.52%.",
    "That combination is consistent with a stronger search result, but it is not proof of enquiries or signed matters. The responsible next measure is page-level query analysis alongside lead quality and conversion tracking."
  ],
  takeaways: [
    "In high-consideration services, click-through rate can reveal more than a large impression total.",
    "Rank improvement and snippet relevance need to move together to produce a credible organic-search outcome.",
    "Search Console evidence should be connected to lead-quality data before a law firm makes commercial decisions from traffic alone."
  ],
  results: [
    { metric: "Organic clicks", before: "940", after: "1,709", note: "+81.8%, or 769 additional clicks" },
    { metric: "Impressions", before: "313,645", after: "328,205", note: "+4.6%, broadly stable exposure" },
    { metric: "Average position", before: "20.4", after: "18.5", note: "Improved by 2.0 positions" },
    { metric: "Click-through rate", before: "0.30%", after: "0.52%", note: "+73.7% relative improvement" }
  ],
  boundary: "This anonymised case study reports Google Search Console organic-search data for two equal 90-day periods. It does not publish the client, property, pages, queries, enquiries, matter values or other confidential data. Search Console does not establish legal outcomes or attribute the movement to a single SEO action, and this result is not a guarantee."
