---
import GscCaseStudyPage from "../../components/GscCaseStudyPage.astro";

const data = {
  slug: "injury-law-organic-growth",
  metaTitle: "Injury Law SEO: +107% Clicks | Bright Forge",
  description: "An anonymised Google Search Console case study showing a personal-injury law firm increasing organic clicks by 106.5% across two 90-day periods.",
  title: "A personal-injury firm doubled organic clicks",
  breadcrumb: "Personal Injury Law Growth",
  industry: "Personal-injury legal services",
  period: "31 May to 28 August 2026, compared with 2 March to 30 May 2026",
  lede: "Organic clicks rose from 1,000 to 2,065 across two 90-day periods. Impressions rose far less, from 307,001 to 342,564, so the gain came from earning more clicks per appearance: click-through rate rose from 0.33% to 0.60% and average position improved from 20.0 to 17.3. This is an efficiency case in a high-consideration legal market, not a claim about signed matters.",
  evidenceImage: "/images/case-studies/injury-law-organic-growth-gsc-evidence.png",
  evidenceAlt: "Redacted Search Console totals chart showing 2,065 clicks for an anonymised personal-injury law firm.",
  metrics: [
    { value: "+106.5%", label: "Organic clicks", note: "1,000 to 2,065" },
    { value: "+1,065", label: "Additional clicks", note: "Latest 90 days" },
    { value: "0.33% → 0.60%", label: "Click-through rate", note: "Up 0.27 percentage points" },
    { value: "20.0 → 17.3", label: "Average position", note: "2.7-position improvement" }
  ],
  evidenceHeading: "A stronger result from only a modest lift in exposure",
  evidenceIntro: "The chart shows redacted Search Console totals for 2 March to 30 May 2026 and 31 May to 28 August 2026. Impressions rose 11.6%. Clicks more than doubled. Position and click-through rate both improved, which is why the result is more than a market-size story: the firm was not simply shown to more people. Position and click-through values come from the published comparison and are not displayed in this totals chart.",
  problemHeading: "Legal search needs trust and relevance before a click can become an enquiry",
  problem: [
    "Someone searching for personal-injury help is weighing three things at once: how urgent the problem is, whether they are eligible to claim, and whether a firm looks relevant to their situation. A listing that appears but does not earn that click has limited value to the firm.",
    "The firm, its services, the queries and the pages stay confidential; the case rests on aggregate Search Console evidence."
  ],
  readingHeading: "Clicks, CTR and position moved together",
  reading: [
    "Organic clicks grew by 1,065 while impressions increased by 35,563. Average position improved from 20.0 to 17.3. Click-through rate increased from 0.33% to 0.60%.",
    "All three moving together is consistent with a stronger search result. It is not proof of enquiries or signed matters. Our next measure would be page-level query analysis set beside lead quality: which practice-area pages earned the extra clicks, and how many of those visitors had a claim the firm could take."
  ],
  takeaways: [
    "In high-consideration services, click-through rate often says more than a large impression total.",
    "Average position and click-through rate improved together here. The totals do not show whether the snippets themselves changed.",
    "Search Console evidence should sit next to lead-quality data before a law firm makes commercial decisions from traffic alone."
  ],
  results: [
    { metric: "Organic clicks", before: "1,000", after: "2,065", note: "+106.5%, or 1,065 additional clicks" },
    { metric: "Impressions", before: "307,001", after: "342,564", note: "+11.6%, modest extra exposure" },
    { metric: "Average position", before: "20.0", after: "17.3", note: "Improved by 2.7 positions" },
    { metric: "Click-through rate", before: "0.33%", after: "0.60%", note: "Up 0.27 percentage points" }
  ],
  boundary: "This anonymised case study reports Google Search Console organic-search data for two equal 90-day periods. The client, property, pages, queries, enquiries, matter values and other confidential data stay private. Search Console measures search behaviour, not legal outcomes, and cannot tie the movement to a single SEO action, so we present the figures as a measured comparison rather than a record of work, and not as a guarantee."
};
---
<GscCaseStudyPage data={data} />
