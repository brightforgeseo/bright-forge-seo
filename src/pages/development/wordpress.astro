---
import '../../styles/development-editorial.css';
import MainLayout from "../../layouts/MainLayout.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";
import DevelopmentStackJobs from "../../components/DevelopmentStackJobs.astro";
const canonical="https://brightforge.com.ph/development/wordpress/";
const proof=[
  {
    "title": "SEO before design polish",
    "text": "We protect crawlability, metadata, content structure and redirects before visual extras."
  },
  {
    "title": "Performance matters",
    "text": "Fast pages help users and reduce technical drag before SEO work even starts."
  },
  {
    "title": "Human QA",
    "text": "Every build still needs manual checks for forms, schema, indexing and conversion paths."
  }
];
const checks=[
  {
    "title": "Crawlable pages",
    "text": "Search engines need clean URLs, internal links, server-rendered content where needed and sensible indexation controls."
  },
  {
    "title": "Content structure",
    "text": "Pages need headings, body copy, proof, FAQs and conversion points that support SEO rather than sit behind visual components."
  },
  {
    "title": "Performance and Core Web Vitals",
    "text": "We reduce bloat, unnecessary scripts, layout shifts and render delays that weaken user experience."
  },
  {
    "title": "Redirect and migration safety",
    "text": "When replacing an old site, URL mapping and launch QA matter more than a prettier homepage."
  },
  {
    "title": "Schema and metadata",
    "text": "Titles, descriptions, canonical tags, structured data and Open Graph basics should be built in, not bolted on later."
  },
  {
    "title": "Analytics and forms",
    "text": "A site that cannot track enquiries properly makes SEO reporting weaker than it needs to be."
  }
];
const process=[
  {
    "title": "Audit",
    "text": "Review the current site, rankings, crawl behaviour, content, analytics and conversion risks."
  },
  {
    "title": "Plan",
    "text": "Map templates, URLs, content sections, redirects, schema and development priorities."
  },
  {
    "title": "Build",
    "text": "Develop the site around speed, accessibility, crawlability and editorial control."
  },
  {
    "title": "QA",
    "text": "Test pages, metadata, forms, mobile layouts, redirects, schema and indexation settings."
  },
  {
    "title": "Launch",
    "text": "Deploy with a launch checklist, Search Console monitoring and post-launch crawl checks."
  },
  {
    "title": "Improve",
    "text": "Use ranking, crawl and conversion data to refine pages after launch."
  }
];
const faqs=[
  {
    "question": "Can you improve WordPress SEO without rebuilding the site?",
    "answer": "Often, yes. We inspect templates, internal links, metadata, schema, indexing and performance before recommending a rebuild. A repair may be enough if the existing theme and editing workflow still meet the business requirements."
  },
  {
    "question": "Will you remove our plugins?",
    "answer": "Not simply to reduce a count. We review dependencies, overlapping output, support status and measured performance. A plugin may provide an essential form, shop or editorial function. Any proposed removal needs a replacement or an agreed retirement, followed by regression checks."
  },
  {
    "question": "What should be backed up before an update?",
    "answer": "A complete recovery plan needs the database and site files, including uploads, themes and plugins. The scope should name who takes the backup, where it is retained and who can restore it. A backup job reporting success is not the same as a tested restore."
  },
  {
    "question": "How do staging and ongoing maintenance fit the project?",
    "answer": "Agree which theme, plugin and core updates need staging checks, who approves production changes and how to recover if a form or template breaks. Hosting, update frequency, monitoring and response times need explicit agreement; a development project alone does not define an ongoing maintenance plan."
  },
  {
    "question": "Who owns licences and what can editors change?",
    "answer": "We clarify hosting and administrator access, licence ownership and renewals before handover. The editor scope should identify which page sections and SEO fields your team can change, which roles can publish and whether training is included. Theme-code changes still need a development workflow."
  },
  {
    "question": "Do you provide WordPress development in the Philippines for overseas businesses?",
    "answer": "Yes. We work with Philippine businesses and teams in Australia, the UK and the US. The brief should identify the publishing owner, review availability and the actual regional content or store requirements. We agree release windows rather than assume every team works Philippine hours."
  },
  {
    "question": "Can you work with our developer during a migration?",
    "answer": "Yes. We can handle SEO direction, QA and implementation guidance while your developer carries out the build. We map existing URLs, redirects, content and metadata, then check the released pages and enquiry paths. No rebuild guarantees higher rankings."
  }
];
---
<MainLayout title="WordPress Development Philippines | Bright Forge" description="WordPress development for businesses that need CMS control, cleaner structure, faster templates and SEO-safe rebuilds." canonical={canonical} type="service" breadcrumbs={[{name:"Home",url:"https://brightforge.com.ph/"},{name:"Development",url:"https://brightforge.com.ph/development/"},{name:"WordPress",url:canonical}]} faqs={faqs}>
<LegacyHeader slot="header" />
<Hero title="WordPress <span>Development</span>" breadcrumbCurrent="WordPress">
<Fragment slot="story"><p class="hero-subtitle">WordPress development in the Philippines for teams that need to publish and maintain their own content.</p><p>Our WordPress developers plan the templates, editing controls and WordPress SEO together. Your team should know how to update a service page, who can publish it and who handles changes to the theme or plugins.</p><div class="hero-proof">{proof.map((item)=>(<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
<Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request a Site Review" /><ButtonSecondary href="#checks" text="See What We Check" /></Fragment>
</Hero>
<main class="dev-page">
<section id="checks"><div class="page-container two-column"><div><p class="eyebrow">Build focus</p><h2>Keep <span>editing useful and changes testable</span></h2><p>A conventional WordPress site lets editors publish without rebuilding a separate front end. The theme, plugins and host still determine what visitors receive. We inspect the live HTML and editing workflow before deciding whether a template repair or a rebuild is justified.</p><p>Illustrative editor check: update a service description and image in staging, preview on mobile and publish with the intended role. Confirm that the public page has the right title, H1, canonical and schema, and that its enquiry form still works. This is a proposed acceptance check, not a client case study.</p></div><aside class="panel"><h3>What we check first</h3><p>The theme and plugin dependencies, editable fields, public HTML, forms and hosting setup. We also ask who owns backups, restore access and paid licences before recommending changes.</p></aside></div></section>
<DevelopmentStackJobs
  title="What we actually change in <span>WordPress</span>"
  intro="Keep the functions the business uses; change the parts that cause an observed publishing or technical problem."
  jobs={[
    {title:'Templates and SEO fields', text:'Identify which theme or plugin controls titles, headings, canonicals and schema. Check the published output for omissions or conflicting values.'},
    {title:'Plugin dependencies', text:'Review what each plugin supplies and measure problems before removal. Retest forms, editor controls and any shop functions affected by a change.'},
    {title:'Staging and recovery', text:'Agree the update test, backup owner and restore procedure. Include both database and files rather than assuming a content export can restore the site.'},
    {title:'Editor and account handover', text:'Set out editable sections, publishing roles and training needs. Confirm hosting access, licence renewals and responsibility for future updates.'}
  ]}
/>
<section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>For businesses where <span>WordPress has a clear role</span></h2><p>This suits businesses that need easy editing, blog or resource sections, CMS workflows, service pages and reliable SEO controls without losing speed.</p></div><div class="panel"><h3>Before changing the theme</h3><p>Record the templates, shortcodes, forms and plugin data that existing pages depend on. A replacement theme must preserve useful content and functions, with URL redirects where needed. Confirm a backup and recovery route before production changes.</p></div></div></section>
<section><div class="page-container"><p class="eyebrow">Related development services</p><h2>Compare <span>editor-led and code-led builds</span></h2><div class="link-grid"><a href="/development/astro/"><span>Astro development</span>Fast content-led sites with very little front-end bloat.</a><a href="/development/wordpress/"><span>WordPress development</span>CMS-led builds with SEO controls and cleaner architecture.</a><a href="/development/nextjs/"><span>Next.js development</span>Application-style sites where React and server rendering make sense.</a></div></div></section>
<section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>WordPress development</span> questions worth answering</h2></div><div class="faq-list">{faqs.map((faq)=>(<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
<section><div class="page-container"><div class="cta-card"><h2>Need a <span>WordPress repair or rebuild</span>?</h2><p>We can review your current theme, plugins and page structure before recommending a rebuild, cleanup or migration plan.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request a Site Review" /><ButtonSecondary href="/technical-seo-services-philippines/" text="Technical SEO" /></div></div></div></section>
</main><Footer slot="footer"/>
</MainLayout>

