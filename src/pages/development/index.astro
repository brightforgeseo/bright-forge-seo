---
import MainLayout from "../../layouts/MainLayout.astro";
import BuyerDecisionSection from "../../components/BuyerDecisionSection.astro";
import LegacyHeader from "../../components/LegacyHeader.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";
import DevelopmentWorkbench from "../../components/DevelopmentWorkbench.astro";
const canonical="https://brightforge.com.ph/development/";
const proof=[
  {
    "title": "Design that can sell",
    "text": "First screen, type, and the enquiry path are the product. A Figma file that dies on a phone is not web design."
  },
  {
    "title": "We ship the sites",
    "text": "This marketing site is Astro. Shinobi is the heavier front-end. WordPress when editors need a CMS. The stack follows the job."
  },
  {
    "title": "Launch without a drop",
    "text": "Redirects, titles, tracking and Search Console are part of the build, not a week of panic after go-live."
  }
];
const checks=[
  {
    "title": "Crawlable pages",
    "text": "Search engines need clean URLs, internal links, server-rendered content where needed and sensible indexation controls."
  },
  {
    "title": "Content structure",
    "text": "Pages need headings, body copy, proof, FAQs and conversion points that support SEO rather than sit behind visual components."
  },
  {
    "title": "Performance and Core Web Vitals",
    "text": "We build responsive layouts and reduce bloat, unnecessary scripts, layout shifts and render delays that weaken user experience."
  },
  {
    "title": "Redirect and migration safety",
    "text": "When replacing an old site, URL mapping and launch QA matter more than a prettier homepage."
  },
  {
    "title": "Schema and metadata",
    "text": "Titles, descriptions, canonical tags, structured data and Open Graph basics should be built in, not bolted on later."
  },
  {
    "title": "Analytics and forms",
    "text": "A site that cannot track enquiries properly makes SEO reporting weaker than it needs to be."
  }
];
const process=[
  {
    "title": "Audit",
    "text": "Review the current site, rankings, crawl behaviour, content, analytics and conversion risks."
  },
  {
    "title": "Plan",
    "text": "Map templates, URLs, content sections, redirects, schema and development priorities."
  },
  {
    "title": "Build",
    "text": "Develop the site around speed, accessibility, crawlability and editorial control."
  },
  {
    "title": "QA",
    "text": "Test pages, metadata, forms, mobile layouts, redirects, schema and indexation settings."
  },
  {
    "title": "Launch",
    "text": "Deploy with a launch checklist, Search Console monitoring and post-launch crawl checks."
  },
  {
    "title": "Improve",
    "text": "Use ranking, crawl and conversion data to refine pages after launch."
  }
];
const faqs=[
  {
    "question": "Do you design and develop, or only advise?",
    "answer": "Both. We design and build the site when that is the brief, and we can sit with your developer when you already have one. Outsource the whole build or a defined stage. The brief, reviews and what goes live stay yours."
  },
  {
    "question": "Is a new website enough for SEO?",
    "answer": "No. A better build can remove technical drag and make pages easier to rank and convert. Rankings still depend on content, authority and competition. New website SEO is the structure, metadata, internal links and launch QA, not a promise."
  },
  {
    "question": "How do you protect rankings during a rebuild?",
    "answer": "We map URLs, redirects, metadata, content, internal links, schema, analytics and Search Console checks before launch, then crawl and monitor the site after launch."
  },
  {
    "question": "WordPress or a modern stack?",
    "answer": "WordPress when the team needs to edit pages without a deploy. Astro or similar when the site is mostly content and speed matters. Next.js or React when the product is an application. We choose the stack around the job, not around fashion."
  },
  {
    "question": "Can we outsource web design and development to your team?",
    "answer": "Yes. Philippine and international businesses can outsource a complete build or bring us in for a defined part of the project. We agree ownership, milestones, review points and handover requirements before development begins."
  },
  {
    "question": "How much does web development in the Philippines cost?",
    "answer": "The scope depends on the site size, design requirements, content readiness, CMS or framework, integrations, migration risk and testing needs. We review those factors first and provide a private proposal rather than publishing a package that may not fit the job."
  },
  {
    "question": "Will the site be responsive?",
    "answer": "Yes. Phone, tablet and desktop are part of the design, not a leftover stylesheet. We test the enquiry path on a phone before we call a layout done."
  }
];
---
<MainLayout title="Web Design & Development Philippines | Bright Forge" description="Web design and web development in the Philippines. SEO-safe builds, WordPress or modern stacks, private proposal, no public rate card." canonical={canonical} type="service" breadcrumbs={[{name:"Home",url:"https://brightforge.com.ph/"},{name:"Development",url:"https://brightforge.com.ph/development/"},{name:"Development",url:canonical}]} faqs={faqs}>
<Fragment slot="head">
  <link rel="dns-prefetch" href="//shinobiseo.com" />
  <link rel="preconnect" href="https://shinobiseo.com" crossorigin="anonymous" />
</Fragment>
<LegacyHeader slot="header" />
<Hero title="Web Design and <span>Development</span>" breadcrumbCurrent="Development">
<Fragment slot="story"><p class="hero-subtitle">Web design and web development for Philippine and international businesses. Outsource the build. Keep the brief.</p><p>We design the first screen, the type, and the enquiry path, then we build it. New website SEO sits in the templates: crawlable pages, clean URLs, redirects, schema and tracking before launch. Layouts are responsive. A mockup that dies on a phone is not the job.</p><div class="hero-proof">{proof.map((item)=>(<article><strong>{item.title}</strong><span>{item.text}</span></article>))}</div></Fragment>
<Fragment slot="actions"><ButtonPrimary href="/contact/" text="Request a Site Review" /><ButtonSecondary href="#workbench" text="See the live build" /></Fragment>
</Hero>
<main class="dev-page">
<section><div class="page-container two-column"><div><p class="eyebrow">Build focus</p><h2><span>Web design</span> has to survive a crawl and a phone</h2><p>Outsource web design when the current site is slow, hard to edit, or about to be rebuilt. The job is still a website development decision: templates, content, redirects and how people enquire.</p><p>We plan Philippine web development around that commercial job first, then pick WordPress or a modern stack. Fashion frameworks come second.</p></div><aside class="panel"><h3>What we check first</h3><p>Rendering, crawlability, content structure, metadata, schema, internal links, performance, analytics and launch risk.</p></aside></div></section>
<DevelopmentWorkbench />
<section id="checks"><div class="page-container"><p class="eyebrow">What the build must do</p><h2>A site Google can read, on a <span>responsive</span> layout</h2><div class="grid">{checks.map((item)=>(<article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
<section><div class="page-container"><p class="eyebrow">How we work</p><h2>Audit, build, launch, then <span>prove it</span></h2><div class="grid">{process.map((item, i)=>(<article class="card"><span>{String(i+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>))}</div></div></section>
<section><div class="page-container two-column"><div><p class="eyebrow">Who this suits</p><h2>For businesses where <span>development has a clear role</span></h2><p>This suits businesses replacing an old website, rebuilding a slow WordPress site, launching a new service site, or trying to protect rankings during a design refresh. This hub is web design and development. WordPress, Astro, Next, React and SvelteKit have their own pages. A domain or CMS cutover belongs on <a href="/website-migration-services/">website migration</a>.</p></div><div class="panel"><h3>What we will not do</h3><p>We will not sell a shiny rebuild that creates indexation problems, strips content, loses redirects or weakens the pages already supporting SEO performance.</p></div></div></section>
<section><div class="page-container two-column"><div><p class="eyebrow">Outsourced delivery</p><h2>Use a Philippine development team without <span>losing control of the build</span></h2><p>Businesses and agencies can outsource web design, development or a defined implementation stage to us. We agree responsibilities, technical decisions, review points and handover requirements before work starts.</p><p>For Manila businesses comparing web design agencies, agree how the work will run before choosing a supplier: remote briefing, a record of design approvals and a documented launch handover. Any requirement for on-site meetings needs to be agreed separately, not inferred from a Philippines service page.</p><p>The result should be easy to own after launch. That means documented routes, sensible components, editorial control, analytics and a clear record of what was built.</p></div><aside class="panel"><h3>New website SEO is part of the build</h3><p>Page mapping, crawlability, content structure, metadata, schema, internal links and indexation controls are planned before launch rather than repaired afterwards.</p></aside></div></section>
<BuyerDecisionSection id="choose-design-team" eyebrow="Compare the work, not the pitch" title="Choosing a web design agency?" emphasis="Test a site they have shipped.">
  <p>Open a real project on your phone, test an enquiry path and check whether the main services are easy to find. Ask the agency to explain the design decisions and the launch checks behind that work. A gallery of desktop mockups cannot answer those questions.</p>
  <p>Then compare the proposals on the same basis: who writes and migrates content, how many design reviews are included, who owns the CMS and accounts, and what handover and post-launch support cover. A lower quote with those items excluded is a different scope, not necessarily better value.</p>
  <p>The Shinobi build shown on this page is a concrete starting point for discussing our approach. Bring your requirements and we can explain which parts of that approach fit your site, rather than promise the same build to every business.</p>
</BuyerDecisionSection>
<BuyerDecisionSection id="store-build-scope" eyebrow="Selling through the site" title="Ecommerce web design" emphasis="starts with the catalogue.">
  <p>A store brief needs more than a page count. Product variants, category navigation, stock rules, delivery information and checkout all affect what the build must do. We establish those requirements before recommending a design or platform.</p>
  <dl>
    <dt>What shoppers need to compare</dt><dd>Category and product templates should make specifications, options and purchase conditions easy to find. A striking homepage cannot compensate for a product page that leaves the buying decision unresolved.</dd>
    <dt>What the team needs to manage</dt><dd>Agree who maintains products, handles content changes and tests updates. Integrations, payment configuration and catalogue migration belong in the scope, not in an assumption that everything is included.</dd>
    <dt>What search engines need to retain</dt><dd>For an existing store, map important URLs, redirects and category relationships before changing the structure. Design approval and SEO launch checks are separate decisions.</dd>
  </dl>
  <p>Already have a working store but need better organic visibility? Our <a href="/ecommerce-seo-services/">ecommerce SEO service</a> covers that work without assuming you need a rebuild.</p>
</BuyerDecisionSection>

<section id="pricing-and-scope"><div class="page-container two-column"><div><p class="eyebrow">Pricing and scope</p><h2>Website pricing should reflect <span>the real build</span>, not a generic package</h2><p>Website development cost in the Philippines varies because the work varies. Site size, design complexity, content readiness, integrations, CMS or framework choice, migration risk and testing requirements all affect the scope.</p><p>We review those factors and provide a private proposal. No public rate card, invented package or fixed figure that hides the work needed to deliver the site properly.</p></div><aside class="panel"><h3>What shapes the private proposal</h3><p>Site size, design, content, integrations, framework, migration requirements, analytics, launch QA and post-launch support.</p></aside></div></section>
<section><div class="page-container"><p class="eyebrow">Related development services</p><h2>Choose the <span>stack around the job</span>, not the fashion cycle</h2><div class="link-grid"><a href="/development/astro/"><span>Astro development</span>Fast content-led sites with very little front-end bloat.</a><a href="/development/wordpress/"><span>WordPress development</span>CMS-led builds with SEO controls and cleaner architecture.</a><a href="/development/nextjs/"><span>Next.js development</span>Application-style sites where React and server rendering make sense.</a><a href="/development/react/"><span>React development</span>Interactive tools without turning the brochure into an app shell.</a><a href="/development/sveltekit/"><span>SvelteKit development</span>Fast routes that still render as real pages.</a></div></div></section>
<section><div class="page-container faq-layout"><div><p class="eyebrow">FAQ</p><h2><span>Development questions</span> worth answering</h2></div><div class="faq-list">{faqs.map((faq)=>(<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}</div></div></section>
<section><div class="page-container"><div class="cta-card"><h2>Need a site that does not <span>break your SEO</span> on launch?</h2><p>We can audit the current site, map the risks and recommend the right build path before anyone starts redesigning pages.</p><div class="cta-actions"><ButtonPrimary href="/contact/" text="Request a Site Review" /><ButtonSecondary href="/technical-seo-services-philippines/" text="Technical SEO" /></div></div></div></section>
</main><Footer slot="footer"/>
</MainLayout>

<style>
.dev-page{background:#0d0f1a;color:#fff}.page-container{width:min(100% - 40px,1120px);margin:0 auto}.hero-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:26px}.hero-proof article,.panel,.card,.faq-item,.cta-card,.link-grid a{border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.045);border-radius:24px;box-shadow:0 18px 48px rgba(0,0,0,.18)}.hero-proof article,.card,.panel,.link-grid a{padding:24px}.hero-proof strong,.link-grid span{display:block;color:#fff;font-weight:900;margin-bottom:8px}.hero-proof span{color:rgba(255,255,255,.66);line-height:1.5}.dev-page > section{padding:78px 0;content-visibility:visible!important}.dev-page > section:nth-child(even){background:#111421}.eyebrow{display:block;color:#f0622a;font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;margin-bottom:10px}h2{color:#fff;font-size:clamp(2rem,4vw,3rem);line-height:1.05;margin:0 0 22px}h3{color:#fff;font-size:1.16rem;margin:0 0 10px}p,li{color:rgba(255,255,255,.74);font-size:1.02rem;line-height:1.72}a{color:#f0622a}.two-column,.faq-layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:clamp(30px,5vw,60px);align-items:start}.grid,.link-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.process span{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:14px;color:#fff;background:rgba(240,98,42,.25);font-weight:900;margin-bottom:18px}.link-grid a{color:inherit;text-decoration:none}.faq-list{display:grid;gap:14px}.faq-item{overflow:hidden}.faq-item summary{cursor:pointer;padding:22px 24px;color:#fff;font-weight:900;list-style:none}.faq-item summary::-webkit-details-marker{display:none}.faq-item p{padding:0 24px 24px;margin:0}.cta-card{text-align:center;padding:clamp(36px,6vw,68px);background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255,255,255,.045))}.cta-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:14px;margin-top:28px}@media(max-width:920px){.hero-proof,.two-column,.grid,.link-grid,.faq-layout{grid-template-columns:1fr}}
</style>

