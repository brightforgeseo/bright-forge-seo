---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const servicePillars = [
  {
    title: 'Technical SEO',
    href: '/technical-seo-services-philippines/',
    kicker: 'Crawling, indexation and site health',
    copy: 'We find and fix the faults that stop Google crawling, understanding and trusting the site: crawl waste, indexation problems, site architecture, redirects, canonicals, Core Web Vitals and structured data. Your developer gets the affected URLs, the change required and the test that confirms it.',
    icon: '<circle cx="16" cy="16" r="5" stroke="#f0622a" stroke-width="2"/><path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" stroke="#8e94ad" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'On-Page SEO',
    href: '/on-page-seo-services-philippines/',
    kicker: 'Relevance and page quality',
    copy: 'We revise titles, headings, copy structure and internal links on your priority pages, match each page to the search it should answer, and tighten the calls to action. Edits are agreed before release and the changed URLs are recorded.',
    icon: '<rect x="7" y="4" width="18" height="24" rx="3" stroke="#8e94ad" stroke-width="2"/><path d="M11 10h7" stroke="#f0622a" stroke-width="2.5" stroke-linecap="round"/><path d="M11 15h10M11 19h10M11 23h6" stroke="#8e94ad" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'Content SEO',
    href: '/content-seo-services-philippines/',
    kicker: 'Pages worth ranking',
    copy: 'We plan, brief, write and improve content around real search demand, buyer intent and the topics your site has not yet covered. That often means strengthening an existing service page before commissioning anything new. Every piece follows an approved brief.',
    icon: '<path d="M5 27l2-7L21 6l5 5-14 14-7 2z" stroke="#8e94ad" stroke-width="2" stroke-linejoin="round"/><path d="M18 9l5 5" stroke="#f0622a" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'Local SEO',
    href: '/local-seo-for-google-maps-and-gbp/',
    kicker: 'Maps, locations and local trust',
    copy: 'For businesses that depend on nearby customers, we work on your Google Business Profile, local landing pages, citations, reviews and service-area relevance, so you appear in Maps and in local organic results for the areas you serve.',
    icon: '<path d="M16 28s-9-8.1-9-14a9 9 0 1 1 18 0c0 5.9-9 14-9 14z" stroke="#8e94ad" stroke-width="2" stroke-linejoin="round"/><circle cx="16" cy="14" r="3.5" fill="#f0622a"/>'
  },
  {
    title: 'SEO Audits',
    href: '/seo-audit-services/',
    kicker: 'A diagnosis with clear priorities',
    copy: 'We diagnose the technical, content, authority and conversion issues holding the site back, then turn the findings into a 90-day roadmap. Each item carries its evidence, its priority, the expected impact and implementation notes.',
    icon: '<rect x="6" y="6" width="20" height="22" rx="3" stroke="#8e94ad" stroke-width="2"/><path d="M11 13l2 2 4-4M11 20l2 2 4-4" stroke="#f0622a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 14h2M20 21h2" stroke="#8e94ad" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'Keyword Research',
    href: '/keyword-research-services/',
    kicker: 'Search demand mapped to pages',
    copy: 'We map commercial keywords, informational demand, local modifiers and competitor gaps to specific pages. The result is a keyword map that assigns each group of searches to one existing or proposed URL, so two of your pages never chase the same search.',
    icon: '<circle cx="14" cy="14" r="8" stroke="#8e94ad" stroke-width="2"/><path d="M20 20l7 7" stroke="#f0622a" stroke-width="2.5" stroke-linecap="round"/><path d="M11 16v-4M14 16v-6M17 16v-3" stroke="#f0622a" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'Link Building',
    href: '/backlink-seo-services-philippines/',
    kicker: 'Authority from relevant sites',
    copy: 'We assess prospective publications, directories and partner sites for audience relevance and placement quality. The brief names the outreach targets and how placements will be checked, and no bulk link packages are bought.',
    icon: '<path d="M13.5 18.5a5 5 0 0 0 7 0l4-4a5 5 0 0 0-7-7l-2 2" stroke="#8e94ad" stroke-width="2" stroke-linecap="round"/><path d="M18.5 13.5a5 5 0 0 0-7 0l-4 4a5 5 0 0 0 7 7l2-2" stroke="#f0622a" stroke-width="2" stroke-linecap="round"/>'
  },
  {
    title: 'AI Search Readiness',
    href: '/ai-search-optimization-services-philippines/',
    kicker: 'SEO foundations for AI answers',
    copy: 'We make the important facts about your business clearer to Google, AI answers and agentic search tools. This work sits on top of the SEO basics (crawlability, structured content, authority, entity clarity and useful pages) and comes with no citation guarantees.',
    icon: '<path d="M16 5l2.2 6.8L25 14l-6.8 2.2L16 23l-2.2-6.8L7 14l6.8-2.2L16 5z" stroke="#8e94ad" stroke-width="2" stroke-linejoin="round"/><path d="M25 21.5l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z" fill="#f0622a"/>'
  },
  {
    title: 'SEO Command Centre',
    href: '/seo-command-centre/',
    kicker: 'Monitoring, QA and growth control',
    copy: 'We connect search monitoring, opportunity detection, delivery QA, reporting intelligence and approval-gated SEO operations in one place, so a campaign is easier to control and harder to neglect.',
    icon: '<path d="M5 22a11 11 0 1 1 22 0" stroke="#8e94ad" stroke-width="2" stroke-linecap="round"/><path d="M16 22l6-7" stroke="#f0622a" stroke-width="2.4" stroke-linecap="round"/><circle cx="16" cy="22" r="2" fill="#f0622a"/>'
  }
];

const processSteps = [
  {
    label: 'Days 1 to 15',
    title: 'Diagnosis and commercial mapping',
    copy: 'Once access is in place we review crawl data, Search Console, GA4, rankings, competitors, conversion paths and your priority pages. The output is a baseline to measure against and a practical map of what needs fixing first, with the reason for each item.'
  },
  {
    label: 'Days 16 to 30',
    title: 'Technical and on-page foundations',
    copy: 'We deal with the faults that hold everything else back: indexation, metadata, page structure, internal links, schema, tracking gaps and the obvious conversion blockers on the pages that earn money. Each release is checked on the live site.'
  },
  {
    label: 'Days 31 to 60',
    title: 'Content and authority building',
    copy: 'We improve existing pages, brief new content and close topic gaps, then begin outreach to build authority around the pages that can produce leads or sales. Content is written from briefs you have approved.'
  },
  {
    label: 'Days 61 to 90',
    title: 'Testing, reporting and next-stage growth',
    copy: 'We review movement in rankings, clicks, enquiries and page performance against the baseline from the first fortnight, including the pages that have not moved. The next quarter is planned from that review, so the task list changes when the data does.'
  },
  {
    label: 'Every month',
    title: 'What you receive',
    copy: 'A report covering rankings, Search Console clicks and impressions, calls and forms where tracking allows, the work completed and the plan for the following month. The SEO Management Sheet is updated with each action and the person accountable for it. Page edits and content arrive for approval, and technical fixes come as briefs for your developer or are made by us where we have access.'
  }
];

const engagementModels = [
  {
    title: 'SEO Audit Sprint',
    copy: 'Best when the site needs a senior diagnosis before you commit to a campaign. It suits technical problems, traffic drops, migration checks and performance nobody can explain, and it ends with a 90-day roadmap you can implement with us or with your own team.'
  },
  {
    title: 'Monthly SEO Campaign',
    copy: 'Best for businesses that need technical, content, authority and reporting work to continue month after month. In competitive commercial markets this is the usual fit, planned in quarterly priorities with a monthly implementation plan.'
  },
  {
    title: 'Local SEO Campaign',
    copy: 'Best for service-area businesses, clinics, trades, professional services and location-led brands that need visibility in Google Maps and enquiries from nearby customers. The work centres on your Google Business Profile, reviews, citations and location pages.'
  },
  {
    title: 'SEO + CRO Growth Campaign',
    copy: 'Best when rankings or traffic already exist but too few visitors become enquiries, calls, bookings or sales. We work on the landing pages, forms, proof and tracking alongside the search work, so gains in visibility can be followed through to a result.'
  }
];

const proofItems = [
  {
    sector: 'Bridal Fashion',
    result: '+137.5% organic clicks',
    copy: 'Emily Bridalwear recorded 7.41k to 17.6k organic clicks across three months, compared with the same period a year earlier. Impressions and average position improved too. The comparison does not establish appointments or sales.',
    href: '/case-studies/bridal-dress-designer-seo/'
  },
  {
    sector: 'Ecommerce',
    result: '+49.3% organic clicks',
    copy: 'Lost Dutchman Leather, which makes full-grain wallets by hand, recorded 15.2k to 22.7k organic clicks on the same year-on-year comparison, with click-through rate rising from 3.1% to 4.5%. It does not isolate the cause of the change.',
    href: '/case-studies/leather-wallet-ecommerce-seo/'
  },
  {
    sector: 'Sports',
    result: '+34% organic clicks',
    copy: 'TeamStats, a football team management app, recorded 200k to 268k organic clicks, with average position improving from 11.4 to 9.1. These are totals for three-month comparison periods. They are not monthly figures or verified sign-ups.',
    href: '/case-studies/football-app-seo/'
  }
];

const faqs = [
  { question: 'What SEO services do Philippine businesses usually need first?', answer: 'Most campaigns start with technical SEO, keyword mapping, on-page improvements, internal linking and content gap work, in roughly that order, because a page Google cannot index gains nothing from better copy. Local businesses also need Google Business Profile optimisation and location signals, while national or ecommerce sites usually need stronger architecture, category content and authority building.' },
  { question: 'How much do SEO services cost in the Philippines?', answer: 'We do not publish a rate card. The figure depends on the size and technical condition of the site, how competitive your searches are, how much implementation is needed and whether the campaign includes content, local SEO, link building or CRO. After a preliminary review you receive a private proposal with the work, priorities and terms written down, scoped to your growth problem.' },
  { question: 'What is included in monthly SEO services?', answer: 'A monthly campaign can include technical fixes, keyword research, on-page optimisation, internal linking, content briefs, content improvements, local SEO, authority building, reporting and conversion recommendations. The mix changes with the site and is set in quarterly priorities with a monthly implementation plan. Each action is logged in the SEO Management Sheet, and the month closes with a report on what was done, what moved and what comes next.' },
  { question: 'How long does SEO take to work?', answer: 'Technical fixes and on-page improvements can show movement within weeks, but meaningful commercial growth usually takes 3 to 6 months. Competitive markets often need 6 to 12 months of consistent technical, content and authority work. How quickly changes are approved and released on your side affects the timeline as much as anything we do.' },
  { question: 'Do you guarantee rankings?', answer: 'No. Google controls the results and competitors keep moving, so nobody can honestly guarantee a fixed ranking. What we commit to is the agreed work, clear priorities, recommendations backed by evidence, and reporting that shows what changed and what happened next, including the months when results do not improve.' },
  { question: 'Can you work with businesses outside the Philippines?', answer: 'Yes. Bright Forge works with Philippine businesses and with companies in the UK, the US, Australia and New Zealand that need SEO strategy, technical implementation, content support, local SEO or an offshore SEO partner with senior experience. Proposals state the billing currency.' },
  { question: 'Do we still need SEO if AI search is changing Google?', answer: 'Yes. AI answers are assembled from clear, crawlable, trustworthy source material, which is exactly what SEO produces. We treat AI readiness as a layer on top of technical health, strong content, links, reviews and pages built to convert, and we offer no guarantee of citations.' },
  { question: 'What makes Bright Forge different from cheap SEO packages?', answer: 'A cheap package sells a fixed list of monthly tasks whether or not your site needs them. We start from a diagnosis, prioritise the fixes that can affect rankings, leads and revenue, and log each action with its owner. Then we show what changed, what the data says and what should happen next.' },
  { question: 'Can SEO get a website penalised by Google, and how do you avoid it?', answer: 'Yes, when the methods break Google\'s spam policies. Google can take manual action against a site, and its systems can demote one, for practices such as paid links presented as editorial ones, link networks, mass-produced thin content and fake reviews. We stay clear by not using them. We do not build campaigns around private blog networks, expired-domain networks, link farms or bulk guest-post packages. Paid or sponsored placements are qualified and reported as paid. Content drafts are edited by a person and approved by you before publication, and we do not buy reviews.' },
  { question: 'Is there a contract or a minimum term?', answer: 'There is no standard contract that every client signs. The engagement length, the payment terms and any notice period are written into your proposal beside the scope, so you can read them before you commit. Before signing with us or anyone else, confirm the work included, the review schedule, and which files and account access are handed over at the end.' }
];
---

<MainLayout
  title="SEO Services Philippines | Managed SEO | Bright Forge"
  description="SEO services in the Philippines: technical fixes, content, local SEO and link work. See what each month includes and how our SEO packages are scoped and quoted."
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brightforge.com.ph/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'SEO Services Philippines',
          item: 'https://brightforge.com.ph/seo-services-philippines/'
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'SEO Services Philippines for Rankings and Leads',
      url: 'https://brightforge.com.ph/seo-services-philippines/',
      inLanguage: 'en',
      description: 'Commercial SEO services in the Philippines covering technical SEO, content, local SEO, authority building, AI search readiness and conversion-focused optimisation.',
      publisher: {
        '@type': 'Organization',
        name: 'Bright Forge SEO',
        url: 'https://brightforge.com.ph/'
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: servicePillars.map((service, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: service.title,
          url: `https://brightforge.com.ph${service.href}`
        }))
      }
    })} />
  </Fragment>

  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-chart-line"
    badgeText="Commercial SEO Services"
    title="SEO Services Philippines for <span>Rankings, Leads and Growth</span>"
    breadcrumbCurrent="SEO Services Philippines"
  >
    <Fragment slot="story">
      <p>Bright Forge is an <a href="/">SEO agency in the Philippines</a>. This page sets out our managed SEO services for local and international businesses: the nine kinds of work a campaign can draw on, what happens in the first 90 days, what you receive each month, and how a proposal is scoped and priced.</p>
    </Fragment>

    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=seo-services#contactForm" text="Request an SEO Review" />
      <ButtonSecondary href="#included" text="See What Is Included" />
    </Fragment>

    <Fragment slot="stats">
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">15+</span>
          <span class="stat-label">Years SEO Experience</span>
        </div>
        <div class="stat">
          <span class="stat-number">25</span>
          <span class="stat-label">Published Case Studies</span>
        </div>
        <div class="stat">
          <span class="stat-number">SEO+CRO</span>
          <span class="stat-label">Rankings to Enquiries</span>
        </div>
      </div>
    </Fragment>
  </Hero>

  <section class="commercial-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="commercial-layout">
        <div class="commercial-copy">
          <span class="eyebrow">What the service covers</span>
          <h2>One managed service: <span>technical, content, local and authority work</span> under a single plan</h2>
          <p>If you are comparing SEO services in the Philippines, you will see packages listed by task count: so many keywords, so many articles, so many links. A more useful question to ask each provider is whether its technical fixes, local search, on-page improvements, content, authority and conversion work are planned together and aimed at the same commercial goal.</p>
          <p>Ours are. One plan decides the order: technical faults first where they block indexing, then the pages closest to an enquiry, then content and authority to widen reach. AI search readiness is part of the work, and it rests on the same foundation of crawlable pages, useful content and trusted signals.</p>
          <p>A managed campaign has three jobs. It makes the right pages easier to find, easier to trust and easier to act on. The panel beside this text lists what we check for each.</p>
          <p>In practice that means we look at crawlability, page structure, content quality, internal links, local signals, authority, tracking and the points where a visitor gives up. A page that ranks but produces no enquiries stays on the task list until it does.</p>
        </div>
        <aside class="commercial-panel" aria-label="SEO campaign focus areas">
          <div class="panel-row">
            <strong>Technical clarity</strong>
            <span>Search engines can crawl, index and understand every page that matters.</span>
          </div>
          <div class="panel-row">
            <strong>Commercial intent</strong>
            <span>Priority pages target the searches that can lead to revenue.</span>
          </div>
          <div class="panel-row">
            <strong>Trust signals</strong>
            <span>Content, links, reviews and entity signals give buyers and Google reasons to believe you.</span>
          </div>
          <div class="panel-row">
            <strong>Conversion focus</strong>
            <span>Each landing page gives visitors a clear next step once they arrive.</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="fit-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="fit-layout">
        <div>
          <span class="eyebrow">Who it is for</span>
          <h2>Four situations where managed <span>SEO support</span> fits</h2>
        </div>
        <div class="fit-list">
          <article>
            <h3>Businesses with traffic but weak enquiries</h3>
            <p>The visits are there and the phone is quiet. We review page intent, calls to action, trust signals and conversion paths, and check the tracking, so existing organic visits have a better chance of turning into leads.</p>
          </article>
          <article>
            <h3>Local service businesses</h3>
            <p>Your customers search with a place name or open Google Maps. We improve Google Business Profile signals, location pages, service pages, reviews and local relevance for searchers who are ready to call or book.</p>
          </article>
          <article>
            <h3>Ecommerce and category-led sites</h3>
            <p>Hundreds of URLs compete with each other and filters multiply them. We strengthen architecture, category content, technical foundations and internal links, so shoppers and Google reach the right products.</p>
          </article>
          <article>
            <h3>Teams that need senior SEO direction</h3>
            <p>You have people who can implement but nobody to set the order. We give internal teams, founders and marketing managers a prioritised roadmap, fix briefs a developer can act on and a monthly review of results.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="pf-section" id="fit-check">
    <div class="pf-wrap">
      <p class="eyebrow">Fit check</p>
      <h2>Which businesses <span>we suit, and which we do not</span></h2>
      <p class="pf-lede">A managed SEO service is the wrong purchase for some businesses, and it is cheaper for both sides to find that out before a proposal is written.</p>
      <div class="pf-table-wrap"><table class="pf-table">
        <thead><tr><th scope="col">Question</th><th scope="col" class="pf-us">We are a good fit when</th><th scope="col">We are probably the wrong choice when</th></tr></thead>
        <tbody>
          <tr><th scope="row">What you want from search</th><td class="pf-us">You have clear growth goals and can say what a good enquiry or sale looks like.</td><td>You want a guaranteed position for a keyword. Nobody can honestly promise one.</td></tr>
          <tr><th scope="row">Who makes the changes</th><td class="pf-us">You have a developer or team who can implement, or you can give us the access to do it.</td><td>Nothing on the site can be changed and nobody can approve an edit.</td></tr>
          <tr><th scope="row">Timescale</th><td class="pf-us">You can give the work 3 to 6 months, or 6 to 12 in a competitive market.</td><td>The business case depends on results inside a few weeks.</td></tr>
          <tr><th scope="row">How you buy</th><td class="pf-us">You want the work scoped to your site in a private proposal.</td><td>You want the cheapest fixed package with a set number of tasks each month.</td></tr>
          <tr><th scope="row">Links</th><td class="pf-us">You want placements on relevant sites, approved and recorded.</td><td>You want bulk link packages, private blog networks or link farms. We do not build campaigns on them.</td></tr>
          <tr><th scope="row">Claims on your pages</th><td class="pf-us">You can name the person who approves facts, credentials and specifications.</td><td>The brief depends on performance or certification claims nobody has approved.</td></tr>
        </tbody>
      </table></div>
      <p class="pf-note">If you are unsure which column you are in, the preliminary review answers it. Where SEO is not the right next step, we say so.</p>
    </div>
  </section>

  <section id="included" class="included-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="section-heading">
        <span class="eyebrow">What is included</span>
        <h2>Fully managed <span>SEO services</span>: the nine parts and what each delivers</h2>
        <p>No campaign uses all nine in equal measure. Some sites need technical fixes first. Others need stronger service pages, local trust, content depth, authority or better conversion paths. The diagnosis decides the mix, and each service below has its own page with the full scope.</p>
      </div>

      <div class="pillar-grid">
        {servicePillars.map((service, index) => (
          <a class="pillar-item" href={service.href}>
            <span class="pillar-top">
              <span class="pillar-glyph" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="26" height="26" fill="none" set:html={service.icon} />
              </span>
              <span class="pillar-number">{String(index + 1).padStart(2, '0')}</span>
            </span>
            <span class="pillar-kicker">{service.kicker}</span>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
            <span class="pillar-arrow">
              View service
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="max-w-7xl mx-auto px-6">
      <div class="process-grid">
        <div class="process-intro">
          <span class="eyebrow">First 90 days</span>
          <h2>What happens after an <span>SEO campaign starts</span></h2>
          <p>This sequence shows how diagnosis, implementation and review usually fit together in the first quarter, and what then arrives every month. It is an illustration: delivery dates depend on access, the agreed scope and your approval or development process.</p>
        </div>
        <div class="timeline">
          {processSteps.map((step) => (
            <article class="timeline-item">
              <span>{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pf-section" id="why-campaigns-fail">
    <div class="pf-wrap">
      <p class="eyebrow">Risk</p>
      <h2>Why <span>SEO campaigns commonly fail</span>, and how we guard against each cause</h2>
      <p class="pf-lede">Most disappointing campaigns fail for ordinary, avoidable reasons. These are the six we plan against, with the working rule that answers each one.</p>
      <div class="pf-table-wrap"><table class="pf-table">
        <thead><tr><th scope="col">Cause</th><th scope="col">What it looks like</th><th scope="col" class="pf-us">What we do about it</th></tr></thead>
        <tbody>
          <tr><th scope="row">No diagnosis</th><td>Monthly tasks begin before anyone has established what is holding the site back.</td><td class="pf-us">A preliminary review first, then a diagnostic with a 90-day roadmap in which each item carries its evidence and priority.</td></tr>
          <tr><th scope="row">Advice that is never implemented</th><td>An audit sits in a folder because nobody owns the changes.</td><td class="pf-us">The roadmap names who approves and who implements each change, and every action is logged in the SEO Management Sheet with its owner.</td></tr>
          <tr><th scope="row">Pages competing with each other</th><td>Two or three URLs chase the same search and none ranks well.</td><td class="pf-us">A keyword map assigns each group of searches to one existing or proposed page.</td></tr>
          <tr><th scope="row">A fixed task list</th><td>The same activity is repeated each month whatever the data says.</td><td class="pf-us">Each month we review dated query and page results, including what has not improved, and those findings set the next work.</td></tr>
          <tr><th scope="row">Traffic measured, enquiries ignored</th><td>Reports show rising clicks while calls and forms go uncounted.</td><td class="pf-us">Call and form tracking is checked, and reports keep search visibility, tracked actions and confirmed outcomes separate.</td></tr>
          <tr><th scope="row">Shortcuts</th><td>Link networks or bulk placements bring a short lift and leave a lasting risk on the domain.</td><td class="pf-us">No private blog networks, expired-domain networks, link farms or bulk guest-post packages. Paid placements are qualified and reported as paid.</td></tr>
        </tbody>
      </table></div>
    </div>
  </section>

  <section class="engagement-section">
