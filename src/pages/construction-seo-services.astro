---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/construction-seo-services/',
  title: 'Construction SEO Services for Builders | Bright Forge',
  description: 'SEO for builders, contractors and building-product suppliers: service and project pages that win quote requests, backed by five published Search Console cases.',
  h1: 'Construction and Industrial SEO Services',
  crumb: 'Construction SEO',
  parents: [{ name: 'Industries', url: '/industries/' }],
  lead: [
    'Builders, contractors and suppliers are found through searches for a service in a place ("scaffolding hire" plus a town) or for a product by specification. We build the service, location and product pages that answer those searches and make it easy to ask for a quote.',
  ],
  sections: [
    {
      h2: 'Published results from construction and industrial sites',
      html: `<p>These clients are not named. Figures are from Search Console and compare two 90-day periods.</p>
<ul class="bf-results">
<li><span class="bf-num">170 to 1,311</span><span class="bf-what"><strong>Building-products supplier:</strong> organic clicks</span><a class="bf-src" href="/case-studies/pvc-building-products-search-growth/">Case study</a></li>
<li><span class="bf-num">+2,433</span><span class="bf-what"><strong>Custom home builder:</strong> additional organic clicks, from 7,201 to 9,634</span><a class="bf-src" href="/case-studies/custom-home-builder-search-growth/">Case study</a></li>
<li><span class="bf-num">704 to 1,054</span><span class="bf-what"><strong>Industrial equipment manufacturer:</strong> organic clicks</span><a class="bf-src" href="/case-studies/industrial-parts-washing-search-growth/">Case study</a></li>
<li><span class="bf-num">1,016 to 1,216</span><span class="bf-what"><strong>Regional scaffolding contractor:</strong> more clicks from fewer impressions, with better average position</span><a class="bf-src" href="/case-studies/regional-scaffolding-growth/">Case study</a></li>
<li><span class="bf-num">+4,621</span><span class="bf-what"><strong>Metal recycling business:</strong> additional organic clicks, from 18,252 to 22,873</span><a class="bf-src" href="/case-studies/metal-recycling-search-growth/">Case study</a></li>
</ul>
<p>Each case study gives the comparison period. The figures record clicks, not quotes or completed jobs.</p>`,
    },
    {
      h2: 'What we work on',
      html: `<dl class="bf-deliverables">
<dt>Service pages</dt><dd>For each trade or service, with the areas covered.</dd>
<dt>Project pages</dt><dd>Photos, scope, location, the client's words where permitted.</dd>
<dt>Product pages</dt><dd>With specifications, standards and data sheets.</dd>
<dt>Google Business Profile</dt><dd>For each depot or office. See <a href="/local-seo-for-google-maps-and-gbp/">local SEO</a>.</dd>
<dt>Quote forms and phone links</dt><dd>That work on site, on a phone.</dd>
<dt>Accreditations and insurance</dt><dd>Shown where buyers look for them.</dd>
</dl>`,
    },
    {
      h2: 'How we do it',
      html: `<ol class="bf-steps">
<li>Review which services and areas bring profitable work.</li>
<li>Keyword research by service and place.</li>
<li>Rebuild the priority pages; add projects as proof.</li>
<li>Local SEO for each real location.</li>
<li>Report monthly on quote requests and calls from search.</li>
</ol>
<p>For domestic trades, see <a href="/home-services-seo/">home services SEO</a>. For suppliers selling to other businesses, see <a href="/b2b-seo-services/">B2B SEO</a>.</p>`,
    },
  ],
  faqs: [
    { question: 'Should we have a page for every town we work in?', answer: 'Only for places you really serve, and only where the page says something particular to that place. Repeating the same text with a different town name does not help.' },
    { question: 'Do the published results show enquiries?', answer: 'No. They record Search Console clicks for anonymised clients. Quote requests and calls are reported separately where tracking allows.' },
  ],
};
---
<EditorialPage page={page} />
