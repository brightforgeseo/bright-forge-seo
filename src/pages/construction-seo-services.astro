---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/construction-seo-services/";
const faqs = [
  {
    question: "What is construction SEO?",
    answer: "Construction SEO is search work for builders, contractors, manufacturers and industrial suppliers. It is not a homepage polish job. The useful work sits on service pages, project or product pages, local coverage where it is real, and enquiry paths that turn specification searches into quotes.",
  },
  {
    question: "How is this different from home services SEO?",
    answer: "Home services SEO is for urgent local trades such as plumbing, HVAC, roofing and cleaning. Construction and industrial SEO is for longer buying cycles: new builds, scaffolding, building products, equipment and B2B supply. Those searches need project proof, specification content and catalogue structure, not just Google Business Profile work.",
  },
  {
    question: "Do we need a page for every service and product?",
    answer: "Every distinct service or product line that people search for needs its own page. A single Services dump with bullet points cannot rank for extensions, scaffolding, PVC systems and equipment at once. We map the searches first, then decide which pages already exist and which ones would overlap.",
  },
  {
    question: "How do you measure construction SEO?",
    answer: "Rankings matter, but the page still has to produce quote requests, tender enquiries or product contacts. We track impressions, clicks, landing pages, enquiry paths where tracking exists, and whether the right commercial URLs are gaining coverage.",
  },
  {
    question: "Do you guarantee first-page rankings?",
    answer: "No. Construction and industrial markets vary by trade, city and authority. We work from Search Console, page quality and competitor coverage, then report what moved. We do not sell guaranteed positions.",
  },
];
---

<MainLayout title="Construction SEO | Industrial Search | Bright Forge" description="SEO for construction companies, contractors and industrial suppliers. Service pages, project proof and quote paths, with published Search Console case studies." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Construction SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Construction and industrial <span>SEO</span>" breadcrumbCurrent="Construction SEO">
    <Fragment slot="story">
      <p class="hero-subtitle">SEO for builders, contractors and industrial suppliers that need quotes, not a prettier brochure.</p>
      <p>Buyers research the trade, the product and the proof for weeks. A generic agency page cannot carry scaffolding, building products and equipment searches at once. We build the pages that match how those jobs are actually bought.</p>
    </Fragment>
    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Request an SEO Review" />
      <ButtonSecondary href="#results" text="See Published Results" />
    </Fragment>
  </Hero>
  <main class="service-page">
    <section>
      <div class="page-container intro-grid">
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2><span>Construction SEO</span> for firms that sell projects, products or plant</h2>
          <p>This page is for construction companies, regional contractors, manufacturers and industrial suppliers. It is not the page for plumbers, HVAC firms or roofers. Those sit on our <a href="/home-services-seo/">home services SEO</a> work, because the search behaviour is different.</p>
          <p>Construction and industrial buyers look for a trade, a system or a specification. They compare project photos, product ranges and whether the company can actually do the work in their market. The SEO job is to make those pages clear, crawlable and easy to enquire from.</p>
        </div>
        <aside class="panel">
          <h3>What we check first</h3>
          <ul>
            <li>Each trade or product line has its own page</li>
            <li>Project and product proof is on the commercial URLs</li>
            <li>Filters, PDFs and duplicate catalogue pages are not wasting crawl</li>
            <li>Location pages only cover real service areas</li>
            <li>Quote requests can be tracked</li>
          </ul>
        </aside>
      </div>
    </section>

    <section id="results">
      <div class="page-container">
        <p class="eyebrow">Published proof</p>
        <h2>Search Console results from <span>construction and industrial</span> sites</h2>
        <p class="lead">These are anonymised 90-day comparisons already published on our case studies. No client names. No invented percentages.</p>
        <div class="results-grid">
          <article class="result-card">
            <p class="result-tag">Construction · Custom homes</p>
            <h3>+33.8% clicks, +2,433 extra visits</h3>
            <p>A custom home builder reached 9,634 organic clicks in 90 days. CTR improved while blended position softened as coverage widened.</p>
            <a href="/case-studies/custom-home-builder-search-growth/">Read the case study</a>
          </article>
          <article class="result-card">
            <p class="result-tag">Industrial · Building products</p>
            <h3>+671% clicks: 170 to 1,311</h3>
            <p>A building-products supplier grew from a small base as impressions and average position both improved, ending at position 11.2.</p>
            <a href="/case-studies/pvc-building-products-search-growth/">Read the case study</a>
          </article>
          <article class="result-card">
            <p class="result-tag">Industrial · Garden products</p>
            <h3>+48.9% clicks from the same demand</h3>
            <p>921 extra clicks with almost the same impression base. CTR did the work, not a bigger market.</p>
            <a href="/case-studies/garden-products-search-growth/">Read the case study</a>
          </article>
          <article class="result-card">
            <p class="result-tag">Construction · Scaffolding</p>
            <h3>+19.7% clicks, stronger position</h3>
            <p>A regional scaffolding contractor took 1,216 clicks from a tighter footprint, with average position at 14.7.</p>
            <a href="/case-studies/regional-scaffolding-growth/">Read the case study</a>
          </article>
          <article class="result-card">
            <p class="result-tag">Industrial · Metal recycling</p>
            <h3>+25.3% clicks, +4,621 visits</h3>
            <p>22,873 organic clicks as coverage expanded. The blended ranking trade-off stays on the case study.</p>
            <a href="/case-studies/metal-recycling-search-growth/">Read the case study</a>
          </article>
          <article class="result-card">
            <p class="result-tag">Industrial · Pool systems</p>
            <h3>+79.8% clicks, +152% impressions</h3>
            <p>Coverage is the honest story here. Clicks rose while blended position and CTR softened.</p>
            <a href="/case-studies/pool-control-systems-search-growth/">Read the case study</a>
          </article>
        </div>
      </div>
    </section>

    <section id="included">
      <div class="page-container">
        <p class="eyebrow">What the work covers</p>
        <h2>What <span>construction company SEO</span> actually needs</h2>
        <div class="fit-grid">
          <article class="fit-card">
            <h3>One page per trade or product</h3>
            <p>If you do new builds, scaffolding, civil work or a product system, those are separate pages. Competitors that rank well do not hide five trades on one Services list.</p>
          </article>
          <article class="fit-card">
            <h3>Project and product proof</h3>
            <p>Specification buyers want completed work, ranges and clear next steps. We tighten project, product and category pages before adding blog volume.</p>
          </article>
          <article class="fit-card">
            <h3>Catalogue and crawl control</h3>
            <p>Industrial sites often waste crawl on filters, PDFs and duplicate product URLs. We clean the architecture so Google spends time on quote pages.</p>
          </article>
          <article class="fit-card">
            <h3>Local only where it is real</h3>
            <p>Regional contractors need service-area pages that match actual coverage. We do not invent cities. National product brands need category demand, not fake maps.</p>
          </article>
          <article class="fit-card">
            <h3>Quote paths that work</h3>
            <p>The page has to ask for the enquiry. Forms, phone, drawings upload and sales-assisted contact beat a buried footer link.</p>
          </article>
          <article class="fit-card">
            <h3>Honest measurement</h3>
            <p>We report the URLs that gained clicks and whether enquiry tracking exists. Traffic without a quote is not the win.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container two-column">
        <div>
          <p class="eyebrow">Fit</p>
          <h2>Right for <span>industrial SEO</span> when the offer is specific</h2>
          <p>This suits house builders, scaffolding contractors, building-product manufacturers, equipment suppliers and recycling or processing firms that already know which jobs they want more of.</p>
          <p>If the site cannot name its trades, serve the geography it claims, or handle extra quotes, SEO should wait. We would rather fix the pages and the offer than publish thin location copies.</p>
        </div>
        <div class="panel">
          <h3>Not the right fit when</h3>
          <p>the business only wants map-pack work for a single trade we already cover on home services, wants guaranteed rankings, or will not let us use Search Console and conversion tracking.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container">
        <p class="eyebrow">Related work</p>
        <h2><span>Useful next steps</span> from here</h2>
        <div class="link-grid">
          <a href="/home-services-seo/"><span>Home services SEO</span>Plumbing, HVAC, roofing and other urgent local trades.</a>
          <a href="/legal-seo-services/"><span>Legal SEO</span>Practice-area pages and intake paths for law firms.</a>
          <a href="/case-studies/"><span>Case studies</span>The construction and industrial evidence behind this page.</a>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container faq-layout">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2><span>Construction SEO</span> questions</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="page-container">
        <div class="cta-card">
          <h2>Want construction pages that win <span>quotes</span>, not just impressions?</h2>
          <p>We can review your service, project and product URLs against the work you actually want more of, then say what is missing.</p>
          <div class="cta-actions">
            <ButtonPrimary href="/contact/" text="Request an SEO Review" />
            <ButtonSecondary href="/case-studies/" text="View Case Studies" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#0d0f1a; color:#fff; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.service-page section { padding:78px 0; content-visibility:visible !important; }
.service-page section:nth-child(even) { background:#111421; }
.eyebrow { display:block; color:#f0622a; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#fff; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; }
h3 { color:#fff; font-size:1.16rem; margin:0 0 10px; }
p, li { color:rgba(255,255,255,.74); font-size:1.02rem; line-height:1.72; }
a { color:#f0622a; }
.lead { max-width:68ch; margin:0 0 28px; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; }
.panel, .fit-card, .result-card, .faq-item, .cta-card { border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.045); border-radius:24px; box-shadow:0 18px 48px rgba(0,0,0,.18); }
.panel { padding:28px; }
.panel ul { margin:0; padding-left:20px; }
.fit-grid, .results-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.fit-card, .result-card, .link-grid a { padding:24px; }
.result-tag { color:#f0622a; font-size:.78rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; margin:0 0 10px; }
.result-card a { font-weight:800; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.045); border-radius:24px; }
.link-grid span { display:block; color:#fff; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; }
.faq-item summary { cursor:pointer; padding:22px 24px; color:#fff; font-weight:900; list-style:none; }
.faq-item summary::-webkit-details-marker { display:none; }
.faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255,255,255,.045)); }
.cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){
  .intro-grid,.two-column,.fit-grid,.results-grid,.link-grid,.faq-layout{grid-template-columns:1fr;}
}
</style>
