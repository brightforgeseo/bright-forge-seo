---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';

const aiSearchFaqs = [
  {
    question: 'What is the difference between AI SEO, GEO and AEO?',
    answer: 'AI SEO is the broad practice of improving visibility across AI-assisted discovery. Generative engine optimisation, or GEO, focuses on how brands and sources appear in generated answers. Answer engine optimisation, or AEO, focuses on direct answers and citation-ready information. We treat them as connected layers of SEO, not separate magic tricks.'
  },
  {
    question: 'Does AI search optimisation replace traditional SEO?',
    answer: 'No. Google states that the same SEO fundamentals still apply to AI Overviews and AI Mode. Crawlability, indexation, useful content, internal links, page experience, entity clarity and authority remain the foundation. AI search work makes those foundations clearer and more useful across answer-led experiences.'
  },
  {
    question: 'Can you guarantee citations in ChatGPT, Perplexity or Google AI Overviews?',
    answer: 'No agency can guarantee inclusion, citations or a fixed position in generated answers. The systems, sources and responses change. We improve the conditions that support visibility, then measure what can be observed without presenting sampled prompts as guaranteed market coverage.'
  },
  {
    question: 'Do we need an llms.txt file or special AI schema?',
    answer: 'Not for Google AI Overviews or AI Mode. Google says there is no special schema or AI text file required. We use valid structured data where it helps describe real visible content, and we check crawler controls such as OAI-SearchBot separately for platforms that publish them.'
  },
  {
    question: 'What does an AI search visibility audit include?',
    answer: 'We review priority prompt and query families, current citations, competing sources, crawler access, indexation, entity clarity, content structure, evidence, third-party authority, internal links and measurement. The result is a prioritised programme tied to pages and commercial journeys.'
  },
  {
    question: 'How do you measure AI search visibility?',
    answer: 'We combine prompt-set observations with platform data where available, including Search Console, Bing Webmaster Tools AI Performance, referral traffic and GA4 conversion events. We distinguish a citation, a visit, a tracked action and a confirmed lead rather than treating every mention as revenue.'
  },
  {
    question: 'How long does AI SEO take?',
    answer: 'Timing depends on crawl health, authority, competition, content quality and how much of the site needs repair. Some technical and content changes can be implemented quickly, but discovery, recrawling, citation changes and commercial results develop over time. We scope the work before setting expectations.'
  },
  {
    question: 'How much do GEO and AI SEO services cost?',
    answer: 'We price through a private proposal after reviewing the number of markets, platforms, priority topics, pages, technical issues, authority gaps and reporting requirements. We do not publish a generic rate because a focused service-site audit and an international ecommerce programme are not the same job.'
  }
];

const methodSteps = [
  {
    number: '01',
    title: 'Map the questions that shape a buying decision',
    copy: 'We group real commercial queries and prompts around discovery, comparison, proof, objections and selection. This creates a useful test set, not a random list of vanity prompts.',
    output: 'Prompt and query map'
  },
  {
    number: '02',
    title: 'Establish where the brand is present, absent or misrepresented',
    copy: 'We record cited domains, landing pages, answer themes and competitor appearances across the agreed surfaces. Each observation keeps its date, market and prompt context.',
    output: 'Visibility baseline'
  },
  {
    number: '03',
    title: 'Repair the source material',
    copy: 'We strengthen crawl access, service clarity, entity relationships, evidence, internal links and the sections answer systems can quote without losing the original meaning.',
    output: 'Prioritised page work'
  },
  {
    number: '04',
    title: 'Build authority beyond the page',
    copy: 'Your own claims are only one source. We identify relevant reviews, profiles, publications, citations and digital PR opportunities that can corroborate the business honestly.',
    output: 'Authority plan'
  },
  {
    number: '05',
    title: 'Measure citations and commercial movement separately',
    copy: 'We track the signals each platform exposes, then connect referral visits and conversion events where possible. A citation is visibility. It is not automatically a lead or sale.',
    output: 'Decision-ready reporting'
  }
];

const platformRows = [
  {
    platform: 'Google',
    surface: 'AI Overviews and AI Mode',
    reality: 'Pages still need to be indexed, snippet-eligible and built on normal SEO fundamentals. Google says there is no special schema required.',
    check: 'Indexation, content usefulness, internal discovery, snippet controls and Search Console performance.'
  },
  {
    platform: 'OpenAI',
    surface: 'ChatGPT search',
    reality: 'OpenAI documents OAI-SearchBot as the crawler used to surface sites in ChatGPT search results. Search access is separate from GPTBot training controls.',
    check: 'Crawler access, cited-page quality, brand accuracy, referral traffic and priority research prompts.'
  },
  {
    platform: 'Perplexity',
    surface: 'Cited research answers',
    reality: 'Answers can cite multiple web sources and change as retrieval changes. Clear, current source pages and corroborating authority matter more than keyword repetition.',
    check: 'Citation patterns, competing sources, source-page depth, evidence and freshness.'
  },
  {
    platform: 'Microsoft',
    surface: 'Copilot and Bing AI answers',
    reality: 'Bing Webmaster Tools now reports citations, cited URLs and sampled grounding queries through AI Performance.',
    check: 'AI Performance, Bing indexation, cited URLs, grounding-query themes and IndexNow suitability.'
  }
];
---

<MainLayout
  title="AI SEO, GEO & AEO Services | Bright Forge"
  description="AI SEO, GEO and AEO services for Google AI Overviews, ChatGPT, Perplexity and Copilot. Build clearer, citable pages that support qualified leads."
  canonical="https://brightforge.com.ph/ai-search-optimization-services-philippines/"
  type="service"
  faqs={aiSearchFaqs}
>
  <LegacyHeader slot="header" />

  <main class="ai-page">
    <section class="ai-hero">
      <div class="ai-shell">
        <nav class="ai-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>AI SEO, GEO &amp; AEO Services</span>
        </nav>

        <div class="ai-hero-layout">
          <div class="ai-hero-copy">
            <p class="ai-kicker"><span></span> Search visibility beyond blue links</p>
            <h1>AI SEO, GEO &amp; AEO services for <span>brands worth citing</span></h1>
            <p class="ai-lede">We make your business easier to find, understand and verify across Google AI Overviews, ChatGPT, Perplexity, Microsoft Copilot and the search journeys around them.</p>
            <p class="ai-hero-note">SEO stays underneath it. Clear entities, strong source pages, technical access, useful evidence and external authority do the real work.</p>
            <div class="ai-actions">
              <a class="ai-button ai-button-primary" href="/contact/">Request an AI visibility audit <span aria-hidden="true">→</span></a>
              <a class="ai-button ai-button-secondary" href="#method">See the method</a>
            </div>
            <ul class="ai-trust-line" aria-label="Service positioning">
              <li>British-led</li>
              <li>Philippines-based</li>
              <li>International delivery</li>
              <li>No citation guarantees</li>
            </ul>
          </div>

          <div class="citation-observatory" aria-label="Illustration of a brand becoming a cited source in AI search">
            <div class="observatory-bar">
              <span><i></i><i></i><i></i></span>
              <small>ILLUSTRATIVE CITATION PATH</small>
            </div>
            <div class="observatory-query">
              <span>Buyer question</span>
              <strong>Which provider can solve this with credible evidence?</strong>
            </div>
            <div class="answer-surface">
              <div class="answer-label"><span>Generated answer</span><small>Sources checked</small></div>
              <p>A credible recommendation needs a clear service fit, verifiable proof and sources that agree on the business.</p>
              <div class="answer-lines" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="source-stack">
                <div><span>01</span><p><strong>Your service page</strong><small>Specific offer and market fit</small></p><b>READY</b></div>
                <div><span>02</span><p><strong>Your evidence</strong><small>Cases, reviews and named expertise</small></p><b>PROOF</b></div>
                <div><span>03</span><p><strong>Independent sources</strong><small>Relevant third-party corroboration</small></p><b>TRUST</b></div>
              </div>
            </div>
            <svg class="signal-path" viewBox="0 0 560 480" aria-hidden="true" preserveAspectRatio="none">
              <path d="M42 405 C150 350 155 250 267 233 S407 160 520 74" />
              <circle cx="42" cy="405" r="5" />
              <circle cx="267" cy="233" r="5" />
              <circle cx="520" cy="74" r="5" />
            </svg>
            <p class="observatory-caption"><span>Signal, not theatre.</span> No live client data is shown in this illustration.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-shift">
      <div class="ai-shell ai-shift-layout">
        <div class="shift-statement">
          <p class="ai-kicker"><span></span> The commercial shift</p>
          <h2>Your next customer may meet the <em>answer</em> before they meet your website.</h2>
        </div>
        <div class="shift-copy">
          <p>Buyers now ask systems to compare providers, shortlist options, explain trade-offs and recommend next steps. A classic ranking can still matter while the click happens later, lands on a different page or never happens at all.</p>
          <p>That creates a new visibility problem. Your brand must be retrievable, accurately described and supported by sources an answer system can use. The work is often called <strong>AI SEO</strong>, <strong>generative engine optimisation</strong> or <strong>GEO</strong>, <strong>answer engine optimisation</strong> or <strong>AEO</strong>, and <strong>LLM SEO</strong>.</p>
          <p>We keep those labels on one existing owner page because the buyer problem is the same: become a credible source and turn the visibility into qualified demand.</p>
        </div>
      </div>
    </section>

    <section class="ai-reality" id="reality">
      <div class="ai-shell">
        <div class="ai-section-heading">
          <p class="ai-kicker"><span></span> The no-nonsense version</p>
          <h2>What AI search optimisation can change, and what it cannot</h2>
        </div>
        <div class="reality-rule"></div>
        <div class="reality-columns">
          <div class="reality-side reality-side-positive">
            <p class="reality-label">WE CAN IMPROVE</p>
            <ul>
              <li><span>01</span><p><strong>Retrievability</strong>Your important pages can be crawled, indexed and discovered through strong internal architecture.</p></li>
              <li><span>02</span><p><strong>Clarity</strong>Your brand, services, markets, expertise and proof can be understood without guesswork.</p></li>
              <li><span>03</span><p><strong>Source quality</strong>Your pages can answer useful questions with specific evidence and current information.</p></li>
              <li><span>04</span><p><strong>Corroboration</strong>Relevant third-party signals can support what your own site says about the business.</p></li>
              <li><span>05</span><p><strong>Measurement</strong>Observed citations, cited URLs, referrals and tracked actions can inform the next decision.</p></li>
            </ul>
          </div>
          <div class="reality-side reality-side-limit">
            <p class="reality-label">WE WILL NOT PRETEND</p>
            <ul>
              <li><span>×</span><p><strong>There is a secret GEO switch</strong>Google says normal SEO fundamentals still underpin its AI features.</p></li>
              <li><span>×</span><p><strong>Special markup guarantees inclusion</strong>There is no special schema that forces a brand into Google AI Overviews or AI Mode.</p></li>
              <li><span>×</span><p><strong>A prompt sample is market share</strong>Generated answers vary by model, time, location, retrieval and wording.</p></li>
              <li><span>×</span><p><strong>A mention is a sale</strong>A citation, referral visit, tracked action and confirmed lead are different commercial signals.</p></li>
              <li><span>×</span><p><strong>No agency can guarantee citations</strong>We improve eligibility and source strength. Platforms decide what they retrieve and present.</p></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-method" id="method">
      <div class="ai-shell">
        <div class="method-intro">
          <div>
            <p class="ai-kicker"><span></span> The Bright Forge method</p>
            <h2>From invisible brand to usable source</h2>
          </div>
          <p>Not a checklist sold as strategy. Each stage produces an evidence-backed output that tells us what to fix, why it matters and how we will judge movement.</p>
        </div>

        <div class="method-ledger">
          {methodSteps.map((step) => (
            <article class="method-row">
              <span class="method-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
              <strong>{step.output}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-source-system">
      <div class="ai-shell source-layout">
        <div class="source-copy">
          <p class="ai-kicker"><span></span> Citation readiness</p>
          <h2>An answer engine needs more than a well-written paragraph.</h2>
          <p>We connect the page to a wider source system. That means the technical route into the content, the facts on the page, the evidence behind those facts and the independent signals that help verify them.</p>
          <p>This is where our <a href="/technical-seo-services-philippines/">technical SEO</a>, <a href="/content-seo-services-philippines/">content SEO</a>, <a href="/backlink-seo-services-philippines/">authority work</a> and <a href="/seo-command-centre/">measurement layer</a> work together.</p>
        </div>
        <div class="source-orbit" aria-label="Four connected layers of citation readiness">
          <div class="orbit-core"><small>USEFUL</small><strong>SOURCE</strong><span>for a real buyer question</span></div>
          <div class="orbit-ring orbit-ring-one"><span>Technical access</span></div>
          <div class="orbit-ring orbit-ring-two"><span>Entity clarity</span></div>
          <div class="orbit-ring orbit-ring-three"><span>Evidence</span></div>
          <div class="orbit-ring orbit-ring-four"><span>Authority</span></div>
        </div>
      </div>
    </section>

    <section class="ai-platforms">
      <div class="ai-shell">
        <div class="platform-heading">
          <div>
            <p class="ai-kicker"><span></span> Different surfaces, one strategy</p>
            <h2>We optimise for the search ecosystem, not one screenshot.</h2>
          </div>
          <p>Every platform exposes different controls and reporting. We use what the platforms document, then apply experienced SEO judgement where the data remains incomplete.</p>
        </div>

        <div class="platform-run" role="table" aria-label="AI search platforms and optimisation checks">
          <div class="platform-run-head" role="row">
            <span role="columnheader">Platform</span>
            <span role="columnheader">Surface</span>
            <span role="columnheader">What matters</span>
            <span role="columnheader">What we check</span>
          </div>
          {platformRows.map((row, index) => (
            <article class="platform-row" role="row">
              <div role="cell"><small>0{index + 1}</small><strong>{row.platform}</strong></div>
              <p role="cell">{row.surface}</p>
              <p role="cell">{row.reality}</p>
              <p role="cell">{row.check}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-measurement">
      <div class="ai-shell measurement-layout">
        <div class="measurement-copy">
          <p class="ai-kicker"><span></span> Measurement without make-believe</p>
          <h2>We separate visibility from visits, and visits from leads.</h2>
          <p>AI search reporting is still uneven. We build a defensible view from the strongest available evidence instead of inventing a single visibility score.</p>
          <a href="/seo-command-centre/">See our wider SEO measurement approach <span aria-hidden="true">→</span></a>
        </div>
        <ol class="measurement-chain">
          <li><span>01</span><p><strong>Observed citation</strong><small>A brand or page appears for a recorded prompt at a recorded time.</small></p></li>
          <li><span>02</span><p><strong>Cited URL or grounding query</strong><small>A platform exposes the source page or retrieval theme.</small></p></li>
          <li><span>03</span><p><strong>Referral visit</strong><small>Analytics records traffic from an identifiable AI or search surface.</small></p></li>
          <li><span>04</span><p><strong>Tracked action</strong><small>A visitor submits, calls, books or completes another configured conversion event.</small></p></li>
          <li><span>05</span><p><strong>Confirmed lead or sale</strong><small>Your commercial process confirms the outcome. Analytics alone does not.</small></p></li>
        </ol>
      </div>
    </section>

    <section class="ai-deliverables">
      <div class="ai-shell deliverables-layout">
        <div class="deliverables-title">
          <p class="ai-kicker"><span></span> What the engagement can include</p>
          <h2>Senior SEO work, adapted for AI-assisted discovery.</h2>
        </div>
        <div class="deliverables-list">
          <article><span>DIAGNOSE</span><h3>AI visibility and citation audit</h3><p>Priority prompts, answer surfaces, cited competitors, source pages, crawler access, indexation and commercial gaps.</p></article>
          <article><span>CLARIFY</span><h3>Entity and service architecture</h3><p>Clear relationships between the brand, people, services, locations, products, proof assets and authoritative profiles.</p></article>
          <article><span>STRENGTHEN</span><h3>Citation-ready page improvements</h3><p>Direct answers, original evidence, comparison detail, scannable structure, internal links and useful supporting media.</p></article>
          <article><span>VALIDATE</span><h3>Technical access and structured data</h3><p>Robots rules, rendering, indexability, snippet controls and valid schema that reflects visible page content.</p></article>
          <article><span>CORROBORATE</span><h3>Authority and digital PR direction</h3><p>Relevant reviews, publications, profiles and third-party sources that can substantiate the business without fake mentions.</p></article>
          <article><span>MEASURE</span><h3>AI and organic visibility reporting</h3><p>Prompt observations, platform data, referrals and conversion signals presented with the limits clearly stated.</p></article>
        </div>
      </div>
    </section>

    <section class="ai-fit">
      <div class="ai-shell fit-layout">
        <div class="fit-heading">
          <p class="ai-kicker"><span></span> Commercial fit</p>
          <h2>This work is valuable when the decision is valuable.</h2>
        </div>
        <div class="fit-editorial">
          <div>
            <h3>Strong fit</h3>
            <p>B2B, professional services, considered ecommerce, SaaS, healthcare, education, property, industrial and multi-market brands where buyers research before choosing.</p>
          </div>
          <div>
            <h3>Usually needs foundations first</h3>
            <p>Sites with blocked crawling, weak service pages, no useful proof, unclear positioning or little conventional search visibility. We repair the source before selling monitoring theatre.</p>
          </div>
          <div>
            <h3>Not a fit</h3>
            <p>Businesses asking for guaranteed ChatGPT recommendations, fabricated mentions, mass AI pages or a shortcut around earning trust.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-commercial" id="scope">
      <div class="ai-shell">
        <div class="commercial-brief">
          <div class="commercial-copy">
            <p class="ai-kicker"><span></span> Private scope and proposal</p>
            <h2>No mystery package. No public rate pretending every site is the same.</h2>
            <p>We scope AI SEO services around the work required, the markets that matter and the commercial value of the decisions being influenced.</p>
            <a class="ai-button ai-button-primary" href="/contact/">Discuss your AI search opportunity <span aria-hidden="true">→</span></a>
          </div>
          <div class="commercial-factors">
            <p>YOUR PRIVATE PROPOSAL CONSIDERS</p>
            <ul>
              <li>Markets, languages and priority platforms</li>
              <li>Number of services, products and source pages</li>
              <li>Technical, content and entity repair required</li>
              <li>Prompt-set depth and competitor monitoring</li>
              <li>Authority, evidence and digital PR gaps</li>
              <li>Reporting and conversion-measurement needs</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-sources">
      <div class="ai-shell sources-layout">
        <div>
          <p class="ai-kicker"><span></span> Primary-source reality check</p>
          <h2>What the platforms actually say</h2>
        </div>
        <div class="source-links">
          <a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noopener noreferrer">
            <span>GOOGLE SEARCH CENTRAL</span>
            <strong>AI features and your website</strong>
            <p>Google says standard SEO best practices remain relevant and no special schema is required.</p>
          </a>
          <a href="https://developers.openai.com/api/docs/bots" target="_blank" rel="noopener noreferrer">
            <span>OPENAI</span>
            <strong>Overview of OpenAI crawlers</strong>
            <p>OpenAI explains OAI-SearchBot, GPTBot and ChatGPT-User as separate controls and use cases.</p>
          </a>
          <a href="https://blogs.bing.com/webmaster/February-2026/Introducing-AI-Performance-in-Bing-Webmaster-Tools-Public-Preview" target="_blank" rel="noopener noreferrer">
            <span>MICROSOFT BING</span>
            <strong>AI Performance in Bing Webmaster Tools</strong>
            <p>Bing documents citation counts, cited URLs and sampled grounding queries for AI answers.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="ai-faq">
      <div class="ai-shell faq-layout">
        <div class="faq-heading">
          <p class="ai-kicker"><span></span> Straight answers</p>
          <h2>AI SEO, GEO and AEO FAQs</h2>
          <p>Enough acronyms. Here is what matters before you invest.</p>
        </div>
        <div class="faq-list">
          {aiSearchFaqs.map((faq, index) => (
            <details>
              <summary><span>0{index + 1}</span>{faq.question}<i aria-hidden="true">+</i></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-final-cta">
      <div class="ai-shell final-cta-layout">
        <p>READY TO BECOME A BETTER SOURCE?</p>
        <h2>Find out where your brand disappears from the answer.</h2>
        <div>
          <p>We will assess the search foundations, source pages, authority and measurable AI visibility behind your priority commercial topics.</p>
          <a class="ai-button ai-button-primary" href="/contact/">Request an AI visibility audit <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <ContactSection />
  <Footer slot="footer" />
</MainLayout>

<style>
  :root {
    --ai-ink: #080a13;
    --ai-night: #0d1020;
    --ai-panel: #14182a;
    --ai-panel-soft: #1a1f34;
    --ai-orange: #f0622a;
    --ai-orange-bright: #ff7a3d;
    --ai-cream: #f3efe8;
    --ai-white: #ffffff;
    --ai-muted: #b7bdcf;
    --ai-border: rgba(255, 255, 255, 0.11);
    --ai-line: rgba(240, 98, 42, 0.42);
  }

  .ai-page {
    background: var(--ai-ink);
    color: var(--ai-white);
    overflow: hidden;
  }

  .ai-shell {
    width: min(1240px, calc(100% - 48px));
    margin-inline: auto;
  }

  .ai-hero {
    position: relative;
    padding: 42px 0 112px;
    background:
      radial-gradient(circle at 82% 17%, rgba(240, 98, 42, 0.14), transparent 25%),
      linear-gradient(115deg, #0f1222 0%, #090b14 60%, #0b0d18 100%) !important;
    border-bottom: 1px solid var(--ai-border);
  }

  .ai-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .22;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 82%);
  }

  .ai-breadcrumb {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 62px;
    color: #8f96aa;
    font-size: .82rem;
  }

  .ai-breadcrumb a { color: #cdd1de; text-decoration: none; }
  .ai-breadcrumb a:hover { color: var(--ai-orange-bright); }

  .ai-hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(480px, .78fr);
    align-items: center;
    gap: clamp(48px, 7vw, 108px);
  }

  .ai-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 20px;
    color: #c6cad7;
    font-size: .73rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .ai-kicker > span {
    width: 26px;
    height: 1px;
    background: var(--ai-orange);
    box-shadow: 10px 0 20px var(--ai-orange);
  }

  .ai-hero h1 {
    max-width: 760px;
    margin: 0;
    color: white;
    font-family: 'Outfit', sans-serif;
    font-size: clamp(3.35rem, 5.25vw, 5.8rem);
    font-weight: 700;
    line-height: .97;
    letter-spacing: -.055em;
  }

  .ai-hero h1 span,
  .ai-page h2 em {
    color: var(--ai-orange);
    font-style: normal;
  }

  .ai-lede {
    max-width: 680px;
    margin: 32px 0 0;
    color: #eef0f7;
    font-size: clamp(1.12rem, 1.5vw, 1.34rem);
    line-height: 1.55;
  }

  .ai-hero-note {
    max-width: 640px;
    margin: 18px 0 0;
    color: var(--ai-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .ai-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .ai-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 5px;
    color: white;
    font-weight: 700;
    text-decoration: none;
