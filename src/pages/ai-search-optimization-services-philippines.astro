  }

  .ai-button:hover { transform: translateY(-2px); }
  .ai-button-primary { background: var(--ai-orange); box-shadow: 0 16px 38px rgba(240,98,42,.2); }
  .ai-button-primary:hover { background: var(--ai-orange-bright); }
  .ai-button-secondary { border-color: rgba(255,255,255,.19); background: rgba(255,255,255,.04); }
  .ai-button-secondary:hover { border-color: rgba(240,98,42,.58); }

  .ai-trust-line {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 32px 0 0;
    padding: 0;
    color: #9299ad;
    font-size: .78rem;
    list-style: none;
  }

  .ai-trust-line li { position: relative; }
  .ai-trust-line li:not(:last-child)::after { content: '·'; position: absolute; right: -15px; color: var(--ai-orange); }

  .citation-observatory {
    position: relative;
    min-height: 580px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 8px;
    background: linear-gradient(145deg, rgba(25,30,51,.96), rgba(11,14,25,.96));
    box-shadow: 0 38px 100px rgba(0,0,0,.42), 0 0 70px rgba(240,98,42,.08);
    isolation: isolate;
  }

  .citation-observatory::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,.045), transparent 42%);
    pointer-events: none;
  }

  .observatory-bar { display: flex; justify-content: space-between; align-items: center; padding: 4px 2px 16px; border-bottom: 1px solid var(--ai-border); }
  .observatory-bar > span { display: flex; gap: 6px; }
  .observatory-bar i { width: 6px; height: 6px; border-radius: 50%; background: #485067; }
  .observatory-bar i:first-child { background: var(--ai-orange); }
  .observatory-bar small { color: #7f879c; font-size: .61rem; letter-spacing: .16em; }

  .observatory-query { position: relative; z-index: 2; margin: 22px 8px 18px; padding: 18px 20px; border-left: 2px solid var(--ai-orange); background: rgba(255,255,255,.035); }
  .observatory-query span { display: block; margin-bottom: 7px; color: var(--ai-orange-bright); font-size: .65rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .observatory-query strong { display: block; max-width: 390px; font-size: 1rem; line-height: 1.45; }

  .answer-surface { position: relative; z-index: 2; margin: 0 8px; padding: 24px; border: 1px solid var(--ai-border); background: rgba(7,9,17,.72); }
  .answer-label { display: flex; justify-content: space-between; color: #8f96aa; font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; }
  .answer-surface > p { max-width: 390px; margin: 20px 0 16px; color: #e7e9f0; font-size: .91rem; line-height: 1.55; }
  .answer-lines { display: grid; gap: 6px; margin-bottom: 22px; }
  .answer-lines i { height: 4px; background: linear-gradient(90deg, rgba(240,98,42,.56), rgba(255,255,255,.08)); }
  .answer-lines i:nth-child(2) { width: 82%; }
  .answer-lines i:nth-child(3) { width: 58%; }

  .source-stack { display: grid; gap: 8px; }
  .source-stack > div { display: grid; grid-template-columns: 28px 1fr auto; gap: 10px; align-items: center; padding: 10px 12px; border: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.025); }
  .source-stack > div > span { color: #747d94; font-family: monospace; font-size: .67rem; }
  .source-stack p { margin: 0; }
  .source-stack strong { display: block; font-size: .77rem; }
  .source-stack small { display: block; margin-top: 2px; color: #7f879c; font-size: .67rem; }
  .source-stack b { color: #f49a73; font-size: .58rem; letter-spacing: .12em; }

  .signal-path { position: absolute; inset: 46px 2px 36px; z-index: 1; width: calc(100% - 4px); height: calc(100% - 82px); opacity: .68; pointer-events: none; }
  .signal-path path { fill: none; stroke: var(--ai-orange); stroke-width: 1.2; stroke-dasharray: 4 8; }
  .signal-path circle { fill: var(--ai-orange); filter: drop-shadow(0 0 8px var(--ai-orange)); }

  .observatory-caption { position: absolute; z-index: 2; right: 26px; bottom: 20px; left: 26px; margin: 0; color: #727a90; font-size: .68rem; }
  .observatory-caption span { color: #b9bfce; }

  .ai-shift { padding: 112px 0; background: var(--ai-cream) !important; color: #151724; }
  .ai-shift-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(64px, 10vw, 150px); }
  .ai-shift .ai-kicker { color: #5f6270; }
  .shift-statement h2 { margin: 0; font-family: 'Outfit', sans-serif; font-size: clamp(2.65rem, 4.5vw, 4.9rem); line-height: 1.02; letter-spacing: -.05em; }
  .shift-copy { padding-top: 48px; border-top: 1px solid rgba(12,14,24,.2); }
  .shift-copy p { margin: 0 0 22px; color: #444754; font-size: 1.04rem; line-height: 1.75; }
  .shift-copy strong { color: #151724; }

  .ai-reality,
  .ai-method,
  .ai-platforms,
  .ai-deliverables,
  .ai-faq { padding: 112px 0; }

  .ai-section-heading { max-width: 880px; }
  .ai-section-heading h2,
  .method-intro h2,
  .source-copy h2,
  .platform-heading h2,
  .measurement-copy h2,
  .deliverables-title h2,
  .fit-heading h2,
  .commercial-copy h2,
  .sources-layout h2,
  .faq-heading h2,
  .ai-final-cta h2 {
    margin: 0;
    color: white;
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.5rem, 4vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: -.045em;
  }

  .reality-rule { height: 1px; margin: 54px 0 0; background: linear-gradient(90deg, var(--ai-orange), var(--ai-border) 35%, var(--ai-border)); }
  .reality-columns { display: grid; grid-template-columns: 1fr 1fr; }
  .reality-side { padding: 48px 48px 0 0; }
  .reality-side + .reality-side { padding-right: 0; padding-left: 48px; border-left: 1px solid var(--ai-border); }
  .reality-label { margin: 0 0 28px; color: #858da2; font-size: .68rem; font-weight: 700; letter-spacing: .15em; }
  .reality-side ul { margin: 0; padding: 0; list-style: none; }
  .reality-side li { display: grid; grid-template-columns: 34px 1fr; gap: 14px; padding: 20px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .reality-side li > span { display: grid; place-items: center; width: 25px; height: 25px; color: var(--ai-orange-bright); border: 1px solid rgba(240,98,42,.4); font-family: monospace; font-size: .68rem; }
  .reality-side p { margin: 0; color: var(--ai-muted); line-height: 1.6; }
  .reality-side strong { display: block; margin-bottom: 5px; color: white; font-size: 1.02rem; }
  .reality-side-limit { opacity: .78; }

  .ai-method { background: #101323; border-block: 1px solid var(--ai-border); }
  .method-intro { display: grid; grid-template-columns: 1.1fr .7fr; gap: 80px; align-items: end; margin-bottom: 62px; }
  .method-intro > p { margin: 0 0 5px; color: var(--ai-muted); font-size: 1.02rem; line-height: 1.7; }
  .method-ledger { border-top: 1px solid rgba(255,255,255,.16); }
  .method-row { display: grid; grid-template-columns: 64px minmax(240px,.9fr) minmax(300px,1.2fr) 170px; gap: 28px; align-items: start; padding: 32px 0; border-bottom: 1px solid var(--ai-border); }
  .method-number { color: var(--ai-orange); font-family: monospace; font-size: .72rem; }
  .method-row h3 { margin: -5px 0 0; color: white; font-family: 'Outfit', sans-serif; font-size: 1.45rem; line-height: 1.2; }
  .method-row p { margin: 0; color: var(--ai-muted); line-height: 1.65; }
  .method-row > strong { color: #f2a482; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }

  .ai-source-system { padding: 125px 0; background: var(--ai-cream) !important; color: #191b27; }
  .source-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 110px; align-items: center; }
  .ai-source-system .ai-kicker { color: #5f6270; }
  .source-copy h2 { color: #171925; }
  .source-copy > p:not(.ai-kicker) { max-width: 570px; color: #4b4e5a; font-size: 1.03rem; line-height: 1.75; }
  .source-copy a { color: #b44214; font-weight: 700; }
  .source-orbit { position: relative; min-height: 510px; display: grid; place-items: center; }
  .source-orbit::before { content: ''; position: absolute; width: 76%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(240,98,42,.19), rgba(240,98,42,0) 68%); }
  .orbit-core { position: relative; z-index: 3; display: grid; place-items: center; width: 178px; height: 178px; border-radius: 50%; background: #111421; color: white; box-shadow: 0 25px 80px rgba(12,15,26,.28); text-align: center; }
  .orbit-core small { color: #f29b75; font-size: .61rem; letter-spacing: .16em; }
  .orbit-core strong { font-family: 'Outfit', sans-serif; font-size: 1.65rem; }
  .orbit-core span { max-width: 116px; color: #9ba2b7; font-size: .7rem; line-height: 1.4; }
  .orbit-ring { position: absolute; display: flex; align-items: center; border: 1px solid rgba(19,22,34,.2); border-radius: 50%; }
  .orbit-ring span { position: absolute; padding: 6px 10px; background: var(--ai-cream); color: #3d404d; font-size: .67rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .orbit-ring-one { width: 255px; height: 255px; transform: rotate(9deg); }
  .orbit-ring-one span { top: 10px; left: 40px; transform: rotate(-9deg); }
  .orbit-ring-two { width: 340px; height: 340px; transform: rotate(-17deg); }
  .orbit-ring-two span { right: -4px; top: 92px; transform: rotate(17deg); }
  .orbit-ring-three { width: 425px; height: 425px; transform: rotate(26deg); }
  .orbit-ring-three span { right: 42px; bottom: 30px; transform: rotate(-26deg); }
  .orbit-ring-four { width: 500px; height: 500px; transform: rotate(-8deg); }
  .orbit-ring-four span { left: 8px; top: 142px; transform: rotate(8deg); }

  .ai-platforms { background: #0c0f1b; }
  .platform-heading { display: grid; grid-template-columns: 1.15fr .65fr; gap: 80px; align-items: end; margin-bottom: 60px; }
  .platform-heading > p { margin: 0; color: var(--ai-muted); line-height: 1.7; }
  .platform-run { border-top: 1px solid rgba(255,255,255,.17); }
  .platform-run-head,
  .platform-row { display: grid; grid-template-columns: .55fr .85fr 1.45fr 1.15fr; gap: 28px; }
  .platform-run-head { padding: 15px 0; color: #6e768c; font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .platform-row { padding: 30px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .platform-row > div { display: flex; gap: 14px; }
  .platform-row small { color: var(--ai-orange); font-family: monospace; font-size: .65rem; }
  .platform-row strong { color: white; font-size: 1.04rem; }
  .platform-row p { margin: 0; color: var(--ai-muted); font-size: .9rem; line-height: 1.6; }

  .ai-measurement { padding: 125px 0; background: linear-gradient(118deg, #ea5721 0%, #f36b34 53%, #d84715 100%) !important; }
  .measurement-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; align-items: start; }
  .measurement-copy .ai-kicker { color: rgba(255,255,255,.78); }
  .measurement-copy .ai-kicker > span { background: white; box-shadow: none; }
  .measurement-copy p:not(.ai-kicker) { color: rgba(255,255,255,.85); font-size: 1.02rem; line-height: 1.7; }
  .measurement-copy > a { display: inline-block; margin-top: 18px; color: white; font-weight: 700; }
  .measurement-chain { margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.35); list-style: none; }
  .measurement-chain li { display: grid; grid-template-columns: 54px 1fr; gap: 18px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.28); }
  .measurement-chain > li > span { font-family: monospace; font-size: .7rem; }
  .measurement-chain p { margin: 0; }
  .measurement-chain strong { display: block; margin-bottom: 5px; font-family: 'Outfit', sans-serif; font-size: 1.3rem; }
  .measurement-chain small { display: block; color: rgba(255,255,255,.78); font-size: .86rem; line-height: 1.5; }

  .ai-deliverables { background: var(--ai-night); }
  .deliverables-layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: 100px; }
  .deliverables-title { position: sticky; top: 110px; align-self: start; }
  .deliverables-list { border-top: 1px solid rgba(255,255,255,.16); }
  .deliverables-list article { padding: 30px 0; border-bottom: 1px solid var(--ai-border); }
  .deliverables-list article > span { color: var(--ai-orange); font-size: .62rem; font-weight: 700; letter-spacing: .14em; }
  .deliverables-list h3 { margin: 8px 0 8px; color: white; font-family: 'Outfit', sans-serif; font-size: 1.5rem; }
  .deliverables-list p { max-width: 650px; margin: 0; color: var(--ai-muted); line-height: 1.65; }

  .ai-fit { padding: 112px 0; background: var(--ai-cream) !important; color: #171925; }
  .fit-layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: 100px; }
  .ai-fit .ai-kicker { color: #5f6270; }
  .fit-heading h2 { color: #171925; }
  .fit-editorial { border-top: 1px solid rgba(13,15,24,.22); }
  .fit-editorial > div { display: grid; grid-template-columns: .55fr 1.45fr; gap: 42px; padding: 30px 0; border-bottom: 1px solid rgba(13,15,24,.15); }
  .fit-editorial h3 { margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.23rem; }
  .fit-editorial p { margin: 0; color: #50535e; line-height: 1.65; }

  .ai-commercial { padding: 112px 0; background: #0a0c16; }
  .commercial-brief { position: relative; display: grid; grid-template-columns: 1fr .82fr; gap: 90px; padding: 68px; border: 1px solid rgba(240,98,42,.32); background: linear-gradient(135deg, rgba(240,98,42,.12), rgba(255,255,255,.025) 45%, rgba(255,255,255,.01)); }
  .commercial-brief::before { content: ''; position: absolute; top: -1px; left: 68px; width: 120px; height: 3px; background: var(--ai-orange); box-shadow: 0 0 30px var(--ai-orange); }
  .commercial-copy > p:not(.ai-kicker) { color: var(--ai-muted); line-height: 1.7; }
  .commercial-copy .ai-button { margin-top: 16px; }
  .commercial-factors { padding-left: 44px; border-left: 1px solid var(--ai-border); }
  .commercial-factors > p { margin: 0 0 20px; color: #7e869c; font-size: .65rem; font-weight: 700; letter-spacing: .14em; }
  .commercial-factors ul { margin: 0; padding: 0; list-style: none; }
  .commercial-factors li { position: relative; padding: 13px 0 13px 24px; border-top: 1px solid rgba(255,255,255,.07); color: #d7dae4; }
  .commercial-factors li::before { content: ''; position: absolute; left: 2px; top: 21px; width: 6px; height: 6px; background: var(--ai-orange); }

  .ai-sources { padding: 100px 0; background: #111421; }
  .sources-layout { display: grid; grid-template-columns: .65fr 1.35fr; gap: 100px; }
  .source-links { border-top: 1px solid rgba(255,255,255,.16); }
  .source-links a { display: grid; grid-template-columns: .48fr .82fr 1.1fr; gap: 28px; padding: 26px 0; border-bottom: 1px solid var(--ai-border); color: inherit; text-decoration: none; }
  .source-links a:hover strong { color: var(--ai-orange-bright); }
  .source-links span { color: var(--ai-orange); font-size: .62rem; font-weight: 700; letter-spacing: .13em; }
  .source-links strong { color: white; transition: color .2s ease; }
  .source-links p { margin: 0; color: var(--ai-muted); font-size: .86rem; line-height: 1.6; }

  .ai-faq { background: #0a0c16; }
  .faq-layout { display: grid; grid-template-columns: .62fr 1.38fr; gap: 100px; }
  .faq-heading { position: sticky; top: 110px; align-self: start; }
  .faq-heading > p:not(.ai-kicker) { color: var(--ai-muted); }
  .faq-list { border-top: 1px solid rgba(255,255,255,.16); }
  .faq-list details { border-bottom: 1px solid var(--ai-border); }
  .faq-list summary { display: grid; grid-template-columns: 42px 1fr 28px; gap: 16px; align-items: center; padding: 25px 0; color: white; font-family: 'Outfit', sans-serif; font-size: 1.12rem; cursor: pointer; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--ai-orange); font-family: monospace; font-size: .65rem; }
  .faq-list summary i { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--ai-border); border-radius: 50%; color: var(--ai-orange); font-style: normal; }
  .faq-list details[open] summary i { transform: rotate(45deg); }
  .faq-list details > p { margin: -4px 38px 26px 58px; color: var(--ai-muted); line-height: 1.7; }

  .ai-final-cta { padding: 105px 0; background: var(--ai-bg) !important; color: var(--ai-white); }
  .final-cta-layout { display: grid; grid-template-columns: .4fr 1.05fr .65fr; gap: 70px; align-items: start; }
  .ai-final-cta > .ai-shell > p { margin: 8px 0 0; color: var(--ai-orange-bright); font-size: .65rem; font-weight: 700; letter-spacing: .15em; }
  .ai-final-cta h2 { color: white; }
  .ai-final-cta div > p { margin: 8px 0 24px; color: var(--ai-muted); line-height: 1.7; }

  /* global.css deliberately forces every section dark with a high-specificity
     important rule. These page-owned surfaces need a stronger selector so the
     art direction and text contrast survive the global fallback. */
  .ai-page.ai-page .ai-hero.ai-hero {
    background:
      radial-gradient(circle at 82% 17%, rgba(240, 98, 42, 0.14), transparent 25%),
      linear-gradient(115deg, #0f1222 0%, #090b14 60%, #0b0d18 100%) !important;
  }
  .ai-page.ai-page .ai-shift.ai-shift,
  .ai-page.ai-page .ai-source-system.ai-source-system,
  .ai-page.ai-page .ai-fit.ai-fit {
    background: var(--ai-cream) !important;
  }
  .ai-page.ai-page .ai-final-cta.ai-final-cta {
    background: var(--ai-bg) !important;
    color: var(--ai-white) !important;
  }
  .ai-page.ai-page .ai-measurement.ai-measurement {
    background: linear-gradient(118deg, #ea5721 0%, #f36b34 53%, #d84715 100%) !important;
  }
  .ai-page.ai-page .ai-shift.ai-shift .shift-statement h2,
  .ai-page.ai-page .ai-source-system.ai-source-system .source-copy h2,
  .ai-page.ai-page .ai-fit.ai-fit .fit-heading h2 {
    color: #171925 !important;
  }
  .ai-page.ai-page .ai-source-system.ai-source-system .source-copy > p:not(.ai-kicker) {
    color: #4b4e5a !important;
  }

  @media (max-width: 1080px) {
    .ai-hero-layout { grid-template-columns: 1fr; }
    .ai-hero-copy { max-width: 850px; }
    .citation-observatory { width: min(720px, 100%); min-height: 540px; }
    .method-row { grid-template-columns: 48px .9fr 1.2fr; }
    .method-row > strong { grid-column: 2 / -1; }
    .source-layout,
    .measurement-layout,
    .deliverables-layout,
    .fit-layout,
    .faq-layout { gap: 62px; }
    .orbit-ring-four { width: 450px; height: 450px; }
    .orbit-ring-three { width: 380px; height: 380px; }
    .final-cta-layout { grid-template-columns: 1fr 2fr; }
    .final-cta-layout > div { grid-column: 2; }
  }

  @media (max-width: 820px) {
    .ai-shell { width: min(100% - 32px, 720px); }
    .ai-hero { padding-top: 28px; padding-bottom: 78px; }
    .ai-breadcrumb { margin-bottom: 44px; }
    .ai-hero h1 { font-size: clamp(3rem, 12vw, 5rem); }
    .ai-shift-layout,
    .reality-columns,
    .method-intro,
    .source-layout,
    .platform-heading,
    .measurement-layout,
    .deliverables-layout,
    .fit-layout,
    .commercial-brief,
    .sources-layout,
    .faq-layout,
    .final-cta-layout { grid-template-columns: 1fr; gap: 42px; }
    .reality-side { padding-right: 0; }
    .reality-side + .reality-side { padding: 46px 0 0; border-left: 0; border-top: 1px solid var(--ai-border); }
    .method-row { grid-template-columns: 38px 1fr; gap: 18px; }
    .method-row > p,
    .method-row > strong { grid-column: 2; }
    .source-orbit { min-height: 480px; }
    .platform-run-head { display: none; }
    .platform-row { grid-template-columns: 1fr; gap: 14px; }
    .platform-row p::before { display: block; margin-bottom: 5px; color: #6e768c; font-size: .58rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .platform-row p:nth-child(2)::before { content: 'Surface'; }
    .platform-row p:nth-child(3)::before { content: 'What matters'; }
    .platform-row p:nth-child(4)::before { content: 'What we check'; }
    .deliverables-title,
    .faq-heading { position: static; }
    .commercial-brief { padding: 44px; }
    .commercial-factors { padding: 36px 0 0; border-top: 1px solid var(--ai-border); border-left: 0; }
    .source-links a { grid-template-columns: 1fr; gap: 9px; }
    .final-cta-layout > div { grid-column: auto; }
  }

  @media (max-width: 520px) {
    .ai-shell { width: min(100% - 28px, 500px); }
