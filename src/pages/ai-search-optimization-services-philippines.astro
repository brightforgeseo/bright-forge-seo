---
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';

const aiSearchFaqs = [
  {
    question: 'What is the difference between AI SEO, GEO and AEO?',
    answer: 'AI SEO covers work to help people find a business through AI search. GEO focuses on generated answers; AEO focuses on direct answers, including search features such as featured snippets. The terms overlap. We agree the platforms, pages and work you need rather than sell a separate service for each label.'
  },
  {
    question: 'Does AI search optimisation replace traditional SEO?',
    answer: 'No. Google says the same SEO fundamentals apply to AI Overviews and AI Mode. Your pages still need to be accessible, indexed and useful. We build on that work by checking AI answers and improving the pages buyers use to compare you.'
  },
  {
    question: 'Can you guarantee citations in ChatGPT, Perplexity or Google AI Overviews?',
    answer: 'No agency can guarantee a citation or recommendation. Platforms choose their sources, and answers change with the question, location and model. We improve your pages and track an agreed set of questions, but those checks cannot cover every answer a buyer might see.'
  },
  {
    question: 'Do we need an llms.txt file or special AI schema?',
    answer: 'Not for Google AI Overviews or AI Mode. Google says there is no special schema or AI text file required. We use valid structured data where it helps describe real visible content, and we check crawler controls such as OAI-SearchBot separately for platforms that publish them.'
  },
  {
    question: 'What does an AI search visibility audit include?',
    answer: 'We check how your business and competitors appear for agreed buyer questions, which pages get cited and whether search crawlers can reach your content. You receive a prioritised page plan with missing information, technical fixes and tracking requirements. We agree implementation separately.'
  },
  {
    question: 'How do you measure AI search visibility?',
    answer: 'We combine prompt-set observations with platform data where available, including Search Console, Bing Webmaster Tools AI Performance, referral traffic and GA4 conversion events. We distinguish a citation, a visit, a tracked action and a confirmed lead rather than treating every mention as revenue.'
  },
  {
    question: 'How long does AI SEO take?',
    answer: 'We set delivery dates after reviewing the site and agreeing approvals. Search platforms then need to recrawl and reassess changed pages, on schedules we do not control. We report completed work and observed results separately; a page going live is not a promise of immediate citations.'
  },
  {
    question: 'How much do GEO and AI SEO services cost?',
    answer: 'We provide a private proposal based on the pages, markets and technical work involved. It sets out the audit, page edits, implementation responsibilities and reporting included, so you can compare the scope with your budget and existing SEO work.'
  },
  {
    question: 'Can you work alongside our existing SEO team?',
    answer: 'Yes. We agree which pages we will work on, who makes the site changes and who approves them. Your team can retain implementation, or we can scope that work with you. Your subject experts review technical or regulated claims before publication.'
  }
];

const methodSteps = [
  {
    number: '01',
    title: 'Map the questions that shape a buying decision',
    copy: 'We combine search evidence with your sales questions, product knowledge and customer objections. We group these into discovery, comparison and selection questions, keeping observed searches separate from prompts we propose to test.',
    output: 'Prompt and query map'
  },
  {
    number: '02',
    title: 'Check what AI answers say about you',
    copy: 'We run the agreed questions on the chosen platforms and record which businesses appear, which pages are cited and any inaccurate descriptions of your services. Each record includes the question, date and market.',
    output: 'Visibility baseline'
  },
  {
    number: '03',
    title: 'Update the pages buyers need',
    copy: 'We identify the exact pages and passages that need work: missing product specifications, unclear service scope, unsupported claims or inaccessible content. We agree who writes, verifies and implements each change.',
    output: 'Prioritised page work'
  },
  {
    number: '04',
    title: 'Build authority beyond the page',
    copy: 'We check the business profiles, reviews and industry publications buyers and search systems can consult. The plan identifies inaccurate listings to correct and relevant opportunities for coverage, with outreach scoped before work begins.',
    output: 'Authority plan'
  },
  {
    number: '05',
    title: 'Review answers, visits and enquiries',
    copy: 'We track the signals each platform exposes, then connect referral visits and conversion events where possible. A citation is visibility. It is not automatically a lead or sale.',
    output: 'Progress report'
  }
];

const platformRows = [
  {
    platform: 'Google',
    surface: 'AI Overviews and AI Mode',
    reality: 'Pages still need to be indexed, snippet-eligible and built on normal SEO fundamentals. Google says there is no special schema required.',
    check: 'Indexation, content usefulness, internal discovery, snippet controls and Search Console performance.'
  },
  {
    platform: 'OpenAI',
    surface: 'ChatGPT search',
    reality: 'OpenAI documents OAI-SearchBot as the crawler used to surface sites in ChatGPT search results. Search access is separate from GPTBot training controls.',
    check: 'Crawler access, cited-page quality, brand accuracy, referral traffic and priority research prompts.'
  },
  {
    platform: 'Perplexity',
    surface: 'Cited research answers',
    reality: 'Answers can cite multiple web sources and change between checks. We inspect the cited pages to understand which information supports the answer.',
    check: 'Citation patterns, competing sources, source-page depth, evidence and freshness.'
  },
  {
    platform: 'Microsoft Copilot',
    surface: 'Copilot and Bing AI answers',
    reality: 'Bing Webmaster Tools reports citations, cited URLs and sampled grounding queries through AI Performance. These are citation records, not ranking positions.',
    check: 'AI Performance, Bing indexation, cited URLs, grounding-query themes and IndexNow suitability.'
  }
];

const geoCases = [
  { href: '/case-studies/ai-sports-saas-geo/', name: 'TeamStats', line: 'Why a team-management product page deserves a different review from football resources, and why an AI-answer sample cannot be joined to referral visits.' },
  { href: '/case-studies/ai-self-storage-geo/', name: 'Newbury Self Store', line: 'Connecting practical storage guides to accurate facility details, unit choices and a quote route without treating tracked events as enquiries.' },
  { href: '/case-studies/ai-leather-goods-ecommerce-geo/', name: 'Lost Dutchman Leather', line: 'Reading product and collection entries together, then helping shoppers compare wallet capacity, dimensions, delivery and returns.' },
  { href: '/case-studies/ai-fintech-saas-geo/', name: 'FinTech SaaS', line: 'Separating educational research, existing-user support and software evaluation before assigning commercial value to referrals.' }
];
---

<MainLayout
  title="AI SEO Services Philippines | GEO & AEO | Bright Forge"
  description="AI search optimisation from the Philippines for businesses buyers research before choosing. SEO, GEO and AEO with clear page improvements. Discuss your site."
  canonical="https://brightforge.com.ph/ai-search-optimization-services-philippines/"
  type="service"
  faqs={aiSearchFaqs}
>
  <LegacyHeader slot="header" />

  <Hero
    badgeIcon="fas fa-comments"
    badgeText="AI SEO, GEO and AEO"
    title="AI search optimisation <span>services</span>"
    breadcrumbCurrent="AI Search Optimisation"
  >
    <Fragment slot="story">
      <p>We work with businesses buyers research before choosing. If your website leaves out the specifications, experience or service details they need, you can be hard to assess. We improve those pages and check how your business appears in Google, ChatGPT and other AI search tools.</p>
      <p>British-led and based in the Philippines, with UK, US and Australian work. We combine technical SEO, page editing and AI search monitoring, with a clear route for interested buyers to enquire.</p>
    </Fragment>
    <Fragment slot="actions">
      <ButtonPrimary href="/contact/?service=ai-search-readiness#contactForm" text="Request an AI visibility audit" />
      <ButtonSecondary href="#method" text="See the method" />
    </Fragment>
    <Fragment slot="stats">
      <div class="hero-stats">
        <div class="stat"><strong>Report reviews</strong><span>Published evidence and limitations</span></div>
        <div class="stat"><strong>15+</strong><span>Years of SEO practice</span></div>
        <div class="stat"><strong>UK US AU</strong><span>Western search work</span></div>
        <div class="stat"><strong>GBP / USD</strong><span>Billed in buyer currency</span></div>
      </div>
    </Fragment>
  </Hero>

  <main class="ai-page">
    <section class="ai-proof" id="proof">
      <div class="ai-shell">
        <p class="proof-people">Work led by <a href="/authors/ben-lowe/">Ben Lowe</a> and <a href="/authors/sassin-lowe/">Sassin Lowe</a>. We review the pages that explain your offer and the evidence buyers need before contacting you.</p>
      </div>
    </section>

    <section class="ai-contrast" id="buying-situations">
      <div class="ai-shell">
        <div class="ai-section-heading">
          <p class="ai-kicker"><span></span> From research to a relevant enquiry</p>
          <h2>AI search work starts with <span>what your buyer needs to know</span>.</h2>
          <p>Examples of buying decisions we can help your website answer. We research your market and speak with your team before choosing the questions to test.</p>
        </div>
        <div class="case-grid">
          <article class="case-card">
            <h3>Industrial suppliers</h3>
            <p>A workshop choosing an industrial parts washer needs to check load capacity, material compatibility and the cleaning process. The purchasing team also needs to know what installation and local support involve.</p>
            <p>We put verified specifications and application limits on the product page, link to supporting documents and explain what details to send for a quote. Your technical team approves the claims.</p>
            <a href="/construction-seo-services/">Construction and industrial SEO <span aria-hidden="true">→</span></a>
          </article>
          <article class="case-card">
            <h3>Local and trade services</h3>
            <p>A homeowner needs someone to repair a leaking roof, but a contractor page only talks about new installations. They cannot tell whether the firm handles repairs or covers their suburb.</p>
            <p>We clarify the repair services, service area and inspection process, add relevant completed projects and check the call or quote link. This work sits alongside Maps and Google Business Profile optimisation.</p>
            <a href="/home-services-seo/">Home services SEO <span aria-hidden="true">→</span></a>
          </article>
          <article class="case-card">
            <h3>Professional services</h3>
            <p>A finance director considering outsourcing payroll needs to know who handles filings, which systems the firm supports and what happens during the handover. They need enough detail to discuss the options with colleagues before booking a consultation.</p>
            <p>We spell out the service scope and client responsibilities, add relevant credentials and approved examples, and explain what to bring to the first consultation. A qualified reviewer checks any regulated advice.</p>
            <a href="/b2b-seo-services/">B2B and professional-services SEO <span aria-hidden="true">→</span></a>
          </article>
          <article class="case-card">
            <h3>Ecommerce</h3>
            <p>A shopper comparing a laptop bag needs to know whether their device fits, how much the bag weighs and whether the material suits a wet commute. Delivery dates and returns may decide between otherwise similar bags.</p>
            <p>We add verified internal dimensions, weight and material details, make delivery and returns easy to find, and help buyers compare suitable models. We also check that structured product data matches the page.</p>
            <a href="/ecommerce-seo-services/">Ecommerce SEO <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="ai-cases" id="cases">
      <div class="ai-shell">
        <div class="ai-section-heading">
          <p class="ai-kicker"><span></span> Report reviews</p>
          <h2>What the referral reports <span>help us review</span></h2>
          <p>These case reviews use the original GEO reports for August 2025 to January 2026. They show which pages deserve attention and how we distinguish referrals from commercial outcomes. Report observations and recommendations are not proof that a particular edit caused growth.</p>
        </div>
        <div class="case-grid">
          {geoCases.map((item) => (
            <a class="case-card" href={item.href}>
              <strong>{item.name}</strong>
              <p>{item.line}</p>
              <span>Read the report review</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-shift">
      <div class="ai-shell ai-shift-layout">
        <div class="shift-statement">
          <p class="ai-kicker"><span></span> The commercial shift</p>
          <h2>Your next customer may meet the <em>answer</em> before they meet your website.</h2>
        </div>
        <div class="shift-copy">
          <p>A buyer can ask ChatGPT to compare suppliers before visiting any of their websites. The answer may name a business, cite a product page or describe a service incorrectly. Checking rankings alone will not show you that.</p>
          <p>The work is often called <strong>AI SEO</strong> or <strong>generative engine optimisation (GEO)</strong>. You may also see <strong>answer engine optimisation (AEO)</strong> and <strong>LLM SEO</strong>. These labels overlap; the useful distinction is which platforms we check and what we change on your site.</p>
          <p>We start with the service and product pages closest to an enquiry or purchase. Missing specifications, outdated service details and unsupported claims give us specific work to do. We then repeat the agreed checks to see whether the answers and cited pages change.</p>
        </div>
      </div>
    </section>

    <section class="ai-reality" id="reality">
      <div class="ai-shell">
        <div class="ai-section-heading">
          <p class="ai-kicker"><span></span> Scope and limits</p>
          <h2>What AI search optimisation <span>can change</span>, and what it cannot</h2>
        </div>
        <div class="reality-rule"></div>
        <div class="reality-columns">
          <div class="reality-side reality-side-positive">
            <p class="reality-label">WE CAN IMPROVE</p>
            <ul>
              <li><span>01</span><p><strong>Page access</strong>We fix crawl barriers and internal links that make important pages difficult to find.</p></li>
              <li><span>02</span><p><strong>Service information</strong>We explain what you offer, where you work and which customers you can help.</p></li>
              <li><span>03</span><p><strong>Product and project detail</strong>We add verified specifications, relevant examples and current information to the pages that need them.</p></li>
              <li><span>04</span><p><strong>Business listings and reviews</strong>We check for conflicting details and identify relevant places to build your reputation.</p></li>
              <li><span>05</span><p><strong>Reporting</strong>We show what changed on the site, what appeared in our checks and which visits led to tracked actions.</p></li>
            </ul>
          </div>
          <div class="reality-side reality-side-limit">
            <p class="reality-label">WHAT REMAINS OUTSIDE OUR CONTROL</p>
            <ul>
              <li><span>×</span><p><strong>When a platform updates</strong>Publishing an edit does not mean a platform will immediately recrawl or use it.</p></li>
              <li><span>×</span><p><strong>Inclusion in an answer</strong>Structured data can describe your pages, but it cannot secure a citation or recommendation.</p></li>
              <li><span>×</span><p><strong>Every answer a buyer sees</strong>Our question set is a sample. Answers vary by model, time, location and wording.</p></li>
              <li><span>×</span><p><strong>Untracked buying decisions</strong>A buyer may read an answer and contact you later without an identifiable referral.</p></li>
              <li><span>×</span><p><strong>How your business is described</strong>We can correct your published information and monitor answers. The platform still chooses its wording and sources.</p></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-method" id="method">
      <div class="ai-shell">
        <div class="method-intro">
          <div>
            <p class="ai-kicker"><span></span> The Bright Forge method</p>
            <h2>From buyer questions to <span>specific page improvements</span></h2>
          </div>
          <p>You get an agreed question set, a dated baseline and a prioritised page plan. We identify the work, the person responsible for approval and the evidence we will use to review progress.</p>
        </div>

        <div class="method-ledger">
          {methodSteps.map((step) => (
            <article class="method-row">
              <span class="method-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
              <strong>{step.output}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-source-system">
      <div class="ai-shell source-layout">
        <div class="source-copy">
          <p class="ai-kicker"><span></span> Citation readiness</p>
          <h2>Make your expertise <span>easy to find and verify</span>.</h2>
          <p>A supplier specification, a named specialist, a clear returns policy or a documented project gives a buyer something to check. We make that information accessible on the relevant page and support it with accurate business profiles, reviews and credible third-party sources.</p>
          <p>Our <a href="/technical-seo-services-philippines/">technical SEO</a> work checks whether important pages can be reached and indexed. <a href="/content-seo-services-philippines/">Content SEO</a> makes the answers useful, while <a href="/backlink-seo-services-philippines/">authority work</a> supports claims beyond your own website. Structured data describes those visible facts; it does not replace them.</p>
          <ul class="source-layers">
            <li>Technical access</li>
            <li>Clear business information</li>
            <li>Evidence</li>
            <li>Authority</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="ai-platforms">
      <div class="ai-shell">
        <div class="platform-heading">
          <div>
            <p class="ai-kicker"><span></span> Platform-specific checks</p>
            <h2>Different platforms need <span>different checks</span>.</h2>
          </div>
          <p>Every platform exposes different controls and reporting. We use what the platforms document, then apply experienced SEO judgement where the data remains incomplete.</p>
        </div>

        <div class="platform-run" role="table" aria-label="AI search platforms and optimisation checks">
          <div class="platform-run-head" role="row">
            <span role="columnheader">Platform</span>
            <span role="columnheader">Surface</span>
            <span role="columnheader">What matters</span>
            <span role="columnheader">What we check</span>
          </div>
          {platformRows.map((row, index) => (
            <article class="platform-row" role="row">
              <div role="cell"><small>0{index + 1}</small><strong>{row.platform}</strong></div>
              <p role="cell">{row.surface}</p>
              <p role="cell">{row.reality}</p>
              <p role="cell">{row.check}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-measurement">
      <div class="ai-shell measurement-layout">
        <div class="measurement-copy">
          <p class="ai-kicker"><span></span> Reporting and attribution</p>
          <h2>We separate visibility from visits, and <span>visits from leads</span>.</h2>
          <p>We report which answers cite you, which pages receive identifiable AI referrals and what those visitors do next. Each tells you something different about whether the work is helping.</p>
          <p>A brand mention is not necessarily a linked citation. A citation does not prove a visit, and a conversion event does not prove a qualified enquiry. We agree what each event means and compare it with your enquiry or order records where available.</p>
          <p>Google AI-feature traffic is included within Search Console web-search reporting, not a complete standalone AI attribution report. Unidentified referrals and later direct visits leave gaps. For ongoing monitoring and delivery QA, see our <a href="/seo-command-centre/">SEO Command Centre</a>.</p>
        </div>
        <ol class="measurement-chain">
          <li><span>01</span><p><strong>Observed mention or citation</strong><small>We record whether an answer names the brand, links a source page or both, with the prompt, platform, market and date.</small></p></li>
          <li><span>02</span><p><strong>Cited URL or grounding query</strong><small>Where available, platform reporting shows the cited page and queries used to find sources.</small></p></li>
          <li><span>03</span><p><strong>Referral visit</strong><small>Analytics records traffic from an identifiable AI or search surface.</small></p></li>
          <li><span>04</span><p><strong>Tracked action</strong><small>A visitor submits, calls, books or completes another configured conversion event.</small></p></li>
          <li><span>05</span><p><strong>Confirmed lead or sale</strong><small>Your commercial process confirms the outcome. Analytics alone does not.</small></p></li>
        </ol>
      </div>
    </section>

    <section class="ai-deliverables">
      <div class="ai-shell deliverables-layout">
        <div class="deliverables-title">
          <p class="ai-kicker"><span></span> Audit and implementation</p>
          <h2>What your <span>AI SEO engagement</span> can include</h2>
        </div>
        <div class="deliverables-list">
          <article><span>DIAGNOSE</span><h3>AI visibility and citation audit</h3><p>A record of answers to agreed buyer questions, the pages they cite and access problems that need fixing.</p></article>
          <article><span>CLARIFY</span><h3>Page-by-page work plan</h3><p>Which page should answer each buying question, which facts are missing and which credentials, specifications or examples need expert approval.</p></article>
          <article><span>STRENGTHEN</span><h3>Revised service and product pages</h3><p>Page edits that answer missing questions, explain comparisons and put approved evidence beside the claims it supports. We agree who publishes each change.</p></article>
          <article><span>VALIDATE</span><h3>Technical access and structured data</h3><p>Robots rules, rendering, indexability, snippet controls and valid schema that reflects visible page content.</p></article>
          <article><span>CORROBORATE</span><h3>Authority and digital PR direction</h3><p>A review of business listings and relevant publications, with recommended corrections and outreach opportunities. Any outreach work is defined in the proposal.</p></article>
          <article><span>MEASURE</span><h3>AI and organic visibility reporting</h3><p>Prompt observations, platform data, referrals and conversion signals presented with the limits clearly stated.</p></article>
        </div>
      </div>
    </section>

    <section class="ai-fit">
      <div class="ai-shell fit-layout">
        <div class="fit-heading">
          <p class="ai-kicker"><span></span> Commercial fit</p>
          <h2>Is AI search work <span>the right next investment</span>?</h2>
        </div>
        <div class="fit-editorial">
          <div>
            <h3>Strong fit</h3>
            <p>Your buyers compare technical details, service scope or specialist experience before they contact you. You have useful expertise or product information, but your website does not yet explain it well enough.</p>
          </div>
          <div>
            <h3>Usually needs foundations first</h3>
            <p>Sites with blocked crawling, weak service pages, no useful proof or unclear positioning. We identify those gaps first and recommend foundational SEO work where it is the more useful investment.</p>
          </div>
          <div>
            <h3>A different priority may come first</h3>
            <p>If buyers mainly need directions, opening hours or an urgent local callout, local SEO and a working enquiry route may deserve the budget first. We discuss that before recommending an AI search engagement.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-commercial" id="scope">
      <div class="ai-shell">
        <div class="commercial-brief">
          <div class="commercial-copy">
            <p class="ai-kicker"><span></span> Private scope and proposal</p>
            <h2>A scope built around <span>your market and website</span>.</h2>
            <p>We agree whether you need an audit, help improving specific pages or an ongoing programme. Your proposal names the deliverables, who implements them and how we will review progress.</p>
            <a class="ai-button ai-button-primary" href="/contact/?service=ai-search-readiness#contactForm">Discuss your AI search opportunity <span aria-hidden="true">→</span></a>
          </div>
          <div class="commercial-factors">
            <p>YOUR PRIVATE PROPOSAL CONSIDERS</p>
            <ul>
              <li>Markets, languages and priority platforms</li>
              <li>Number of service and product pages</li>
              <li>Technical fixes and missing or conflicting business information</li>
              <li>Buyer questions and competitors to monitor</li>
              <li>Authority, evidence and digital PR gaps</li>
              <li>Reporting and conversion-measurement needs</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-sources">
      <div class="ai-shell sources-layout">
        <div>
          <p class="ai-kicker"><span></span> Platform guidance</p>
          <h2>Guidance from <span>the platforms</span></h2>
        </div>
        <div class="source-links">
          <a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noopener noreferrer">
            <span>GOOGLE SEARCH CENTRAL</span>
            <strong>AI features and your website</strong>
            <p>Google says standard SEO best practices remain relevant and no special schema is required.</p>
          </a>
          <a href="https://developers.openai.com/api/docs/bots" target="_blank" rel="noopener noreferrer">
            <span>OPENAI</span>
            <strong>Overview of OpenAI crawlers</strong>
            <p>OpenAI explains OAI-SearchBot, GPTBot and ChatGPT-User as separate controls and use cases.</p>
          </a>
          <a href="https://blogs.bing.com/webmaster/February-2026/Introducing-AI-Performance-in-Bing-Webmaster-Tools-Public-Preview" target="_blank" rel="noopener noreferrer">
            <span>MICROSOFT BING</span>
            <strong>AI Performance in Bing Webmaster Tools</strong>
            <p>Bing documents citation counts, cited URLs and sampled grounding queries for AI answers.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="ai-faq">
      <div class="ai-shell faq-layout">
        <div class="faq-heading">
          <p class="ai-kicker"><span></span> Straight answers</p>
          <h2>AI SEO, GEO and AEO <span>FAQs</span></h2>
          <p>What to know about scope, measurement and working with us.</p>
        </div>
        <div class="faq-list">
          {aiSearchFaqs.map((faq, index) => (
            <details>
              <summary><span>0{index + 1}</span>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="ai-final-cta">
      <div class="ai-shell final-cta-layout">
        <p>START WITH YOUR BUYING JOURNEY</p>
        <h2>Show us the work <span>you want to win</span>.</h2>
        <div>
          <p>Send your website, priority services or products, target markets and the questions buyers ask before contacting you. We will review the fit, discuss the evidence and access needed, and scope an audit or implementation programme through a private proposal.</p>
          <a class="ai-button ai-button-primary" href="/contact/?service=ai-search-readiness#contactForm">Request an AI visibility audit <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <ContactSection href="/contact/?service=ai-search-readiness#contactForm" />
  <Footer slot="footer" />
</MainLayout>

<style>
  :root {
    --ai-ink: #ffffff;
    --ai-night: #ffffff;
