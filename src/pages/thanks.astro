---
import ForgeHero from '../components/ForgeHero.astro';
import Layout from '../layouts/MainLayout.astro';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
const title = "Thank You | Bright Forge SEO";
const description = "Contact-form next steps and links to continue browsing Bright Forge SEO.";
---

<Layout title={title} description={description} noindex={true}>
  <LegacyHeader slot="header" />

  <ForgeHero title="Thank you for <span>getting in touch</span>" eyebrow="Thank you" breadcrumb="Thank you">
    <p>If you have just submitted our contact form, thank you for sharing the details. We review your website, market and main SEO problem, and usually reply within one business day with a suggested next step.</p>
    <Fragment slot="actions"><a href="/" class="forge-read-link">Back to Home</a></Fragment>
  </ForgeHero>

  <Footer slot="footer" />
</Layout>
