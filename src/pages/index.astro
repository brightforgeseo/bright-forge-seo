---
// Home page: answers "who is this agency". The services hub (/seo-services-philippines/) answers
// "what do the services include and cost". Copy: brightforge-site-audit/REWRITES.md; layout: design/DESIGN.md.
import MainLayout from '../layouts/MainLayout.astro';
import homepageFaqs from '../data/homepageFaqs.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';

const results = [
  { num: '7,410 to 17,600', what: '<strong>Emily Bridalwear</strong> (UK bridal retailer): organic clicks over three months, compared with the same three months a year earlier', href: '/case-studies/bridal-dress-designer-seo/' },
  { num: '15,200 to 22,700', what: '<strong>Lost Dutchman Leather</strong> (leather goods store): organic clicks on the same comparison, with a higher click-through rate', href: '/case-studies/leather-wallet-ecommerce-seo/' },
  { num: '200,000 to 268,000', what: '<strong>TeamStats</strong> (football team management software): organic clicks on the same comparison', href: '/case-studies/football-app-seo/' },
  { num: '6,550 to 10,900', what: '<strong>Speediance Australia</strong> (fitness equipment store): organic clicks across six months, compared with the previous six', href: '/case-studies/speediance-au-fitness-seo/' },
];

const services = [
  { name: 'SEO audits', href: '/seo-audit-services/', text: 'A crawl of the site set against Search Console and analytics data, written up as a prioritised list of findings with the evidence for each and who should fix it.' },
  { name: 'Technical SEO', href: '/technical-seo-services-philippines/', text: 'Indexing, redirects, canonicals, page speed, structured data and JavaScript rendering. We give your developer the affected URLs, the change required and the test that shows it worked.' },
  { name: 'Keyword research', href: '/keyword-research-services/', text: 'A keyword map that assigns each group of searches to one existing or proposed page, with the reason and the priority.' },
  { name: 'On-page optimisation', href: '/on-page-seo-services-philippines/', text: 'Revised titles, headings, copy and internal links for your priority pages, shown beside the current version for approval.' },
  { name: 'Content strategy and writing', href: '/content-seo-services-philippines/', text: 'Service pages, guides and refreshes of existing articles, briefed from your own knowledge and checked by an editor before you see them.' },
  { name: 'Link building', href: '/backlink-seo-services-philippines/', text: 'Outreach to publications and sites your customers read, with every placement recorded.' },
  { name: 'Local SEO', href: '/local-seo-for-google-maps-and-gbp/', text: 'Google Business Profile, citations and location pages for businesses that depend on nearby customers.' },
  { name: 'Website migrations', href: '/website-migration-services/', text: 'Redirect maps, staging checks and post-launch monitoring when a site is redesigned or moved. Our <a href="/development/">web development</a> team handles builds and upkeep afterwards.' },
  { name: 'AI search', href: '/ai-search-optimization-services-philippines/', text: "Checks on how your business appears in Google's AI answers and in ChatGPT, and the page changes that follow." },
  { name: 'White label SEO', href: '/white-label-seo-services-philippines/', text: "The same work delivered under an agency's brand." },
];

const team = [
  { name: 'Ben Lowe', role: 'Founder', href: '/authors/ben-lowe/', img: '/images/About us/ben-lowe-owner.webp', note: 'More than 15 years in SEO; marketing degree from London Metropolitan University. Leads strategy on client work.' },
  { name: 'Sassin Lowe', role: 'Co-Founder', href: '/authors/sassin-lowe/', img: '/images/About us/sassin-lowe-owner.webp' },
  { name: 'Jani A. Cañonero', role: 'Head of Team', href: '/authors/janin-a-canonero/', img: '/images/About us/Janin-seo-manager.webp' },
  { name: 'Jewe O. Manalo', role: 'SEO Expert', href: '/authors/jewe-o-manalo/', img: '/images/About us/jewe-seo-expert.webp' },
];

const awards = [
  { img: '/images/awards/top-clutch-seo-company-philippines-2025.png', label: 'Top SEO Company, Clutch Philippines 2025', href: 'https://clutch.co/ph/seo-firms/international' },
  { img: '/images/awards/top-clutch-seo-company-manila-2025.png', label: 'Top SEO Company Manila, Clutch 2025', href: 'https://clutch.co/ph/seo-firms/manila' },
  { img: '/images/awards/top-clutch-seo-company-ecommerce-philippines.png', label: 'Top E-commerce SEO Company, Clutch Philippines', href: 'https://clutch.co/ph/seo-firms/ecommerce-industry/manila' },
];
---

<MainLayout
  title="SEO Agency Philippines for Local and Overseas Firms"
  description="Bright Forge is an SEO agency in Quezon City led by Ben Lowe, with 15+ years in search. Technical SEO, content and reporting, with published client results."
  type="company"
  image="/images/og-image.jpg"
  breadcrumbs={[
    { name: 'Home', url: '/' }
  ]}
  faqs={homepageFaqs}
>
  <LegacyHeader slot="header" />

  <div class="bf-page">
    <header class="bf-hero bf-hero--home">
      <div class="bf-wrap bf-hero-grid">
        <div>
          <h1>SEO Agency in the Philippines for Local and Overseas Businesses</h1>
          <p class="bf-lead">We are a search engine optimisation agency based in Quezon City, Metro Manila. Ben Lowe, our founder, has worked in SEO for more than 15 years and leads the strategy on client work. Our team audits websites, fixes technical faults, researches keywords, writes and edits pages, and reports each month on what changed.</p>
          <p>We work with businesses in the Philippines, with companies in the UK, the US, Australia and New Zealand, and with agencies that need SEO delivered under their own name.</p>
          <p class="bf-actions">
            <a class="bf-btn bf-btn--primary" href="/contact/">Request an SEO review</a>
            <a class="bf-btn bf-btn--quiet" href="/case-studies/">Read the case studies</a>
          </p>
        </div>
        <div class="bf-hero-art" aria-hidden="true">
          <img src="/assets/forge-conversions-corrected-640.webp" width="640" height="640" alt="" loading="lazy" decoding="async" />
        </div>
      </div>
    </header>

    <section class="bf-sec" id="results">
      <div class="bf-wrap">
        <h2>Results you can check</h2>
        <p>Each figure below comes from the client's Google Search Console and links to a case study that states the comparison period and its limits. The Search Console totals are rounded.</p>
        <ul class="bf-results">
          {results.map((r) => (
            <li><span class="bf-num">{r.num}</span><span class="bf-what" set:html={r.what} /><a class="bf-src" href={r.href}>Case study</a></li>
          ))}
        </ul>
        <p>These are search clicks. Where a client has shared sales or enquiry figures, the case study says so; where they have not, we do not claim them.</p>
        <figure class="bf-figure">
          <img src="/images/case-studies/bridal-dress-seo.webp" width="1031" height="410" loading="lazy" decoding="async" alt="Google Search Console comparison for Emily Bridalwear: 17.6K clicks in the last three months against 7.41K in the same period last year" />
          <figcaption>Emily Bridalwear, Google Search Console: last three months against the same period a year earlier. Source: <a href="/case-studies/bridal-dress-designer-seo/">the case study</a>.</figcaption>
        </figure>
      </div>
    </section>

    <section class="bf-sec" id="what-we-do">
      <div class="bf-wrap">
        <h2>What we do</h2>
        <dl class="bf-deliverables">
          {services.map((s) => (
            <>
              <dt><a href={s.href}>{s.name}</a></dt>
              <dd set:html={s.text} />
            </>
          ))}
        </dl>
        <p>For what a monthly programme includes and how it is priced, see <a href="/seo-services-philippines/">SEO services and packages</a>.</p>
      </div>
    </section>

    <section class="bf-sec" id="how-it-works">
      <div class="bf-wrap">
        <h2>How an engagement works</h2>
        <ol class="bf-steps">
          <li><strong>You send the site and the problem.</strong> We usually reply within one business day (Monday to Friday, 9:00 to 18:00 Manila time).</li>
          <li><strong>We look before we quote.</strong> A preliminary review of the obvious search, technical and conversion issues. If SEO is not the right next step, we say so.</li>
          <li><strong>Diagnostic and 90-day roadmap.</strong> A fixed piece of work: technical, content and authority review, a baseline of current search and enquiry performance, and a priority list with owners.</li>
          <li><strong>Monthly programme.</strong> Agreed work each month across technical fixes, page improvements, content and links. Every task is logged in a shared SEO management sheet with its status and evidence.</li>
          <li><strong>Monthly report and review call.</strong></li>
        </ol>
        <p>Some clients stop after step 3 and implement the roadmap themselves. That is a normal outcome.</p>
      </div>
    </section>

    <section class="bf-sec" id="each-month">
      <div class="bf-wrap">
        <h2>What you receive each month</h2>
        <ul class="bf-list">
          <li>A report covering organic traffic, rankings for agreed keywords, enquiries or sales where tracking allows, the work completed and the plan for next month.</li>
          <li>The management sheet, updated, showing each action, who owns it and the proof it was done.</li>
          <li>New or revised pages for approval before anything is published.</li>
          <li>Technical fix briefs for your developer, or the fixes made by us where we have access.</li>
        </ul>
      </div>
    </section>

    <section class="bf-sec" id="pricing">
      <div class="bf-wrap">
        <h2>How pricing works</h2>
        <p>We do not publish a rate card. Each proposal is written for one site and states the work included, the reporting, the billing currency and the terms.</p>
        <p>The price depends on the size of the site, how competitive the searches are, how much content is needed, and whether we or your team implement changes.</p>
      </div>
    </section>

    <section class="bf-sec" id="team">
      <div class="bf-wrap">
        <h2>Who does the work</h2>
        <div class="bf-team">
          {team.map((person) => (
            <div>
              <img src={person.img} alt={person.name} width="300" height="300" loading="lazy" decoding="async" />
              <h3><a href={person.href}>{person.name}</a></h3>
              <p>{person.role}</p>
            </div>
          ))}
        </div>
        <p>Ben Lowe has worked in SEO for more than 15 years and holds a marketing degree from London Metropolitan University. He leads the strategy and the quality standards behind client work. Read more <a href="/about-us/">about us</a>.</p>
      </div>
    </section>

    <section class="bf-sec" id="recognition">
      <div class="bf-wrap">
        <h2>Recognition</h2>
        <p>Clutch lists us as a Top SEO Company in the Philippines for 2025. Each badge links to the Clutch listing.</p>
        <ul class="bf-badges">
          {awards.map((a) => (
            <li><a class="award-card" href={a.href} target="_blank" rel="noopener noreferrer" data-analytics-event="clutch_evidence_click"><img src={a.img} alt="" width="72" height="72" loading="lazy" decoding="async" /><span>{a.label}</span></a></li>
          ))}
        </ul>
        <blockquote class="bf-quote">
          <p>Working with Bright Forge SEO has been a huge benefit for TeamStats. They understand our needs and deliver consistently.</p>
          <footer>Tom Stanbury. <a href="https://www.google.com/maps/contrib/116331598386131030776/place/ChIJE2gAZiKxlzMRs_CdsvEp-4I/@33.1283139,60.4938897,3z/data=!4m6!1m5!8m4!1e1!2s116331598386131030776!3m1!1e1?hl=en&entry=ttu" target="_blank" rel="noopener noreferrer" data-analytics-event="featured_review_source">View the public Google review</a></footer>
        </blockquote>
      </div>
    </section>

    <section class="bf-sec" id="questions">
      <div class="bf-wrap">
        <h2>Questions we are asked most</h2>
        {homepageFaqs.map((faq) => (
          <>
            <h3>{faq.question}</h3>
            <p set:html={faq.answer} />
          </>
        ))}
      </div>
    </section>

    <section class="bf-sec" id="contact">
      <div class="bf-wrap">
        <h2>Request an SEO review</h2>
        <p>Send your website, your target market and the problem you want solved. We usually reply within one business day.</p>
        <div class="bf-contact">
          <div>
            <form class="bf-form" name="homepage-contact" method="POST" data-netlify="true" data-lead-form="homepage-contact" netlify-honeypot="bot-field" action="/thanks/">
            <input type="hidden" name="form-name" value="homepage-contact" />
            <input type="hidden" name="subject" value="New Contact Form Submission from Website" />
            <input type="hidden" name="notification-email" value="seo@brightforgeseo.com" />
            <input type="hidden" name="landing_page" value="" />
            <input type="hidden" name="page_path" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="first_touch_landing_page" value="" />
            <input type="hidden" name="first_touch_referrer" value="" />
            <input type="hidden" name="first_touch_utm_source" value="" />
            <input type="hidden" name="first_touch_utm_medium" value="" />
            <input type="hidden" name="first_touch_utm_campaign" value="" />
            <p class="bf-hidden"><label>Do not fill this out: <input name="bot-field" /></label></p>

            <div class="bf-row">
              <div>
                <label for="firstName">First Name *</label>
                <input type="text" id="firstName" name="firstName" placeholder="Enter your first name" required />
              </div>
              <div>
                <label for="lastName">Last Name *</label>
                <input type="text" id="lastName" name="lastName" placeholder="Enter your last name" required />
              </div>
            </div>

            <div class="bf-row">
              <div>
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="your@email.com" required />
              </div>
              <div>
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="(+63) 912 345 6789" />
              </div>
            </div>

            <div>
              <label for="website">Website URL</label>
              <input type="url" id="website" name="website" placeholder="https://yourwebsite.com" />
            </div>

            <div>
              <label for="services">Services Interested In</label>
              <select id="services" name="services" required>
                <option value="">Select a service...</option>
                <option value="seo-review">Preliminary SEO review</option>
                <option value="seo-services">SEO Services Philippines</option>
                <option value="local-seo">Local SEO and Google Business Profile</option>
                <option value="technical-seo">Technical SEO</option>
                <option value="cro">SEO + CRO / Lead Generation Improvements</option>
                <option value="ai-search">AI Search Readiness</option>
                <option value="white-label">White Label SEO Services Philippines</option>
                <option value="not-sure">Not sure yet</option>
              </select>
            </div>

            <div>
              <label for="message">Tell us about your project</label>
              <textarea id="message" name="message" rows="5" placeholder="Tell us your website, target market, SEO goals and what a good enquiry or sale looks like..."></textarea>
            </div>

            <button type="submit" class="bf-btn bf-btn--primary">
              Request an SEO review
            </button>
            <p>Read our <a href="/privacy-policy/">privacy policy</a> before sending your enquiry.</p>
          </form>
          </div>
          <div>
            <address>Kathleen Place 4, Block 16, Lot 37 Armani Street, 75 S Francisco, Novaliches, Quezon City 1116, Metro Manila, Philippines</address>
            <dl class="bf-facts">
              <dt>Hours</dt><dd>Monday to Friday, 9:00 to 18:00 Manila time</dd>
              <dt>Phone</dt><dd><a href="tel:+639696206182">(+63) 969 620 6182</a></dd>
              <dt>Email</dt><dd><a href="mailto:seo@brightforgeseo.com">seo@brightforgeseo.com</a></dd>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</MainLayout>
