---
import MainLayout from '../layouts/MainLayout.astro';
import homepageFaqs from '../data/homepageFaqs.json';
import LegacyHeader from '../components/LegacyHeader.astro';
import Footer from '../components/Footer.astro';
import TestimonialsMarquee from '../components/TestimonialsMarquee.astro';
import AwardsSection from '../components/AwardsSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import RevenueSection from '../components/RevenueSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import TrustedBySection from '../components/TrustedBySection.astro';
import FeaturedTestimonial from '../components/FeaturedTestimonial.astro';
import HomepageHero from '../components/HomepageHero.astro';
import HomepageSearchLab from '../components/HomepageSearchLab.astro';
import { getAllBlogPosts } from '../lib/contentful.js';
 

// Fetch latest blog posts from Contentful
const allPosts = await getAllBlogPosts();
const featuredSlugs = [
  'how-much-does-seo-cost-in-the-philippines-in-2026',
  'how-to-choose-an-seo-agency-in-the-philippines',
  'seo-consultant-vs-agency-in-the-philippines',
];
const featured = featuredSlugs
  .map((slug) => allPosts.find((post) => post.slug === slug))
  .filter(Boolean);
const latestPosts = featured.length === 3
  ? featured
  : allPosts.slice(0, 3);

const title = "SEO Agency Philippines | Bright Forge";
const description = "Bright Forge is an SEO agency in Quezon City led by Ben Lowe, with 15+ years in search. Named team and 25 published case studies. Request an SEO review.";
const type = "company";
const image = "/images/og-image.jpg";
const breadcrumbs = [
  { name: 'Home', url: '/' }
];

---

<MainLayout
  title="SEO Agency Philippines | Bright Forge"
  description="SEO built around what you sell, not just keyword rankings. We improve how buyers find your website and enquire. Request an SEO review."
  type="company"
  image="/images/og-image.jpg"
  breadcrumbs={[
    { name: 'Home', url: '/' }
  ]}
  faqs={homepageFaqs}
>
  <LegacyHeader slot="header" />
  
  <!-- Hero Section -->
  <HomepageHero
    badge="British-led SEO, based in the Philippines"
    title="SEO Agency Philippines for Enquiries, Not Vanity Traffic"
    buttonText="Request an SEO Review"
    buttonHref="/contact/"
    secondaryButtonText="See case studies"
    secondaryButtonHref="/case-studies/"
    imageSrc="/images/Hero-SEO-Agency-In-The-Philippines.webp"
    imageAlt="Sassin Lowe - Bright Forge SEO Expert Philippines"
    trustBadgeText="Published Case Studies"
  >
    <Fragment slot="description">
      <p>Bright Forge is an SEO agency in Quezon City, Philippines, founded and led by Ben Lowe, who has worked in SEO for more than 15 years. We work for Philippine, Australian, UK and US businesses whose websites have to bring in enquiries, and we publish the Search Console figures behind our client work.</p>
    </Fragment>
    <Fragment slot="support">
      <p>British-led delivery from the Philippines by people you can name: Ben leads the strategy on client work, alongside Sassin Lowe (Co-Founder), Jani A. Cañonero (Head of Team) and Jewe O. Manalo (SEO Expert). Scope, reporting and billing currency are written into your proposal before any work starts.</p>
    </Fragment>
  </HomepageHero>

  <!-- Commercial Proof Section -->
  <section class="commercial-intro bg-[#ffffff] px-4 py-16 md:py-20">
    <div class="max-w-7xl mx-auto commercial-intro-grid">
      <div class="commercial-copy">
        <span class="section-label">THE AGENCY</span>
        <h2>A <span>named SEO team</span> in Quezon City, working for clients in four markets.</h2>
        <p>You can check our results for yourself. We have published 25 case studies, including Emily Bridalwear (organic clicks up from 7.41k to 17.6k), Lost Dutchman Leather (15.2k to 22.7k) and TeamStats (200k to 268k). Each one compares three months of Google Search Console data with the same three months a year earlier. You will also find our Clutch listings and reviews, and Google reviews from named reviewers, linked on this page.</p>
        <p>If you need the phone to ring, and you have paid for SEO before only to receive a ranking report you could not connect to a single call, we work differently. Bright Forge is a senior-led agency built to be checked: you know who leads your account, what we changed on your site and what happened in Search Console afterwards. You can meet the team on our <a href="/about-us/">about page</a>.</p>
        <p>We work from our Quezon City office, Monday to Friday, for companies in the Philippines, the UK, the US and Australia, and for agencies that resell our delivery under their own brand. Every engagement begins the same way: a preliminary review of your site, then a written proposal that states the work, the reporting and the currency you will be billed in.</p>
        <p>If you already know what you need, go straight to our <a href="/seo-services-philippines/">Philippine SEO services and packages</a>, <a href="/local-seo-for-google-maps-and-gbp/">local SEO for Maps and Google Business Profile</a> or our <a href="/ai-search-optimization-services-philippines/">AI search agency work</a>. Agencies can use our <a href="/white-label-seo-services-philippines/">white label SEO team</a> when the delivery needs to sit behind their own name.</p>
        <div class="commercial-actions">
          <a href="/contact/#contactForm" class="btn-view-all">Request an SEO Review</a>
          <a href="/case-studies/" class="text-link">View case studies</a>
        </div>
      </div>
      <div class="commercial-panel" aria-label="Bright Forge SEO agency at a glance">
        <div class="panel-row">
          <span>Led by</span>
          <strong>Ben Lowe, founder, 15+ years in SEO</strong>
        </div>
        <div class="panel-row">
          <span>Markets</span>
          <strong>Philippine, UK, US and Australian search</strong>
        </div>
        <div class="panel-row">
          <span>Reporting</span>
          <strong>Rankings, Search Console, calls, forms and leads</strong>
        </div>
        <div class="panel-row">
          <span>Recognition</span>
          <strong>Three Clutch listings, each linked below</strong>
        </div>
      </div>
    </div>
  </section>

  <HomepageSearchLab />

  <!-- Trusted By Section -->
  <TrustedBySection />

  <!-- Awards Section -->
  <AwardsSection />

  <!-- Featured Testimonial -->
  <FeaturedTestimonial />

  <!-- Case Studies Section - Modern Design -->
  <section class="case-studies-section">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Header -->
      <div class="section-header">
        <span class="section-badge">
          <i class="fas fa-trophy"></i>
          Published Results
        </span>
        <h2 class="section-title">
          Case Studies With the <span class="title-highlight">Search Console Figures</span> Shown
        </h2>
        <p class="section-description">
          We have published 25 case studies, and each one states its comparison period and what the data cannot show. The three below set a three-month Search Console total against the same three months a year earlier. They report search clicks, impressions and click-through rate. They do not claim sales.
        </p>
        <p class="section-description">
          Longer comparisons are published too: <a href="/case-studies/pest-control-core-update-seo/">ThermoPest</a> went from 10.3k to 23.5k clicks between two six-month windows, and <a href="/case-studies/speediance-au-fitness-seo/">Speediance Australia</a> from 6,550 to 10,900.
        </p>
      </div>

      <!-- Cards Grid -->
      <div class="case-studies-grid">
        <!-- Card 1 - Bridal Dress Designer -->
        <article class="case-study-card">
          <div class="card-image">
            <img src="/images/case-studies/bridal-dress-seo.webp" alt="Search Console comparison for Emily Bridalwear, a bridal dress designer" width="400" height="300" loading="lazy" decoding="async">
            <span class="card-badge">Bridal Fashion</span>
          </div>
          <div class="card-content">
            <h3 class="card-title">Emily Bridalwear: 137.5% Organic Click Growth, from 7.41k to 17.6k year on year</h3>
            <div class="card-stats">
              <div class="stat">
                <span class="stat-value">+137.5%</span>
                <span class="stat-label">Organic Clicks</span>
              </div>
              <div class="stat">
                <span class="stat-value">+118.1%</span>
                <span class="stat-label">Impressions</span>
              </div>
              <div class="stat">
                <span class="stat-value">3 mo.</span>
                <span class="stat-label">Year on year</span>
              </div>
            </div>
            <a href="/case-studies/bridal-dress-designer-seo/" class="card-link">
              Read the Emily Bridalwear case
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <!-- Card 2 - Leather Wallet E-Commerce -->
        <article class="case-study-card">
          <div class="card-image">
            <img src="/images/case-studies/leather-wallet-ecommerce-seo.webp" alt="Search Console comparison for Lost Dutchman Leather, a handmade wallet store" width="400" height="300" loading="lazy" decoding="async">
            <span class="card-badge">E-commerce</span>
          </div>
          <div class="card-content">
            <h3 class="card-title">Lost Dutchman Leather: 49.3% Organic Click Growth, from 15.2k to 22.7k year on year</h3>
            <div class="card-stats">
              <div class="stat">
                <span class="stat-value">+49.3%</span>
                <span class="stat-label">Organic Clicks</span>
              </div>
              <div class="stat">
                <span class="stat-value">4.5%</span>
                <span class="stat-label">CTR, from 3.1%</span>
              </div>
              <div class="stat">
                <span class="stat-value">3 mo.</span>
                <span class="stat-label">Year on year</span>
              </div>
            </div>
            <a href="/case-studies/leather-wallet-ecommerce-seo/" class="card-link">
              Read the Lost Dutchman Leather case
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <!-- Card 3 - Football App -->
        <article class="case-study-card">
          <div class="card-image">
            <img src="/images/case-studies/football-app-seo-case-study.webp" alt="Search Console comparison for TeamStats, a football team management app" width="400" height="300" loading="lazy" decoding="async">
            <span class="card-badge">Sports</span>
          </div>
          <div class="card-content">
            <h3 class="card-title">TeamStats: 34% Organic Click Growth, from 200k to 268k year on year</h3>
            <div class="card-stats">
              <div class="stat">
                <span class="stat-value">+34%</span>
                <span class="stat-label">Organic Clicks</span>
              </div>
              <div class="stat">
                <span class="stat-value">+29.3%</span>
                <span class="stat-label">Impressions</span>
              </div>
              <div class="stat">
                <span class="stat-value">3 mo.</span>
                <span class="stat-label">Year on year</span>
              </div>
            </div>
            <a href="/case-studies/football-app-seo/" class="card-link">
              Read the TeamStats case
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      </div>

      <!-- View All Button -->
      <div class="section-cta">
        <a href="/case-studies/" class="btn-view-all">
          View All 25 Case Studies
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <style>
    .case-studies-section {
      padding: 6rem 0;
      background: #ffffff;
    }

    .case-studies-section .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 4rem;
    }

    .case-studies-section .section-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: linear-gradient(135deg, rgba(240, 98, 42, 0.1) 0%, rgba(240, 98, 42, 0.05) 100%);
      border: 1px solid rgba(240, 98, 42, 0.15);
      color: #b83e12;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 20px;
    }

    .case-studies-section .section-badge i {
      font-size: 10px;
    }

    .case-studies-section .section-title {
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 800;
      color: #19212e;
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .case-studies-section .title-highlight {
      color: #b83e12;
    }

    .case-studies-section .section-description {
      font-size: 1.125rem;
      color: #19212e;
      line-height: 1.7;
    }

    .case-studies-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .case-study-card {
      background: #f7f8fa;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid rgba(25, 33, 46, 0.07);
      box-shadow: 0 1px 3px rgba(25, 33, 46, 0.09);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .case-study-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(25, 33, 46, 0.09);
    }

    .card-image {
      position: relative;
      height: 200px;
      overflow: hidden;
    }

    .card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .case-study-card:hover .card-image img {
      transform: scale(1.05);
    }

    .card-badge {
      position: absolute;
      top: 16px;
      left: 16px;
      background: linear-gradient(135deg, #f0622a 0%, #d4510e 100%);
      color: #19212e;
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-content {
      padding: 1.5rem;
    }

    .card-title {
      font-size: 1.125rem;
      font-weight: 700;
      color: #19212e;
      margin-bottom: 1rem;
      line-height: 1.4;
      letter-spacing: -0.01em;
    }

    .card-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding: 1rem;
      background: #f1f3f5;
      border-radius: 12px;
    }

    .stat {
      text-align: center;
    }

    .stat-value {
      display: block;
      font-size: 1.25rem;
      font-weight: 800;
      color: #b83e12;
      letter-spacing: -0.02em;
    }

    .stat-label {
      display: block;
      font-size: 0.6875rem;
      color: #19212e;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 4px;
    }

    .card-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9375rem;
      font-weight: 600;
      color: #b83e12;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .card-link:hover {
      gap: 12px;
    }

    .card-link svg {
      transition: transform 0.2s ease;
    }

    .card-link:hover svg {
      transform: translateX(4px);
    }

    .case-studies-section .section-cta {
      text-align: center;
    }

    .btn-view-all {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 32px;
      background: linear-gradient(135deg, rgba(240, 98, 42, 0.1), rgba(240, 98, 42, 0.05));
      border: 1px solid rgba(240, 98, 42, 0.15);
      color: #b83e12;
      border-radius: 100px;
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-view-all:hover {
      transform: translateY(-2px);
      border-color: rgba(240, 98, 42, 0.4);
      background: linear-gradient(135deg, rgba(240, 98, 42, 0.15), rgba(240, 98, 42, 0.08));
    }

    .btn-view-all:hover svg {
      transform: translateX(4px);
    }

    .btn-view-all svg {
      transition: transform 0.2s ease;
    }

    @media (max-width: 1024px) {
      .case-studies-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .case-studies-section {
        padding: 4rem 0;
      }

      .case-studies-grid {
        grid-template-columns: 1fr;
      }

      .case-studies-section .section-header {
        margin-bottom: 3rem;
      }
    }
  </style>

  <!-- Why Choose Us Section -->
  <WhyChooseUs />

  <!-- Team row -->
  <section class="pf-section" id="team">
    <div class="pf-wrap">
      <p class="eyebrow">Who does the work</p>
      <h2>The four people <span>behind your SEO campaign</span></h2>
      <p class="pf-lede">Strategy, operations, campaign delivery and specialist SEO each have a named owner in our Quezon City office. Every name links to that person's profile and articles.</p>
      <ul class="pf-team">
        <li><img src="/images/About us/ben-lowe-owner.webp" alt="Ben Lowe" width="300" height="300" loading="lazy" decoding="async"><div class="pf-team-body"><strong><a href="/authors/ben-lowe/">Ben Lowe</a></strong><span class="pf-team-role">Founder &amp; CEO</span><p>More than 15 years in SEO and a marketing degree from London Metropolitan University. Ben leads the strategy, commercial judgement and quality standards behind client work.</p></div></li>
        <li><img src="/images/About us/sassin-lowe-owner.webp" alt="Sassin Lowe" width="300" height="300" loading="lazy" decoding="async"><div class="pf-team-body"><strong><a href="/authors/sassin-lowe/">Sassin Lowe</a></strong><span class="pf-team-role">Co-Founder</span><p>Runs operations: scope, delivery rhythm, reporting and the gap between what was recommended and what was implemented.</p></div></li>
        <li><img src="/images/About us/Janin-seo-manager.webp" alt="Jani A. Cañonero" width="300" height="300" loading="lazy" decoding="async"><div class="pf-team-body"><strong><a href="/authors/janin-a-canonero/">Jani A. Cañonero</a></strong><span class="pf-team-role">Head of Team</span><p>Manages campaign execution, including tasking and quality checks, and checks implementation against the brief.</p></div></li>
        <li><img src="/images/About us/jewe-seo-expert.webp" alt="Jewe O. Manalo" width="300" height="300" loading="lazy" decoding="async"><div class="pf-team-body"><strong><a href="/authors/jewe-o-manalo/">Jewe O. Manalo</a></strong><span class="pf-team-role">SEO Expert</span><p>Handles the specialist work inside campaigns: keyword mapping, technical checks and on-page changes.</p></div></li>
      </ul>
      <p class="pf-note">How we check work and what we will not claim is set out in our <a href="/editorial-standards/">editorial standards</a>.</p>
    </div>
  </section>

  <!-- Our Process Steps Section (red) -->
  <ProcessSection />


  <!-- Services Section -->
  <section class="seo-services-section bg-[#ffffff] py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Left Side - Image/Card -->
        <div class="relative">
          <div class="bg-[#f7f8fa] rounded-3xl p-8 shadow-lg max-w-lg mx-auto">
            <div class="rounded-2xl h-80 mb-6 overflow-hidden bg-[#ffffff]">
              <svg viewBox="0 0 600 400" class="w-full h-full" role="img" aria-label="Illustration of a search result leading to a tracked phone enquiry" preserveAspectRatio="xMidYMid slice">
                <rect width="600" height="400" fill="#f7f8fa"/>
                <g stroke="#dce2e8" stroke-width="1"><path d="M0 100h600M0 200h600M0 300h600M150 0v400M300 0v400M450 0v400" fill="none"/></g>
                <rect x="60" y="48" width="480" height="304" rx="14" fill="#f1f3f5" stroke="#dce2e8"/>
                <path d="M60 92h480v-30a14 14 0 0 0-14-14H74a14 14 0 0 0-14 14z" fill="#1f2440"/>
                <circle cx="88" cy="70" r="5" fill="#f0622a"/>
                <circle cx="106" cy="70" r="5" fill="#3c4569"/>
                <circle cx="124" cy="70" r="5" fill="#3c4569"/>
                <rect x="150" y="58" width="246" height="24" rx="12" fill="#f7f8fa" stroke="#dce2e8"/>
                <circle cx="167" cy="70" r="6" fill="none" stroke="#f0622a" stroke-width="2"/>
                <path d="M171.5 74.5l5 5" stroke="#f0622a" stroke-width="2" stroke-linecap="round"/>
                <rect x="186" y="66" width="130" height="8" rx="4" fill="#323a5e"/>
                <rect x="84" y="116" width="200" height="42" rx="9" fill="#f0622a" opacity="0.14"/>
                <rect x="84" y="116" width="200" height="42" rx="9" fill="none" stroke="#f0622a" stroke-width="1.5"/>
                <circle cx="107" cy="137" r="10" fill="#f0622a"/>
                <rect x="127" y="127" width="118" height="7" rx="3.5" fill="#19212e" opacity="0.92"/>
                <rect x="127" y="140" width="78" height="6" rx="3" fill="#3c4569"/>
                <rect x="84" y="170" width="200" height="42" rx="9" fill="#1d2238"/>
                <circle cx="107" cy="191" r="10" fill="#323a5e"/>
                <rect x="127" y="181" width="106" height="7" rx="3.5" fill="#3c4569"/>
                <rect x="127" y="194" width="66" height="6" rx="3" fill="#dce2e8"/>
                <rect x="84" y="224" width="200" height="42" rx="9" fill="#1d2238"/>
                <circle cx="107" cy="245" r="10" fill="#323a5e"/>
                <rect x="127" y="235" width="112" height="7" rx="3.5" fill="#3c4569"/>
                <rect x="127" y="248" width="58" height="6" rx="3" fill="#dce2e8"/>
                <rect x="84" y="278" width="200" height="42" rx="9" fill="#1d2238"/>
                <circle cx="107" cy="299" r="10" fill="#323a5e"/>
                <rect x="127" y="289" width="98" height="7" rx="3.5" fill="#3c4569"/>
                <rect x="127" y="302" width="72" height="6" rx="3" fill="#dce2e8"/>
                <rect x="312" y="116" width="204" height="146" rx="10" fill="#1d2238"/>
                <g stroke="#dce2e8" stroke-width="1"><path d="M330 226h170M330 192h170M330 158h170" fill="none"/></g>
                <path d="M330 238L368 218L406 224L444 190L478 198L500 154" fill="none" stroke="#f0622a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M330 238L368 218L406 224L444 190L478 198L500 154L500 246L330 246Z" fill="#f0622a" opacity="0.08"/>
                <circle cx="500" cy="154" r="5" fill="#f0622a"/>
                <circle cx="500" cy="154" r="9" fill="#f0622a" opacity="0.25"/>
