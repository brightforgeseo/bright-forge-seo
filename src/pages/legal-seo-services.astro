---
import EditorialPage from '../components/EditorialPage.astro';

const page = {
  path: '/legal-seo-services/',
  title: 'Legal SEO Services for Law Firms | Bright Forge SEO',
  description: 'SEO for law firms: practice-area pages, solicitor profiles and enquiry routes, written with your lawyers\' approval. One published personal-injury case study.',
  h1: 'Legal SEO Services for Law Firms',
  crumb: 'Legal SEO',
  parents: [{ name: 'Industries', url: '/industries/' }],
  lead: [
    'People looking for a lawyer search by problem and by place. We improve the practice-area pages, lawyer profiles and local listings that answer those searches, and we publish nothing about the law until one of your lawyers has approved it.',
  ],
  secondary: { href: '/case-studies/injury-law-organic-growth/', label: 'Read the case study' },
  sections: [
    {
      h2: 'Published result',
      html: `<ul class="bf-results">
<li><span class="bf-num">1,000 to 2,065</span><span class="bf-what"><strong>A personal-injury law firm</strong> (not named): organic clicks across two 90-day periods, from a modest rise in impressions, with better average position and click-through rate</span><a class="bf-src" href="/case-studies/injury-law-organic-growth/">Case study</a></li>
</ul>
<p>This is our one published legal case. It records search clicks, not signed matters.</p>`,
    },
    {
      h2: 'What we work on',
      html: `<dl class="bf-deliverables">
<dt>Practice-area pages</dt><dd>The matters you take, who they are for, what happens first, fees or how fees work.</dd>
<dt>Lawyer profiles</dt><dd>Qualifications, admissions, experience.</dd>
<dt>Local SEO</dt><dd>Business Profile and legal directories. See <a href="/local-seo-for-google-maps-and-gbp/">local SEO</a>.</dd>
<dt>Articles</dt><dd>Answering real client questions, reviewed by a lawyer. See <a href="/content-seo-services-philippines/">SEO content writing</a>.</dd>
<dt>Enquiry routes</dt><dd>Forms, phone, call-back, and tracking of each.</dd>
</dl>`,
    },
    {
      h2: 'What we will not write',
      html: `<p>Promises about outcomes, comparisons with other firms that cannot be supported, or anything that breaches your regulator's advertising rules. You tell us which rules apply; we follow them.</p>`,
    },
    {
      h2: 'How we do it',
      html: `<ol class="bf-steps">
<li>Agree the practice areas and locations that matter.</li>
<li>Keyword research and review of current pages.</li>
<li>Draft; lawyer review; publish.</li>
<li>Report monthly on consultation requests from search.</li>
</ol>`,
    },
  ],
  faqs: [
    { question: 'Who approves legal content before it is published?', answer: 'One of your lawyers. We do not publish statements about the law on our own authority.' },
  ],
};
---
<EditorialPage page={page} />
