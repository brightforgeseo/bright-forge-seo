---
import MainLayout from "../layouts/MainLayout.astro";
import LegacyHeader from "../components/LegacyHeader.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonSecondary from "../components/ButtonSecondary.astro";

const canonical = "https://brightforge.com.ph/legal-seo-services/";
const faqs = [
  {
    question: "What is legal SEO?",
    answer: "Legal SEO is search work that helps a law firm get found for the practice areas it actually handles. People looking for a lawyer search by problem and by place, so the core is practice-area pages, lawyer profiles, local signals where the firm has a real office, reviews, technical health and an intake path people will use. Accuracy and trust matter more than blog volume: one approved practice page outweighs ten general articles.",
  },
  {
    question: "Why do law firm SEO pages fail?",
    answer: "Usually because a prospective client cannot tell, from the page they land on, whether the firm handles their kind of matter, works in the relevant jurisdiction or offers the consultation they need. They leave and ring a firm whose page does say. We check those gaps alongside search visibility and technical access. Legal information can affect important decisions, so accuracy and a qualified review owner are essential.",
  },
  {
    question: "Do you write legal advice?",
    answer: "No. We work on page structure, metadata, internal links, schema recommendations and the enquiry route, and we draft copy for your review. The firm appoints a qualified reviewer for legal accuracy, advertising rules and jurisdiction-specific claims, and nothing is published until that reviewer has approved it. Case results, credentials, fees and testimonials all need the firm's approval.",
  },
  {
    question: "How do you measure law firm SEO?",
    answer: "In four separate layers: search impressions and clicks, contact activity, booked consultations and signed matters. We can see the first directly; the firm owns intake and matter records. We agree privacy-safe reporting before connecting outcomes, because a submitted form does not establish a suitable or retained client.",
  },
  {
    question: "Do you guarantee page-one rankings for lawyers?",
    answer: "No. We can identify page gaps, agree changes and check the released result. Rankings depend on competition and search systems as well as the site, and legal markets are among the most contested. Our reporting distinguishes completed work from search movement and from consultations, so you can see what we did even in a month when positions did not move.",
  },
];
---

<MainLayout title="Legal SEO | SEO for Law Firms | Bright Forge" description="SEO for lawyers and law firms: practice-area pages, lawyer profiles and consultation intake approved by your reviewer, backed by a published injury-law case." canonical={canonical} type="service" breadcrumbs={[{ name: "Home", url: "https://brightforge.com.ph/" }, { name: "Legal SEO", url: canonical }]} faqs={faqs}>
  <LegacyHeader slot="header" />
  <Hero title="Legal SEO for <span>law firms</span>" breadcrumbCurrent="Legal SEO">
    <Fragment slot="story">
      <p class="hero-subtitle">SEO for lawyers who need consultations from the practice areas they actually handle.</p>
      <p>Someone looking for help with an injury claim wants three answers before they call: does this firm handle my type of matter, can it act where I am, and what happens at first contact? We review practice-area pages, lawyer profiles and intake routes so those answers are easy to find. Our published legal case is a personal-injury firm whose organic clicks rose from 1,000 to 2,065 across two 90-day periods.</p>
    </Fragment>
    <Fragment slot="actions">
      <ButtonPrimary href="/contact/" text="Request an SEO Review" />
      <ButtonSecondary href="#results" text="See Published Results" />
    </Fragment>
  </Hero>
  <main class="service-page">
    <section>
      <div class="page-container intro-grid">
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2><span>SEO for lawyers</span> starts with the matters the firm accepts</h2>
          <p>We begin with three facts: the matters you accept, the jurisdictions you can act in and the lawyers responsible. Those facts shape the practice-page map, the biographies that matter and the location information. We assess the pages you already have before proposing another practice or city URL.</p>
          <p>Before anything is published, you name the person who approves legal accuracy, advertising claims and intake wording. A Philippine firm, an Australian practice, a UK solicitor and a US law firm may each face different requirements. You tell us which rules apply and we scope the SEO changes with that reviewer. An SEO review is not legal or regulatory clearance.</p>
        </div>
        <aside class="panel">
          <h3>What we check first</h3>
          <ul>
            <li>Each distinct practice enquiry has a page that answers it</li>
            <li>Lawyer bios match the people doing the work</li>
            <li>Offices and jurisdictions served are described separately</li>
            <li>Reviews and contact details sit on the pages where people decide to call</li>
            <li>Calls, forms and consultations can be tracked</li>
          </ul>
        </aside>
      </div>
    </section>

    <section id="results">
      <div class="page-container">
        <p class="eyebrow">Published proof</p>
        <h2>A legal campaign you can <span>check in public</span></h2>
        <p class="lead">The case study compares two 90-day periods in Search Console for an anonymised personal-injury firm. It records search performance rather than signed matters, and we present it as this firm's result, not a forecast for every legal market.</p>
        <div class="results-grid single">
          <article class="result-card">
            <p class="result-tag">Legal · Personal injury</p>
            <h3>+106.5% organic clicks</h3>
            <p>A personal-injury law firm rose from 1,000 to 2,065 organic clicks (31 May to 28 August 2026 against the previous 90 days) on impressions up only 11.6%. CTR rose from 0.33% to 0.60% and average position improved from 20.0 to 17.3, so more of the people who saw the firm chose to click. The published case does not identify the jurisdiction or isolate the effect of individual page changes.</p>
            <a href="/case-studies/injury-law-organic-growth/">Read the case study</a>
          </article>
        </div>
      </div>
    </section>

    <section class="pf-section" id="legal-start">
      <div class="pf-wrap">
        <p class="eyebrow">How to start</p>
        <h2>Three steps, with <span>your reviewer in control</span></h2>
        <p class="pf-lede">Nothing about the law is published until a lawyer at the firm has approved it. The process is built around that rule.</p>
        <ol class="pf-steps">
          <li><strong>Send the site and the practice areas</strong><span>Your priority practice areas, the jurisdictions you serve and the name of the person who will review the copy. We need no confidential client files.</span></li>
          <li><strong>We assess the pages and the first contact</strong><span>We check whether each practice enquiry has a page that answers it, whether biographies match the lawyers doing the work, and whether calls, forms and consultations can be tracked.</span></li>
          <li><strong>We draft, your reviewer approves, then it goes live</strong><span>Legal accuracy, advertising claims and intake wording are cleared by the firm before publication. The work is scoped in a written proposal.</span></li>
        </ol>
      </div>
    </section>

    <section id="included">
      <div class="page-container">
        <p class="eyebrow">What the work covers</p>
        <h2>What <span>law firm SEO</span> should cover</h2>
        <div class="fit-grid">
          <article class="fit-card">
            <h3>Practice-area pages first</h3>
            <p>We compare the questions behind injury, family, employment or property searches with your existing coverage. A practice page should say which matters you take, who they are for, what happens first and how fees work. Separate pages make sense where the service and the client's decision differ; closely related questions are often better answered together.</p>
          </article>
          <article class="fit-card">
            <h3>Lawyer pages that do a job</h3>
            <p>A prospective client should see who handles the matter, their role and their current credentials. The firm supplies and checks admissions, memberships, experience and contact details. We connect each biography to the practice pages that lawyer is responsible for.</p>
          </article>
          <article class="fit-card">
            <h3>Offices and jurisdiction coverage</h3>
            <p>An office address and a jurisdiction served mean different things. Pages should say where the firm is based and where it can act. Google Business Profile eligibility is assessed separately; representing clients in a city does not create an office there.</p>
          </article>
          <article class="fit-card">
            <h3>Trust on the page</h3>
            <p>Approved credentials, relevant experience and contact details belong beside the service explanation. Testimonials and case examples need permission and review under the rules that apply to the firm. We will not write promises about outcomes or comparisons with other firms that cannot be supported.</p>
          </article>
          <article class="fit-card">
            <h3>Intake that can be measured</h3>
            <p>We agree the minimum information needed for first contact and who receives it. An ordinary marketing form should not ask for a detailed, sensitive case history. The firm approves privacy notices, handling and any tracking before the route goes live.</p>
          </article>
          <article class="fit-card">
            <h3>Technical and schema basics</h3>
            <p>We check crawl access, speed and mobile usability, and recommend LegalService or FAQ markup only where the visible page supports it.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container two-column">
        <div>
          <p class="eyebrow">Fit</p>
          <h2>Right when the firm can name its <span>practice areas</span></h2>
          <p>Take an employment practice. An illustrative page brief might distinguish employee advice from employer support, explain the initial consultation and link the responsible lawyer. The firm supplies the accurate scope, fee information where appropriate and approved next-step wording. That page will do more for the firm than another general employment-law article.</p>
        </div>
        <div class="panel">
          <h3>Not the right fit when</h3>
          <p>the firm cannot assign a legal reviewer or approve how enquiries are collected. Those responsibilities need settling before we publish new service claims or add tracking to intake.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container">
        <p class="eyebrow">Related work</p>
        <h2><span>Useful next steps</span> from here</h2>
        <div class="link-grid">
          <a href="/construction-seo-services/"><span>Construction SEO</span>Separate support for a construction business, as distinct from a law firm advising one.</a>
          <a href="/local-seo-for-google-maps-and-gbp/"><span>Local SEO</span>Maps, listings and location pages that match the offices you really have.</a>
          <a href="/case-studies/injury-law-organic-growth/"><span>Injury-law case</span>The Search Console evidence behind this page, with its periods and limits.</a>
        </div>
      </div>
    </section>

    <section>
      <div class="page-container faq-layout">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2><span>Legal SEO</span> questions</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="page-container">
        <div class="cta-card">
          <h2>Want practice-area pages that bring <span>consultations</span>?</h2>
          <p>Send the site, your priority practice areas, the jurisdictions you serve and the name of the person who will review the copy. We can assess the relevant pages and the first-contact route without needing confidential client files, and the work is then scoped in a written proposal.</p>
          <div class="cta-actions">
            <ButtonPrimary href="/contact/" text="Request an SEO Review" />
            <ButtonSecondary href="/case-studies/" text="View Case Studies" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</MainLayout>

<style>
.service-page { background:#ffffff; color:#19212e; }
.page-container { width:min(100% - 40px,1120px); margin:0 auto; }
.service-page section { padding:78px 0; content-visibility:visible !important; }
.service-page section:nth-child(even) { background:#ffffff; }
.eyebrow { display:block; color:#b83e12; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; }
h2 { color:#19212e; font-size:clamp(2rem,4vw,3rem); line-height:1.05; margin:0 0 22px; }
h3 { color:#19212e; font-size:1.16rem; margin:0 0 10px; }
p, li { color:#465365; font-size:1.02rem; line-height:1.72; }
a { color:#b83e12; }
.lead { max-width:68ch; margin:0 0 28px; }
.intro-grid, .two-column, .faq-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:clamp(30px,5vw,60px); align-items:start; }
.panel, .fit-card, .result-card, .faq-item, .cta-card { border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; box-shadow:0 18px 48px rgba(25, 33, 46, 0.09); }
.panel { padding:28px; }
.panel ul { margin:0; padding-left:20px; }
.fit-grid, .results-grid, .link-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.results-grid.single { grid-template-columns:1fr; max-width:720px; }
.fit-card, .result-card, .link-grid a { padding:24px; }
.result-tag { color:#b83e12; font-size:.78rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; margin:0 0 10px; }
.result-card a { font-weight:800; }
.link-grid a { color:inherit; text-decoration:none; border:1px solid rgba(25, 33, 46, 0.09); background:rgba(255, 255, 255, 0.045); border-radius:24px; }
.link-grid span { display:block; color:#19212e; font-weight:900; margin-bottom:8px; }
.faq-list { display:grid; gap:14px; }
.faq-item summary { cursor:pointer; padding:22px 24px; color:#19212e; font-weight:900; list-style:none; }
.faq-item summary::-webkit-details-marker { display:none; }
.faq-item p { padding:0 24px 24px; margin:0; }
.cta-card { text-align:center; padding:clamp(36px,6vw,68px); background:radial-gradient(circle at top left,rgba(240,98,42,.22),rgba(255, 255, 255, 0.045)); }
.cta-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
:global(.service-page .btn-primary), :global(.service-page .btn-secondary) { min-height:48px; }
@media (max-width:920px){
  .intro-grid,.two-column,.fit-grid,.results-grid,.link-grid,.faq-layout{grid-template-columns:1fr;}
}
</style>
