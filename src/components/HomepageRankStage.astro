---
/**
 * Ranking as a material. Pointer height sets the position.
 * Copy is Bright Forge homepage language, not a live rank claim.
 */
---

<section class="rank-stage" id="ranking-stage" data-rank-stage aria-label="How a search result earns an enquiry">
  <div class="rank-beam" data-rank-beam hidden></div>
  <div class="rank-inner">
    <div class="rank-top">
      <p class="rank-kicker">Move to rank</p>
      <p class="rank-word" data-rank-word>Position 08</p>
    </div>

    <div class="rank-grid">
      <div class="rank-copy">
        <p class="rank-eyebrow">A stranger is searching for an SEO agency in the Philippines.</p>
        <p class="rank-num" data-rank-num>08</p>
        <h2 class="rank-line"><span data-rank-line>Page eight. The enquiry never starts.</span></h2>
        <p class="rank-note">Not a live ranking. Move up the page. Vague copy loses. Named work and a next step win the enquiry.</p>
      </div>

      <article class="rank-card" data-rank-card>
        <p class="rank-url" data-rank-url>example.com/seo</p>
        <h3 class="rank-title" data-rank-title>Quality Solutions for Your Business</h3>
        <p class="rank-meta" data-rank-meta>We help brands unlock growth with digital strategies and dedicated support.</p>
        <a class="rank-cta" data-rank-cta href="/contact/" hidden>Request an SEO Review</a>
      </article>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-rank-stage]');
  if (root) {
    const stages = [
      {
        n: '08',
        word: 'Position 08',
        line: 'Page eight. The enquiry never starts.',
        url: 'example.com/seo',
        title: 'Quality Solutions for Your Business',
        meta: 'We help brands unlock growth with digital strategies and dedicated support.',
        lead: false
      },
      {
        n: '06',
        word: 'Position 06',
        line: 'People see you. They pick someone else.',
        url: 'example.com/seo-agency',
        title: 'SEO Services | Trusted Agency',
        meta: 'Full-service SEO, content and reporting for growing companies.',
        lead: false
      },
      {
        n: '03',
        word: 'Position 03',
        line: 'The job is named. Rankings are the means.',
        url: 'brightforge.com.ph',
        title: 'SEO Agency Philippines | Bright Forge',
        meta: 'Philippine SEO agency for businesses that need enquiries from search. Technical SEO, content and conversion work. Named team. Private proposal.',
        lead: false
      },
      {
        n: '01',
        word: 'Position 01',
        line: 'Enquiries are the job. The first screen has to take the click.',
        url: 'brightforge.com.ph',
        title: 'SEO Agency Philippines for Enquiries, Not Vanity Traffic',
        meta: 'British-led SEO, based in the Philippines. Request an SEO review. We will say if there is a fit.',
        lead: true
      }
    ];

    const num = root.querySelector('[data-rank-num]');
    const word = root.querySelector('[data-rank-word]');
    const line = root.querySelector('[data-rank-line]');
    const card = root.querySelector('[data-rank-card]');
    const title = root.querySelector('[data-rank-title]');
    const meta = root.querySelector('[data-rank-meta]');
    const url = root.querySelector('[data-rank-url]');
    const cta = root.querySelector('[data-rank-cta]');
    const beam = root.querySelector('[data-rank-beam]');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let cur = -1;
    let box = null;
    let pendingY = null;
    let raf = 0;
    let live = fine;

    function measure() {
      box = root.getBoundingClientRect();
    }

    function apply(i) {
      if (i === cur) return;
      cur = i;
      const s = stages[i];
      if (num) num.textContent = s.n;
      if (word) word.textContent = s.word;
      if (line) line.textContent = s.line;
      if (title) title.textContent = s.title;
      if (meta) meta.textContent = s.meta;
      if (url) url.textContent = s.url;
      if (cta) cta.hidden = !s.lead;
      if (card) {
        card.style.transform = 'translate3d(0,' + (-i * 8) + 'px,0)';
        card.classList.toggle('is-lead', s.lead);
      }
    }

    function tick() {
      raf = 0;
      if (pendingY == null) return;
      if (!box) measure();
      const y = pendingY;
      pendingY = null;
      const top = y - box.top;
      if (beam) {
        beam.hidden = false;
        beam.style.transform = 'translate3d(0,' + top + 'px,0)';
      }
      const t = top / Math.max(1, box.height);
      apply(t > 0.72 ? 0 : t > 0.5 ? 1 : t > 0.28 ? 2 : 3);
    }

    function move(e) {
      if (!live) return;
      if (e.target && e.target.closest && e.target.closest('a')) return;
      pendingY = e.clientY;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    root.addEventListener('pointerdown', (e) => {
      live = true;
      measure();
      move(e);
    });
    root.addEventListener('pointerup', () => { if (!fine) live = false; });
    root.addEventListener('pointercancel', () => { if (!fine) live = false; });
    root.addEventListener('pointermove', move, { passive: true });
    window.addEventListener('scroll', () => { box = null; }, { passive: true });
    window.addEventListener('resize', () => { box = null; }, { passive: true });
    apply(0);
  }
</script>

<style>
  .rank-stage {
    position: relative;
    overflow: clip;
    contain: layout style;
    color: #f4f1ea;
    background: #0d0f1a;
    touch-action: pan-y;
    padding: 2.5rem 0 3rem;
  }
  .rank-beam {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: #f0622a;
    opacity: 0.7;
    pointer-events: none;
    z-index: 2;
    will-change: transform;
  }
  .rank-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .rank-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .rank-kicker { color: #9aa3b5; }
  .rank-word { color: #f0622a; }
  .rank-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 1201px) and (hover: hover) and (pointer: fine) {
    .rank-grid { grid-template-columns: 1.15fr 0.85fr; align-items: end; }
  }
  .rank-eyebrow {
    margin: 0;
    color: #9aa3b5;
    font-size: 0.95rem;
  }
  .rank-num {
    margin: 0.2rem 0 0;
    font-size: clamp(5.5rem, 16vw, 11rem);
    line-height: 0.85;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .rank-line {
    margin: 1.1rem 0 0;
    max-width: 22rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .rank-line span { color: #f0622a; }
  .rank-note {
    margin: 1rem 0 0;
    max-width: 28rem;
    color: #9aa3b5;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .rank-card {
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.25rem;
    background: #121526;
    padding: 1.35rem 1.4rem 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .rank-card.is-lead { border-color: rgba(240,98,42,0.55); }
  .rank-url {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #9aa3b5;
  }
  .rank-title {
    margin: 0.55rem 0 0;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #8ab4f8;
    font-weight: 600;
  }
  .rank-meta {
    margin: 0.55rem 0 0;
    color: #c5c9d4;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .rank-cta {
    display: inline-block;
    margin-top: 1rem;
    color: #f0622a;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .rank-cta[hidden] { display: none; }
</style>
