---
/**
 * Ranking as a material. Pointer height sets the position.
 * Copy is Bright Forge homepage language, not a live rank claim.
 */
const stages = [
  {
    n: '08',
    word: '08',
    line: 'Nobody calls from here.',
    url: 'example.com/seo',
    title: 'Quality Solutions for Your Business',
    meta: 'Digital strategies and support for growing brands.',
    lead: false
  },
  {
    n: '06',
    word: '06',
    line: 'They saw it. They chose someone else.',
    url: 'example.com/seo-agency',
    title: 'SEO Services | Trusted Agency',
    meta: 'SEO, content and reporting for companies that want more traffic.',
    lead: false
  },
  {
    n: '03',
    word: '03',
    line: 'The listing names the job.',
    url: 'brightforge.com.ph',
    title: 'SEO Agency Philippines | Bright Forge',
    meta: 'Technical SEO, content and conversion work for enquiries from search. Named team.',
    lead: false
  },
  {
    n: '01',
    word: '01',
    line: 'The click is available. The page has to take it.',
    url: 'brightforge.com.ph',
    title: 'SEO Agency Philippines for Enquiries, Not Vanity Traffic',
    meta: 'British-led SEO, based in the Philippines. Request a review and we will say if there is a fit.',
    lead: true
  }
];
---

<section class="rank-stage" id="ranking-stage" data-rank-stage aria-label="How a search result earns an enquiry">
  <div class="rank-beam" data-rank-beam></div>
  <div class="rank-inner">
    <p class="rank-eyebrow">A search for an SEO agency in the Philippines.</p>
    <p class="rank-num" data-rank-num>08</p>
    <h2 class="rank-line" data-rank-line>Nobody calls from here.</h2>

    <article class="rank-card" data-rank-card>
      <p class="rank-url" data-rank-url>example.com/seo</p>
      <h3 class="rank-title" data-rank-title>Quality Solutions for Your Business</h3>
      <p class="rank-meta" data-rank-meta>Digital strategies and support for growing brands.</p>
      <a class="rank-cta" data-rank-cta href="/contact/" hidden>Request an SEO Review</a>
    </article>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-rank-stage]');
    if (!root) return;
    var stages = [
      { n: '08', line: 'Nobody calls from here.', url: 'example.com/seo', title: 'Quality Solutions for Your Business', meta: 'Digital strategies and support for growing brands.', lead: false },
      { n: '06', line: 'They saw it. They chose someone else.', url: 'example.com/seo-agency', title: 'SEO Services | Trusted Agency', meta: 'SEO, content and reporting for companies that want more traffic.', lead: false },
      { n: '03', line: 'The listing names the job.', url: 'brightforge.com.ph', title: 'SEO Agency Philippines | Bright Forge', meta: 'Technical SEO, content and conversion work for enquiries from search. Named team.', lead: false },
      { n: '01', line: 'The click is available. The page has to take it.', url: 'brightforge.com.ph', title: 'SEO Agency Philippines for Enquiries, Not Vanity Traffic', meta: 'British-led SEO, based in the Philippines. Request a review and we will say if there is a fit.', lead: true }
    ];
    var num = root.querySelector('[data-rank-num]');
    var line = root.querySelector('[data-rank-line]');
    var card = root.querySelector('[data-rank-card]');
    var title = root.querySelector('[data-rank-title]');
    var meta = root.querySelector('[data-rank-meta]');
    var url = root.querySelector('[data-rank-url]');
    var cta = root.querySelector('[data-rank-cta]');
    var beam = root.querySelector('[data-rank-beam]');
    var cur = 0;
    var box = null;
    var y = null;
    var raf = 0;
    var down = false;

    function apply(i) {
      if (i === cur) return;
      cur = i;
      var s = stages[i];
      num.textContent = s.n;
      line.textContent = s.line;
      title.textContent = s.title;
      meta.textContent = s.meta;
      url.textContent = s.url;
      cta.hidden = !s.lead;
      card.classList.toggle('is-lead', s.lead);
    }

    function tick() {
      raf = 0;
      if (y == null || !box) return;
      var top = y - box.top;
      beam.style.transform = 'translate3d(0,' + top + 'px,0)';
      var t = top / Math.max(1, box.height);
      apply(t > 0.72 ? 0 : t > 0.5 ? 1 : t > 0.28 ? 2 : 3);
    }

    function move(e) {
      if (!down) return;
      y = e.clientY;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    function onDown(e) {
      if (e.target.closest && e.target.closest('a')) return;
      down = true;
      box = root.getBoundingClientRect();
      root.classList.add('is-live');
      move(e);
    }

    function onUp() {
      down = false;
      root.classList.remove('is-live');
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    root.addEventListener('pointerdown', onDown);
    root.addEventListener('pointermove', move, { passive: true });
    root.addEventListener('pointerup', onUp);
    root.addEventListener('pointercancel', onUp);
    root.addEventListener('lostpointercapture', onUp);
  })();
</script>

<style>
  .rank-stage {
    position: relative;
    overflow: clip;
    contain: content;
    color: #f4f1ea;
    background: #0d0f1a;
    touch-action: pan-y;
    padding: 2.75rem 0 3rem;
  }
  .rank-stage.is-live {
    touch-action: none;
  }
  .rank-beam {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: #f0622a;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }
  .rank-stage.is-live .rank-beam { opacity: 0.7; }
  .rank-inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .rank-eyebrow {
    margin: 0;
    color: #9aa3b5;
    font-size: 0.95rem;
  }
  .rank-num {
    margin: 0.35rem 0 0;
    font-size: clamp(4.5rem, 18vw, 8.5rem);
    line-height: 0.85;
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .rank-line {
    margin: 0.9rem 0 0;
    max-width: 22rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: #f0622a;
    min-height: 2.7em;
  }
  .rank-card {
    margin-top: 1.5rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.25rem;
    background: #121526;
    padding: 1.25rem 1.3rem 1.4rem;
  }
  .rank-card.is-lead { border-color: rgba(240,98,42,0.55); }
  .rank-url {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #9aa3b5;
  }
  .rank-title {
    margin: 0.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.3;
    color: #8ab4f8;
    font-weight: 600;
  }
  .rank-meta {
    margin: 0.5rem 0 0;
    color: #c5c9d4;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .rank-cta {
    display: inline-block;
    margin-top: 0.9rem;
    color: #f0622a;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .rank-cta[hidden] { display: none; }
</style>
