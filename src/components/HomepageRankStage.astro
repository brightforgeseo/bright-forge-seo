---
/**
 * Ranking as a material. Tap a position, or scroll while it is on screen.
 * Copy is Bright Forge homepage language, not a live rank claim.
 */
---

<section class="rank-stage" id="ranking-stage" data-rank-stage aria-label="How a search result earns an enquiry">
  <div class="rank-inner">
    <div class="rank-top">
      <p class="rank-kicker">How a result earns the click</p>
      <p class="rank-word" data-rank-word>Position 08</p>
    </div>

    <div class="rank-picks" role="tablist" aria-label="Search position">
      <button type="button" class="rank-pick is-on" data-rank-pick="0" aria-selected="true">08</button>
      <button type="button" class="rank-pick" data-rank-pick="1" aria-selected="false">06</button>
      <button type="button" class="rank-pick" data-rank-pick="2" aria-selected="false">03</button>
      <button type="button" class="rank-pick" data-rank-pick="3" aria-selected="false">01</button>
    </div>

    <div class="rank-grid">
      <div class="rank-copy">
        <p class="rank-eyebrow">A stranger is searching for an SEO agency in the Philippines.</p>
        <p class="rank-num" data-rank-num>08</p>
        <h2 class="rank-line"><span data-rank-line>Page eight. The enquiry never starts.</span></h2>
        <p class="rank-note">Not a live ranking. Tap 08 to 01. Vague copy loses. Named work and a next step win the enquiry.</p>
      </div>

      <article class="rank-card" data-rank-card>
        <p class="rank-url" data-rank-url>example.com/seo</p>
        <h3 class="rank-title" data-rank-title>Quality Solutions for Your Business</h3>
        <p class="rank-meta" data-rank-meta>We help brands unlock growth with digital strategies and dedicated support.</p>
        <a class="rank-cta" data-rank-cta href="/contact/" hidden>Request an SEO Review</a>
      </article>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-rank-stage]');
  if (root) {
    const stages = [
      {
        n: '08',
        word: 'Position 08',
        line: 'Page eight. The enquiry never starts.',
        url: 'example.com/seo',
        title: 'Quality Solutions for Your Business',
        meta: 'We help brands unlock growth with digital strategies and dedicated support.',
        lead: false
      },
      {
        n: '06',
        word: 'Position 06',
        line: 'People see you. They pick someone else.',
        url: 'example.com/seo-agency',
        title: 'SEO Services | Trusted Agency',
        meta: 'Full-service SEO, content and reporting for growing companies.',
        lead: false
      },
      {
        n: '03',
        word: 'Position 03',
        line: 'The job is named. Rankings are the means.',
        url: 'brightforge.com.ph',
        title: 'SEO Agency Philippines | Bright Forge',
        meta: 'Philippine SEO agency for businesses that need enquiries from search. Technical SEO, content and conversion work. Named team. Private proposal.',
        lead: false
      },
      {
        n: '01',
        word: 'Position 01',
        line: 'Enquiries are the job. The first screen has to take the click.',
        url: 'brightforge.com.ph',
        title: 'SEO Agency Philippines for Enquiries, Not Vanity Traffic',
        meta: 'British-led SEO, based in the Philippines. Request an SEO review. We will say if there is a fit.',
        lead: true
      }
    ];

    const num = root.querySelector('[data-rank-num]');
    const word = root.querySelector('[data-rank-word]');
    const line = root.querySelector('[data-rank-line]');
    const card = root.querySelector('[data-rank-card]');
    const title = root.querySelector('[data-rank-title]');
    const meta = root.querySelector('[data-rank-meta]');
    const url = root.querySelector('[data-rank-url]');
    const cta = root.querySelector('[data-rank-cta]');
    const picks = root.querySelectorAll('[data-rank-pick]');
    let cur = -1;

    function apply(i) {
      if (i === cur) return;
      cur = i;
      const s = stages[i];
      if (num) num.textContent = s.n;
      if (word) word.textContent = s.word;
      if (line) line.textContent = s.line;
      if (title) title.textContent = s.title;
      if (meta) meta.textContent = s.meta;
      if (url) url.textContent = s.url;
      if (cta) cta.hidden = !s.lead;
      if (card) card.classList.toggle('is-lead', s.lead);
      picks.forEach((btn, idx) => {
        const on = idx === i;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    picks.forEach((btn) => {
      btn.addEventListener('click', () => apply(Number(btn.getAttribute('data-rank-pick'))));
    });
    apply(0);
  }
</script>

<style>
  .rank-stage {
    position: relative;
    color: #f4f1ea;
    background: #0d0f1a;
    padding: 4rem 0 5rem;
  }
  .rank-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .rank-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .rank-kicker { color: #9aa3b5; }
  .rank-word { color: #f0622a; }
  .rank-picks {
    display: flex;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
  }
  .rank-pick {
    flex: 1;
    max-width: 4.5rem;
    border: 1px solid rgba(255,255,255,0.12);
    background: transparent;
    color: #9aa3b5;
    border-radius: 999px;
    padding: 0.55rem 0;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .rank-pick.is-on {
    background: #f0622a;
    border-color: #f0622a;
    color: #0d0f1a;
  }
  .rank-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .rank-grid { grid-template-columns: 1.15fr 0.85fr; align-items: end; }
  }
  .rank-eyebrow {
    margin: 0;
    color: #9aa3b5;
    font-size: 0.95rem;
  }
  .rank-num {
    margin: 0.2rem 0 0;
    font-size: clamp(4.2rem, 14vw, 8rem);
    line-height: 0.85;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .rank-line {
    margin: 1.1rem 0 0;
    max-width: 22rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .rank-line span { color: #f0622a; }
  .rank-note {
    margin: 1rem 0 0;
    max-width: 28rem;
    color: #9aa3b5;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .rank-card {
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.25rem;
    background: #121526;
    padding: 1.35rem 1.4rem 1.5rem;
  }
  .rank-card.is-lead { border-color: rgba(240,98,42,0.55); }
  .rank-url {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #9aa3b5;
  }
  .rank-title {
    margin: 0.55rem 0 0;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #8ab4f8;
    font-weight: 600;
  }
  .rank-meta {
    margin: 0.55rem 0 0;
    color: #c5c9d4;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .rank-cta {
    display: inline-block;
    margin-top: 1rem;
    color: #f0622a;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .rank-cta[hidden] { display: none; }
</style>
