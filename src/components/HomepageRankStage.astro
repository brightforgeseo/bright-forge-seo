---
/**
 * Ranking as a material. Pointer height sets the position.
 * Four states sit in the DOM. JS only flips data-on.
 * Copy is Bright Forge homepage language, not a live rank claim.
 */
---

<section class="rank-stage" id="ranking-stage" data-rank-stage data-on="0" aria-label="How a search result earns an enquiry">
  <div class="rank-beam" data-rank-beam hidden></div>
  <div class="rank-inner">
    <div class="rank-top">
      <p class="rank-kicker">Move to rank</p>
      <p class="rank-word">
        <span>Position 08</span>
        <span>Position 06</span>
        <span>Position 03</span>
        <span>Position 01</span>
      </p>
    </div>

    <div class="rank-grid">
      <div class="rank-copy">
        <p class="rank-eyebrow">Someone searching for an SEO agency in the Philippines has the results page open.</p>
        <p class="rank-num" aria-hidden="true">
          <span>08</span>
          <span>06</span>
          <span>03</span>
          <span>01</span>
        </p>
        <h2 class="rank-line">
          <span>Eighth result. The call never starts.</span>
          <span>They saw the listing. They chose a clearer title.</span>
          <span>The job is named: enquiries, not vanity traffic.</span>
          <span>Position one. The first screen still has to take the enquiry.</span>
        </h2>
        <p class="rank-note">Not a live ranking. Drag the number. Vague copy loses. Named work and a next step win the click.</p>
      </div>

      <div class="rank-cards">
        <article class="rank-card">
          <p class="rank-url">example.com/seo</p>
          <h3 class="rank-title">Quality Solutions for Your Business</h3>
          <p class="rank-meta">We help brands grow with digital strategies and a dedicated support team.</p>
        </article>
        <article class="rank-card">
          <p class="rank-url">example.com/seo-agency</p>
          <h3 class="rank-title">SEO Services | Trusted Agency</h3>
          <p class="rank-meta">Full-service SEO, content and reporting for growing companies.</p>
        </article>
        <article class="rank-card">
          <p class="rank-url">brightforge.com.ph</p>
          <h3 class="rank-title">SEO Agency Philippines | Bright Forge</h3>
          <p class="rank-meta">Philippine SEO agency for businesses that need enquiries from search. Technical SEO, content and conversion work. Named team.</p>
        </article>
        <article class="rank-card is-lead">
          <p class="rank-url">brightforge.com.ph</p>
          <h3 class="rank-title">SEO Agency Philippines for Enquiries, Not Vanity Traffic</h3>
          <p class="rank-meta">British-led SEO, based in the Philippines. Request an SEO review. We will say if there is a fit.</p>
          <a class="rank-cta" href="/contact/">Request an SEO Review</a>
        </article>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-rank-stage]');
    if (!root) return;
    var beam = root.querySelector('[data-rank-beam]');
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var cur = 0;
    var box = null;
    var y = null;
    var raf = 0;
    var live = fine;

    function measure() {
      box = root.getBoundingClientRect();
    }

    function tick() {
      raf = 0;
      if (y == null) return;
      if (!box) measure();
      var top = y - box.top;
      if (beam) {
        beam.hidden = false;
        beam.style.transform = 'translate3d(0,' + top + 'px,0)';
      }
      var t = top / Math.max(1, box.height);
      var i = t > 0.72 ? 0 : t > 0.5 ? 1 : t > 0.28 ? 2 : 3;
      if (i === cur) return;
      cur = i;
      root.setAttribute('data-on', String(i));
    }

    function move(e) {
      if (!live) return;
      if (e.target && e.target.closest && e.target.closest('a')) return;
      y = e.clientY;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    root.addEventListener('pointerdown', function (e) {
      live = true;
      measure();
      move(e);
    });
    root.addEventListener('pointerup', function () { if (!fine) live = false; });
    root.addEventListener('pointercancel', function () { if (!fine) live = false; });
    root.addEventListener('pointermove', move, { passive: true });
  })();
</script>

<style>
  .rank-stage {
    position: relative;
    overflow: clip;
    contain: layout style;
    color: #f4f1ea;
    background: #0d0f1a;
    touch-action: pan-y;
    padding: 2.5rem 0 3rem;
  }
  .rank-beam {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: #f0622a;
    opacity: 0.7;
    pointer-events: none;
    z-index: 2;
    will-change: transform;
  }
  .rank-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .rank-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .rank-kicker { color: #9aa3b5; }
  .rank-word {
    position: relative;
    color: #f0622a;
    min-width: 12ch;
    min-height: 1.2em;
  }
  .rank-word span {
    position: absolute;
    right: 0;
    top: 0;
    opacity: 0;
    visibility: hidden;
  }
  .rank-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 1201px) and (hover: hover) and (pointer: fine) {
    .rank-grid { grid-template-columns: 1.15fr 0.85fr; align-items: end; }
  }
  .rank-eyebrow {
    margin: 0;
    color: #9aa3b5;
    font-size: 0.95rem;
  }
  .rank-num {
    display: grid;
    margin: 0.2rem 0 0;
    font-size: clamp(5.5rem, 16vw, 11rem);
    line-height: 0.85;
    font-weight: 800;
    letter-spacing: -0.04em;
    touch-action: none;
    cursor: ns-resize;
    user-select: none;
  }
  .rank-num span {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
  }
  .rank-line {
    position: relative;
    margin: 1.1rem 0 0;
    min-height: 3.4em;
    max-width: 24rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .rank-line span {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    color: #f0622a;
    opacity: 0;
    visibility: hidden;
  }
  .rank-note {
    margin: 1rem 0 0;
    max-width: 28rem;
    color: #9aa3b5;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .rank-cards {
    display: grid;
    touch-action: none;
  }
  .rank-card {
    grid-area: 1 / 1;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.25rem;
    background: #121526;
    padding: 1.35rem 1.4rem 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .rank-card.is-lead { border-color: rgba(240,98,42,0.55); }
  .rank-url {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #9aa3b5;
  }
  .rank-title {
    margin: 0.55rem 0 0;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #8ab4f8;
    font-weight: 600;
  }
  .rank-meta {
    margin: 0.55rem 0 0;
    color: #c5c9d4;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .rank-cta {
    display: inline-block;
    margin-top: 1rem;
    color: #f0622a;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .rank-stage[data-on="0"] .rank-word span:nth-child(1),
  .rank-stage[data-on="0"] .rank-num span:nth-child(1),
  .rank-stage[data-on="0"] .rank-line span:nth-child(1),
  .rank-stage[data-on="0"] .rank-card:nth-child(1),
  .rank-stage[data-on="1"] .rank-word span:nth-child(2),
  .rank-stage[data-on="1"] .rank-num span:nth-child(2),
  .rank-stage[data-on="1"] .rank-line span:nth-child(2),
  .rank-stage[data-on="1"] .rank-card:nth-child(2),
  .rank-stage[data-on="2"] .rank-word span:nth-child(3),
  .rank-stage[data-on="2"] .rank-num span:nth-child(3),
  .rank-stage[data-on="2"] .rank-line span:nth-child(3),
  .rank-stage[data-on="2"] .rank-card:nth-child(3),
  .rank-stage[data-on="3"] .rank-word span:nth-child(4),
  .rank-stage[data-on="3"] .rank-num span:nth-child(4),
  .rank-stage[data-on="3"] .rank-line span:nth-child(4),
  .rank-stage[data-on="3"] .rank-card:nth-child(4) {
    opacity: 1;
    visibility: visible;
  }
  .rank-stage[data-on="3"] .rank-card:nth-child(4) {
    pointer-events: auto;
  }
</style>
