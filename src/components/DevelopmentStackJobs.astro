---
const { eyebrow = 'In this stack', title, intro, jobs } = Astro.props;
---

<section class="stack-work">
  <div class="page-container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 set:html={title} />
    {intro && <p class="stack-intro">{intro}</p>}
    <div class="stack-jobs">
      {jobs.map((job) => (
        <article>
          <h3>{job.title}</h3>
          <p>{job.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-work { padding: 78px 0; background: #0d0f1a; }
  .stack-work .page-container {
    width: min(100% - 40px, 1120px);
    margin: 0 auto;
  }
  .stack-intro { max-width: 46rem; margin: 0 0 28px; }
  .stack-jobs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .stack-jobs article {
    padding: 1.4rem 1.2rem 1.4rem 0;
    border-top: 1px solid rgba(255,255,255,.12);
    background: transparent;
  }
  .stack-jobs article:nth-child(2n) { border-right: 0; }
  .stack-jobs h3 { margin: 0 0 8px; font-size: 1.05rem; color: #fff; }
  .stack-jobs p { margin: 0; color: rgba(255,255,255,.72); line-height: 1.6; }
  @media (max-width: 800px) {
    .stack-jobs { grid-template-columns: 1fr; }
    .stack-jobs article { border-right: 0; }
  }
</style>
