---
// Privacy-safe first-touch/current-touch attribution and lead-event tracking.
// Stores campaign context only. No form values or personal data are persisted.
---

<script is:inline>
  (() => {
    const FIRST_TOUCH_KEY = 'bf_first_touch_v1';
    const PENDING_LEAD_KEY = 'bf_pending_lead_v1';
    const FIRST_TOUCH_TTL_MS = 90 * 24 * 60 * 60 * 1000;
    const ATTRIBUTION_FIELDS = [
      'landing_page',
      'page_path',
      'referrer',
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'first_touch_landing_page',
      'first_touch_referrer',
      'first_touch_utm_source',
      'first_touch_utm_medium',
      'first_touch_utm_campaign'
    ];

    const safeStorage = {
      get(store, key) {
        try { return window[store].getItem(key); } catch { return null; }
      },
      set(store, key, value) {
        try { window[store].setItem(key, value); } catch { /* Storage may be blocked. */ }
      },
      remove(store, key) {
        try { window[store].removeItem(key); } catch { /* Storage may be blocked. */ }
      }
    };

    // Retire the old native-submit marker. It never proved server acceptance.
    safeStorage.remove('sessionStorage', PENDING_LEAD_KEY);
    const query = new URLSearchParams(window.location.search);
    const privacy = window.BFAttributionPrivacy;
    // If the early privacy guard fails, retain native forms without collecting.
    if (!privacy) return;
    const sanitiseUrl = privacy.safeUrl;
    const sanitiseUtm = privacy.safeUtm;
    const currentTouch = {
      landing_page: sanitiseUrl(window.location.href),
      page_path: privacy.safePath(window.location.pathname),
      referrer: sanitiseUrl(document.referrer, true),
      utm_source: sanitiseUtm('utm_source', query.get('utm_source')),
      utm_medium: sanitiseUtm('utm_medium', query.get('utm_medium')),
      utm_campaign: sanitiseUtm('utm_campaign', query.get('utm_campaign')),
      utm_term: sanitiseUtm('utm_term', query.get('utm_term')),
      utm_content: sanitiseUtm('utm_content', query.get('utm_content'))
    };

    let firstTouch;
    try {
      firstTouch = JSON.parse(safeStorage.get('localStorage', FIRST_TOUCH_KEY) || 'null');
    } catch {
      firstTouch = null;
    }

    const firstTouchExpired = !Number.isFinite(firstTouch?.captured_at) || firstTouch.captured_at > Date.now() || (Date.now() - firstTouch.captured_at) > FIRST_TOUCH_TTL_MS;
    if (!firstTouch || firstTouchExpired) {
      firstTouch = {
        landing_page: currentTouch.landing_page,
        referrer: currentTouch.referrer,
        utm_source: currentTouch.utm_source,
        utm_medium: currentTouch.utm_medium,
        utm_campaign: currentTouch.utm_campaign,
        captured_at: Date.now()
      };
    }

    // Revalidate previously stored values as well as the incoming URL.
    firstTouch = {
      landing_page: sanitiseUrl(firstTouch.landing_page),
      referrer: sanitiseUrl(firstTouch.referrer, true),
      utm_source: sanitiseUtm('utm_source', firstTouch.utm_source),
      utm_medium: sanitiseUtm('utm_medium', firstTouch.utm_medium),
      utm_campaign: sanitiseUtm('utm_campaign', firstTouch.utm_campaign),
      captured_at: firstTouch.captured_at
    };
    safeStorage.set('localStorage', FIRST_TOUCH_KEY, JSON.stringify(firstTouch));

    const attribution = {
      ...currentTouch,
      first_touch_landing_page: firstTouch.landing_page || '',
      first_touch_referrer: firstTouch.referrer || '',
      first_touch_utm_source: firstTouch.utm_source || '',
      first_touch_utm_medium: firstTouch.utm_medium || '',
      first_touch_utm_campaign: firstTouch.utm_campaign || ''
    };

    const track = (eventName, eventParams = {}) => {
      const payload = {
        page_path: privacy.safePath(window.location.pathname),
        ...eventParams
      };

      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, payload);
        return;
      }

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName, ...payload });
    };

    const ensureHiddenField = (form, name) => {
      let input = form.elements.namedItem(name);
      if (!input || input instanceof RadioNodeList) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        form.appendChild(input);
      }
      return input;
    };

    const populateAttribution = (form) => {
      ATTRIBUTION_FIELDS.forEach((name) => {
        const input = ensureHiddenField(form, name);
        input.value = attribution[name] || '';
      });
    };

    const forms = [...document.querySelectorAll('form[data-lead-form]')];
    forms.forEach((form) => {
      populateAttribution(form);
      let started = false;
      let submitting = false;
      let accepted = false;
      const formName = form.getAttribute('name') || form.id || 'website-form';

      form.addEventListener('focusin', (event) => {
        const target = event.target;
        if (started || !(target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLTextAreaElement)) return;
        if (target.type === 'hidden' || target.name === 'bot-field') return;
        started = true;
        track('lead_form_start', { form_name: formName });
      });

      form.addEventListener('submit', async (event) => {
        // With no JavaScript/fetch, the original Netlify POST/action stays usable.
        if (typeof window.fetch !== 'function') return;
        event.preventDefault();
        if (submitting || accepted) return;
        if (!form.reportValidity()) return;
        populateAttribution(form);
        safeStorage.remove('sessionStorage', PENDING_LEAD_KEY);
        submitting = true;
        const buttons = [...form.querySelectorAll('button[type="submit"],input[type="submit"]')];
        const previousDisabled = buttons.map(button => button.disabled);
        buttons.forEach(button => { button.disabled = true; });
        form.setAttribute('aria-busy', 'true');
        let error = form.querySelector('[data-submit-error]');
        if (!error) {
          error = document.createElement('p');
          error.dataset.submitError = '';
          error.setAttribute('role', 'alert');
          error.tabIndex = -1;
          form.appendChild(error);
        }
        error.hidden = true;
        error.textContent = '';
        track('lead_form_submit', { form_name: formName });
        try {
          const body = new URLSearchParams();
          new FormData(form).forEach((value, name) => {
            if (typeof value === 'string') body.append(name, value);
          });
          const response = await window.fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
            credentials: 'same-origin'
          });
          if (!response.ok) throw new Error('Form was not accepted');
          accepted = true;
          track('generate_lead', { form_name: formName, transport_type: 'beacon' });
          window.location.assign('/thanks/');
        } catch {
          safeStorage.remove('sessionStorage', PENDING_LEAD_KEY);
          error.textContent = 'Your enquiry could not be sent. Your details are still here. Please try again, or use the contact details on this page.';
          error.hidden = false;
          error.focus();
        } finally {
          submitting = false;
          if (!accepted) buttons.forEach((button, index) => { button.disabled = previousDisabled[index]; });
          form.removeAttribute('aria-busy');
        }
      });
    });

    const refreshAttribution = () => forms.forEach(populateAttribution);
    const scheduleAttributionRefresh = () => {
      window.requestAnimationFrame(refreshAttribution);
      window.setTimeout(refreshAttribution, 250);
      window.setTimeout(refreshAttribution, 1500);
    };

    window.addEventListener('load', scheduleAttributionRefresh, { once: true });
    window.addEventListener('pageshow', scheduleAttributionRefresh);
    scheduleAttributionRefresh();

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a,button') : null;
      if (!link) return;

      const href = link instanceof HTMLAnchorElement ? link.getAttribute('href') || '' : '';
      const explicitEvent = link.getAttribute('data-analytics-event');

      if (explicitEvent) {
        if (/^[a-z_]{1,64}$/.test(explicitEvent)) track(explicitEvent, { destination: sanitiseUrl(href) });
      } else if (href.startsWith('tel:')) {
        track('phone_click');
      } else if (href.startsWith('mailto:')) {
        track('email_click');
      }
    });

    // A visit to /thanks/ is presentation only, never conversion evidence.

    window.BFLeadTracking = { track, attribution, refreshAttribution };
  })();
</script>
