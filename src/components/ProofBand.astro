---
// Proof directly under the hero of every service, country and sector page:
// published case results with one clear figure each, a named public review, and the Clutch listings.
import { proofBand } from '../lib/proofBand';
const band = proofBand(Astro.url.pathname);
const awards = [
  { img: '/images/awards/top-clutch-seo-company-philippines-2025-288.webp', label: 'Top SEO Company, Clutch Philippines 2025', href: 'https://clutch.co/ph/seo-firms/international' },
  { img: '/images/awards/top-clutch-seo-company-manila-2025-288.webp', label: 'Top SEO Company Manila, Clutch 2025', href: 'https://clutch.co/ph/seo-firms/manila' },
  { img: '/images/awards/top-clutch-seo-company-ecommerce-philippines-288.webp', label: 'Top E-commerce SEO Company, Clutch Philippines', href: 'https://clutch.co/ph/seo-firms/ecommerce-industry/manila' },
];
---
{band && (
<section class="proof-band" aria-labelledby="proof-band-title">
  <div class="proof-band-wrap">
    <header class="proof-band-head">
      <div>
        <p class="proof-band-kicker">Published evidence</p>
        <h2 id="proof-band-title">Results you can <span>check for yourself</span></h2>
      </div>
      <p>Each figure is organic search clicks as reported in Google Search Console, and each case study states its comparison period and exactly what the data covers. <a href="/case-studies/">See all 25 case studies</a>.</p>
    </header>
    <ul class:list={['proof-band-cases', { 'proof-band-cases--2': band.cases.length === 2 }]}>
      {band.cases.map((c) => (
        <li>
          <a class="proof-case" href={c.href}>
            <span class="proof-case-shot"><img src={c.image} alt={c.alt} width="640" height="360" loading="lazy" decoding="async" /></span>
            <span class="proof-case-body">
              <span class="proof-case-sector">{c.sector}</span>
              <strong class="proof-case-name">{c.name}</strong>
              <span class="proof-case-figure">{c.pct ? <b>{c.pct}</b> : <b class="proof-case-range">{c.range}</b>}<span>{c.pct ? `organic clicks: ${c.range}` : 'organic clicks'}</span></span>
              <span class="proof-case-period">{c.period}.</span>
              <span class="proof-case-more">Read the case study <span aria-hidden="true">↗</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="proof-band-trust">
      <figure class="proof-review">
        <svg class="proof-review-mark" width="34" height="26" viewBox="0 0 34 26" aria-hidden="true"><path d="M0 26V15.6C0 6.9 4.6 1.6 13 0l1.4 3.6C9.800 5 7.6 7.6 7.4 11H14v15H0Zm19.6 0V15.600C19.600 6.900 24.200 1.600 32.600 0L34 3.600C29.400 5 27.200 7.600 27 11h6.600v15h-14Z" fill="currentColor"/></svg>
        <blockquote><p>{band.review.quote}</p></blockquote>
        <figcaption><strong>{band.review.name}</strong><span>{band.review.meta} · public Google review</span><a href={band.review.href} target="_blank" rel="noopener noreferrer" data-analytics-event="review_source_click">Read it on Google <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
      <div class="proof-recognition">
        <p class="proof-band-kicker">Recognition</p>
        <ul>
          {awards.map((a) => (
            <li><a href={a.href} target="_blank" rel="noopener noreferrer" data-analytics-event="clutch_evidence_click"><img src={a.img} alt="" width="56" height="56" loading="lazy" decoding="async" /><span>{a.label}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
)}
<style>
.proof-band { background:#fff; padding:clamp(40px,5vw,72px) 0 clamp(44px,5.5vw,80px); border-top:1px solid #eceef1; font-family:'Inter',sans-serif; color:#18202b; }
.proof-band-wrap { width:min(100% - 48px,1308px); margin-inline:auto; }
.proof-band-head { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:24px 56px; align-items:end; margin-bottom:clamp(24px,3vw,40px); }
.proof-band-kicker { display:inline-flex; align-items:center; gap:10px; margin:0 0 14px; font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#a63c15; }
.proof-band-kicker::before { content:''; width:22px; height:2px; border-radius:2px; background:#f0622a; }
.proof-band h2 { margin:0; font-family:'Outfit','Inter',sans-serif; font-size:clamp(2rem,3.4vw,3rem); font-weight:800; line-height:1.05; letter-spacing:-.035em; color:#18202b; }
.proof-band-head > p { margin:0; font-size:16px; line-height:1.65; color:#3f4a59; max-width:54ch; }
.proof-band-head a { color:#a63c15; font-weight:600; text-underline-offset:3px; }
.proof-band-cases { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin:0; padding:0; list-style:none; }
.proof-band-cases--2 { grid-template-columns:repeat(2,minmax(0,1fr)); }
.proof-case { display:flex; flex-direction:column; height:100%; overflow:hidden; border:1px solid #e3e6ea; border-radius:20px; background:#fff; color:inherit; text-decoration:none; box-shadow:0 1px 2px rgb(24 32 43 / 4%),0 10px 24px -16px rgb(24 32 43 / 22%); transition:transform .28s cubic-bezier(.2,.7,.2,1),box-shadow .28s cubic-bezier(.2,.7,.2,1),border-color .28s; }
.proof-case-shot { display:block; padding:14px 14px 0; background:#f6f7f9; border-bottom:1px solid #eceef1; }
.proof-case-shot img { display:block; width:100%; aspect-ratio:16/9; height:auto; object-fit:contain; object-position:center top; border:1px solid #e3e6ea; border-bottom:0; border-radius:10px 10px 0 0; background:#fff; }
.proof-case-body { display:flex; flex-direction:column; flex:1; padding:20px 22px 22px; }
.proof-case-sector { font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#5c6675; }
.proof-case-name { margin-top:4px; font-family:'Outfit','Inter',sans-serif; font-size:1.25rem; font-weight:700; letter-spacing:-.02em; line-height:1.2; }
.proof-case-figure { display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 12px; margin-top:14px; }
.proof-case-figure b { font-family:'Outfit','Inter',sans-serif; font-size:clamp(2.4rem,3.6vw,3.25rem); font-weight:800; letter-spacing:-.045em; line-height:1; color:#cf4b1c; font-variant-numeric:tabular-nums; }
.proof-case-figure b.proof-case-range { font-size:clamp(1.7rem,2.4vw,2.1rem); letter-spacing:-.035em; }
.proof-case-figure > span { font-size:14px; font-weight:600; color:#18202b; font-variant-numeric:tabular-nums; }
.proof-case-period { margin-top:8px; font-size:14px; line-height:1.55; color:#5c6675; }
.proof-case-more { margin-top:auto; padding-top:16px; font-size:14px; font-weight:600; color:#a63c15; }
.proof-case-more span { display:inline-block; transition:transform .2s; }
.proof-case:focus-visible { outline:3px solid #b83e12; outline-offset:3px; }
@media(hover:hover) and (prefers-reduced-motion:no-preference) { .proof-case:hover { transform:translateY(-4px); border-color:#f3c9b4; box-shadow:0 2px 4px rgb(24 32 43 / 6%),0 26px 44px -24px rgb(64 32 13 / 38%); }.proof-case:hover .proof-case-more span { transform:translate(3px,-3px); } }
.proof-band-trust { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:16px; margin-top:16px; }
.proof-review { position:relative; margin:0; padding:28px 30px 26px; border-radius:20px; background:#18202b; color:#fff; overflow:hidden; }
.proof-review::after { content:''; position:absolute; right:-80px; top:-120px; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgb(240 98 42 / 30%),transparent 68%); pointer-events:none; }
.proof-review-mark { color:#f0622a; margin-bottom:14px; }
.proof-review blockquote { margin:0; padding:0; border:0; background:none; }
.proof-review blockquote p { margin:0; font-family:'Outfit','Inter',sans-serif; font-size:clamp(1.2rem,1.9vw,1.6rem); font-weight:500; line-height:1.38; letter-spacing:-.015em; color:#fff; max-width:34em; }
.proof-review figcaption { position:relative; z-index:1; display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 14px; margin-top:20px; font-size:14px; color:#c3cad4; }
.proof-review figcaption strong { color:#fff; font-weight:600; font-size:15px; }
.proof-review figcaption a { margin-left:auto; color:#ff9a70; font-weight:600; text-underline-offset:3px; }
.proof-recognition { padding:24px 26px; border:1px solid #e3e6ea; border-radius:20px; background:#f6f7f9; }
.proof-recognition ul { display:grid; gap:10px; margin:0; padding:0; list-style:none; }
.proof-recognition a { display:flex; align-items:center; gap:14px; color:#18202b; font-size:14px; font-weight:600; line-height:1.35; text-decoration:none; }
.proof-recognition a:hover span { text-decoration:underline; text-underline-offset:3px; }
.proof-recognition img { width:48px; height:48px; object-fit:contain; flex:none; }
@media(max-width:1024px) { .proof-band-head { grid-template-columns:1fr; align-items:start; }.proof-band-trust { grid-template-columns:1fr; } }
@media(max-width:860px) { .proof-band-cases,.proof-band-cases--2 { grid-template-columns:1fr; }.proof-case { flex-direction:column; } }
@media(min-width:561px) and (max-width:860px) { .proof-case { flex-direction:row; }.proof-case-shot { flex:0 0 42%; padding:14px 0 14px 14px; border-bottom:0; border-right:1px solid #eceef1; display:flex; align-items:center; }.proof-case-shot img { border-bottom:1px solid #e3e6ea; border-radius:10px; } }
@media(max-width:560px) { .proof-band-wrap { width:min(100% - 40px,1308px); }.proof-review { padding:24px 22px; }.proof-review figcaption a { margin-left:0; flex-basis:100%; } }
</style>
