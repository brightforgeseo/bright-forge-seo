---
interface Props { id: string; eyebrow: string; title: string; emphasis: string; }
const { id, eyebrow, title, emphasis } = Astro.props;
---
<section id={id} class="buyer-decision" aria-labelledby={`${id}-heading`}>
  <div class="decision-shell">
    <header><p class="decision-eyebrow">{eyebrow}</p><h2 id={`${id}-heading`}>{title} <span>{emphasis}</span></h2></header>
    <div class="decision-body"><slot /></div>
  </div>
</section>
<style>
.buyer-decision { padding:clamp(3.5rem,7vw,6rem) 1.5rem; background:#0d0f1a; color:#c8cbd5; }
.decision-shell { max-width:1200px; margin:auto; display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(2rem,5vw,5rem); border-top:1px solid #f0622a66; padding-top:2rem; }
.decision-eyebrow { font-size:.75rem; font-weight:700; letter-spacing:.15em; text-transform:uppercase; color:#f0622a; margin:0 0 1rem; }
h2 { font-family:'Outfit',sans-serif; font-weight:800; font-size:clamp(1.8rem,3vw,2.8rem); line-height:1.15; color:#fff; margin:0; }
h2 span { color:#f0622a; }
.decision-body { font-size:1rem; line-height:1.8; }
.decision-body :global(p) { margin:0 0 1.25rem; }
.decision-body :global(dl) { margin:1.5rem 0; }
.decision-body :global(dt) { color:#fff; font-weight:700; padding-top:1rem; border-top:1px solid #ffffff18; }
.decision-body :global(dd) { margin:0 0 1rem; }
.decision-body :global(a) { color:#f0622a; text-decoration:underline; text-underline-offset:.2em; }
.decision-body :global(a:focus-visible) { outline:2px solid #f0622a; outline-offset:4px; }
@media(max-width:760px) { .decision-shell { grid-template-columns:1fr; gap:1.75rem; } }
</style>
