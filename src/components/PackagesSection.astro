---
const offers = [
  {
    index: '01',
    eyebrow: 'DIAGNOSE',
    icon: 'fa-search',
    title: 'SEO Diagnostic & 90-Day Roadmap',
    summary: 'A defined review of the technical, content, authority and conversion issues most likely to limit qualified organic growth.',
    bestFor: 'Businesses that need evidence and priorities before committing to ongoing SEO.',
    model: 'Scoped diagnostic project',
    includes: [
      'Technical, content and commercial opportunity review',
      'Priority roadmap with impact and implementation detail',
      'Search, conversion and measurement baseline',
      'Senior findings review and recommended next step'
    ],
    href: '/seo-audit-services/',
    cta: 'Explore the audit scope',
    featured: true
  },
  {
    index: '02',
    eyebrow: 'PROTECT',
    icon: 'fa-route',
    title: 'Migration & Ranking Recovery Support',
    summary: 'Pre-launch protection or post-launch diagnosis for businesses changing domains, platforms, templates or site architecture.',
    bestFor: 'Website migrations, redesigns, unexplained traffic loss and high-risk technical changes.',
    model: 'Pre-launch or recovery scope',
    includes: [
      'Baseline crawl and priority-page inventory',
      'Redirect, canonical, indexation and staging checks',
      'Launch monitoring and post-change validation',
      'Recovery priorities tied to evidence'
    ],
    href: '/website-migration-services/',
    cta: 'Discuss migration support'
  },
  {
    index: '03',
    eyebrow: 'STRENGTHEN',
    icon: 'fa-robot',
    title: 'AI Search Visibility Assessment',
    summary: 'An evidence-led assessment of whether your entities, content, schema and proof give search and answer engines strong material to understand and cite.',
    bestFor: 'Established sites that already have SEO foundations and need an AI-search readiness plan.',
    model: 'Standalone assessment',
    includes: [
      'Entity and service-understanding review',
      'Content structure and answer-readiness checks',
      'Schema, sourceworthiness and proof gaps',
      'Prioritised actions that support SEO first'
    ],
    href: '/ai-search-optimization-services-philippines/',
    cta: 'Review AI-search readiness'
  },
  {
    index: '04',
    eyebrow: 'GROW',
    icon: 'fa-chart-line',
    title: 'Ongoing SEO Growth Programme',
    summary: 'Senior strategy and governed delivery across technical SEO, content, authority, conversion and reporting, scoped around the site and market.',
    bestFor: 'Businesses with clear growth goals, implementation capacity and a need for sustained SEO ownership.',
    model: 'Monthly programme after fit review',
    includes: [
      'Quarterly priorities and monthly implementation plan',
      'Technical, content, CRO and authority work',
      'SEO Management Sheet with accountable actions',
      'Reporting tied to visibility, enquiries and next steps'
    ],
    href: '/contact/',
    cta: 'Discuss an ongoing programme'
  }
];
---

<section id="packages" class="offers-section">
  <div class="offers-shell">
    <div class="offers-intro">
      <div class="offers-heading">
        <span class="section-badge"><i class="fas fa-compass" aria-hidden="true"></i> CHOOSE THE RIGHT START</span>
        <h2>Start with the problem, <span>not a block of hours</span>.</h2>
      </div>
      <div class="offers-copy">
        <p>SEO scope should reflect the commercial problem, technical risk, current evidence and implementation capacity. We review fit first, define the work clearly and only recommend an ongoing programme when it is justified.</p>
        <div class="offer-principles" aria-label="How Bright Forge scopes SEO work">
          <span>Defined deliverables</span>
          <span>Suitability criteria</span>
          <span>Evidence before activity</span>
        </div>
      </div>
    </div>

    <div class="offers-grid">
      {offers.map((offer) => (
        <article class:list={['offer-card', { featured: offer.featured }]}>
          <div class="offer-topline">
            <span class="offer-index">{offer.index}</span>
            <span class="offer-eyebrow">{offer.eyebrow}</span>
            {offer.featured && <span class="offer-flag">Recommended first step</span>}
          </div>

          <div class="offer-title-row">
            <div class="offer-icon" aria-hidden="true"><i class={`fas ${offer.icon}`}></i></div>
            <h3>{offer.title}</h3>
          </div>

          <p class="offer-summary">{offer.summary}</p>

          <div class="offer-fit">
            <span>BEST FOR</span>
            <p>{offer.bestFor}</p>
          </div>

          <ul class="offer-list">
            {offer.includes.map((item) => (
              <li><i class="fas fa-check" aria-hidden="true"></i><span>{item}</span></li>
            ))}
          </ul>

          <div class="offer-footer">
            <div class="offer-model"><span>Commercial model</span><strong>{offer.model}</strong></div>
            <a href={offer.href} class="offer-cta" data-analytics-event={`offer_${offer.index}_cta`}>
              {offer.cta}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="offers-final">
      <div>
        <span class="offers-final-label">NOT SURE WHICH ROUTE FITS?</span>
        <h3>Describe the site, market and main commercial problem.</h3>
        <p>We will recommend the narrowest sensible next step. That may be a diagnostic, a migration scope, an AI-search assessment or an ongoing programme.</p>
      </div>
      <a href="/contact/" class="offers-final-cta" data-analytics-event="offers_final_review_cta">Request an SEO review</a>
    </div>
  </div>
</section>

<style>
  .offers-section {
    background:
      radial-gradient(circle at 82% 18%, rgba(240, 98, 42, 0.08), transparent 30%),
      #0d0f1a;
    padding: clamp(4.5rem, 8vw, 7rem) 1.25rem;
  }

  .offers-shell {
    width: min(1200px, 100%);
    margin: 0 auto;
  }

  .offers-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.75fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: end;
    margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(240, 98, 42, 0.22);
    border-radius: 999px;
    background: rgba(240, 98, 42, 0.08);
    color: #f0622a;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .offers-heading h2 {
    margin: 0;
    max-width: 760px;
    color: #f7f8fc;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.4rem, 5.5vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .offers-heading h2 span {
    color: #f0622a;
  }

  .offers-copy > p {
    margin: 0 0 1.5rem;
    color: #c7cada;
    font-size: 1.05rem;
    line-height: 1.72;
  }

  .offer-principles {
    display: grid;
    gap: 0.65rem;
  }

  .offer-principles span {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #e8eaf2;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .offer-principles span::before {
    content: '';
    width: 18px;
    height: 2px;
    background: #f0622a;
    box-shadow: 0 0 12px rgba(240, 98, 42, 0.45);
  }

  .offers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .offer-card {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 1.35rem;
    background: linear-gradient(150deg, rgba(25, 29, 48, 0.96), rgba(15, 18, 31, 0.98));
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.24);
    padding: clamp(1.45rem, 3vw, 2.25rem);
  }

  .offer-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, #f0622a, rgba(240, 98, 42, 0));
    opacity: 0.55;
  }

  .offer-card.featured {
    border-color: rgba(240, 98, 42, 0.32);
    box-shadow: 0 26px 70px rgba(240, 98, 42, 0.09);
  }

  .offer-topline {
    display: flex;
    min-height: 28px;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.6rem;
  }

  .offer-index {
    color: #6f758e;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .offer-eyebrow {
    color: #f0622a;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .offer-flag {
    margin-left: auto;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #f0622a;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .offer-title-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .offer-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(240, 98, 42, 0.22);
    border-radius: 0.9rem;
    background: rgba(240, 98, 42, 0.09);
    color: #f0622a;
  }

  .offer-title-row h3 {
    margin: 0;
    color: #f4f5fa;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 750;
    line-height: 1.12;
  }

  .offer-summary {
    margin: 0 0 1.4rem;
    color: #c8cbda;
    line-height: 1.65;
  }

  .offer-fit {
    margin-bottom: 1.4rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid #f0622a;
    background: rgba(255, 255, 255, 0.025);
  }

  .offer-fit > span,
  .offer-model > span {
    display: block;
    margin-bottom: 0.28rem;
    color: #f0622a;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .offer-fit p {
    margin: 0;
    color: #e5e7ef;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .offer-list {
    display: grid;
    gap: 0.72rem;
    margin: 0 0 1.8rem;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    color: #d8dae5;
    font-size: 0.91rem;
    line-height: 1.48;
  }

  .offer-list i {
    margin-top: 0.18rem;
    color: #f0622a;
    font-size: 0.72rem;
  }

  .offer-footer {
    display: grid;
    gap: 1.15rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .offer-model strong {
    color: #f1f2f7;
    font-size: 0.9rem;
  }

  .offer-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.6rem;
    color: #f0622a;
    font-weight: 800;
    text-decoration: none;
  }

  .offer-cta:hover,
  .offer-cta:focus-visible {
    color: #ff8a56;
  }

  .offers-final {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    margin-top: 1.25rem;
    padding: clamp(1.5rem, 3.5vw, 2.6rem);
    border: 1px solid rgba(240, 98, 42, 0.24);
    border-radius: 1.35rem;
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.1), rgba(19, 22, 39, 0.96) 48%);
  }

  .offers-final-label {
    color: #f0622a;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .offers-final h3 {
    margin: 0.45rem 0;
    color: #fff;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .offers-final p {
    max-width: 790px;
    margin: 0;
    color: #c8cbda;
    line-height: 1.6;
  }

  .offers-final-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    background: #f0622a;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 12px 30px rgba(240, 98, 42, 0.2);
  }

  .offers-final-cta:hover,
  .offers-final-cta:focus-visible {
    background: #ff7440;
  }

  @media (max-width: 900px) {
    .offers-intro,
    .offers-final {
      grid-template-columns: 1fr;
    }

    .offers-grid {
      grid-template-columns: 1fr;
    }

    .offers-final-cta {
      width: fit-content;
    }
  }

  @media (max-width: 560px) {
    .offers-section {
      padding-inline: 1rem;
    }

    .offers-heading h2 {
      font-size: clamp(2.15rem, 12vw, 3rem);
    }

    .offer-card {
      border-radius: 1.05rem;
      padding: 1.25rem;
    }

    .offer-topline {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .offer-flag {
      width: 100%;
      margin-left: 0;
      text-align: center;
    }

    .offer-title-row {
      grid-template-columns: 42px minmax(0, 1fr);
    }

    .offer-icon {
      width: 42px;
      height: 42px;
    }

    .offers-final-cta {
      width: 100%;
    }
  }
</style>
