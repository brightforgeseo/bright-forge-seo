---
// Props with defaults
const {
  badge = "",
  title = "REVENUE BOOSTING SEO",
  subtitle = "Generate More Leads",
  description = "More traffic is a win, but the right traffic truly drives your bottom line. Our SEO focus zeros in on prospects actively seeking the products or services you provide, laying the groundwork for meaningful conversions."
} = Astro.props;

const features = [
  {
    title: "Which Searches Count as Buying Searches",
    description: "Before anything is measured, we map purchase and enquiry searches to the products and services you sell. A category comparison, a repair request and a branded product search are counted separately, because growth in one says little about the others."
  },
  {
    title: "What an Organic Enquiry Costs You",
    description: "Where tracking allows, we compare the cost of organic acquisition with confirmed enquiries or orders. That figure helps you decide whether to improve existing pages, expand coverage or put the next budget somewhere else entirely."
  },
  {
    title: "How You Compare With the Pages Above You",
    description: "We inspect the pages competing for your priority searches: their offer, their supporting evidence and the useful detail they give a buyer. The gaps become a page plan with named URLs: a short list of pages worth improving, in place of more content for its own sake."
  },
  {
    title: "Calls, Forms and Confirmed Sales",
    description: "We check that call and form tracking fires correctly, distinguish repeat events from real enquiries, and use your sales records where you can share them. A report then shows three separate lines: search visibility, tracked actions and confirmed business outcomes."
  }
];
---

<div class="bg-[#ffffff] py-16 px-4">
  <div class="max-w-7xl mx-auto">

    <!-- Decorative dots -->
    <div class="flex gap-2 mb-8">
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
    </div>

    <!-- Main heading -->
    <div class="mb-8">
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight mb-4" style="font-family: 'Outfit', sans-serif; font-weight: 800;">
        {title}
      </h2>
      <h3 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6" style="font-family: 'Outfit', sans-serif; font-weight: 800;">
        {subtitle}
      </h3>
    </div>

    <!-- Description -->
    <p class="text-lg text-[#465365] leading-relaxed mb-12 max-w-4xl">
      {description}
    </p>

    <!-- Feature grid -->
    <div class="revenue-grid">
      {features.map((feature) => (
        <div class="revenue-card">
          <h4 class="text-xl font-bold text-slate-900 mb-3">
            {feature.title}
          </h4>
          <p class="text-[#465365] leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</div>

<style>
  .revenue-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .revenue-card {
    background: #f7f8fa;
    border: 1px solid rgba(25, 33, 46, 0.07);
    border-left: 4px solid #f0622a;
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.5rem 1.75rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .revenue-card:hover {
    background: rgba(240,98,42,0.08);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(25, 33, 46, 0.09);
  }

  @media (max-width: 768px) {
    .revenue-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Add hover effects with JavaScript for better browser support
  document.addEventListener('DOMContentLoaded', () => {
    const featureCards = document.querySelectorAll('.revenue-card');

    featureCards.forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.backgroundColor = 'rgba(240,98,42,0.08)';
        this.style.transform = 'scale(1.02)';
      });

      card.addEventListener('mouseleave', function() {
        this.style.backgroundColor = '#131627';
        this.style.transform = 'scale(1)';
      });
    });
  });
</script>
