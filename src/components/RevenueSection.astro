---
// Props with defaults
const {
  badge = "",
  title = "REVENUE BOOSTING SEO",
  subtitle = "Generate More Leads",
  description = "More traffic is a win, but the right traffic truly drives your bottom line. Our SEO focus zeros in on prospects actively seeking the products or services you provide, laying the groundwork for meaningful conversions."
} = Astro.props;

const features = [
  {
    title: "Attract Buyers, Not Just Browsers",
    description: "We map purchase and enquiry searches to the products and services you sell. A category comparison needs different content from a repair request or a branded product search."
  },
  {
    title: "Assess Customer Acquisition Costs",
    description: "We compare organic acquisition costs with confirmed enquiries or orders where tracking allows. That helps you decide whether to improve existing pages, expand coverage or put the next budget elsewhere."
  },
  {
    title: "Outperform Competitors in Search",
    description: "We inspect the pages competing for your priority searches: their offer, supporting evidence and useful detail. The gaps become a page plan, rather than a request to publish more of everything."
  },
  {
    title: "Track What Matters to Your Bottom Line",
    description: "We check call and form tracking, distinguish repeat events from enquiries, and use sales records where available. Reports separate search visibility, tracked actions and confirmed business outcomes."
  }
];
---

<div class="bg-[#ffffff] py-16 px-4">
  <div class="max-w-7xl mx-auto">

    <!-- Decorative dots -->
    <div class="flex gap-2 mb-8">
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
      <div class="w-3 h-3 bg-[#f0622a] rounded-full"></div>
    </div>

    <!-- Main heading -->
    <div class="mb-8">
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight mb-4" style="font-family: 'Outfit', sans-serif; font-weight: 800;">
        {title}
      </h2>
      <h3 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6" style="font-family: 'Outfit', sans-serif; font-weight: 800;">
        {subtitle}
      </h3>
    </div>

    <!-- Description -->
    <p class="text-lg text-[#465365] leading-relaxed mb-12 max-w-4xl">
      {description}
    </p>

    <!-- Feature grid -->
    <div class="revenue-grid">
      {features.map((feature) => (
        <div class="revenue-card">
          <h4 class="text-xl font-bold text-slate-900 mb-3">
            {feature.title}
          </h4>
          <p class="text-[#465365] leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</div>

<style>
  .revenue-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .revenue-card {
    background: #f7f8fa;
    border: 1px solid rgba(25, 33, 46, 0.07);
    border-left: 4px solid #f0622a;
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.5rem 1.75rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .revenue-card:hover {
    background: rgba(240,98,42,0.08);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(25, 33, 46, 0.09);
  }

  @media (max-width: 768px) {
    .revenue-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Add hover effects with JavaScript for better browser support
  document.addEventListener('DOMContentLoaded', () => {
    const featureCards = document.querySelectorAll('.revenue-card');

    featureCards.forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.backgroundColor = 'rgba(240,98,42,0.08)';
        this.style.transform = 'scale(1.02)';
      });

      card.addEventListener('mouseleave', function() {
        this.style.backgroundColor = '#131627';
        this.style.transform = 'scale(1)';
      });
    });
  });
</script>
