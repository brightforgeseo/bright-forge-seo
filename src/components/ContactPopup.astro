---
// ContactPopup.astro  - Timed popup form for SEO lead capture
---

<div id="contact-popup-overlay" class="popup-overlay" aria-hidden="true">
  <div class="popup-card" role="dialog" aria-modal="true" aria-labelledby="popup-title" aria-describedby="popup-description" tabindex="-1">
    <button type="button" class="popup-close" id="popup-close" aria-label="Close popup">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="popup-header">
      <div class="popup-badge">
        <span class="badge-dot"></span>
        <span>Preliminary SEO Review</span>
      </div>
      <h2 id="popup-title">Request an <span>SEO Review</span></h2>
      <p id="popup-description">Tell us about your website and priorities. We start with a preliminary SEO review of the obvious search and conversion signals before recommending work.</p>
    </div>

    <form name="popup-contact" method="POST" data-netlify="true" data-lead-form="popup-contact" netlify-honeypot="bot-field" action="/thanks/">
      <input type="hidden" name="form-name" value="popup-contact" />
      <input type="hidden" name="landing_page" value="" />
      <input type="hidden" name="page_path" value="" />
      <input type="hidden" name="referrer" value="" />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="utm_term" value="" />
      <input type="hidden" name="utm_content" value="" />
      <input type="hidden" name="first_touch_landing_page" value="" />
      <input type="hidden" name="first_touch_referrer" value="" />
      <input type="hidden" name="first_touch_utm_source" value="" />
      <input type="hidden" name="first_touch_utm_medium" value="" />
      <input type="hidden" name="first_touch_utm_campaign" value="" />
      <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="form-row">
        <div class="form-group">
          <label for="popup-name">Your name *</label>
          <input id="popup-name" type="text" name="name" placeholder="Your Name" required autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="popup-email">Email address *</label>
          <input id="popup-email" type="email" name="email" placeholder="Email Address" required autocomplete="email" />
        </div>
      </div>

      <div class="form-group">
        <label for="popup-phone">Phone number (optional)</label>
        <input id="popup-phone" type="tel" name="phone" placeholder="Phone Number (optional)" autocomplete="tel" />
      </div>

      <div class="form-group">
        <label for="popup-message">Tell us about your project</label>
        <textarea id="popup-message" name="message" rows="3" placeholder="Tell us about your project..."></textarea>
      </div>

      <button type="submit" class="popup-submit">
        <span>Request an SEO Review</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <p class="popup-privacy">Read our <a href="/privacy-policy/">privacy policy</a> before sending your enquiry.</p>
    </form>
  </div>
</div>

<script is:inline>
(function() {
  const POPUP_DELAY = 45000;
  const STORAGE_KEY = 'popupShown';
  const overlay = document.getElementById('contact-popup-overlay');
  const dialog = overlay?.querySelector('[role="dialog"]');
  if (!overlay || !dialog) return;
  let previousFocus;
  let previousOverflow = '';
  const inerted = [];
  const focusable = () => [...dialog.querySelectorAll('a[href],button:not([disabled]),input:not([type="hidden"]),textarea,select')]
    .filter(el => !el.closest('.hidden-field') && !el.disabled);

  function shouldShow() {
    if (window.location.pathname.startsWith('/contact')) return false;
    if (window.location.hash === '#contact') return false;
    try { return !sessionStorage.getItem(STORAGE_KEY); } catch { return true; }
  }
  function markSuppressed() {
    try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch { /* Optional storage. */ }
  }
  function showPopup() {
    // A contact CTA can suppress an already-scheduled popup.
    if (!shouldShow()) return;
    previousFocus = document.activeElement;
    previousOverflow = document.body.style.overflow;
    let branch = overlay;
    while (branch.parentElement && branch.parentElement !== document.documentElement) {
      [...branch.parentElement.children].forEach(el => {
        if (el !== branch && !['SCRIPT', 'STYLE', 'LINK'].includes(el.tagName)) {
          inerted.push([el, el.inert]); el.inert = true;
        }
      });
      branch = branch.parentElement;
    }
    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    document.getElementById('popup-close').focus({ preventScroll: true });
    // Inert/visibility updates need a rendered frame before Chromium can focus.
    window.requestAnimationFrame?.(() => {
      if (overlay.classList.contains('active')) document.getElementById('popup-close').focus({ preventScroll: true });
    });
    markSuppressed();
  }
  function closePopup() {
    if (!overlay.classList.contains('active')) return;
    overlay.classList.remove('active');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = previousOverflow;
    inerted.splice(0).forEach(([el, value]) => { el.inert = value; });
    const restoreTarget = previousFocus?.isConnected ? previousFocus : document.body;
    const needsTabindex = restoreTarget === document.body && !restoreTarget.hasAttribute('tabindex');
    if (needsTabindex) restoreTarget.setAttribute('tabindex', '-1');
    restoreTarget.focus({ preventScroll: true });
    if (needsTabindex) restoreTarget.removeAttribute('tabindex');
  }
  if (shouldShow()) setTimeout(showPopup, POPUP_DELAY);

  function initialise() {
    document.getElementById('popup-close').addEventListener('click', closePopup);
    overlay.addEventListener('click', e => { if (e.target === overlay) closePopup(); });
    document.querySelectorAll('a[href^="/contact"], a[href="#contact"]').forEach(link => link.addEventListener('click', markSuppressed));
    document.addEventListener('keydown', e => {
      if (!overlay.classList.contains('active')) return;
      if (e.key === 'Escape') { e.preventDefault(); closePopup(); }
      if (e.key === 'Tab') {
        const items = focusable(), first = items[0], last = items[items.length - 1];
        if (e.shiftKey && (document.activeElement === first || !dialog.contains(document.activeElement))) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && (document.activeElement === last || !dialog.contains(document.activeElement))) {
          e.preventDefault(); first.focus();
        }
      }
    });
    document.addEventListener('focusin', e => {
      if (overlay.classList.contains('active') && !dialog.contains(e.target)) focusable()[0].focus();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialise, { once: true });
  else initialise();
})();
</script>

<style>
  .popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(25, 33, 46, 0.09);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  .popup-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .popup-card {
    background: #f7f8fa;
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgba(25, 33, 46, 0.07);
    border-radius: 20px;
    padding: 40px;
    max-width: 520px;
    width: 100%;
    position: relative;
    box-shadow: 0 30px 80px rgba(25, 33, 46, 0.09);
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .popup-overlay.active .popup-card {
    transform: translateY(0);
  }

  .popup-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-radius: 10px;
    color: #465365;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .popup-close:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #19212e;
  }

  .popup-header {
    margin-bottom: 28px;
    text-align: center;
  }

  .popup-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(240, 98, 42, 0.12);
    border: 1px solid rgba(240, 98, 42, 0.25);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    color: #19212e;
    margin-bottom: 16px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .popup-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.625rem;
    font-weight: 800;
    color: #19212e;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .popup-header p {
    font-size: 0.9375rem;
    color: #465365;
    line-height: 1.5;
  }

  .hidden-field {
    display: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-group {
    margin-bottom: 12px;
  }

  .form-group label { display: block; font-weight: 600; font-size: .875rem; color: #19212e; margin-bottom: 6px; }
  .popup-privacy { font-size: .8rem; line-height: 1.5; margin-top: 12px; color: #465365; }
  .popup-privacy a { color: #b83e12; text-decoration: underline; }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: #ffffff;
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-radius: 12px;
    color: #19212e;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    transition: all 0.2s ease;
    outline: none;
    box-sizing: border-box;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #465365;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #f0622a;
    box-shadow: 0 0 0 3px rgba(240, 98, 42, 0.15);
    background: #f7f8fa;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 80px;
  }

  .popup-submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.1), rgba(240, 98, 42, 0.05));
    border: 1px solid rgba(240, 98, 42, 0.15);
    color: #b83e12;
    border-radius: 100px;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 4px;
  }

  .popup-submit:hover {
    transform: translateY(-2px);
    border-color: rgba(240, 98, 42, 0.4);
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.15), rgba(240, 98, 42, 0.08));
  }

  .popup-submit svg {
    transition: transform 0.3s ease;
  }

  .popup-submit:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 560px) {
    .popup-card {
      padding: 28px 20px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .popup-header h2 {
      font-size: 1.375rem;
    }
  }
</style>
