---
/**
 * Homepage middle: pick who you are, then pick the search problem.
 * No fake CTR claims. No keyword-target lists.
 */
const fits = [
  {
    id: "ph",
    title: "Philippine businesses",
    blurb: "Local and national companies that need stronger service pages and more qualified enquiries.",
    next: [
      { n: "01", t: "We check the pages people already search.", d: "Service pages, locations, Google Business Profile and whether the site can take a call." },
      { n: "02", t: "We find why enquiries are not landing.", d: "Weak titles, missing proof, broken mobile contact, or the wrong page ranking." },
      { n: "03", t: "We map the next 90 days.", d: "What to fix first, what can wait, and what we will not invent." },
      { n: "04", t: "We only scope if there is a fit.", d: "No generic package if the site needs something more specific." },
    ],
  },
  {
    id: "intl",
    title: "International companies",
    blurb: "Brands targeting the Philippines, or using a Philippines team for delivery they can still control.",
    next: [
      { n: "01", t: "We check the market, not just the CMS.", d: "Which country the searchers are in, which URLs should own that demand, and whether tracking is honest." },
      { n: "02", t: "We separate delivery from ownership.", d: "You keep the brief, the reviews and what goes live. We do the technical, content and reporting work." },
      { n: "03", t: "We map work against paid, not vanity traffic.", d: "If ads already buy the click, SEO has to earn the enquiry cheaper over time." },
      { n: "04", t: "We quote the actual workload.", d: "Hours follow the competition. We do not publish a fake cheap package." },
    ],
  },
  {
    id: "agency",
    title: "Agency partners",
    blurb: "White-label SEO when you need fulfilment without hiring a full in-house team.",
    next: [
      { n: "01", t: "We review the client site as your team.", d: "Audit, gaps and a plan you can put in front of the client without our name on it." },
      { n: "02", t: "We keep reporting usable.", d: "Rankings, Search Console, calls and forms, plus what should happen next." },
      { n: "03", t: "We stay in your process.", d: "Your Slack, your sheet, your client call. We do not poach." },
      { n: "04", t: "We scope per client.", d: "One overloaded retainer for five sites is how white label goes bad." },
    ],
  },
  {
    id: "commerce",
    title: "Service and ecommerce teams",
    blurb: "Businesses where rankings only matter if they lead to calls, quotes, bookings or sales.",
    next: [
      { n: "01", t: "We start with the money URLs.", d: "Services, categories and products before a content calendar." },
      { n: "02", t: "We check the path after the click.", d: "Offer, proof, stock, forms and whether anyone can actually buy or enquire." },
      { n: "03", t: "We keep catalogue crawl under control.", d: "Filters and duplicates should not eat the pages that sell." },
      { n: "04", t: "We report against the action.", d: "Clicks without add-to-cart, quote or call tracking are incomplete." },
    ],
  },
];

const problems = [
  {
    id: "buried",
    label: "We do not rank",
    kicker: "Visibility",
    title: "The page is not in the fight yet.",
    copy: "If Google cannot crawl it, trust it or tell it apart from weaker URLs, strangers never see you. We fix the foundations before we write more pages.",
    work: ["Crawl and indexation", "Which URL owns the job", "Service-page structure", "Content gaps that are real", "Authority, not spam links"],
  },
  {
    id: "ignored",
    label: "We rank, no clicks",
    kicker: "Selection",
    title: "People see you. They pick someone else.",
    copy: "Position 6 with almost no clicks is a trust problem, not a missing blog. The title, description and proof have to make a stranger choose you.",
    work: ["Title and description that say the job", "Brand people can recognise", "Reviews and proof near the result", "The right page, not the homepage for everything"],
  },
  {
    id: "bounce",
    label: "Clicks, no leads",
    kicker: "Conversion",
    title: "The visit happened. The enquiry did not.",
    copy: "Traffic is wasted when the landing page is vague. Offer, proof and a clear next step have to sit on the same screen as the promise that won the click.",
    work: ["What you actually sell, above the fold", "Proof next to the decision", "Call, form or quote path that works on a phone", "Tracking that can tell organic from ads"],
  },
];
---

<section class="lab" id="search-to-lead" data-lab>
  <div class="lab-inner">
    <p class="lab-label">Who this is for</p>
    <h2>Pick the kind of business. Then pick the <span>search problem</span>.</h2>
    <p class="lab-lead">The globe shows we can build. This bit shows we know why SEO traffic fails commercially. Tap through. Nothing here is a ranking promise.</p>

    <div class="fit-switch" role="tablist" aria-label="Who we help">
      {fits.map((fit, i) => (
        <button type="button" class:list={["fit-btn", i === 0 && "is-on"]} role="tab" aria-selected={i === 0 ? "true" : "false"} data-fit={fit.id}>{fit.title}</button>
      ))}
    </div>

    {fits.map((fit, i) => (
      <div class:list={["fit-panel", i === 0 && "is-on"]} data-fit-panel={fit.id} hidden={i !== 0}>
        <p class="fit-blurb">{fit.blurb}</p>
        <ol class="fit-steps">
          {fit.next.map((step) => (
            <li><span>{step.n}</span><div><strong>{step.t}</strong><p>{step.d}</p></div></li>
          ))}
        </ol>
      </div>
    ))}
  </div>

  <div class="lab-stage">
    <p class="lab-label">Search to lead</p>
    <h2>Where the work actually <span>breaks</span></h2>

    <div class="problem-switch" role="tablist" aria-label="Search problem">
      {problems.map((problem, i) => (
        <button type="button" class:list={["problem-btn", i === 0 && "is-on"]} role="tab" aria-selected={i === 0 ? "true" : "false"} data-problem={problem.id}>{problem.label}</button>
      ))}
    </div>

    <div class="problem-grid">
      <div class="board" aria-live="polite">
        <div class="scene is-on" data-scene="buried">
          <p class="scene-kicker">Page eight energy</p>
          <ol class="serp">
            <li class="ghost"><b>Competitor already chosen</b><i>example.com</i></li>
            <li class="ghost"><b>Directory with reviews</b><i>lists.example</i></li>
            <li class="you"><b>Your service page, if it ranks at all</b><i>yoursite.com/services</i><em>Too far down to get the click.</em></li>
          </ol>
        </div>

        <div class="scene" data-scene="ignored" hidden>
          <p class="scene-kicker">Same position. Different reason to click.</p>
          <article class="result weak">
            <p class="result-url">brightforge.com.ph</p>
            <h3>Bright Forge SEO | Growth &amp; Digital Solutions</h3>
            <p>We help brands unlock sustainable growth with holistic digital strategies.</p>
            <span>Vague. Could be anyone.</span>
          </article>
          <article class="result strong">
            <p class="result-url">brightforge.com.ph</p>
            <h3>SEO Agency Philippines | Bright Forge</h3>
            <p>Philippine SEO agency for businesses that need enquiries from search. Named team. Private proposal.</p>
            <span>Says the job. Gives a reason to click.</span>
          </article>
        </div>

        <div class="scene" data-scene="bounce" hidden>
          <p class="scene-kicker">Turn the page layers on.</p>
          <div class="landing" data-landing>
            <button type="button" class="layer-btn is-on" data-layer="offer">Offer</button>
            <button type="button" class="layer-btn" data-layer="proof">Proof</button>
            <button type="button" class="layer-btn" data-layer="cta">Next step</button>
            <div class="landing-card">
              <p class="landing-offer is-on" data-layer-copy="offer">We do SEO.</p>
              <p class="landing-offer" data-layer-copy="proof" hidden>Published cases. Named specialists. Search Console in the open.</p>
              <p class="landing-offer" data-layer-copy="cta" hidden>Request a review. We will say if there is a fit.</p>
              <div class="landing-cta" data-cta hidden>Get a review</div>
            </div>
          </div>
        </div>
      </div>

      {problems.map((problem, i) => (
        <div class:list={["explain", i === 0 && "is-on"]} data-explain={problem.id} hidden={i !== 0}>
          <p class="scene-kicker">{problem.kicker}</p>
          <h3>{problem.title}</h3>
          <p>{problem.copy}</p>
          <ul>
            {problem.work.map((item) => <li>{item}</li>)}
          </ul>
          <a href="/contact/">Request an SEO review</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.lab {
  background: #0d0f1a;
  color: #f4f1ea;
  padding: 0 1.25rem 5rem;
}
.lab-inner,
.lab-stage {
  width: min(100%, 1120px);
  margin: 0 auto;
}
.lab-stage {
  margin-top: 4.5rem;
  padding: clamp(1.75rem, 4vw, 2.75rem);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 28px;
  background: #111421;
  box-shadow: 0 24px 70px rgba(0,0,0,.28);
}
.lab-label {
  display: block;
  color: #f0622a;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .12em;
  text-transform: uppercase;
  margin: 0 0 10px;
}
.lab h2 {
  color: #f4f1ea;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.02;
  letter-spacing: -.04em;
  margin: 0 0 1rem;
}
.lab h2 span { color: #f0622a; }
.lab-lead,
.fit-blurb,
.explain p,
.explain li {
  color: #9aa3b5;
  font-size: 1.05rem;
  line-height: 1.7;
}
.lab-lead { max-width: 62ch; margin: 0 0 1.75rem; }
.fit-switch,
.problem-switch {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0 0 1.5rem;
}
.fit-btn,
.problem-btn,
.layer-btn {
  min-height: 44px;
  padding: .7rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.16);
  background: transparent;
  color: #f4f1ea;
  font-weight: 800;
  cursor: pointer;
}
.fit-btn.is-on,
.problem-btn.is-on,
.layer-btn.is-on {
  background: #f0622a;
  border-color: #f0622a;
  color: #0d0f1a;
}
.fit-panel[hidden],
.scene[hidden],
.explain[hidden],
.landing-offer[hidden],
.landing-cta[hidden] { display: none; }
.fit-steps {
  list-style: none;
  margin: 1.25rem 0 0;
  padding: 0;
  display: grid;
  gap: 12px;
}
.fit-steps li {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 1rem;
  padding: 1rem 0 1rem .2rem;
  border-left: 2px solid rgba(240,98,42,.55);
  padding-left: 1rem;
}
.fit-steps span {
  color: #f0622a;
  font-weight: 900;
  font-size: 1.15rem;
}
.fit-steps strong { color: #f4f1ea; display: block; margin-bottom: .2rem; }
.fit-steps p { margin: 0; color: #9aa3b5; }
.problem-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, .9fr);
  gap: clamp(1.5rem, 4vw, 2.5rem);
  align-items: start;
}
.board {
  min-height: 280px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 22px;
  padding: 1.25rem;
  background: #0d0f1a;
}
.scene-kicker {
  color: #f0622a;
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin: 0 0 1rem;
}
.serp { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.serp li {
  padding: .85rem 1rem;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.08);
}
.serp .ghost { opacity: .72; }
.serp b { display: block; color: #f4f1ea; }
.serp i { color: #9aa3b5; font-style: normal; font-size: .85rem; }
.serp em { display: block; color: #f0622a; font-style: normal; margin-top: .35rem; }
.serp .you { border-color: rgba(240,98,42,.45); opacity: 1; }
.result {
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.1);
  margin-bottom: 12px;
}
.result-url { color: #9aa3b5; font-size: .82rem; margin: 0 0 .25rem; }
.result h3 { margin: 0 0 .35rem; font-size: 1.05rem; color: #f4f1ea; }
.result p { margin: 0 0 .5rem; color: #9aa3b5; font-size: .95rem; }
.result span { color: #f0622a; font-size: .82rem; font-weight: 800; }
.result.weak { opacity: .55; }
.result.strong { border-color: rgba(240,98,42,.4); }
.landing { display: flex; flex-wrap: wrap; gap: 8px; }
.landing-card {
  flex: 1 1 100%;
  margin-top: 12px;
  min-height: 140px;
  border-radius: 16px;
  border: 1px dashed rgba(255,255,255,.2);
  padding: 1.25rem;
}
.landing-offer { margin: 0; color: #f4f1ea; font-size: 1.2rem; font-weight: 800; }
.landing-cta {
  margin-top: 1rem;
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  padding: 0 1rem;
  border-radius: 999px;
  background: #f0622a;
  color: #0d0f1a;
  font-weight: 900;
}
.explain h3 { margin: 0 0 .75rem; font-size: 1.35rem; }
.explain ul { margin: 1rem 0; padding-left: 1.1rem; }
.explain a {
  color: #f0622a;
  font-weight: 800;
}
@media (max-width: 900px) {
  .problem-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .fit-btn, .problem-btn, .layer-btn { transition: none; }
}
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-lab]");
    if (!root) return;

    function on(group, attr, value) {
      root.querySelectorAll(group).forEach(function (el) {
        var match = el.getAttribute(attr) === value;
        el.classList.toggle("is-on", match);
        if (el.hasAttribute("hidden") || el.hasAttribute("data-fit-panel") || el.hasAttribute("data-explain") || el.hasAttribute("data-scene")) {
          if (match) el.removeAttribute("hidden");
          else el.setAttribute("hidden", "");
        }
        if (el.getAttribute("role") === "tab") el.setAttribute("aria-selected", match ? "true" : "false");
      });
    }

    root.querySelectorAll("[data-fit]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-fit");
        root.querySelectorAll("[data-fit]").forEach(function (b) {
          var match = b === btn;
          b.classList.toggle("is-on", match);
          b.setAttribute("aria-selected", match ? "true" : "false");
        });
        root.querySelectorAll("[data-fit-panel]").forEach(function (panel) {
          var match = panel.getAttribute("data-fit-panel") === id;
          panel.classList.toggle("is-on", match);
          if (match) panel.removeAttribute("hidden");
          else panel.setAttribute("hidden", "");
        });
      });
    });

    root.querySelectorAll("[data-problem]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-problem");
        root.querySelectorAll("[data-problem]").forEach(function (b) {
          var match = b === btn;
          b.classList.toggle("is-on", match);
          b.setAttribute("aria-selected", match ? "true" : "false");
        });
        root.querySelectorAll("[data-scene]").forEach(function (scene) {
          var match = scene.getAttribute("data-scene") === id;
          scene.classList.toggle("is-on", match);
          if (match) scene.removeAttribute("hidden");
          else scene.setAttribute("hidden", "");
        });
        root.querySelectorAll("[data-explain]").forEach(function (box) {
          var match = box.getAttribute("data-explain") === id;
          box.classList.toggle("is-on", match);
          if (match) box.removeAttribute("hidden");
          else box.setAttribute("hidden", "");
        });
      });
    });

    root.querySelectorAll("[data-layer]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-layer");
        root.querySelectorAll("[data-layer]").forEach(function (b) {
          b.classList.toggle("is-on", b === btn);
        });
        root.querySelectorAll("[data-layer-copy]").forEach(function (copy) {
          var match = copy.getAttribute("data-layer-copy") === id;
          if (match) copy.removeAttribute("hidden");
          else copy.setAttribute("hidden", "");
        });
        var cta = root.querySelector("[data-cta]");
        if (cta) {
          if (id === "cta") cta.removeAttribute("hidden");
          else cta.setAttribute("hidden", "");
        }
      });
    });
  })();
</script>
