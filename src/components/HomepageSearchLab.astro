---
/**
 * Homepage middle: pick who you are, then pick the search problem.
 * No fake CTR claims. No keyword-target lists.
 */
const fits = [
  {
    id: "ph",
    title: "Philippine businesses",
    blurb: "Local and national companies whose service pages are found too rarely, or found and then not acted on.",
    next: [
      { n: "01", t: "We check the pages people already search for.", d: "Service pages, location pages and your Google Business Profile, plus one basic test: can a visitor on a phone call you from the page they land on?" },
      { n: "02", t: "We find where the enquiry is being lost.", d: "A title that says nothing, missing proof, a contact form that fails on mobile, or the wrong page ranking for the search." },
      { n: "03", t: "We map the next 90 days.", d: "What to fix first, what can wait, and where we have no evidence yet and will say so." },
      { n: "04", t: "We only scope the work if there is a fit.", d: "The proposal covers what this site needs. If that is one technical fix and two rewritten pages, that is what we quote." },
    ],
  },
  {
    id: "intl",
    title: "International companies",
    blurb: "Brands targeting the Philippines, and overseas companies that want a Philippines-based team while keeping control of the brief.",
    next: [
      { n: "01", t: "We check the market before the website.", d: "Which country the searchers are in, which URLs should answer that demand, and whether your tracking counts real enquiries." },
      { n: "02", t: "We separate delivery from ownership.", d: "You keep the brief, the approvals and the final say on what goes live. We do the technical, content and reporting work." },
      { n: "03", t: "We weigh organic search against what you already pay for.", d: "If ads already buy the click, SEO has to earn the same enquiry for less over time. We plan the work with that comparison in view." },
      { n: "04", t: "We quote the actual workload.", d: "The proposal follows the size of the site and the strength of the competition, in a billing currency agreed with you. There is no public rate card." },
    ],
  },
  {
    id: "agency",
    title: "Agency partners",
    blurb: "White-label SEO for agencies that need delivery capacity without hiring a full in-house team.",
    next: [
      { n: "01", t: "We review the client site as part of your team.", d: "An audit, the gaps and a plan you can put in front of your client under your own brand." },
      { n: "02", t: "We keep the reporting usable.", d: "Rankings, Search Console, calls and forms, plus the work completed and what should happen next, ready for you to present." },
      { n: "03", t: "We stay inside your process.", d: "Your channels, your sheet, your client call. Client contact stays with your agency unless we both agree otherwise." },
      { n: "04", t: "We scope each client separately.", d: "One stretched retainer spread across five sites is how white label goes wrong, so every site gets its own brief." },
    ],
  },
  {
    id: "commerce",
    title: "Service and ecommerce teams",
    blurb: "Businesses that judge search by calls, quotes, bookings and orders.",
    next: [
      { n: "01", t: "We start with the pages that take the money.", d: "Service, category and product pages come first. A content calendar comes later, if at all." },
      { n: "02", t: "We check the path after the click.", d: "The offer, the proof, stock, forms, and whether a visitor can complete a purchase or an enquiry without help." },
      { n: "03", t: "We keep catalogue crawling under control.", d: "Filter pages and duplicates should never crowd out the pages that sell, so we decide which URLs Google is asked to index." },
      { n: "04", t: "We report against the action.", d: "A click total with no add-to-cart, quote or call tracking beside it is an incomplete report, so tracking is checked early." },
    ],
  },
];

const problems = [
  {
    id: "buried",
    label: "We do not rank",
    kicker: "Visibility",
    title: "The page is not in the fight yet.",
    copy: "If Google cannot crawl the page, trust it or tell it apart from weaker URLs on your own site, strangers never see you. We repair those foundations first. Writing more pages comes after.",
    work: ["Crawl and indexation checks", "One URL chosen to answer each search", "Service-page structure", "Content gaps confirmed in Search Console", "Links from sites your customers read"],
  },
  {
    id: "ignored",
    label: "We rank, no clicks",
    kicker: "Selection",
    title: "People see you. They choose someone else.",
    copy: "Few clicks from position 6 is a question to investigate before anything is rewritten. We compare query mix, device and SERP features, then check whether your title and description answer what the searcher asked.",
    work: ["A title and description that say what the page offers", "A brand name people can recognise", "Reviews and proof visible beside the result", "The specific page ranking, in place of the homepage"],
  },
  {
    id: "bounce",
    label: "Clicks, no leads",
    kicker: "Conversion",
    title: "The visit happened. The enquiry did not.",
    copy: "A vague landing page wastes the visit you worked to win. The offer, the proof and a clear next step have to sit on the same screen as the promise that earned the click.",
    work: ["What you sell, stated at the top of the page", "Proof placed next to the decision", "A call, form or quote path that works on a phone", "Tracking that separates organic visits from ads"],
  },
];
---

<section class="lab" id="search-to-lead" data-lab>
  <div class="lab-inner">
    <p class="lab-label">How we diagnose</p>
    <h2>Pick your kind of business. See <span>what we check first</span>.</h2>
    <p class="lab-lead">A diagnosis for a Manila service company starts in a different place from one for an overseas brand, an agency partner or an online shop. Choose the description closest to you to see the four checks we run before we propose any work. Below that, choose the symptom you recognise to see what usually causes it.</p>

    <div class="fit-switch" role="tablist" aria-label="Who we help">
      {fits.map((fit, i) => (
        <button type="button" class:list={["fit-btn", i === 0 && "is-on"]} role="tab" aria-selected={i === 0 ? "true" : "false"} data-fit={fit.id}>{fit.title}</button>
      ))}
    </div>

    {fits.map((fit, i) => (
      <div class:list={["fit-panel", i === 0 && "is-on"]} data-fit-panel={fit.id} hidden={i !== 0}>
        <p class="fit-blurb">{fit.blurb}</p>
        {fit.id === 'intl' && (
          <p class="fit-market-links">Explore SEO for <a href="/seo-services-uk/">UK businesses</a>, <a href="/seo-services-usa/">US businesses</a> and <a href="/seo-services-australia/">Australian businesses</a>.</p>
        )}
        <ol class="fit-steps">
          {fit.next.map((step) => (
            <li><span>{step.n}</span><div><strong>{step.t}</strong><p>{step.d}</p></div></li>
          ))}
        </ol>
      </div>
    ))}
  </div>

  <div class="lab-stage">
    <p class="lab-label">Three symptoms, three causes</p>
    <h2>Where the route from search to enquiry <span>breaks</span></h2>

    <div class="problem-switch" role="tablist" aria-label="Search problem">
      {problems.map((problem, i) => (
        <button type="button" class:list={["problem-btn", i === 0 && "is-on"]} role="tab" aria-selected={i === 0 ? "true" : "false"} data-problem={problem.id}>{problem.label}</button>
      ))}
    </div>

    <div class="problem-grid">
      <div class="board" aria-live="polite">
        <div class="scene is-on" data-scene="buried">
          <p class="scene-kicker">What the searcher sees first</p>
          <ol class="serp">
            <li class="ghost"><b>A competitor the searcher has already heard of</b><i>Their service page, near the top</i></li>
            <li class="ghost"><b>A directory listing with star ratings</b><i>Dozens of reviews shown beside it</i></li>
            <li class="you"><b>Your service page, if it ranks at all</b><i>Several results further down</i><em>Too far down to get the click.</em></li>
          </ol>
        </div>

        <div class="scene" data-scene="ignored" hidden>
          <p class="scene-kicker">Same position. Different reason to click.</p>
          <article class="result weak">
            <p class="result-url">A title that could belong to any agency</p>
            <h3>Home | Growth &amp; Digital Solutions</h3>
            <p>Welcome to our website. We help brands grow online with a full range of digital services.</p>
            <span>Vague. Could be anyone, selling anything.</span>
          </article>
          <article class="result strong">
            <p class="result-url">brightforge.com.ph</p>
            <h3>SEO Agency Philippines | Bright Forge</h3>
            <p>Bright Forge is an SEO agency in Quezon City led by Ben Lowe, with 15+ years in search. Named team and 25 published case studies. Request an SEO review.</p>
            <span>This page's own title and description. It says what we are, where, and who leads the work.</span>
          </article>
        </div>

        <div class="scene" data-scene="bounce" hidden>
          <p class="scene-kicker">Add one layer at a time.</p>
          <div class="landing" data-landing>
            <button type="button" class="layer-btn is-on" data-layer="offer">Offer</button>
            <button type="button" class="layer-btn" data-layer="proof">Proof</button>
            <button type="button" class="layer-btn" data-layer="cta">Next step</button>
            <div class="landing-card">
              <p class="landing-offer is-on" data-layer-copy="offer">An offer on its own: "We do SEO."</p>
              <p class="landing-offer" data-layer-copy="proof" hidden>Add proof: 25 published cases, a named team, Search Console figures in the open.</p>
              <p class="landing-offer" data-layer-copy="cta" hidden>Add the next step: request a review, and we will tell you if there is a fit.</p>
              <div class="landing-cta" data-cta hidden>Get a review</div>
            </div>
          </div>
        </div>
      </div>

      {problems.map((problem, i) => (
        <div class:list={["explain", i === 0 && "is-on"]} data-explain={problem.id} hidden={i !== 0}>
          <p class="scene-kicker">{problem.kicker}</p>
          <h3>{problem.title}</h3>
          <p>{problem.copy}</p>
          <ul>
            {problem.work.map((item) => <li>{item}</li>)}
          </ul>
          <a href="/contact/">Request an SEO review</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.fit-market-links a {
  color: #b83e12;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.fit-market-links a:hover { color: #19212e; }

.lab {
  background: #ffffff;
  color: #465365;
  padding: 0 1.25rem 5rem;
}
.lab-inner,
.lab-stage {
  width: min(100%, 1120px);
  margin: 0 auto;
}
.lab-stage {
  margin-top: 4.5rem;
  padding: clamp(1.75rem, 4vw, 2.75rem);
  border: 1px solid rgba(25, 33, 46, 0.09);
  border-radius: 28px;
  background: #ffffff;
  box-shadow: 0 24px 70px rgba(25, 33, 46, 0.09);
}
.lab-label {
  display: block;
  color: #b83e12;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .12em;
  text-transform: uppercase;
  margin: 0 0 10px;
}
.lab h2 {
  color: #465365;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.02;
  letter-spacing: -.04em;
  margin: 0 0 1rem;
}
.lab h2 span { color: #b83e12; }
.lab-lead,
.fit-blurb,
.explain p,
.explain li {
  color: #596779;
  font-size: 1.05rem;
  line-height: 1.7;
}
.lab-lead { max-width: 62ch; margin: 0 0 1.75rem; }
.fit-switch,
.problem-switch {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0 0 1.5rem;
}
.fit-btn,
.problem-btn,
.layer-btn {
  min-height: 44px;
  padding: .7rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  background: transparent;
  color: #465365;
  font-weight: 800;
  cursor: pointer;
}
.fit-btn.is-on,
.problem-btn.is-on,
.layer-btn.is-on {
  background: #f0622a;
  border-color: #f0622a;
  color: #0d0f1a;
}
.fit-panel[hidden],
.scene[hidden],
.explain[hidden],
.landing-offer[hidden],
.landing-cta[hidden] { display: none; }
.fit-steps {
  list-style: none;
  margin: 1.25rem 0 0;
  padding: 0;
  display: grid;
  gap: 12px;
}
.fit-steps li {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 1rem;
  padding: 1rem 0 1rem .2rem;
  border-left: 2px solid rgba(240,98,42,.55);
  padding-left: 1rem;
}
.fit-steps span {
  color: #b83e12;
  font-weight: 900;
  font-size: 1.15rem;
}
.fit-steps strong { color: #465365; display: block; margin-bottom: .2rem; }
.fit-steps p { margin: 0; color: #596779; }
.problem-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, .9fr);
  gap: clamp(1.5rem, 4vw, 2.5rem);
  align-items: start;
}
.board {
  min-height: 280px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  border-radius: 22px;
  padding: 1.25rem;
  background: #ffffff;
}
.scene-kicker {
  color: #b83e12;
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin: 0 0 1rem;
}
.serp { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.serp li {
  padding: .85rem 1rem;
  border-radius: 14px;
  border: 1px solid rgba(25, 33, 46, 0.08);
}
.serp .ghost { opacity: .72; }
.serp b { display: block; color: #465365; }
.serp i { color: #596779; font-style: normal; font-size: .85rem; }
.serp em { display: block; color: #b83e12; font-style: normal; margin-top: .35rem; }
.serp .you { border-color: rgba(240,98,42,.45); opacity: 1; }
.result {
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid rgba(25, 33, 46, 0.09);
  margin-bottom: 12px;
}
.result-url { color: #596779; font-size: .82rem; margin: 0 0 .25rem; }
.result h3 { margin: 0 0 .35rem; font-size: 1.05rem; color: #465365; }
.result p { margin: 0 0 .5rem; color: #596779; font-size: .95rem; }
.result span { color: #b83e12; font-size: .82rem; font-weight: 800; }
.result.weak { opacity: .55; }
.result.strong { border-color: rgba(240,98,42,.4); }
.landing { display: flex; flex-wrap: wrap; gap: 8px; }
.landing-card {
  flex: 1 1 100%;
  margin-top: 12px;
  min-height: 140px;
  border-radius: 16px;
  border: 1px dashed rgba(25, 33, 46, 0.09);
  padding: 1.25rem;
}
.landing-offer { margin: 0; color: #465365; font-size: 1.2rem; font-weight: 800; }
.landing-cta {
  margin-top: 1rem;
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  padding: 0 1rem;
  border-radius: 999px;
  background: #f0622a;
  color: #0d0f1a;
  font-weight: 900;
}
.explain h3 { margin: 0 0 .75rem; font-size: 1.35rem; }
.explain ul { margin: 1rem 0; padding-left: 1.1rem; }
.explain a {
  color: #b83e12;
  font-weight: 800;
}
@media (max-width: 900px) {
  .problem-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .fit-btn, .problem-btn, .layer-btn { transition: none; }
}
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-lab]");
    if (!root) return;

    function on(group, attr, value) {
      root.querySelectorAll(group).forEach(function (el) {
        var match = el.getAttribute(attr) === value;
        el.classList.toggle("is-on", match);
        if (el.hasAttribute("hidden") || el.hasAttribute("data-fit-panel") || el.hasAttribute("data-explain") || el.hasAttribute("data-scene")) {
          if (match) el.removeAttribute("hidden");
          else el.setAttribute("hidden", "");
        }
        if (el.getAttribute("role") === "tab") el.setAttribute("aria-selected", match ? "true" : "false");
      });
    }

    root.querySelectorAll("[data-fit]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-fit");
        root.querySelectorAll("[data-fit]").forEach(function (b) {
          var match = b === btn;
          b.classList.toggle("is-on", match);
          b.setAttribute("aria-selected", match ? "true" : "false");
        });
        root.querySelectorAll("[data-fit-panel]").forEach(function (panel) {
          var match = panel.getAttribute("data-fit-panel") === id;
          panel.classList.toggle("is-on", match);
          if (match) panel.removeAttribute("hidden");
          else panel.setAttribute("hidden", "");
        });
      });
    });

    root.querySelectorAll("[data-problem]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-problem");
        root.querySelectorAll("[data-problem]").forEach(function (b) {
          var match = b === btn;
          b.classList.toggle("is-on", match);
          b.setAttribute("aria-selected", match ? "true" : "false");
        });
        root.querySelectorAll("[data-scene]").forEach(function (scene) {
          var match = scene.getAttribute("data-scene") === id;
          scene.classList.toggle("is-on", match);
          if (match) scene.removeAttribute("hidden");
          else scene.setAttribute("hidden", "");
        });
        root.querySelectorAll("[data-explain]").forEach(function (box) {
          var match = box.getAttribute("data-explain") === id;
          box.classList.toggle("is-on", match);
          if (match) box.removeAttribute("hidden");
          else box.setAttribute("hidden", "");
        });
      });
    });

    root.querySelectorAll("[data-layer]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-layer");
        root.querySelectorAll("[data-layer]").forEach(function (b) {
          b.classList.toggle("is-on", b === btn);
        });
        root.querySelectorAll("[data-layer-copy]").forEach(function (copy) {
          var match = copy.getAttribute("data-layer-copy") === id;
          if (match) copy.removeAttribute("hidden");
          else copy.setAttribute("hidden", "");
        });
        var cta = root.querySelector("[data-cta]");
        if (cta) {
          if (id === "cta") cta.removeAttribute("hidden");
          else cta.setAttribute("hidden", "");
        }
      });
    });
  })();
</script>
