---
// Text-led page template for service, country, sector and development pages.
// Copy lives in a `page` object at the top of each page file; this component only lays it out.
// Design: brightforge-site-audit/design/DESIGN.md (text hero, hairline sections, lists in place of cards).
import MainLayout from '../layouts/MainLayout.astro';
import LegacyHeader from './LegacyHeader.astro';
import Footer from './Footer.astro';

interface Section { h2: string; html: string; id?: string; }
interface Faq { question: string; answer: string; }
interface Page {
  path: string;
  title: string;
  description: string;
  h1: string;
  crumb: string;
  parents?: Array<{ name: string; url: string }>;
  lead: string[];
  secondary?: { href: string; label: string };
  byline?: boolean;
  sections: Section[];
  faqs?: Faq[];
  faqHeading?: string;
  contact?: { h2?: string; text?: string };
  // Contact link carrying an allowlisted service and market, so the contact form opens with them selected.
  enquiry?: string;
  geo?: { geoRegion: string; geoPlacename: string; contentLanguage: string };
  // Country pages describe one market: emit a single country-specific Service definition.
  country?: { name: string; language: string };
}
interface Props { page: Page; }

const { page } = Astro.props;
const SITE = 'https://brightforge.com.ph';
const canonical = `${SITE}${page.path}`;
const parents = page.parents || [];
const breadcrumbs = [
  { name: 'Home', url: `${SITE}/` },
  ...parents.map((p) => ({ name: p.name, url: `${SITE}${p.url}` })),
  { name: page.crumb, url: canonical },
];
const secondary = page.secondary || { href: '/case-studies/', label: 'Read the case studies' };
const faqs = page.faqs || [];
const contact = {
  h2: 'Request an SEO review',
  text: 'Send your website, your target market and the problem you want solved. We usually reply within one business day.',
  ...(page.contact || {}),
};
const enquiry = page.enquiry || '/contact/';
const showByline = page.byline !== false;
const geo = page.geo || {};
const countryService = page.country ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  serviceType: 'Search engine optimisation',
  url: canonical,
  description: page.description,
  areaServed: { '@type': 'Country', name: page.country.name },
  availableLanguage: page.country.language,
  provider: { '@type': 'Organization', name: 'Bright Forge SEO', url: `${SITE}/` },
} : null;
---
<MainLayout title={page.title} description={page.description} canonical={canonical} type="service" breadcrumbs={breadcrumbs} faqs={faqs.length ? faqs : undefined} includeServiceSchema={!countryService} {...geo}>
  {countryService && <script slot="head" type="application/ld+json" set:html={JSON.stringify(countryService)} />}
  <LegacyHeader slot="header" />
  <div class="bf-page">
    <header class="bf-hero">
      <div class="bf-wrap">
        <nav class="bf-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          {parents.map((p) => (<><a href={p.url}>{p.name}</a><span aria-hidden="true">/</span></>))}
          <span aria-current="page">{page.crumb}</span>
        </nav>
        <h1>{page.h1}</h1>
        {page.lead.map((text, i) => (i === 0 ? <p class="bf-lead" set:html={text} /> : <p set:html={text} />))}
        <p class="bf-actions">
          <a class="bf-btn bf-btn--primary" href={enquiry}>Request an SEO review</a>
          <a class="bf-btn bf-btn--quiet" href={secondary.href}>{secondary.label}</a>
        </p>
        {showByline && (
          <div class="bf-byline">
            <img src="/images/About us/ben-lowe-owner.webp" alt="" width="44" height="44" loading="lazy" decoding="async" />
            <p><strong>Strategy led by <a href="/authors/ben-lowe/">Ben Lowe</a>, Founder.</strong> More than 15 years in SEO.</p>
          </div>
        )}
      </div>
    </header>

    {page.sections.map((section) => (
      <section class="bf-sec" id={section.id}>
        <div class="bf-wrap">
          <h2>{section.h2}</h2>
          <Fragment set:html={section.html} />
        </div>
      </section>
    ))}

    {faqs.length > 0 && (
      <section class="bf-sec" id="questions">
        <div class="bf-wrap">
          <h2>{page.faqHeading || 'Questions'}</h2>
          {faqs.map((faq) => (
            <>
              <h3>{faq.question}</h3>
              <p set:html={faq.answer} />
            </>
          ))}
        </div>
      </section>
    )}

    <section class="bf-sec" id="contact">
      <div class="bf-wrap bf-contact">
        <div>
          <h2>{contact.h2}</h2>
          <p>{contact.text}</p>
          <p class="bf-actions"><a class="bf-btn bf-btn--primary" href={enquiry}>Request an SEO review</a></p>
        </div>
        <div>
          <address>Kathleen Place 4, Block 16, Lot 37 Armani Street, 75 S Francisco, Novaliches, Quezon City 1116, Metro Manila, Philippines</address>
          <dl class="bf-facts">
            <dt>Hours</dt><dd>Monday to Friday, 9:00 to 18:00 Manila time</dd>
            <dt>Phone</dt><dd><a href="tel:+639696206182">(+63) 969 620 6182</a></dd>
            <dt>Email</dt><dd><a href="mailto:seo@brightforgeseo.com">seo@brightforgeseo.com</a></dd>
          </dl>
        </div>
      </div>
    </section>
  </div>
  <Footer slot="footer" />
</MainLayout>
