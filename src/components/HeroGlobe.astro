---
/** Contained local globe illustration. No WebGL runtime or text-column overlay. */
---
<div class="brand-globe" aria-hidden="true">
  <img src="/images/brand-globe.svg" alt="" width="600" height="600" decoding="async" />
</div>

<style>
  .brand-globe {
    position: absolute;
    width: min(42vw, 550px);
    aspect-ratio: 1;
    right: max(24px, calc((100vw - 1280px) / 2));
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .brand-globe img { display: block; width: 100%; height: auto; }
  @media (max-width: 1100px) { .brand-globe { display: none; } }
</style>
