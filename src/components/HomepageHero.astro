---
import ForgeHero from './ForgeHero.astro';
interface Props {
 badge?: string; title: string; subtitle?: string; buttonText?: string; buttonHref?: string;
 secondaryButtonText?: string; secondaryButtonHref?: string; imageSrc?: string; imageAlt?: string;
 trustBadgeCount?: string; trustBadgeText?: string;
}
const {badge = 'British-led SEO, based in the Philippines', title, buttonText = 'Get Started', buttonHref = '/contact/', secondaryButtonText, secondaryButtonHref} = Astro.props;
---
<ForgeHero title={title} eyebrow={badge}>
 <slot name="description" />
 <slot name="support" />
 <Fragment slot="actions">
  <a class="forge-primary" href={buttonHref} data-analytics-event="hero_primary_cta">{buttonText}<span aria-hidden="true">↗</span></a>
  {secondaryButtonText && secondaryButtonHref && <a class="forge-secondary" href={secondaryButtonHref} data-analytics-event="hero_secondary_cta">{secondaryButtonText}<span aria-hidden="true">↗</span></a>}
 </Fragment>
</ForgeHero>
<style>
.forge-primary,.forge-secondary { display:inline-flex; align-items:center; justify-content:center; gap:18px; min-height:44px; border-radius:12px; font-weight:600; text-decoration:none; color:#18202b; }
.forge-primary { background:#f56327; border:1px solid #f56327; }.forge-secondary { border:1px solid #d9dce0; background:#fff; }.forge-primary:hover { background:#ed5317; }.forge-secondary:hover { border-color:#f56327; }.forge-home-support { max-width:1000px; }
</style>
