---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
  imageSrc: string;
  imageAlt: string;
  trustBadgeCount?: string;
  trustBadgeText?: string;
}

const {
  badge = "British-led SEO, based in the Philippines",
  title,
  subtitle,
  buttonText = "Get Started",
  buttonHref = "/contact/",
  secondaryButtonText,
  secondaryButtonHref,
  imageSrc,
  imageAlt,
  trustBadgeCount = "17",
  trustBadgeText = "Published Case Studies"
} = Astro.props;

const addHeroHighlight = (value: string) => {
  if (value.includes('<span')) return value;
  const words = value.trim().split(/\s+/);
  if (words.length <= 2) return `<span>${value}</span>`;
  const splitAt = Math.max(words.length - 3, 1);
  return `${words.slice(0, splitAt).join(' ')} <span>${words.slice(splitAt).join(' ')}</span>`;
};

const highlightedTitle = addHeroHighlight(title);

import HeroGlobe from './HeroGlobe.astro';
---

<section class="homepage-hero">
  <!-- Subtle background elements -->
  <div class="hero-bg-elements">
    <div class="bg-gradient"></div>
    <HeroGlobe />
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 lg:py-24 relative z-10">
    <div class="hero-grid">
      <!-- Left Column - Content -->
      <div class="hero-content">
        <!-- Badge -->
        {badge && (
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>{badge}</span>
          </div>
        )}

        <!-- Main Heading -->
        <h1 class="hero-title" set:html={highlightedTitle} />

        <!-- Description -->
        <div class="hero-description">
          <slot name="description" />
        </div>

        <!-- CTA Buttons -->
        <div class="hero-buttons">
          <a href={buttonHref} class="btn-hero-primary" data-analytics-event="hero_primary_cta">
            <span>{buttonText}</span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {secondaryButtonText && secondaryButtonHref && (
            <a href={secondaryButtonHref} class="btn-hero-secondary" data-analytics-event="hero_secondary_cta">
              <span>{secondaryButtonText}</span>
            </a>
          )}
        </div>

        {Astro.slots.has('support') && (
          <div class="hero-description hero-support">
            <slot name="support" />
          </div>
        )}

        <!-- Stats row -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">{trustBadgeCount}</span>
            <span class="stat-label">{trustBadgeText}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">15+</span>
            <span class="stat-label">Years Experience</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">Clutch</span>
            <span class="stat-label">Listed Agency</span>
          </div>
        </div>
      </div>

      <!-- Right Column - Visual -->
      <div class="hero-visual">
        <div class="hero-image-wrapper">
          <div class="image-glow"></div>
          <picture class="hero-image-picture">
            <source media="(min-width: 1025px)" srcset="/images/hero-480w.webp" />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
              alt={imageAlt}
              class="hero-image"
              width="480"
              height="480"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <!-- Floating elements -->
          <div class="floating-card floating-card-1">
            <div class="floating-icon">
              <i class="fas fa-chart-line"></i>
            </div>
            <div class="floating-text">
              <span class="floating-value">Senior-led</span>
              <span class="floating-label">Strategy & QA</span>
            </div>
          </div>
          <div class="floating-card floating-card-2">
            <div class="floating-icon success">
              <i class="fas fa-check"></i>
            </div>
            <div class="floating-text">
              <span class="floating-value">Lead-focused</span>
              <span class="floating-label">SEO + CRO</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .homepage-hero {
    position: relative;
    overflow-x: clip;
    overflow-y: hidden;
    background: #ffffff;
    min-height: auto;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100vw;
  }

  /* Background elements */
  .hero-bg-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #ffffff 0%, #f7f8fa 40%, #ffffff 100%);
  }

  /* gradientFlow animation removed, continuous animation wastes main-thread time */

  /* Grid layout */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Content styles */
  .hero-content {
    max-width: 580px;
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(240, 98, 42, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(240, 98, 42, 0.25);
    color: #19212e;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }

  .hero-title {
    font-size: clamp(2.75rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #19212e;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero-title :global(span) {
    color: #b83e12 !important;
  }

  .hero-description {
    margin-bottom: 32px;
  }

  .hero-description :global(p) {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #19212e;
    margin-bottom: 12px;
  }

  .hero-description :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Buttons */
  .hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.1), rgba(240, 98, 42, 0.05));
    border: 1px solid rgba(240, 98, 42, 0.15);
    color: #b83e12;
    border-radius: 100px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(240, 98, 42, 0.4);
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.15), rgba(240, 98, 42, 0.08));
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-arrow {
    transition: transform 0.3s ease;
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 28px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(25, 33, 46, 0.09);
    color: #19212e;
    border-radius: 14px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(25, 33, 46, 0.09);
    transform: translateY(-2px);
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: #19212e;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #465365;
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.09);
  }

  /* Visual/Image section */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .image-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(240,98,42,0.15) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    will-change: transform;
    transform: translateZ(0);
  }

  .hero-image {
    width: 480px;
    height: 480px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 1;
    box-shadow: 0 30px 60px rgba(25, 33, 46, 0.09);
    border: 4px solid rgba(25, 33, 46, 0.09);
  }

  /* Floating cards */
  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f7f8fa;
    padding: 14px 18px;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(25, 33, 46, 0.09);
    border: 1px solid rgba(25, 33, 46, 0.06);
    z-index: 10;
    animation: floatCard 4s ease-in-out infinite;
  }

  .floating-card-1 {
    top: 10%;
    right: -10%;
    animation-delay: 0s;
  }

  .floating-card-2 {
    bottom: 15%;
    left: -5%;
    animation-delay: 2s;
  }

  @keyframes floatCard {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .floating-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #f0622a 0%, #ff9a62 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #19212e;
    font-size: 16px;
  }

  .floating-icon.success {
    background: #f1f3f5;
    border: 1px solid rgba(240, 98, 42, 0.4);
    color: #b83e12;
  }

  .floating-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .floating-value {
    font-size: 1.1rem;
    font-weight: 800;
    color: #19212e;
    letter-spacing: -0.02em;
  }

  .floating-label {
    font-size: 0.75rem;
    color: #19212e;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 1200px), (hover: none) and (pointer: coarse) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .hero-content {
      max-width: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: clamp(2rem, 5vw, 2.75rem);
      max-width: 100%;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .homepage-hero {
      min-height: auto;
    }

    .homepage-hero :global(.max-w-7xl) {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .hero-title {
      font-size: 2.1rem;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      justify-content: center;
    }

    .hero-stats {
      flex-wrap: wrap;
      gap: 16px;
    }

    .stat-divider {
      display: none;
    }

    .stat-item {
      flex: 1;
      min-width: 100px;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.875rem;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .hero-description :global(p) {
      font-size: 1rem;
    }

    .stat-number {
      font-size: 1.25rem;
    }

    .stat-label {
      font-size: 0.7rem;
    }
  }

  /* Mobile performance: Disable animations */
  @media (max-width: 768px) {
    .badge-dot {
      animation: none;
    }

    .floating-card {
      animation: none;
    }

    /* Reduce blur for better performance */
    .hero-badge {
      backdrop-filter: none;
      background: rgba(240, 98, 42, 0.15);
    }

    .btn-hero-secondary {
      backdrop-filter: none;
      background: rgba(255, 255, 255, 0.08);
    }

    .image-glow {
      display: none;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .badge-dot,
    .floating-card {
      animation: none;
    }
  }
</style>
