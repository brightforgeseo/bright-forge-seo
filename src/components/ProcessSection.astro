---
// Props with defaults
const {
  badge = "OUR METHOD",
  title = "Step-by-Step",
  titleHighlight = "Process"
} = Astro.props;

const steps = [
  {
    number: "01",
    title: "In-Depth Website Audit",
    description: "We crawl the site and compare priority pages with Search Console data. We check indexation, competing URLs, missing buying information and whether mobile visitors can contact you."
  },
  {
    number: "02",
    title: "Custom Strategy Development",
    description: "We agree the pages to work on first, the changes required and who approves and implements them. The roadmap separates urgent technical fixes from content and outreach work."
  },
  {
    number: "03",
    title: "Execution & Optimization",
    description: "We release the agreed fixes and page edits, check the published result and record changed URLs. Content and outreach follow the approved brief and supporting evidence."
  },
  {
    number: "04",
    title: "Continuous Performance Monitoring",
    description: "We compare dated query and page results, check enquiry tracking and review what has not improved. Those findings determine the next work, rather than repeating the previous month."
  }
];
---

<div class="bg-[#ffffff] py-16 px-4">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-4 text-[#b83e12] border border-[rgba(240,98,42,0.15)]" style="background:linear-gradient(135deg,rgba(240,98,42,0.1),rgba(240,98,42,0.05))">
        {badge}
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-2" style="font-family: 'Outfit', sans-serif; font-weight: 800;">
        {title} <span class="text-[#b83e12]">{titleHighlight}</span>
      </h2>
    </div>

    <!-- Process Steps - 2 Column Grid -->
    <div class="process-grid">
      {steps.map((step) => (
        <div
          class="process-card"
        >
          <div class="process-number">
            {step.number}
          </div>

          <div class="process-copy">
            <h3 class="text-xl font-bold text-slate-900">
              {step.title}
            </h3>

            <p class="text-[#465365] leading-relaxed text-base">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(25, 33, 46, 0.08);
    border-radius: 18px;
    overflow: hidden;
  }

  .process-card {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 1.35rem;
    background: #ffffff;
    padding: clamp(1.35rem, 3vw, 2.25rem);
    min-height: 190px;
  }

  .process-number {
    color: #b83e12;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.85;
    font-weight: 900;
    letter-spacing: -0.08em;
    opacity: 0.9;
  }

  .process-copy h3 {
    margin: 0 0 0.85rem;
    line-height: 1.2;
  }

  .process-copy p {
    margin: 0;
  }

  .process-card:nth-child(2),
  .process-card:nth-child(3) {
    background: #f7f8fa;
  }

  @media (max-width: 768px) {
    .process-grid {
      grid-template-columns: 1fr;
    }

    .process-card {
      grid-template-columns: 60px 1fr;
      min-height: auto;
    }
  }
</style>
