</footer>

<style>
  .footer-modern {
    background: linear-gradient(135deg, #ffffff 0%, #f7f8fa 40%, #ffffff 100%);
    color: #19212e;
    margin-top: 0 !important;
    position: relative;
    z-index: 1;
  }

  .footer-main {
    padding: 4rem 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 3rem;
  }

  /* Brand section */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: flex-start;
  }

  .footer-logo {
    display: block;
    width: fit-content;
  }

  .footer-logo img {
    width: 246px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    margin: 0;
  }

  .footer-description {
    font-size: 0.9375rem;
    color: #465365;
    line-height: 1.7;
    margin: 0;
    max-width: 280px;
  }

  .social-links {
    display: flex;
    gap: 10px;
  }

  .social-link {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #465365;
    font-size: 14px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    background: #f0622a;
    color: #19212e;
    transform: translateY(-2px);
  }

  /* Footer headings */
  .footer-heading {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #19212e;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    position: relative;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background: #f0622a;
    border-radius: 2px;
  }

  /* Footer links */
  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: #465365;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #19212e;
    transform: translateX(4px);
  }

  /* Contact section */
  .contact-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .contact-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b83e12;
    font-size: 14px;
    flex-shrink: 0;
  }

  .contact-item p,
  .contact-item a {
    font-size: 0.875rem;
    color: #465365;
    line-height: 1.6;
    margin: 0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-item a:hover {
    color: #19212e;
  }

  /* Footer bottom */
  .footer-bottom {
    border-top: 1px solid rgba(25, 33, 46, 0.06);
    padding: 1.25rem 0;
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: #465365;
    text-align: center;
    margin: 0;
  }

  /* Safe area support */
  .footer-modern::after {
    content: '';
    display: block;
    height: env(safe-area-inset-bottom);
    background: transparent;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-main {
      padding: 3rem 0 2rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      text-align: center;
      align-items: center;
    }

    .footer-description {
      max-width: 100%;
    }

    .footer-heading {
      text-align: center;
    }

    .footer-heading::after {
      left: 50%;
      transform: translateX(-50%);
    }

    .footer-links ul {
      align-items: center;
    }

    .footer-links a:hover {
      transform: none;
    }

    .contact-items {
      align-items: center;
    }

    .contact-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>

<style>
  /* Brand/contact row above a compact, balanced link directory. */
  .footer-modern .footer-main { padding: 64px 0 40px; }
  .footer-modern .footer-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: 28px;
    row-gap: 44px;
    align-items: start;
  }
  .footer-modern .footer-brand {
    grid-column: 1 / 3;
    grid-row: 1;
    gap: 20px;
    padding: 12px 28px 0 0;
  }
  .footer-modern .footer-logo img { width: 252px; }
  .footer-modern .footer-description { max-width: 360px; font-size: 15px; line-height: 1.75; }
  .footer-modern .social-link {
    width: 44px;
    height: 44px;
    border: 1px solid #e1e5eb;
    border-radius: 12px;
    background: #f3f4f6;
    color: #19212e;
  }
  .footer-modern .social-link:hover { background: #f0622a; border-color: #f0622a; }
  .footer-modern .footer-contact {
    grid-column: 3 / 6;
    grid-row: 1;
    background: #f3f4f6;
    border: 1px solid #e1e5eb;
    border-radius: 20px;
    padding: 28px 30px;
  }
  .footer-modern .footer-heading {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -.02em;
    text-transform: none;
    margin: 0 0 22px;
    padding-bottom: 14px;
    text-align: left;
  }
  .footer-modern .footer-heading::after { width: 28px; left: 0; transform: none; }
  .footer-modern .contact-items { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; }
  .footer-modern .contact-item:first-child { grid-column: 1 / -1; }
  .footer-modern .contact-item { align-items: flex-start; flex-direction: row; text-align: left; gap: 12px; }
  .footer-modern .contact-icon { width: 34px; height: 34px; background: #ffffff; color: #cf4b1c; }
  .footer-modern .contact-item :is(p,a) { font-size: 14px; line-height: 1.65; padding-top: 5px; overflow-wrap: anywhere; }
  .footer-modern .footer-links { padding-top: 30px; border-top: 1px solid #e1e5eb; min-width: 0; }
  .footer-modern .footer-links:nth-child(2) { grid-column: 1 / 4; grid-row: 2; }
  .footer-modern .footer-links:nth-child(3) { grid-column: 4 / 6; grid-row: 2; }
  .footer-modern .footer-links ul { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px 22px; align-items: start; }
  .footer-modern .footer-links:nth-child(3) ul { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .footer-modern .footer-links li { min-width: 0; }
  .footer-modern .footer-links a { font-size: 14px; line-height: 1.55; padding: 4px 0; }
  .footer-modern .footer-links a:hover { color: #a63c15; transform: none; text-decoration: underline; text-underline-offset: 4px; }
  .footer-modern .footer-bottom { border-top: 1px solid #e1e5eb; padding-top: 20px; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
  .footer-modern .footer-bottom p { text-align: left; font-size: 12px; letter-spacing: .01em; }
  @media (max-width: 1024px) {
    .footer-modern .footer-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 32px; }
    .footer-modern .footer-brand { grid-column: 1; grid-row: 1; padding-right: 0; }
    .footer-modern .footer-contact { grid-column: 2; grid-row: 1; padding: 24px; }
    .footer-modern .contact-items { grid-template-columns: 1fr; gap: 16px; }
    .footer-modern .footer-links:nth-child(2) { grid-column: 1; grid-row: 2; }
    .footer-modern .footer-links:nth-child(3) { grid-column: 2; grid-row: 2; }
    .footer-modern .footer-links ul { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px 18px; }
  }
  @media (max-width: 640px) {
    .footer-modern .footer-main { padding: 40px 0 28px; }
    .footer-modern .footer-grid { grid-template-columns: 1fr; gap: 30px; }
    .footer-modern .footer-brand { grid-column: 1; grid-row: 1; text-align: left; align-items: flex-start; padding: 0; }
    .footer-modern .footer-logo img { width: 236px; }
    .footer-modern .footer-description { max-width: 100%; }
    .footer-modern .footer-contact { grid-column: 1; grid-row: 2; padding: 24px 20px; border-radius: 16px; }
    .footer-modern .footer-links:nth-child(2) { grid-column: 1; grid-row: 3; }
    .footer-modern .footer-links:nth-child(3) { grid-column: 1; grid-row: 4; }
    .footer-modern .footer-links { padding-top: 24px; }
    .footer-modern .footer-links a { display: inline-flex; align-items: center; min-height: 44px; width: 100%; padding: 6px 0; }
    .footer-modern .footer-bottom p { line-height: 1.8; }
  }
</style>
