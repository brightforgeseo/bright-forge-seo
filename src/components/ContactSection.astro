---
// Contact Section Component - Used on multiple pages
const { href = '/contact/' } = Astro.props;
---

<section class="contact-cta-section">
  <div class="max-w-7xl mx-auto px-6">
    <div class="contact-cta-wrapper">
      <div class="contact-cta-content">
        <span class="contact-badge">Let's Talk</span>
        <h2>Ready to Grow <span>Your Business</span>?</h2>
        <p>Tell us about your website, target market and the search problems you want to address.</p>
        <div class="contact-cta-actions">
          <a href={href} class="cta-btn-primary">
            <span>Discuss Your Website</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="mailto:seo@brightforgeseo.com" class="cta-btn-secondary">
            <i class="fas fa-envelope"></i>
            <span>seo@brightforgeseo.com</span>
          </a>
        </div>
      </div>
      <div class="contact-cta-info">
        <div class="info-card">
          <div class="info-icon">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div class="info-text">
            <span class="info-label">Call Us</span>
            <a href="tel:+639696206182">(+63) 969 620 6182</a>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="info-text">
            <span class="info-label">Office Hours</span>
            <span>Mon - Fri: 9AM - 6PM</span>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div class="info-text">
            <span class="info-label">Location</span>
            <span>Quezon City, Philippines</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta-section {
    padding: 5rem 0;
    background: #f7f8fa;
    position: relative;
    overflow: hidden;
  }

  .contact-cta-section::before,
  .contact-cta-section::after {
    display: none;
  }

  .contact-cta-wrapper {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .contact-cta-content {
    max-width: 560px;
  }

  .contact-badge {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-radius: 100px;
    color: #19212e;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .contact-cta-content h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #19212e;
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .contact-cta-content p {
    font-size: 1.0625rem;
    color: #19212e;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .contact-cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.1), rgba(240, 98, 42, 0.05));
    border: 1px solid rgba(240, 98, 42, 0.15);
    color: #b83e12;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(240, 98, 42, 0.4);
    background: linear-gradient(135deg, rgba(240, 98, 42, 0.15), rgba(240, 98, 42, 0.08));
  }

  .cta-btn-primary svg {
    transition: transform 0.3s ease;
  }

  .cta-btn-primary:hover svg {
    transform: translateX(4px);
  }

  .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(25, 33, 46, 0.09);
    color: #19212e;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(25, 33, 46, 0.09);
  }

  .cta-btn-secondary i {
    font-size: 14px;
  }

  .contact-cta-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(25, 33, 46, 0.09);
    border-radius: 14px;
    min-width: 240px;
  }

  .info-icon {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #19212e;
    font-size: 16px;
    flex-shrink: 0;
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-label {
    font-size: 0.75rem;
    color: #465365;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info-text a,
  .info-text span:not(.info-label) {
    color: #19212e;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .info-text a:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-cta-wrapper {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .contact-cta-content {
      max-width: 100%;
    }

    .contact-cta-actions {
      justify-content: center;
    }

    .contact-cta-info {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .info-card {
      min-width: auto;
    }
  }

  @media (max-width: 768px) {
    .contact-cta-section {
      padding: 4rem 0;
    }

    .contact-cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn-primary,
    .cta-btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .contact-cta-info {
      flex-direction: column;
    }

    .info-card {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .contact-cta-section {
      padding: 3rem 0;
    }

    .contact-cta-content h2 {
      font-size: 1.5rem;
    }

    .contact-badge {
      font-size: 0.75rem;
    }
  }
  /* Release 3: the closing contact block is a dark panel on the white page, so every page ends on a clear, confident call to act. */
  .contact-cta-section { background: #fff; padding: clamp(3rem, 6vw, 5.5rem) 0; }
  .contact-cta-wrapper { isolation: isolate; overflow: hidden; padding: clamp(28px, 4.6vw, 64px); border-radius: 28px; background: #18202b; box-shadow: 0 2px 4px rgb(24 32 43 / 8%), 0 40px 70px -40px rgb(24 32 43 / 55%); }
  .contact-cta-wrapper::before { content: ''; position: absolute; z-index: -1; right: -12%; top: -55%; width: 62%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(240 98 42 / 34%), rgb(240 98 42 / 0%) 68%); pointer-events: none; }
  .contact-cta-wrapper::after { content: ''; position: absolute; z-index: -1; inset: 0; background: linear-gradient(120deg, rgb(255 255 255 / 4%), transparent 42%); pointer-events: none; }
  .contact-badge { background: rgb(255 255 255 / 8%) !important; border-color: rgb(255 255 255 / 18%) !important; color: #fff !important; backdrop-filter: none; letter-spacing: .08em; text-transform: uppercase; font-size: .75rem; }
  .contact-cta-content h2 { color: #fff !important; font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -.032em; line-height: 1.06; }
  .contact-cta-content h2 span { color: #ff7a45 !important; -webkit-text-fill-color: #ff7a45 !important; }
  .contact-cta-content p { color: #d3d9e1 !important; font-size: 1.0938rem; max-width: 46ch; }
  .cta-btn-primary { background: #f0622a !important; border-color: #f0622a !important; color: #18202b !important; border-radius: 12px; padding: 15px 26px; }
  .cta-btn-primary:hover { background: #ff7a45 !important; }
  .cta-btn-secondary { background: transparent !important; border-color: rgb(255 255 255 / 28%) !important; color: #fff !important; backdrop-filter: none; padding: 15px 22px; }
  .cta-btn-secondary:hover { border-color: #ff7a45 !important; background: rgb(255 255 255 / 5%) !important; }
  .info-card { background: rgb(255 255 255 / 6%) !important; border-color: rgb(255 255 255 / 13%) !important; backdrop-filter: none; min-width: 270px; box-shadow: none !important; }
  .info-icon { background: rgb(240 98 42 / 18%) !important; color: #ff8a57 !important; }
  .info-label { color: #a9b3c1 !important; letter-spacing: .08em; }
  .info-text a, .info-text span:not(.info-label) { color: #fff !important; }
  @media (max-width: 1024px) { .info-card { min-width: 0; text-align: left; } }
  @media (max-width: 768px) { .contact-cta-wrapper { border-radius: 22px; text-align: left; } .contact-cta-actions { justify-content: flex-start; } }
  @media (max-width: 480px) { .contact-cta-content h2 { font-size: 1.85rem; } }
</style>
