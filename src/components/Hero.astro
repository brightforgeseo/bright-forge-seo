---
import ForgeHero from './ForgeHero.astro';
interface Props { badgeIcon?: string; badgeText?: string; title: string; breadcrumbCurrent?: string; }
const { title, badgeText, breadcrumbCurrent = 'Home' } = Astro.props;
const hasIntro = Astro.slots.has('intro');
// Retain the existing feature strip below the supplied cards instead of squeezing
// its three columns into the new hero's narrow introductory text column.
const story = await Astro.slots.render('story') || '';
const featurePattern = /<div class="hero-proof"[^>]*>[\s\S]*?<\/div>/g;
const features = (story.match(featurePattern) || []).join('');
const mainStory = story.replace(featurePattern, '');
const hasDetails = Astro.slots.has('stats') || Astro.slots.has('visual') || !!features || (hasIntro && !!mainStory);
---
<ForgeHero title={title} eyebrow={badgeText || breadcrumbCurrent} breadcrumb={breadcrumbCurrent}>
 {hasIntro ? <slot name="intro" /> : <Fragment set:html={mainStory} />}
 <Fragment slot="actions"><slot name="actions" /></Fragment>
 {hasDetails && <Fragment slot="details">
  <Fragment set:html={features} />
  <div class="forge-retained-details">
   <div>{hasIntro && <Fragment set:html={mainStory} />}<slot name="stats" /></div>
   <div><slot name="visual" /></div>
  </div>
 </Fragment>}
</ForgeHero>
