---
import { heroCards } from '../lib/heroProof';
const { context = '' } = Astro.props;
const cards = heroCards(Astro.url.pathname, context);
---
<brightforge-proof-cards class="forge-proof" aria-label="Relevant work and next steps">
  <div class="forge-proof-grid">
    {cards.map((card, i) => (
      <a class:list={['forge-proof-card', `forge-proof-card--${i}`]} href={card.href} data-proof-source={card.source}>
        <span class="forge-card-label">{card.label}</span>
        <strong class:list={['forge-card-value', { 'forge-card-value--number': /^[+\d]/.test(card.value) }]}>{card.value}</strong>
        <span class="forge-card-bottom"><span>{card.detail}</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></span>
      </a>
    ))}
  </div>
</brightforge-proof-cards>
<style>
.forge-proof { position:relative; z-index:2; display:block; width:min(100%,1380px); margin:0 auto; padding:0 36px 36px; font-family:'Inter',sans-serif; }
.forge-proof-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.forge-proof-card { --tilt-x:0deg; --tilt-y:0deg; --light-x:50%; --light-y:50%; position:relative; display:flex; flex-direction:column; justify-content:space-between; min-height:200px; min-width:0; padding:24px; overflow:hidden; border-radius:16px; border:1px solid transparent; color:#18202b; text-decoration:none; transform:perspective(900px) rotateX(0deg) rotateY(0deg); transition:transform 350ms cubic-bezier(.2,.75,.25,1),box-shadow 350ms; }
.forge-proof-card--0 { background:#f56327; }.forge-proof-card--1 { background:#18202b; color:white; }.forge-proof-card--2 { background:#fff6ef; border-color:#edd8ca; }
.forge-proof-card::after { content:''; position:absolute; inset:0; pointer-events:none; border-radius:inherit; opacity:0; background:radial-gradient(circle at var(--light-x) var(--light-y),rgb(255 255 255 / 19%),transparent 70%); transition:opacity 250ms; }
.forge-card-label { position:relative; z-index:1; font-size:16px; font-weight:500; line-height:1.3; }
.forge-card-value { position:relative; z-index:1; display:block; margin:16px 0; font-family:'Outfit','Inter',sans-serif; font-size:clamp(1.7rem,2.5vw,2.15rem); font-weight:500; line-height:1.05; letter-spacing:-.045em; overflow-wrap:break-word; }
.forge-card-value--number { font-size:clamp(2.8rem,5.3vw,4.6rem); font-variant-numeric:tabular-nums; letter-spacing:-.065em; }
.forge-card-bottom { position:relative; z-index:1; display:flex; align-items:flex-end; justify-content:space-between; gap:12px; font-size:13px; line-height:1.4; }.forge-card-bottom svg { flex-shrink:0; transition:transform 260ms; }.forge-proof-card--1 .forge-card-bottom { color:#e5e7eb; }
.forge-proof-card:focus-visible { outline:3px solid #b83e12; outline-offset:4px; box-shadow:inset 0 0 0 2px currentColor; }
@media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference) { .forge-proof-card:hover { z-index:2; transform:perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-4px); box-shadow:0 16px 30px -15px rgb(0 0 0 / 55%); transition-duration:140ms; }.forge-proof-card:hover::after { opacity:1; }.forge-proof-card:hover svg { transform:translate(3px,-3px); } }
@media(max-width:767px) { .forge-proof { padding:0 24px 30px; }.forge-proof-grid { grid-template-columns:1fr; }.forge-proof-card { min-height:180px; }.forge-card-value--number { font-size:clamp(3.5rem,14vw,4.6rem); } }
@media(prefers-reduced-motion:reduce) { .forge-proof-card,.forge-proof-card::after,.forge-card-bottom svg { transition:none; } }
</style>
<script>
class BrightForgeProofCards extends HTMLElement {
 private controller?: AbortController;
 connectedCallback() {
  this.controller?.abort(); this.controller = new AbortController(); const {signal} = this.controller;
  const fine = matchMedia('(hover:hover) and (pointer:fine)'); const reduced = matchMedia('(prefers-reduced-motion:reduce)');
  this.querySelectorAll<HTMLAnchorElement>('.forge-proof-card').forEach(card => {
   const reset = () => ['--tilt-x','--tilt-y','--light-x','--light-y'].forEach(v => card.style.removeProperty(v));
   card.addEventListener('pointermove', e => {
    if (!fine.matches || reduced.matches || e.pointerType === 'touch') return;
    const b = card.getBoundingClientRect(), x = Math.max(0,Math.min(1,(e.clientX-b.left)/b.width)), y = Math.max(0,Math.min(1,(e.clientY-b.top)/b.height));
    card.style.setProperty('--tilt-x',`${(.5-y)*8}deg`); card.style.setProperty('--tilt-y',`${(x-.5)*8}deg`);
    card.style.setProperty('--light-x',`${x*100}%`); card.style.setProperty('--light-y',`${y*100}%`);
   },{signal});
   ['pointerleave','pointercancel','blur'].forEach(e => card.addEventListener(e,reset,{signal}));
   fine.addEventListener('change',reset,{signal}); reduced.addEventListener('change',reset,{signal});
  });
 }
 disconnectedCallback() { this.controller?.abort(); }
}
if (!customElements.get('brightforge-proof-cards')) customElements.define('brightforge-proof-cards',BrightForgeProofCards);
</script>
